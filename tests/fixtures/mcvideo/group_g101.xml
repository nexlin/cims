<?xml version="1.0" encoding="UTF-8"?>
<group xmlns="urn:oma:xml:poc:list-service"
  xmlns:rl="urn:ietf:params:xml:ns:resource-lists"
  xmlns:cp="urn:ietf:params:xml:ns:common-policy"
  xmlns:ocp="urn:oma:xml:xdm:common-policy"
  xmlns:oxe="urn:oma:xml:xdm:extensions"
  xmlns:mcpttgi="urn:3gpp:ns:mcpttGroupInfo:1.0"
  xmlns:cims="urn:cims:groupinfo:1.0">
  <list-service uri="tel:g101">
    <display-name xml:lang="en-us">현장영상 1팀</display-name>
    <list>
      <entry uri="tel:+82510002001">
        <rl:display-name>영상요원1</rl:display-name>
        <mcpttgi:participant-type>participant</mcpttgi:participant-type>
        <mcpttgi:user-priority>5</mcpttgi:user-priority>
        <mcpttgi:mcvideo-mcvideo-id uri="tel:+82510002001"/>
        <mcpttgi:mcdata-mcdata-id uri="tel:+82510002001"/>
      </entry>
      <entry uri="tel:+82510002002">
        <rl:display-name>영상요원2</rl:display-name>
        <mcpttgi:participant-type>participant</mcpttgi:participant-type>
        <mcpttgi:user-priority>5</mcpttgi:user-priority>
        <mcpttgi:mcvideo-mcvideo-id uri="tel:+82510002002"/>
        <mcpttgi:mcdata-mcdata-id uri="tel:+82510002002"/>
      </entry>
      <entry uri="tel:+82510002003">
        <rl:display-name>관제1</rl:display-name>
        <mcpttgi:participant-type>chair</mcpttgi:participant-type>
        <mcpttgi:user-priority>1</mcpttgi:user-priority>
        <mcpttgi:mcvideo-mcvideo-id uri="tel:+82510002003"/>
        <mcpttgi:mcdata-mcdata-id uri="tel:+82510002003"/>
      </entry>
    </list>
    <mcpttgi:mcdata-allow-short-data-service>true</mcpttgi:mcdata-allow-short-data-service>
    <mcpttgi:mcdata-allow-file-distribution>false</mcpttgi:mcdata-allow-file-distribution>
    <mcpttgi:mcdata-on-network-max-data-size-for-SDS>10000</mcpttgi:mcdata-on-network-max-data-size-for-SDS>
    <mcpttgi:mcdata-on-network-max-data-size-auto-recv>1048576</mcpttgi:mcdata-on-network-max-data-size-auto-recv>
    <mcpttgi:on-network-invite-members>true</mcpttgi:on-network-invite-members>
    <mcpttgi:preferred-voice-encodings><mcpttgi:encoding name="AMR-WB"/></mcpttgi:preferred-voice-encodings>
    <mcpttgi:on-network-require-affiliation>true</mcpttgi:on-network-require-affiliation>
    <mcpttgi:on-network-hang-timer>PT30S</mcpttgi:on-network-hang-timer>
    <mcpttgi:on-network-maximum-duration>PT3600S</mcpttgi:on-network-maximum-duration>
    <mcpttgi:on-network-minimum-number-to-start>0</mcpttgi:on-network-minimum-number-to-start>
    <mcpttgi:on-network-timeout-for-acknowledgement-of-required-members>PT5S</mcpttgi:on-network-timeout-for-acknowledgement-of-required-members>
    <mcpttgi:on-network-action-upon-expiration-of-timeout-for-acknowledgement-of-required-members>abandon</mcpttgi:on-network-action-upon-expiration-of-timeout-for-acknowledgement-of-required-members>
    <mcpttgi:protect-media>false</mcpttgi:protect-media>
    <mcpttgi:protect-floor-control-signalling>false</mcpttgi:protect-floor-control-signalling>
    <mcpttgi:on-network-require-talker-id>false</mcpttgi:on-network-require-talker-id>
    <mcpttgi:on-network-group-priority>5</mcpttgi:on-network-group-priority>
    <mcpttgi:on-network-encryption>false</mcpttgi:on-network-encryption>
    <mcpttgi:mcvideo-on-network-invite-members>false</mcpttgi:mcvideo-on-network-invite-members>
    <mcpttgi:mcvideo-on-network-maximum-duration>PT1800S</mcpttgi:mcvideo-on-network-maximum-duration>
    <mcpttgi:mcvideo-protect-media>false</mcpttgi:mcvideo-protect-media>
    <mcpttgi:mcvideo-protect-transmission-control>false</mcpttgi:mcvideo-protect-transmission-control>
    <mcpttgi:mcvideo-preferred-audio-encodings><mcpttgi:encoding name="AMR-WB"/></mcpttgi:mcvideo-preferred-audio-encodings>
    <mcpttgi:mcvideo-preferred-video-encodings><mcpttgi:encoding name="H264"/></mcpttgi:mcvideo-preferred-video-encodings>
    <mcpttgi:mcvideo-preferred-video-resolutions>1280x720,640x480</mcpttgi:mcvideo-preferred-video-resolutions>
    <mcpttgi:mcvideo-preferred-video-frame-rate>30,15</mcpttgi:mcvideo-preferred-video-frame-rate>
    <mcpttgi:mcvideo-non-urgent-real-time-video-mode>true</mcpttgi:mcvideo-non-urgent-real-time-video-mode>
    <mcpttgi:mcvideo-active-real-time-video-mode>non-urgent-real-time</mcpttgi:mcvideo-active-real-time-video-mode>
    <mcpttgi:mcvideo-maximum-simultaneous-mcvideo-transmitting-group-members>2</mcpttgi:mcvideo-maximum-simultaneous-mcvideo-transmitting-group-members>
    <mcpttgi:mcvideo-on-network-minimum-number-to-start>0</mcpttgi:mcvideo-on-network-minimum-number-to-start>
    <mcpttgi:mcvideo-on-network-group-priority>100</mcpttgi:mcvideo-on-network-group-priority>
    <mcpttgi:on-network-reception-hang-timer>PT30S</mcpttgi:on-network-reception-hang-timer>
    <cp:ruleset>
      <cp:rule id="a7c">
        <cp:conditions>
          <is-list-member/>
        </cp:conditions>
        <cp:actions>
          <allow-initiate-conference>true</allow-initiate-conference>
          <join-handling>true</join-handling>
          <mcpttgi:on-network-allow-getting-member-list>true</mcpttgi:on-network-allow-getting-member-list>
          <mcpttgi:allow-MCPTT-emergency-call>true</mcpttgi:allow-MCPTT-emergency-call>
          <mcpttgi:allow-imminent-peril-call>true</mcpttgi:allow-imminent-peril-call>
          <mcpttgi:allow-MCPTT-emergency-alert>true</mcpttgi:allow-MCPTT-emergency-alert>
          <mcpttgi:on-network-allow-conference-state>true</mcpttgi:on-network-allow-conference-state>
          <mcpttgi:mcvideo-allow-emergency-call>false</mcpttgi:mcvideo-allow-emergency-call>
          <mcpttgi:mcvideo-allow-emergency-alert>false</mcpttgi:mcvideo-allow-emergency-alert>
          <mcpttgi:mcvideo-allow-imminent-peril-call>false</mcpttgi:mcvideo-allow-imminent-peril-call>
          <mcpttgi:mcvideo-on-network-allow-conference-state>true</mcpttgi:mcvideo-on-network-allow-conference-state>
        </cp:actions>
      </cp:rule>
    </cp:ruleset>
    <oxe:supported-services>
     <oxe:service enabler="urn:urn-7:3gpp-service.ims.icsi.mcptt">
      <oxe:group-media>
       <mcpttgi:mcptt-speech/>
      </oxe:group-media>
     </oxe:service>
     <oxe:service enabler="urn:urn-7:3gpp-service.ims.icsi.mcvideo">
      <oxe:group-media>
       <mcpttgi:mcvideo-video-media/>
      </oxe:group-media>
     </oxe:service>
     <oxe:service enabler="urn:urn-7:3gpp-service.ims.icsi.mcdata.sds"/>
    </oxe:supported-services>
  </list-service>
</group>
