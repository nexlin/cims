#!/usr/bin/env python3
"""tester_models → schema/*.json 생성. 모델이 SoT, 스키마 파일은 파생물(워커 C++ 가 읽는다).
tests/test_tester_models.py 가 두 쪽의 동기화를 검사한다."""
import json
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_ROOT = os.path.normpath(os.path.join(_HERE, '..'))
sys.path.insert(0, os.path.join(_ROOT, 'src'))
sys.path.insert(1, os.path.normpath(os.path.join(_ROOT, '..', '..', 'core', 'oam', 'vendor')))

from services.tester_models import SCHEMAS, schema_json  # noqa: E402

out = os.path.join(_ROOT, 'schema')
os.makedirs(out, exist_ok=True)
for name in SCHEMAS:
    p = os.path.join(out, f'{name}.schema.json')
    with open(p, 'w', encoding='utf-8') as f:
        json.dump(schema_json(name), f, ensure_ascii=False, indent=2, sort_keys=True)
        f.write('\n')
    print(p)
