{
  "$defs": {
    "During": {
      "additionalProperties": false,
      "description": "media_hold 유지 구간 안 시각 지정 동작(§7 ⓓ) — at_s = 확립 뒤 경과 초. 컴파일러가 `hold at_s → 동작 → hold 나머지` 로 푼다.",
      "properties": {
        "at_s": {
          "minimum": 0,
          "title": "At S",
          "type": "number"
        },
        "expect": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "$ref": "#/$defs/Percentiles"
              }
            ]
          },
          "title": "Expect",
          "type": "object"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From"
        },
        "loop": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "media_send — false 면 샘플 끝에서 송출 정지(기본 true)",
          "title": "Loop"
        },
        "payload": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload"
        },
        "sample": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "media_send — 샘플 id(topology.media.samples). 생략 = 풀 기본 원천",
          "title": "Sample"
        },
        "step": {
          "enum": [
            "dtmf",
            "hold",
            "resume",
            "refer",
            "media_send",
            "media_stop"
          ],
          "title": "Step",
          "type": "string"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To"
        },
        "who": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Who"
        }
      },
      "required": [
        "at_s",
        "step"
      ],
      "title": "During",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "알람/이벤트 정의 코드 (alarm_catalog)",
          "title": "Code"
        },
        "kind": {
          "enum": [
            "recording_created",
            "log_errors",
            "alarm_raised",
            "event_logged",
            "rss_growth_mb",
            "fd_growth"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "proc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "rss_growth_mb/fd_growth — 판정할 프로세스(\"host/proc\" 또는 프로세스 이름 = 모든 호스트). 비면 관측된 프로세스 전부 중 최댓값",
          "title": "Proc"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FixtureAccessService": {
      "additionalProperties": false,
      "description": "접속서비스 변종 — 역할 신원의 현 서비스 레코드를 복제해 이름·필드를 바꿔 대상 CSP 컬렉션 access_services 에 넣는다(태그 cims-tester, run 뒤 제거).\nsubscriber 픽스처가 service_ref 로 참조한다(예: transfer_allowed=false 변종 — volte_supplementary_services.md §6.3 게이트).",
      "properties": {
        "from_role": {
          "description": "복제 원본 = 이 역할 첫 신원의 현 service_ref 레코드",
          "title": "From Role",
          "type": "string"
        },
        "kind": {
          "const": "access_service",
          "title": "Kind",
          "type": "string"
        },
        "set": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "바꿀 필드(예: {transfer_allowed: false}). name/id/kind/domain 은 못 바꾼다",
          "minProperties": 1,
          "title": "Set",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "from_role",
        "set"
      ],
      "title": "FixtureAccessService",
      "type": "object"
    },
    "FixturePhoneGroup": {
      "additionalProperties": false,
      "description": "전화 그룹(dispatch_center.md §4·§5.1 — 픽업 그룹 + 선택 대표번호). 멤버 = 역할 이름(유선/이동 UE 풀). CSC 가 멤버의 pickup_group 을 그룹 id 로 파생한다.",
      "properties": {
        "alert_mode": {
          "default": "parallel",
          "enum": [
            "parallel",
            "sequential"
          ],
          "title": "Alert Mode",
          "type": "string"
        },
        "kind": {
          "const": "phone_group",
          "title": "Kind",
          "type": "string"
        },
        "members": {
          "description": "그룹원 역할 이름 — 역할마다 계획의 첫 신원(단발 첫 인스턴스)이 멤버가 된다",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "no_answer_sec": {
          "default": 8,
          "maximum": 120,
          "minimum": 1,
          "title": "No Answer Sec",
          "type": "integer"
        },
        "overflow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "무응답 overflow 대상 역할 이름(선택)",
          "title": "Overflow"
        },
        "pilot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "대표번호(TS 24.239 Flexible Alerting) — 번호 리터럴 또는 ${var}. ${var} 인데 바인딩이 없으면 컨트롤러가 내선형 번호(7<첫 멤버 끝 3자리>0)를 만들어 그 바인딩에 넣는다(시나리오 to: \"${var}\" 와 짝). 생략 = 픽업 그룹만",
          "title": "Pilot"
        },
        "service_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "대표번호의 서비스명(pilot 있을 때) — 생략 = 첫 멤버 신원의 현 service_ref",
          "title": "Service Ref"
        }
      },
      "required": [
        "kind",
        "members"
      ],
      "title": "FixturePhoneGroup",
      "type": "object"
    },
    "FixtureRole": {
      "additionalProperties": false,
      "description": "역할(mcptt_authorization.md — 능력+범위). assign 의 역할 신원이 속한 person(users.id)에 배정한다(사람당 역할 하나 — 되돌릴 때 종전 역할로).",
      "properties": {
        "assign": {
          "description": "배정 대상 역할 이름",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Assign",
          "type": "array"
        },
        "history_read": {
          "default": "scope",
          "enum": [
            "none",
            "scope",
            "all"
          ],
          "title": "History Read",
          "type": "string"
        },
        "kind": {
          "const": "role",
          "title": "Kind",
          "type": "string"
        },
        "listen_visibility": {
          "default": "hidden",
          "description": "hidden|visible 또는 ${var} 바인딩(로스터 노출/은닉을 같은 시나리오로 두 번 볼 때)",
          "title": "Listen Visibility",
          "type": "string"
        },
        "monitor_call": {
          "default": "none",
          "enum": [
            "none",
            "own",
            "listed",
            "all"
          ],
          "title": "Monitor Call",
          "type": "string"
        },
        "monitor_targets": {
          "description": "monitor_call=listed — phone_group 픽스처 키",
          "items": {
            "type": "string"
          },
          "title": "Monitor Targets",
          "type": "array"
        },
        "ptt_listen": {
          "default": "none",
          "enum": [
            "none",
            "own",
            "listed",
            "all"
          ],
          "title": "Ptt Listen",
          "type": "string"
        },
        "ptt_targets": {
          "description": "ptt_listen=listed — MCPTT 그룹 id 리터럴 또는 ${group}(그룹 세션이 잡는 첫 그룹)",
          "items": {
            "type": "string"
          },
          "title": "Ptt Targets",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "assign"
      ],
      "title": "FixtureRole",
      "type": "object"
    },
    "FixtureSubscriber": {
      "additionalProperties": false,
      "description": "가입 서비스 소속 — 역할 신원의 회선 service_ref 를 바꾼다(CSC PUT /users/{person}/{kind}/{msisdn}). run 뒤 종전 값으로.",
      "properties": {
        "kind": {
          "const": "subscriber",
          "title": "Kind",
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "service_ref": {
          "description": "접속서비스 이름 — access_service 픽스처 키 또는 대상에 이미 있는 서비스명",
          "minLength": 1,
          "title": "Service Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "roles",
        "service_ref"
      ],
      "title": "FixtureSubscriber",
      "type": "object"
    },
    "Media": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "amr-wb",
          "description": "amr-wb | amr | pcmu | pcma | g722",
          "title": "Audio"
        },
        "rtp": {
          "default": "auto",
          "description": "미디어 평면 — auto: SDP 교환 즉시 송출 · none: 시그널링 전용 · explicit: media_send 가 부를 때만 송출",
          "enum": [
            "auto",
            "none",
            "explicit"
          ],
          "title": "Rtp",
          "type": "string"
        },
        "video": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "h264 | none",
          "title": "Video"
        }
      },
      "title": "Media",
      "type": "object"
    },
    "Percentiles": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P50"
        },
        "p95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95"
        },
        "p99": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P99"
        }
      },
      "title": "Percentiles",
      "type": "object"
    },
    "Role": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "역할이 쓰는 신원 수 — 생략=풀 전체",
          "title": "Count"
        },
        "disjoint_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disjoint From"
        },
        "member": {
          "default": true,
          "description": "그룹 세션에서 false = 그룹 밖 신원(청취 관제사·비멤버) — 인스턴스가 잡은 그룹의 멤버가 아닌 PTT 단말을 역할 풀에서 배정한다(다른 풀도 됨). 첫 group_call 의 from·to 는 될 수 없다",
          "title": "Member",
          "type": "boolean"
        },
        "multi": {
          "default": false,
          "description": "인스턴스마다 단말 여럿 — 그룹 세션(group_call)에서 단일 역할들이 멤버를 하나씩 잡고 남은 그룹 멤버 전부",
          "title": "Multi",
          "type": "boolean"
        },
        "pool": {
          "title": "Pool",
          "type": "string"
        }
      },
      "required": [
        "pool"
      ],
      "title": "Role",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "after_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Ms"
        },
        "cause": {
          "anyOf": [
            {
              "maximum": 127,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "bye/reject 의 Reason: Q.850;cause= (RFC 3326 — MGCF 종료 사유, 16=정상 34=회선 없음)",
          "title": "Cause"
        },
        "dial": {
          "anyOf": [
            {
              "enum": [
                "e164",
                "national",
                "international"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "invite 만 — 착신 역할의 E.164 신원을 어떤 꼴로 다이얼하는가: e164(기본, +82…) · national(국내형 0… — 대상 노드 sip.dial_plan 의 접두) · international(국제 접두 00+82…). 대상 CSP 의 다이얼 플랜 번역(TS 24.229 §5.4.3.2) 시험. 역할 대상에만(번호 리터럴 to 에는 못 둔다)",
          "title": "Dial"
        },
        "disposition": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sds_send — delivery disposition 요청(TS 24.282 §9.2.2): 수신 단말이 SDS NOTIFICATION(delivered)을 되보낸다(sds_disposition_pct)",
          "title": "Disposition"
        },
        "during": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/During"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "media_hold 만 — 유지 구간 안 통화 중 동작(at_s 순)",
          "title": "During"
        },
        "expect": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "$ref": "#/$defs/Percentiles"
              }
            ]
          },
          "title": "Expect",
          "type": "object"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "group_call — MCPTT 그룹 id 를 직접 지정(생략 = 인스턴스가 잡은 그룹, 곧 발신 멤버의 affiliation 그룹) · publish — affiliation 대상 그룹(생략 = 신원의 그룹) · sds_send/subscribe conference — 대상 그룹(생략 = 인스턴스 그룹)",
          "title": "Group"
        },
        "loop": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "media_send — false 면 샘플 끝에서 송출 정지(기본 true)",
          "title": "Loop"
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/Media"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "payload": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "dtmf: 숫자열(0-9*#A-D) · reject: 응답 코드 · floor_request: 기대 결과 granted|denied|queued|any · pickup: 피처코드(${var} 바인딩 가능) · subscribe: 이벤트 패키지(기본 dialog) · publish: affiliate|deaffiliate · fd_send: 파일 원천(합성 크기 256k|2m 또는 워커 샘플 파일 이름) · fd_recv: download(기본)|signal",
          "title": "Payload"
        },
        "plane": {
          "anyOf": [
            {
              "enum": [
                "control",
                "media"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sds_send — control(기본): SIP MESSAGE(C-plane) · media: MSRP media plane(TS 24.282 §9.2.3 — INVITE m=message → cmdp 종단, 수신자는 풀 msrp 면 MSRP 배포·아니면 FILEURL 폴백). 대상 CSP 는 그룹 SDS 만 media plane 을 받는다(1:1 은 403)",
          "title": "Plane"
        },
        "sample": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "media_send — 샘플 id(topology.media.samples). 생략 = 풀 기본 원천",
          "title": "Sample"
        },
        "seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "정수 또는 ${ht} 같은 바인딩",
          "title": "Seconds"
        },
        "step": {
          "enum": [
            "register",
            "deregister",
            "invite",
            "progress",
            "answer",
            "reject",
            "bye",
            "hold",
            "resume",
            "dtmf",
            "refer",
            "replaces",
            "join",
            "pickup",
            "subscribe",
            "publish",
            "group_call",
