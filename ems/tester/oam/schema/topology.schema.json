{
  "$defs": {
    "CredsSource": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "creds": {
          "description": "creds JSONL 경로(cspsim -creds 승계) — scenarios/ 상대 또는 절대",
          "title": "Creds",
          "type": "string"
        }
      },
      "required": [
        "creds"
      ],
      "title": "CredsSource",
      "type": "object"
    },
    "DbSource": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "db": {
          "const": "target",
          "description": "대상 DB — 토폴로지 target 의 CSC 가 알려주는 접속(계측기가 자격을 직접 갖지 않음)",
          "title": "Db",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "table": {
          "enum": [
            "volte_subscriptions",
            "voip_subscriptions",
            "ptt_subscriptions"
          ],
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "db",
        "table",
        "count"
      ],
      "title": "DbSource",
      "type": "object"
    },
    "PeerBind": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "protocol": {
          "default": "udp",
          "enum": [
            "udp",
            "tcp",
            "tls"
          ],
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "ip",
        "port"
      ],
      "title": "PeerBind",
      "type": "object"
    },
    "PeerIdentities": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "범위 앞에서부터 쓸 신원 수 — 생략=범위 전부",
          "title": "Count"
        },
        "did_range": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Did Range"
        },
        "e164_range": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "E164 Range"
        },
        "ext_len": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ext Len"
        }
      },
      "title": "PeerIdentities",
      "type": "object"
    },
    "PeerPool": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "default": "normal",
          "description": "silent = 착신 INVITE 무응답(죽은 피어 — failover 시험)",
          "enum": [
            "normal",
            "silent"
          ],
          "title": "Answer",
          "type": "string"
        },
        "bind": {
          "$ref": "#/$defs/PeerBind"
        },
        "codecs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "오퍼 코덱(우선순위 순). 생략=프로파일 기본 — ibcf/mgcf: AMR-WB,AMR,PCMU,PCMA · pbx: PCMA,PCMU (§3.2)",
          "title": "Codecs"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "dtmf": {
          "default": true,
          "description": "RFC 4733 telephone-event 오퍼/echo",
          "title": "Dtmf",
          "type": "boolean"
        },
        "identities": {
          "$ref": "#/$defs/PeerIdentities"
        },
        "kind": {
          "const": "peer",
          "title": "Kind",
          "type": "string"
        },
        "prack": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RFC 3262 100rel/PRACK — 생략=프로파일 기본(ibcf/mgcf 켬, pbx 끔)",
          "title": "Prack"
        },
        "profile": {
          "enum": [
            "ibcf",
            "pbx",
            "mgcf"
          ],
          "title": "Profile",
          "type": "string"
        },
        "register": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeerRegister"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pbx 트렁크 REGISTER — YAML 키는 register"
        },
        "seed": {
          "$ref": "#/$defs/PeerSeed"
        }
      },
      "required": [
        "kind",
        "profile",
        "bind",
        "domain",
        "identities"
      ],
      "title": "PeerPool",
      "type": "object"
    },
    "PeerRegister": {
      "additionalProperties": false,
      "description": "pbx 트렁크 REGISTER(SIPconnect 2.0 §8 등록 모드) — 계정 하나가 DID 범위를 대표. 대상의 access 접속점으로 Digest 등록.",
      "properties": {
        "expires": {
          "default": 3600,
          "minimum": 60,
          "title": "Expires",
          "type": "integer"
        },
        "ha1_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "H(A1) 을 담은 환경변수 — 비밀은 YAML 에 두지 않는다",
          "title": "Ha1 Env"
        },
        "password_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "평문 비밀번호 환경변수 — ha1_env 가 없을 때",
          "title": "Password Env"
        },
        "realm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Digest realm·To/From host — 비면 target.csp.domain_volte",
          "title": "Realm"
        },
        "user": {
          "title": "User",
          "type": "string"
        }
      },
      "required": [
        "user"
      ],
      "title": "PeerRegister",
      "type": "object"
    },
    "PeerSeed": {
      "additionalProperties": false,
      "description": "대상 CSP 컬렉션 시드 — 이 피어를 CSP 가 알게 하는 remote_node/route/rule/routing_policy 를 run 전에 넣고 끝에 복원한다\n(§3.2). 같은 `route_set` 을 가진 피어 풀은 한 RouteSet 의 멤버(priority/weight) — failover·round_robin 시험.",
      "properties": {
        "acl": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "이 피어 소스 IP 에 대한 ACL(global) — deny 면 403 기대",
          "title": "Acl"
        },
        "distribution": {
          "default": "failover",
          "enum": [
            "failover",
            "round_robin",
            "weighted",
            "hash_by_caller"
          ],
          "title": "Distribution",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "priority": {
          "default": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "route_set": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RouteSet 이름 — 생략=풀 이름",
          "title": "Route Set"
        },
        "weight": {
          "default": 1,
          "minimum": 1,
          "title": "Weight",
          "type": "integer"
        }
      },
      "title": "PeerSeed",
      "type": "object"
    },
    "RealUePool": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "real-ue",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CredsSource"
        },
        "srtp": {
          "default": "optional",
          "enum": [
            "off",
            "optional",
            "required"
          ],
          "title": "Srtp",
          "type": "string"
        },
        "transport": {
          "default": "tls",
          "enum": [
            "udp",
            "tcp",
            "tls"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source"
      ],
      "title": "RealUePool",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "csc": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetCsc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "csp": {
          "$ref": "#/$defs/TargetCsp"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "oam": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetOam"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observe": {
          "items": {
            "enum": [
              "oam_stats",
              "oam_alarms",
              "agent_heartbeat",
              "ssh_proc"
            ],
            "type": "string"
          },
          "title": "Observe",
          "type": "array"
        }
      },
      "required": [
        "name",
        "csp"
      ],
      "title": "Target",
      "type": "object"
    },
    "TargetCsc": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 4430,
          "title": "Port",
          "type": "integer"
        },
        "tls": {
          "default": true,
          "title": "Tls",
          "type": "boolean"
        }
      },
      "required": [
        "host"
      ],
      "title": "TargetCsc",
      "type": "object"
    },
    "TargetCsp": {
      "additionalProperties": false,
      "properties": {
        "domain_ptt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Ptt"
        },
        "domain_volte": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Volte"
        },
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "peering": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetPeering"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "피어 풀이 쓰는 CSP 피어링 접속점 — 없으면 access UDP 접속점"
        },
        "tcp": {
          "default": 25061,
          "title": "Tcp",
          "type": "integer"
        },
        "tls": {
          "default": 5061,
          "title": "Tls",
          "type": "integer"
        },
        "udp": {
          "default": 5060,
          "title": "Udp",
          "type": "integer"
        }
      },
      "required": [
        "ip"
      ],
      "title": "TargetCsp",
      "type": "object"
    },
    "TargetOam": {
      "additionalProperties": false,
      "description": "대상 관측·컬렉션 시드 전용 — 동거 형태여도 스토어를 직접 읽지 않고 이 API 로 본다(I5).",
      "properties": {
        "csp_deployment_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "대상 CSP 의 배포 id — 비면 배포 목록에서 패키지 csp 를 찾는다",
          "title": "Csp Deployment Id"
        },
        "token_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "토큰을 담은 환경변수 이름",
          "title": "Token Env"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "TargetOam",
      "type": "object"
    },
    "TargetPeering": {
      "additionalProperties": false,
      "description": "대상 CSP 의 피어링 접속점(edge=peering LocalNode) — 피어 풀 발신의 다음 홉이자 시드 route 의 local_node_ref.\n`local_node` 가 대상에 이미 있으면 그 레코드를 쓰고, 없으면 그 이름으로 LocalNode 를 시드한다(run 끝에 복원).",
      "properties": {
        "ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "비면 csp.ip",
          "title": "Ip"
        },
        "local_node": {
          "default": "cims-tester-peering",
          "description": "대상 local_nodes 의 name",
          "title": "Local Node",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "protocol": {
          "default": "udp",
          "enum": [
            "udp",
            "tcp",
            "tls"
          ],
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "port"
      ],
      "title": "TargetPeering",
      "type": "object"
    },
    "UePool": {
      "additionalProperties": false,
      "properties": {
        "dtmf": {
          "default": true,
          "description": "RFC 4733 telephone-event 를 오퍼/echo — dtmf 단계의 전제",
          "title": "Dtmf",
          "type": "boolean"
        },
        "kind": {
          "const": "ue",
          "title": "Kind",
          "type": "string"
        },
        "prack": {
          "default": false,
          "description": "RFC 3262 100rel — 발신 INVITE 에 Supported/Require: 100rel, RSeq 1xx 에 PRACK (mgcf early media 시험)",
          "title": "Prack",
          "type": "boolean"
        },
        "register_expires": {
          "default": 3600,
          "minimum": 60,
          "title": "Register Expires",
          "type": "integer"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/DbSource"
            },
            {
              "$ref": "#/$defs/CredsSource"
            }
          ],
          "title": "Source"
        },
        "srtp": {
          "default": "off",
          "enum": [
            "off",
            "optional",
            "required"
          ],
          "title": "Srtp",
          "type": "string"
        },
        "transport": {
          "default": "udp",
          "enum": [
            "udp",
            "tcp",
            "tls"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source"
      ],
      "title": "UePool",
      "type": "object"
    },
    "Worker": {
      "additionalProperties": false,
      "properties": {
        "cpus": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpus"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "url": {
          "description": "cims-tester-worker 제어 URL (http://ip:7100)",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "Worker",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "pools": {
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/UePool"
          },
          {
            "$ref": "#/$defs/PeerPool"
          },
          {
            "$ref": "#/$defs/RealUePool"
          }
        ]
      },
      "minProperties": 1,
      "title": "Pools",
      "type": "object"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "workers": {
      "description": "수동 항목 — 배포 목록에서 자동 발견한 워커에 보태거나 덮어쓴다(§6.1)",
      "items": {
        "$ref": "#/$defs/Worker"
      },
      "title": "Workers",
      "type": "array"
    }
  },
  "required": [
    "name",
    "target",
    "pools"
  ],
  "title": "Topology",
  "type": "object"
}
