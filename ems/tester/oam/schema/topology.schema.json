{
  "$defs": {
    "CredsSource": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "creds": {
          "description": "creds JSONL 경로(cspsim -creds 승계) — scenarios/ 상대 또는 절대",
          "title": "Creds",
          "type": "string"
        }
      },
      "required": [
        "creds"
      ],
      "title": "CredsSource",
      "type": "object"
    },
    "DbSource": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "db": {
          "description": "신원 원천 노드 id — role=db 또는 api 있는 subscriber 노드",
          "title": "Db",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "table": {
          "enum": [
            "volte_subscriptions",
            "voip_subscriptions",
            "ptt_subscriptions"
          ],
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "db",
        "table",
        "count"
      ],
      "title": "DbSource",
      "type": "object"
    },
    "Host": {
      "additionalProperties": false,
      "description": "서버 — 주소·SSH 자격의 유일한 자리. 계측기/대상/동거 구분은 필드가 아니라 그 위에 무엇이 있느냐(파생).",
      "properties": {
        "ip": {
          "minLength": 1,
          "title": "Ip",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "ssh": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostSsh"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "있으면 노드 procs 의 CPU/메모리를 SSH 로 관측(stop_on.target_cpu_pct 원천)"
        }
      },
      "required": [
        "ip"
      ],
      "title": "Host",
      "type": "object"
    },
    "HostSsh": {
      "additionalProperties": false,
      "properties": {
        "key_env": {
          "description": "SSH 개인키 경로를 담은 환경변수 이름 — 비밀은 레코드에 두지 않는다",
          "title": "Key Env",
          "type": "string"
        },
        "port": {
          "default": 22,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "user": {
          "title": "User",
          "type": "string"
        }
      },
      "required": [
        "user",
        "key_env"
      ],
      "title": "HostSsh",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "description": "UI 배치 상태 — 캔버스 영역(호스트) 좌표·크기, 카드(워커·노드) 좌표. 컴파일러는 읽지 않는다.",
      "properties": {
        "items": {
          "additionalProperties": {
            "$ref": "#/$defs/LayoutItem"
          },
          "title": "Items",
          "type": "object"
        },
        "regions": {
          "additionalProperties": {
            "$ref": "#/$defs/LayoutRegion"
          },
          "title": "Regions",
          "type": "object"
        }
      },
      "title": "Layout",
      "type": "object"
    },
    "LayoutItem": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 14,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 12,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "LayoutItem",
      "type": "object"
    },
    "LayoutRegion": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "default": 240,
          "title": "H",
          "type": "number"
        },
        "w": {
          "default": 360,
          "title": "W",
          "type": "number"
        },
        "x": {
          "default": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "LayoutRegion",
      "type": "object"
    },
    "NodeApi": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "tls": {
          "default": true,
          "title": "Tls",
          "type": "boolean"
        }
      },
      "required": [
        "port"
      ],
      "title": "NodeApi",
      "type": "object"
    },
    "NodeDb": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "cims",
          "title": "Name",
          "type": "string"
        },
        "password_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password Env"
        },
        "port": {
          "default": 3306,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "user_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Env"
        }
      },
      "title": "NodeDb",
      "type": "object"
    },
    "NodeMedia": {
      "additionalProperties": false,
      "properties": {
        "control": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control"
        },
        "rtp_range": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "있어야 미디어 leg 지표를 이 노드에 귀속",
          "title": "Rtp Range"
        }
      },
      "title": "NodeMedia",
      "type": "object"
    },
    "NodeOam": {
      "additionalProperties": false,
      "description": "CIMS 전용 — 통계·알람 관측 + 컬렉션 시드. url = https://<host.ip>:<port>.",
      "properties": {
        "csp_deployment_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "대상 CSP 의 배포 id — 비면 배포 목록에서 패키지 csp 를 찾는다",
          "title": "Csp Deployment Id"
        },
        "observe": {
          "items": {
            "enum": [
              "oam_stats",
              "oam_alarms",
              "agent_heartbeat",
              "ssh_proc"
            ],
            "type": "string"
          },
          "title": "Observe",
          "type": "array"
        },
        "port": {
          "default": 4419,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "tls": {
          "default": true,
          "title": "Tls",
          "type": "boolean"
        },
        "token_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "토큰을 담은 환경변수 이름(기본 TESTER_OAM_TOKEN)",
          "title": "Token Env"
        }
      },
      "title": "NodeOam",
      "type": "object"
    },
    "NodeSip": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "anyOf": [
            {
              "$ref": "#/$defs/SipAccess"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "peering": {
          "anyOf": [
            {
              "$ref": "#/$defs/SipPeering"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "NodeSip",
      "type": "object"
    },
    "NodeTas": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        }
      },
      "title": "NodeTas",
      "type": "object"
    },
    "PeerBind": {
      "additionalProperties": false,
      "description": "피어 수신점 — ip 는 워커 호스트 주소에서 파생된다.",
      "properties": {
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "protocol": {
          "default": "udp",
          "enum": [
            "udp",
            "tcp",
            "tls"
          ],
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "port"
      ],
      "title": "PeerBind",
      "type": "object"
    },
    "PeerIdentities": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "범위 앞에서부터 쓸 신원 수 — 생략=범위 전부",
          "title": "Count"
        },
        "did_range": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Did Range"
        },
        "e164_range": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "E164 Range"
        },
        "ext_len": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ext Len"
        }
      },
      "title": "PeerIdentities",
      "type": "object"
    },
    "PeerPool": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "default": "normal",
          "description": "silent = 착신 INVITE 무응답(죽은 피어 — failover 시험)",
          "enum": [
            "normal",
            "silent"
          ],
          "title": "Answer",
          "type": "string"
        },
        "bind": {
          "$ref": "#/$defs/PeerBind"
        },
        "codecs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "오퍼 코덱(우선순위 순). 생략=프로파일 기본 — ibcf/mgcf: AMR-WB,AMR,PCMU,PCMA · pbx: PCMA,PCMU (§3.2)",
          "title": "Codecs"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "dtmf": {
          "default": true,
          "description": "RFC 4733 telephone-event 오퍼/echo",
          "title": "Dtmf",
          "type": "boolean"
        },
        "group": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "논리 풀 이름 — 워커 여럿에 나눌 때 워커마다 풀 + 같은 group. 시나리오 roles.X.pool 이 참조",
          "title": "Group"
        },
        "identities": {
          "$ref": "#/$defs/PeerIdentities"
        },
        "kind": {
          "const": "peer",
          "title": "Kind",
          "type": "string"
        },
        "peering": {
          "description": "다음 홉 노드 id — sip.peering 이 있는 SIP 노드",
          "title": "Peering",
          "type": "string"
        },
        "prack": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RFC 3262 100rel/PRACK — 생략=프로파일 기본(ibcf/mgcf 켬, pbx 끔)",
          "title": "Prack"
        },
        "profile": {
          "enum": [
            "ibcf",
            "pbx",
            "mgcf"
          ],
          "title": "Profile",
          "type": "string"
        },
        "register": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeerRegister"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pbx 트렁크 REGISTER — YAML 키는 register"
        },
        "seed": {
          "$ref": "#/$defs/PeerSeed"
        },
        "worker": {
          "description": "이 풀이 놓인 워커(풀 하나 = 워커 하나)",
          "title": "Worker",
          "type": "string"
        }
      },
      "required": [
        "worker",
        "kind",
        "peering",
        "profile",
        "bind",
        "domain",
        "identities"
      ],
      "title": "PeerPool",
      "type": "object"
    },
    "PeerRegister": {
      "additionalProperties": false,
      "description": "pbx 트렁크 REGISTER(SIPconnect 2.0 §8 등록 모드) — 계정 하나가 DID 범위를 대표. 대상의 access 접속점으로 Digest 등록.",
      "properties": {
        "expires": {
          "default": 3600,
          "minimum": 60,
          "title": "Expires",
          "type": "integer"
        },
        "ha1_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "H(A1) 을 담은 환경변수 — 비밀은 YAML 에 두지 않는다",
          "title": "Ha1 Env"
        },
        "password_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "평문 비밀번호 환경변수 — ha1_env 가 없을 때",
          "title": "Password Env"
        },
        "realm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Digest realm·To/From host — 비면 접속점 기본 도메인",
          "title": "Realm"
        },
        "user": {
          "title": "User",
          "type": "string"
        }
      },
      "required": [
        "user"
      ],
      "title": "PeerRegister",
      "type": "object"
    },
    "PeerSeed": {
      "additionalProperties": false,
      "description": "대상 CSP 컬렉션 시드 — 이 피어를 CSP 가 알게 하는 remote_node/route/rule/routing_policy 를 run 전에 넣고 끝에 복원한다\n(§3.2). 같은 `route_set` 을 가진 피어 풀은 한 RouteSet 의 멤버(priority/weight) — failover·round_robin 시험.",
      "properties": {
        "acl": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "이 피어 소스 IP 에 대한 ACL — deny 면 403 기대",
          "title": "Acl"
        },
        "distribution": {
          "default": "failover",
          "enum": [
            "failover",
            "round_robin",
            "weighted",
            "hash_by_caller"
          ],
          "title": "Distribution",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "priority": {
          "default": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "route_set": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RouteSet 이름 — 생략=풀 이름",
          "title": "Route Set"
        },
        "weight": {
          "default": 1,
          "minimum": 1,
          "title": "Weight",
          "type": "integer"
        }
      },
      "title": "PeerSeed",
      "type": "object"
    },
    "RealUePool": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "title": "Access",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "논리 풀 이름 — 워커 여럿에 나눌 때 워커마다 풀 + 같은 group. 시나리오 roles.X.pool 이 참조",
          "title": "Group"
        },
        "kind": {
          "const": "real-ue",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CredsSource"
        },
        "srtp": {
          "default": "optional",
          "enum": [
            "off",
            "optional",
            "required"
          ],
          "title": "Srtp",
          "type": "string"
        },
        "transport": {
          "default": "tls",
          "enum": [
            "udp",
            "tcp",
            "tls"
          ],
          "title": "Transport",
          "type": "string"
        },
        "worker": {
          "description": "이 풀이 놓인 워커(풀 하나 = 워커 하나)",
          "title": "Worker",
          "type": "string"
        }
      },
      "required": [
        "worker",
        "kind",
        "access",
        "source"
      ],
      "title": "RealUePool",
      "type": "object"
    },
    "SipAccess": {
      "additionalProperties": false,
      "description": "UE 가 등록·발신하는 접속점 — transport 별 포트(없는 transport 는 그 노드에서 거절).",
      "properties": {
        "domains": {
          "description": "첫 항목 = 기본 홈 도메인, \"ptt\" 가 든 항목 = PTT 풀 도메인",
          "items": {
            "type": "string"
          },
          "title": "Domains",
          "type": "array"
        },
        "tcp": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tcp"
        },
        "tls": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tls"
        },
        "udp": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Udp"
        }
      },
      "title": "SipAccess",
      "type": "object"
    },
    "SipPeering": {
      "additionalProperties": false,
      "description": "피어 풀의 다음 홉(edge=peering 접속점). `local_node` 는 cims 대상에서만 — 대상 local_nodes 의 name(없으면 시드).",
      "properties": {
        "local_node": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cims: 대상 local_nodes 이름 — 비면 cims-tester-peering",
          "title": "Local Node"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "protocol": {
          "default": "udp",
          "enum": [
            "udp",
            "tcp",
            "tls"
          ],
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "port"
      ],
      "title": "SipPeering",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "kind": {
