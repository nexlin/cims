{
  "$defs": {
    "CredsSource": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "creds": {
          "description": "creds JSONL 경로(cspsim -creds 승계) — scenarios/ 상대 또는 절대",
          "title": "Creds",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "description": "파일의 몇 번째 신원부터(0 기준) — 워커 여럿이 같은 creds 파일의 다른 구간을 나눠 쓸 때",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "creds"
      ],
      "title": "CredsSource",
      "type": "object"
    },
    "DbSource": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "db": {
          "description": "신원 원천 노드 id — role=db 또는 api 있는 subscriber 노드",
          "title": "Db",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "ptt_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ptt_subscriptions 만 — 이 MCPTT 그룹(mcptt_group_id) 멤버만 읽는다. 생략 = 가입자마다 첫 그룹(mcptt_group_id·priority 순)",
          "title": "Ptt Group"
        },
        "table": {
          "enum": [
            "volte_subscriptions",
            "voip_subscriptions",
            "ptt_subscriptions"
          ],
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "db",
        "table",
        "count"
      ],
      "title": "DbSource",
      "type": "object"
    },
    "Host": {
      "additionalProperties": false,
      "description": "서버 — 주소·SSH 자격의 유일한 자리. 계측기/대상/동거 구분은 필드가 아니라 그 위에 무엇이 있느냐(파생).",
      "properties": {
        "ip": {
          "minLength": 1,
          "title": "Ip",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "ssh": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostSsh"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "있으면 run 동안 SSH 로 호스트 CPU/메모리·노드 procs 의 프로세스별 CPU/RSS 를 관측하고(stop_on.target_cpu_pct 원천) nodes.*.logs 의 늘어난 ERROR 줄을 센다(log_errors). 비밀은 key_env 의 개인키 파일"
        }
      },
      "required": [
        "ip"
      ],
      "title": "Host",
      "type": "object"
    },
    "HostSsh": {
      "additionalProperties": false,
      "properties": {
        "key_env": {
          "description": "SSH 개인키 경로를 담은 환경변수 이름 — 비밀은 레코드에 두지 않는다",
          "title": "Key Env",
          "type": "string"
        },
        "port": {
          "default": 22,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "user": {
          "title": "User",
          "type": "string"
        }
      },
      "required": [
        "user",
        "key_env"
      ],
      "title": "HostSsh",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "description": "UI 배치 상태 — 캔버스 영역(호스트) 좌표·크기, 카드(워커·노드) 좌표. 컴파일러는 읽지 않는다.",
      "properties": {
        "items": {
          "additionalProperties": {
            "$ref": "#/$defs/LayoutItem"
          },
          "title": "Items",
          "type": "object"
        },
        "regions": {
          "additionalProperties": {
            "$ref": "#/$defs/LayoutRegion"
          },
          "title": "Regions",
          "type": "object"
        }
      },
      "title": "Layout",
      "type": "object"
    },
    "LayoutItem": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 14,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 12,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "LayoutItem",
      "type": "object"
    },
    "LayoutRegion": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "default": 240,
          "title": "H",
          "type": "number"
        },
        "w": {
          "default": 360,
          "title": "W",
          "type": "number"
        },
        "x": {
          "default": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "LayoutRegion",
      "type": "object"
    },
    "NodeApi": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "tls": {
          "default": true,
          "title": "Tls",
          "type": "boolean"
        }
      },
      "required": [
        "port"
      ],
      "title": "NodeApi",
      "type": "object"
    },
    "NodeDb": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "cims",
          "title": "Name",
          "type": "string"
        },
        "password_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password Env"
        },
        "port": {
          "default": 3306,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "user_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Env"
        }
      },
      "title": "NodeDb",
      "type": "object"
    },
    "NodeMedia": {
      "additionalProperties": false,
      "properties": {
        "control": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control"
        },
        "rtp_range": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "있어야 미디어 leg 지표를 이 노드에 귀속",
          "title": "Rtp Range"
        }
      },
      "title": "NodeMedia",
      "type": "object"
    },
    "NodeOam": {
      "additionalProperties": false,
      "description": "CIMS 전용 — 통계·알람 관측 + 컬렉션 시드. url = https://<host.ip>:<port>.",
      "properties": {
        "csp_deployment_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "대상 CSP 의 배포 id — 비면 배포 목록에서 패키지 csp 를 찾는다",
          "title": "Csp Deployment Id"
        },
        "observe": {
          "items": {
            "enum": [
              "oam_stats",
              "oam_alarms",
              "agent_heartbeat",
              "ssh_proc"
            ],
            "type": "string"
          },
          "title": "Observe",
          "type": "array"
        },
        "port": {
          "default": 4419,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "tls": {
          "default": true,
          "title": "Tls",
          "type": "boolean"
        },
        "token_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "토큰을 담은 환경변수 이름(기본 TESTER_OAM_TOKEN)",
          "title": "Token Env"
        }
      },
      "title": "NodeOam",
      "type": "object"
    },
    "NodeSip": {
      "additionalProperties": false,
      "description": "SIP 노드의 수신점 N 개 + 도메인. 입력이 이전 꼴(`access{udp,tcp,tls,domains}`·`peering{port,protocol,local_node}`)이면\n`normalize_sip_block` 이 수신점 항목 `udp`/`tcp`/`tls`/`peering` 으로 승계한다(store 도 읽을 때 같은 함수로 바꿔 저장).",
      "properties": {
        "domains": {
          "description": "첫 항목 = 기본 홈 도메인, \"ptt\" 가 든 항목 = PTT 풀 도메인",
          "items": {
            "type": "string"
          },
          "title": "Domains",
          "type": "array"
        },
        "listeners": {
          "additionalProperties": {
            "$ref": "#/$defs/SipListener"
          },
          "title": "Listeners",
          "type": "object"
        }
      },
      "title": "NodeSip",
      "type": "object"
    },
    "NodeTas": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        }
      },
      "title": "NodeTas",
      "type": "object"
    },
    "PeerBind": {
      "additionalProperties": false,
      "description": "피어 수신점 — ip 가 비면 워커 호스트 주소(다중 IP 호스트면 여기서 고른다).",
      "properties": {
        "ip": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ip"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "protocol": {
          "default": "udp",
          "enum": [
            "udp",
            "tcp",
            "tls"
          ],
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "port"
      ],
      "title": "PeerBind",
      "type": "object"
    },
    "PeerFault": {
      "additionalProperties": false,
      "description": "피어 오류 주입 — answer 정책의 매개변수(code/q850/delay_ms) + answer 와 독립인 **와이어 유실**(drop_invite/drop_pct — psip RecvFilter 로\n수신 메시지를 트랜잭션에 넣기 전에 버린다 → 상대의 Timer A/E 재전송이 닿는지, SRD 가 T1 만큼 늘어나는지 시험. UDP 에서만 뜻이 있다).",
      "properties": {
        "code": {
          "default": 503,
          "description": "answer=reject 의 최종 응답 코드(503 = 5xx failover, 486/603 = 사용자 측 거절)",
          "maximum": 699,
          "minimum": 300,
          "title": "Code",
          "type": "integer"
        },
        "delay_ms": {
          "default": 0,
          "description": "answer=delay — 착신 INVITE 뒤 이 시간 동안 아무 응답도 내지 않는다(100 Trying 은 스택)",
          "maximum": 120000,
          "minimum": 0,
          "title": "Delay Ms",
          "type": "integer"
        },
        "drop_invite": {
          "default": 0,
          "description": "새 착신 INVITE 마다 첫 N 벌을 와이어 유실처럼 버린다(1 = 상대 Timer A 500 ms 재전송이 첫 도달 — 카운터 peer_fault_drop·invite_retrans_rx, 비율 retrans_rx_pct)",
          "maximum": 5,
          "minimum": 0,
          "title": "Drop Invite",
          "type": "integer"
        },
        "drop_pct": {
          "default": 0,
          "description": "모든 수신 메시지를 이 확률(%)로 버린다 — 재전송·재시도 복원력(응답 유실 → 상대의 200 재전송 등)",
          "maximum": 90,
          "minimum": 0,
          "title": "Drop Pct",
          "type": "integer"
        },
        "q850": {
          "anyOf": [
            {
              "maximum": 127,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "거절에 실을 Reason: Q.850;cause= (RFC 3326 — 대상의 Reason 투과 시험)",
          "title": "Q850"
        }
      },
      "title": "PeerFault",
      "type": "object"
    },
    "PeerIdentities": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "범위 앞에서부터 쓸 신원 수 — 생략=범위 전부",
          "title": "Count"
        },
        "did_range": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Did Range"
        },
        "e164_range": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "E164 Range"
        },
        "ext_len": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ext Len"
        }
      },
      "title": "PeerIdentities",
      "type": "object"
    },
    "PeerPool": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "default": "normal",
          "description": "착신 정책 — normal: 시나리오 단계가 응답 · silent: 무응답(죽은 피어 — Timer B failover) · reject: 엔진이 즉시 fault.code 로 거절(5xx failover·Reason 투과) · delay: fault.delay_ms 동안 100 Trying 뒤 침묵(응답 지연 — 대상 타이머·early media 대기 시험), 그 뒤 시나리오 단계가 응답",
          "enum": [
            "normal",
            "silent",
            "reject",
            "delay"
          ],
          "title": "Answer",
          "type": "string"
        },
        "bind": {
          "$ref": "#/$defs/PeerBind"
        },
        "codecs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "오퍼 코덱(우선순위 순). 생략=프로파일 기본 — ibcf/mgcf: AMR-WB,AMR,PCMU,PCMA · pbx: PCMA,PCMU (§3.2)",
          "title": "Codecs"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "dtmf": {
          "default": "rfc4733",
          "description": "DTMF 방식 — rfc4733(telephone-event 오퍼/echo) · inband(G.711 톤 — mgcf in-band 옵션) · off. 옛 bool 도 받는다",
          "enum": [
            "rfc4733",
            "inband",
            "off"
          ],
          "title": "Dtmf",
          "type": "string"
        },
        "fault": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeerFault"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "answer reject/delay 의 매개변수 + 와이어 유실 drop_invite/drop_pct(오류 주입)"
        },
        "group": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "논리 풀 이름 — 워커 여럿에 나눌 때 워커마다 풀 + 같은 group. 시나리오 roles.X.pool 이 참조",
          "title": "Group"
        },
        "identities": {
          "$ref": "#/$defs/PeerIdentities"
        },
        "kind": {
          "const": "peer",
          "title": "Kind",
          "type": "string"
        },
        "listener": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "그 노드의 수신점 id — 비면 첫 edge=peering 수신점, 없으면 bind.protocol 과 같은 첫 수신점. access 수신점도 된다(CSP 는 Route 로 피어를 신뢰한다)",
          "title": "Listener"
        },
        "peering": {
          "description": "다음 홉 노드 id — SIP 노드(수신점 하나 이상)",
          "title": "Peering",
          "type": "string"
        },
        "prack": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RFC 3262 100rel/PRACK — 생략=프로파일 기본(ibcf/mgcf 켬, pbx 끔)",
          "title": "Prack"
        },
        "profile": {
          "enum": [
            "ibcf",
            "pbx",
            "mgcf"
          ],
          "title": "Profile",
          "type": "string"
        },
        "register": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeerRegister"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pbx 트렁크 REGISTER — YAML 키는 register"
        },
        "seed": {
          "$ref": "#/$defs/PeerSeed"
        },
        "thig": {
          "default": false,
          "description": "ibcf — 발신 INVITE 에 토큰화 Via(tokenized-by, TS 24.229 §5.10.4 THIG 흔적)를 얹고 응답의 Via 보존을 관측(thig_pct)",
          "title": "Thig",
          "type": "boolean"
        },
        "tls_client_auth": {
          "default": false,
          "description": "bind.protocol=tls — 수신점이 클라이언트 인증서를 요구(상호인증, 워커 Tls.CaFile 이 발급자). 대상 CSP 가 인증서를 내지 않으면 핸드셰이크 실패 = §12 과제 드러남",
          "title": "Tls Client Auth",
          "type": "boolean"
        },
        "tls_client_cert": {
          "default": false,
          "description": "발신 TLS 연결에 워커 Tls.ClientCertFile 을 클라이언트 인증서로 제시(대상 접속점이 상호인증을 요구할 때)",
          "title": "Tls Client Cert",
          "type": "boolean"
        },
        "tls_verify": {
          "default": false,
          "description": "발신 TLS 연결(→ 대상 수신점·트렁크 REGISTER)에서 서버 인증서를 워커 Tls.CaFile 로 검증",
          "title": "Tls Verify",
          "type": "boolean"
        },
        "worker": {
          "description": "이 풀이 놓인 워커(풀 하나 = 워커 하나)",
          "title": "Worker",
          "type": "string"
        }
      },
      "required": [
        "worker",
        "kind",
        "peering",
        "profile",
        "bind",
        "domain",
        "identities"
      ],
      "title": "PeerPool",
      "type": "object"
    },
    "PeerRegister": {
      "additionalProperties": false,
