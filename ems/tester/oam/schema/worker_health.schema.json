{
  "$defs": {
    "WorkerHealthMedia": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "description": "샘플 디렉터리의 파일 이름 — 컨트롤러가 샘플 라이브러리와 대조",
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "max_rtp_streams": {
          "default": 0,
          "description": "Media.MaxRtpStreams — 0 = 제한 없음",
          "minimum": 0,
          "title": "Max Rtp Streams",
          "type": "integer"
        },
        "rtp_streams": {
          "default": 0,
          "description": "RTP 를 쓰는 단말 수(진행 중 인스턴스의 단말, rtp: none 제외)",
          "minimum": 0,
          "title": "Rtp Streams",
          "type": "integer"
        },
        "sample_dir": {
          "default": "",
          "title": "Sample Dir",
          "type": "string"
        }
      },
      "title": "WorkerHealthMedia",
      "type": "object"
    },
    "WorkerPoolState": {
      "additionalProperties": false,
      "properties": {
        "affiliated": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "service=ptt — 그룹 affiliation 200 을 받은 단말 수",
          "title": "Affiliated"
        },
        "endpoints": {
          "title": "Endpoints",
          "type": "integer"
        },
        "groups": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "service=ptt — 이 풀 신원이 속한 MCPTT 그룹 수",
          "title": "Groups"
        },
        "kind": {
          "enum": [
            "ue",
            "peer",
            "real-ue"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pool": {
          "title": "Pool",
          "type": "string"
        },
        "registered": {
          "default": 0,
          "title": "Registered",
          "type": "integer"
        },
        "service": {
          "anyOf": [
            {
              "enum": [
                "volte",
                "voip",
                "ptt"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service"
        }
      },
      "required": [
        "pool",
        "kind",
        "endpoints"
      ],
      "title": "WorkerPoolState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "GET /health 응답 — 용량 선언 + 시계 확인(§6.1).",
  "properties": {
    "active_endpoints": {
      "minimum": 0,
      "title": "Active Endpoints",
      "type": "integer"
    },
    "active_run": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Run"
    },
    "clock_unix_ms": {
      "description": "워커 시각 — 컨트롤러가 오차를 계산, > 50 ms 면 경고",
      "title": "Clock Unix Ms",
      "type": "integer"
    },
    "cpu_pct": {
      "minimum": 0,
      "title": "Cpu Pct",
      "type": "number"
    },
    "local_ip": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Ip"
    },
    "max_endpoints": {
      "minimum": 0,
      "title": "Max Endpoints",
      "type": "integer"
    },
    "max_saps": {
      "minimum": 0,
      "title": "Max Saps",
      "type": "number"
    },
    "media": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkerHealthMedia"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pools": {
      "items": {
        "$ref": "#/$defs/WorkerPoolState"
      },
      "title": "Pools",
      "type": "array"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "worker": {
      "title": "Worker",
      "type": "string"
    }
  },
  "required": [
    "worker",
    "version",
    "max_endpoints",
    "max_saps",
    "cpu_pct",
    "active_endpoints",
    "clock_unix_ms"
  ],
  "title": "WorkerHealth",
  "type": "object"
}
