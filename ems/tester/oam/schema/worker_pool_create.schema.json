{
  "$defs": {
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "aka_k": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aka K"
        },
        "aka_opc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aka Opc"
        },
        "auth_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IMPI 사용자부 — '@' 없으면 워커가 domain 을 붙인다(cspsim -creds authId 규약). 비면 user",
          "title": "Auth Id"
        },
        "auth_scheme": {
          "default": "digest",
          "enum": [
            "digest",
            "aka"
          ],
          "title": "Auth Scheme",
          "type": "string"
        },
        "display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "ha1": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ha1"
        },
        "password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password"
        },
        "user": {
          "title": "User",
          "type": "string"
        }
      },
      "required": [
        "user",
        "domain"
      ],
      "title": "Identity",
      "type": "object"
    },
    "PeerBind": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "protocol": {
          "default": "udp",
          "enum": [
            "udp",
            "tcp",
            "tls"
          ],
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "ip",
        "port"
      ],
      "title": "PeerBind",
      "type": "object"
    },
    "PeerIdentities": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "범위 앞에서부터 쓸 신원 수 — 생략=범위 전부",
          "title": "Count"
        },
        "did_range": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Did Range"
        },
        "e164_range": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "E164 Range"
        },
        "ext_len": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ext Len"
        }
      },
      "title": "PeerIdentities",
      "type": "object"
    },
    "PeerPool": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "default": "normal",
          "description": "silent = 착신 INVITE 무응답(죽은 피어 — failover 시험)",
          "enum": [
            "normal",
            "silent"
          ],
          "title": "Answer",
          "type": "string"
        },
        "bind": {
          "$ref": "#/$defs/PeerBind"
        },
        "codecs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "오퍼 코덱(우선순위 순). 생략=프로파일 기본 — ibcf/mgcf: AMR-WB,AMR,PCMU,PCMA · pbx: PCMA,PCMU (§3.2)",
          "title": "Codecs"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "dtmf": {
          "default": true,
          "description": "RFC 4733 telephone-event 오퍼/echo",
          "title": "Dtmf",
          "type": "boolean"
        },
        "identities": {
          "$ref": "#/$defs/PeerIdentities"
        },
        "kind": {
          "const": "peer",
          "title": "Kind",
          "type": "string"
        },
        "prack": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RFC 3262 100rel/PRACK — 생략=프로파일 기본(ibcf/mgcf 켬, pbx 끔)",
          "title": "Prack"
        },
        "profile": {
          "enum": [
            "ibcf",
            "pbx",
            "mgcf"
          ],
          "title": "Profile",
          "type": "string"
        },
        "register": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeerRegister"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pbx 트렁크 REGISTER — YAML 키는 register"
        },
        "seed": {
          "$ref": "#/$defs/PeerSeed"
        }
      },
      "required": [
        "kind",
        "profile",
        "bind",
        "domain",
        "identities"
      ],
      "title": "PeerPool",
      "type": "object"
    },
    "PeerRegister": {
      "additionalProperties": false,
      "description": "pbx 트렁크 REGISTER(SIPconnect 2.0 §8 등록 모드) — 계정 하나가 DID 범위를 대표. 대상의 access 접속점으로 Digest 등록.",
      "properties": {
        "expires": {
          "default": 3600,
          "minimum": 60,
          "title": "Expires",
          "type": "integer"
        },
        "ha1_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "H(A1) 을 담은 환경변수 — 비밀은 YAML 에 두지 않는다",
          "title": "Ha1 Env"
        },
        "password_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "평문 비밀번호 환경변수 — ha1_env 가 없을 때",
          "title": "Password Env"
        },
        "realm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Digest realm·To/From host — 비면 target.csp.domain_volte",
          "title": "Realm"
        },
        "user": {
          "title": "User",
          "type": "string"
        }
      },
      "required": [
        "user"
      ],
      "title": "PeerRegister",
      "type": "object"
    },
    "PeerSeed": {
      "additionalProperties": false,
      "description": "대상 CSP 컬렉션 시드 — 이 피어를 CSP 가 알게 하는 remote_node/route/rule/routing_policy 를 run 전에 넣고 끝에 복원한다\n(§3.2). 같은 `route_set` 을 가진 피어 풀은 한 RouteSet 의 멤버(priority/weight) — failover·round_robin 시험.",
      "properties": {
        "acl": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "이 피어 소스 IP 에 대한 ACL(global) — deny 면 403 기대",
          "title": "Acl"
        },
        "distribution": {
          "default": "failover",
          "enum": [
            "failover",
            "round_robin",
            "weighted",
            "hash_by_caller"
          ],
          "title": "Distribution",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "priority": {
          "default": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "route_set": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RouteSet 이름 — 생략=풀 이름",
          "title": "Route Set"
        },
        "weight": {
          "default": 1,
          "minimum": 1,
          "title": "Weight",
          "type": "integer"
        }
      },
      "title": "PeerSeed",
      "type": "object"
    },
    "TargetCsp": {
      "additionalProperties": false,
      "properties": {
        "domain_ptt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Ptt"
        },
        "domain_volte": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Volte"
        },
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "peering": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetPeering"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "피어 풀이 쓰는 CSP 피어링 접속점 — 없으면 access UDP 접속점"
        },
        "tcp": {
          "default": 25061,
          "title": "Tcp",
          "type": "integer"
        },
        "tls": {
          "default": 5061,
          "title": "Tls",
          "type": "integer"
        },
        "udp": {
          "default": 5060,
          "title": "Udp",
          "type": "integer"
        }
      },
      "required": [
        "ip"
      ],
      "title": "TargetCsp",
      "type": "object"
    },
    "TargetPeering": {
      "additionalProperties": false,
      "description": "대상 CSP 의 피어링 접속점(edge=peering LocalNode) — 피어 풀 발신의 다음 홉이자 시드 route 의 local_node_ref.\n`local_node` 가 대상에 이미 있으면 그 레코드를 쓰고, 없으면 그 이름으로 LocalNode 를 시드한다(run 끝에 복원).",
      "properties": {
        "ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "비면 csp.ip",
          "title": "Ip"
        },
        "local_node": {
          "default": "cims-tester-peering",
          "description": "대상 local_nodes 의 name",
          "title": "Local Node",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "protocol": {
          "default": "udp",
          "enum": [
            "udp",
            "tcp",
            "tls"
          ],
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "port"
      ],
      "title": "TargetPeering",
      "type": "object"
    },
    "TrunkRegister": {
      "additionalProperties": false,
      "description": "워커에 내려가는 트렁크 REGISTER 계정 — 컨트롤러가 환경변수(ha1_env/password_env)를 풀어 값으로 채운다.",
      "properties": {
        "expires": {
          "default": 3600,
          "title": "Expires",
          "type": "integer"
        },
        "ha1": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ha1"
        },
        "password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password"
        },
        "realm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realm"
        },
        "user": {
          "title": "User",
          "type": "string"
        }
      },
      "required": [
        "user"
      ],
      "title": "TrunkRegister",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "POST /pools — 풀 생성·신원 적재. 멱등(pool 이름 기준).",
  "properties": {
    "dtmf": {
      "default": true,
      "description": "kind=ue — telephone-event 오퍼/echo",
      "title": "Dtmf",
      "type": "boolean"
    },
    "identities": {
      "items": {
        "$ref": "#/$defs/Identity"
      },
      "title": "Identities",
      "type": "array"
    },
    "kind": {
      "enum": [
        "ue",
        "peer",
        "real-ue"
      ],
      "title": "Kind",
      "type": "string"
    },
    "peer": {
      "anyOf": [
        {
          "$ref": "#/$defs/PeerPool"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "kind=peer 일 때 프로파일·bind·신원 범위"
    },
    "pool": {
      "title": "Pool",
      "type": "string"
    },
    "prack": {
      "default": false,
      "description": "kind=ue — 100rel/PRACK",
      "title": "Prack",
      "type": "boolean"
    },
    "srtp": {
      "default": "off",
      "enum": [
        "off",
        "optional",
        "required"
      ],
      "title": "Srtp",
      "type": "string"
    },
    "target_csp": {
      "$ref": "#/$defs/TargetCsp"
    },
    "transport": {
      "default": "udp",
      "enum": [
        "udp",
        "tcp",
        "tls"
      ],
      "title": "Transport",
      "type": "string"
    },
    "trunk_register": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrunkRegister"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "kind=peer(pbx) 트렁크 REGISTER 계정 — 비밀 해석 완료본"
    }
  },
  "required": [
    "pool",
    "kind",
    "target_csp"
  ],
  "title": "PoolCreate",
  "type": "object"
}
