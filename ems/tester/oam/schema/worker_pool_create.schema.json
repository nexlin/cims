{
  "$defs": {
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "aka_k": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aka K"
        },
        "aka_opc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aka Opc"
        },
        "auth_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IMPI 사용자부 — '@' 없으면 워커가 domain 을 붙인다(cspsim -creds authId 규약). 비면 user",
          "title": "Auth Id"
        },
        "auth_scheme": {
          "default": "digest",
          "enum": [
            "digest",
            "aka"
          ],
          "title": "Auth Scheme",
          "type": "string"
        },
        "display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "ha1": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ha1"
        },
        "password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password"
        },
        "ptt_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "service=ptt — 이 단말이 affiliation 하는 MCPTT 그룹 id(가상 단말 하나 = 그룹 하나)",
          "title": "Ptt Group"
        },
        "user": {
          "title": "User",
          "type": "string"
        }
      },
      "required": [
        "user",
        "domain"
      ],
      "title": "Identity",
      "type": "object"
    },
    "PeerFault": {
      "additionalProperties": false,
      "description": "피어 오류 주입 — answer 정책의 매개변수(code/q850/delay_ms) + answer 와 독립인 **와이어 유실**(drop_invite/drop_pct — psip RecvFilter 로\n수신 메시지를 트랜잭션에 넣기 전에 버린다 → 상대의 Timer A/E 재전송이 닿는지, SRD 가 T1 만큼 늘어나는지 시험. UDP 에서만 뜻이 있다).",
      "properties": {
        "code": {
          "default": 503,
          "description": "answer=reject 의 최종 응답 코드(503 = 5xx failover, 486/603 = 사용자 측 거절)",
          "maximum": 699,
          "minimum": 300,
          "title": "Code",
          "type": "integer"
        },
        "delay_ms": {
          "default": 0,
          "description": "answer=delay — 착신 INVITE 뒤 이 시간 동안 아무 응답도 내지 않는다(100 Trying 은 스택)",
          "maximum": 120000,
          "minimum": 0,
          "title": "Delay Ms",
          "type": "integer"
        },
        "drop_invite": {
          "default": 0,
          "description": "새 착신 INVITE 마다 첫 N 벌을 와이어 유실처럼 버린다(1 = 상대 Timer A 500 ms 재전송이 첫 도달 — 카운터 peer_fault_drop·invite_retrans_rx, 비율 retrans_rx_pct)",
          "maximum": 5,
          "minimum": 0,
          "title": "Drop Invite",
          "type": "integer"
        },
        "drop_pct": {
          "default": 0,
          "description": "모든 수신 메시지를 이 확률(%)로 버린다 — 재전송·재시도 복원력(응답 유실 → 상대의 200 재전송 등)",
          "maximum": 90,
          "minimum": 0,
          "title": "Drop Pct",
          "type": "integer"
        },
        "q850": {
          "anyOf": [
            {
              "maximum": 127,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "거절에 실을 Reason: Q.850;cause= (RFC 3326 — 대상의 Reason 투과 시험)",
          "title": "Q850"
        }
      },
      "title": "PeerFault",
      "type": "object"
    },
    "PeerIdentities": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "범위 앞에서부터 쓸 신원 수 — 생략=범위 전부",
          "title": "Count"
        },
        "did_range": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Did Range"
        },
        "e164_range": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "E164 Range"
        },
        "ext_len": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ext Len"
        }
      },
      "title": "PeerIdentities",
      "type": "object"
    },
    "TargetCsp": {
      "additionalProperties": false,
      "description": "풀이 닿는 SIP 서버(워커 관점) — access 포트 + 도메인 + (피어 풀) 피어링 다음 홉.",
      "properties": {
        "domain_ptt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Ptt"
        },
        "domain_volte": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Volte"
        },
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "peering": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetPeering"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tcp": {
          "default": 25061,
          "title": "Tcp",
          "type": "integer"
        },
        "tls": {
          "default": 5061,
          "title": "Tls",
          "type": "integer"
        },
        "udp": {
          "default": 5060,
          "title": "Udp",
          "type": "integer"
        }
      },
      "required": [
        "ip"
      ],
      "title": "TargetCsp",
      "type": "object"
    },
    "TargetPeering": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ip"
        },
        "local_node": {
          "default": "cims-tester-peering",
          "title": "Local Node",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "protocol": {
          "default": "udp",
          "enum": [
            "udp",
            "tcp",
            "tls"
          ],
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "port"
      ],
      "title": "TargetPeering",
      "type": "object"
    },
    "TrunkRegister": {
      "additionalProperties": false,
      "description": "워커에 내려가는 트렁크 REGISTER 계정 — 컨트롤러가 환경변수(ha1_env/password_env)를 풀어 값으로 채운다.",
      "properties": {
        "expires": {
          "default": 3600,
          "title": "Expires",
          "type": "integer"
        },
        "ha1": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ha1"
        },
        "password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password"
        },
        "realm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realm"
        },
        "user": {
          "title": "User",
          "type": "string"
        }
      },
      "required": [
        "user"
      ],
      "title": "TrunkRegister",
      "type": "object"
    },
    "UeNat": {
      "additionalProperties": false,
      "description": "NAT 뒤 단말 모사(§3.1 nat, ue_nat_traversal.md 검증) — 워커 호스트의 network namespace 안에서 UE 스택·RTP 소켓을 만든다(setns, 워커에\nCAP_SYS_ADMIN). netns·veth·MASQUERADE 는 워커 패키지 scripts/nat-netns.sh create <netns> 가 만든다. 대상은 호스트 주소로 변환된 소스만 본다.",
      "properties": {
        "local_ip": {
          "description": "netns 안 단말 주소 — SDP·Via·Contact 의 로컬 IP(스크립트 기본 <cidr>.2)",
          "minLength": 7,
          "title": "Local Ip",
          "type": "string"
        },
        "netns": {
          "description": "워커 호스트의 netns 이름(/var/run/netns/<netns>, Nat.NetnsDir)",
          "pattern": "^[A-Za-z0-9_-]{1,15}$",
          "title": "Netns",
          "type": "string"
        }
      },
      "required": [
        "netns",
        "local_ip"
      ],
      "title": "UeNat",
      "type": "object"
    },
    "WorkerPeer": {
      "additionalProperties": false,
      "description": "워커에 내려가는 피어 엔진 사양 — 토폴로지 PeerPool 에서 워커·노드 참조를 떼고 bind.ip(워커 호스트 주소)를 채운 것.",
      "properties": {
        "answer": {
          "default": "normal",
          "enum": [
            "normal",
            "silent",
            "reject",
            "delay"
          ],
          "title": "Answer",
          "type": "string"
        },
        "bind": {
          "$ref": "#/$defs/WorkerPeerBind"
        },
        "codecs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codecs"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "dtmf": {
          "default": "rfc4733",
          "enum": [
            "rfc4733",
            "inband",
            "off"
          ],
          "title": "Dtmf",
          "type": "string"
        },
        "fault": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeerFault"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "identities": {
          "$ref": "#/$defs/PeerIdentities"
        },
        "prack": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prack"
        },
        "profile": {
          "enum": [
            "ibcf",
            "pbx",
            "mgcf"
          ],
          "title": "Profile",
          "type": "string"
        },
        "thig": {
          "default": false,
          "title": "Thig",
          "type": "boolean"
        },
        "tls_client_auth": {
          "default": false,
          "title": "Tls Client Auth",
          "type": "boolean"
        },
        "tls_client_cert": {
          "default": false,
          "title": "Tls Client Cert",
          "type": "boolean"
        },
        "tls_verify": {
          "default": false,
          "title": "Tls Verify",
          "type": "boolean"
        }
      },
      "required": [
        "profile",
        "bind",
        "domain",
        "identities"
      ],
      "title": "WorkerPeer",
      "type": "object"
    },
    "WorkerPeerBind": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "protocol": {
          "default": "udp",
          "enum": [
            "udp",
            "tcp",
            "tls"
          ],
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "ip",
        "port"
      ],
      "title": "WorkerPeerBind",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "POST /pools — 풀 생성·신원 적재. 멱등(pool 이름 기준).",
  "properties": {
    "dtmf": {
      "default": "rfc4733",
      "description": "kind=ue — rfc4733(telephone-event 오퍼/echo) · inband(G.711 톤) · off",
      "enum": [
        "rfc4733",
        "inband",
        "off"
      ],
      "title": "Dtmf",
      "type": "string"
    },
    "identities": {
      "items": {
        "$ref": "#/$defs/Identity"
      },
      "title": "Identities",
      "type": "array"
    },
    "kind": {
      "enum": [
        "ue",
        "peer",
        "real-ue"
      ],
      "title": "Kind",
      "type": "string"
    },
    "nat": {
      "anyOf": [
        {
          "$ref": "#/$defs/UeNat"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "kind=ue — NAT 풀: 워커가 netns 안에서 스택을 띄운다(local_ip 가 단말 주소)"
    },
    "peer": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkerPeer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "kind=peer 일 때 프로파일·bind·신원 범위"
    },
    "pool": {
      "title": "Pool",
      "type": "string"
    },
    "prack": {
      "default": false,
      "description": "kind=ue — 100rel/PRACK",
      "title": "Prack",
      "type": "boolean"
    },
    "service": {
      "default": "volte",
      "description": "kind=ue — ptt 면 MCPTT 단말(기동 절차·자동응답·floor)",
      "enum": [
        "volte",
        "voip",
        "ptt"
      ],
      "title": "Service",
      "type": "string"
    },
    "srtp": {
      "default": "off",
      "enum": [
        "off",
        "optional",
        "required"
      ],
      "title": "Srtp",
      "type": "string"
    },
    "target_csp": {
      "$ref": "#/$defs/TargetCsp",
      "description": "풀이 닿는 SIP 서버 — 컨트롤러가 토폴로지 노드 참조에서 파생"
    },
    "tls_client_cert": {
      "default": false,
      "description": "kind=ue — 워커 Tls.ClientCertFile 을 클라이언트 인증서로 제시(대상 접속점 상호인증)",
      "title": "Tls Client Cert",
      "type": "boolean"
    },
    "tls_verify": {
      "default": false,
      "description": "kind=ue|real-ue — 서버 TLS 인증서 검증(ue: 워커 Tls.CaFile · real-ue: RealUe.TlsCaFile 앵커, 없으면 검증 없이)",
      "title": "Tls Verify",
      "type": "boolean"
    },
    "transport": {
      "default": "udp",
      "enum": [
        "udp",
        "tcp",
        "tls"
      ],
      "title": "Transport",
      "type": "string"
    },
    "trunk_register": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrunkRegister"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "kind=peer(pbx) 트렁크 REGISTER 계정 — 비밀 해석 완료본"
    }
  },
  "required": [
    "pool",
    "kind",
    "target_csp"
  ],
  "title": "PoolCreate",
  "type": "object"
}
