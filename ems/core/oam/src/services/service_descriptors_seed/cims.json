    {
      "id": "cims.svc.volte",
      "label": "VoLTE 서비스",
      "shapes": [
        "kpi",
        "time-bar",
        "distribution",
        "matrix"
      ],
      "endpoint": "/stats/calls?svc=volte",
      "query": [
        "granularity",
        "from",
        "to"
      ],
      "map": {
        "kpi": {
          "items": [
            {
              "label": "호 시도",
              "path": "totals.volte.attempts",
              "unit": "건"
            },
            {
              "label": "성공률",
              "path": "totals.volte.success_rate",
              "unit": "%"
            },
            {
              "label": "소통률",
              "path": "totals.volte.talk_rate",
              "unit": "%"
            },
            {
              "label": "완료율",
              "path": "totals.volte.completion_rate",
              "unit": "%"
            },
            {
              "label": "평균 통화시간",
              "path": "totals.volte.avg_duration_sec",
              "format": "duration"
            },
            {
              "label": "평균 접속지연",
              "path": "totals.volte.avg_pdd_ms",
              "unit": "ms"
            }
          ]
        },
        "time-bar": {
          "from": "buckets",
          "label": [
            "bucket",
            "label",
            "hour",
            "date"
          ],
          "value": "volte.attempts",
          "unit": "건"
        },
        "distribution": {
          "fromObject": "totals.volte.reasons",
          "totalPath": "totals.volte.attempts"
        },
        "matrix": {
          "from": "buckets",
          "label": [
            "bucket",
            "label",
            "hour",
            "date"
          ],
          "columns": [
            {
              "key": "attempts",
              "label": "시도",
              "path": "volte.attempts",
              "totalPath": "totals.volte.attempts",
              "unit": "건"
            },
            {
              "key": "sessions",
              "label": "성립",
              "path": "volte.sessions",
              "totalPath": "totals.volte.sessions",
              "unit": "건"
            },
            {
              "key": "talked",
              "label": "소통",
              "path": "volte.talked",
              "totalPath": "totals.volte.talked",
              "unit": "건"
            },
            {
              "key": "completed",
              "label": "정상종료",
              "path": "volte.completed",
              "totalPath": "totals.volte.completed",
              "unit": "건"
            },
            {
              "key": "success",
              "label": "성공률",
              "path": "volte.success_rate",
              "totalPath": "totals.volte.success_rate",
              "unit": "%"
            },
            {
              "key": "talk",
              "label": "소통률",
              "path": "volte.talk_rate",
              "totalPath": "totals.volte.talk_rate",
              "unit": "%"
            },
            {
              "key": "comp",
              "label": "완료율",
              "path": "volte.completion_rate",
              "totalPath": "totals.volte.completion_rate",
              "unit": "%"
