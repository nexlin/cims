      "name": "cwrtc",
      "controllable": true
    },
    {
      "name": "phone",
      "controllable": true
    },
    {
      "name": "cspsim"
    }
  ],
  "alert_rules": [
    {
      "type": "process_unresponsive",
      "code": "A-PRC-004",
      "perceived_severity": "major",
      "event_type": "processingError",
      "probable_cause": "responseTimeExcessive",
      "mo_class": "service",
      "check": "process_unresponsive",
      "target": "csp",
      "metric": "프로세스 응답성",
      "msg_open": "{mo} 관리 프로브(STATS) 무응답",
      "msg_close": "{mo} 응답 정상화",
      "effect": "CSP 제어/관측 불가 — hang·과부하 의심, 호처리 영향 가능",
      "recommended_action": "csp 프로세스 상태·부하 확인(process_down 동반 여부), 필요 시 재기동"
    },
    {
      "type": "process_unresponsive",
      "code": "A-PRC-004",
      "perceived_severity": "major",
      "event_type": "processingError",
      "probable_cause": "responseTimeExcessive",
      "mo_class": "service",
      "check": "process_unresponsive",
      "target": "cmp",
      "metric": "프로세스 응답성",
      "msg_open": "{mo} 관리 프로브(STATS) 무응답",
      "msg_close": "{mo} 응답 정상화",
      "effect": "CMP 미디어 노드 제어/관측 불가 — hang·과부하 의심",
      "recommended_action": "cmp 프로세스 상태·부하 확인(process_down 동반 여부), 필요 시 재기동"
    },
    {
      "type": "connection_lost",
      "code": "A-COM-001",
      "perceived_severity": "critical",
      "event_type": "communications",
      "probable_cause": "communicationsSubsystemFailure",
      "mo_class": "service",
      "check": "db_down",
      "metric": "DB 연결",
      "msg_open": "{mo} 연결 끊김",
      "msg_close": "{mo} 연결 복구",
      "effect": "가입자/그룹 조회·인증 실패",
      "recommended_action": "DB 가용성/방화벽/연결설정 확인"
    },
    {
      "type": "threshold_crossed",
      "code": "A-QOS-024",
      "perceived_severity": "warning",
      "event_type": "qualityOfService",
      "probable_cause": "resourceAtOrNearingCapacity",
      "mo_class": "service",
      "check": "rtp_pct_gte",
      "thresholds": {
        "minor": 80,
        "major": 90,
        "critical": 95
      },
      "unit": "%",
      "metric": "RTP 포트 사용률(노드별)",
      "msg_open": "{mo} 사용률 {pct}% ({threshold}% 초과)",
      "msg_close": "{mo} 사용률 {pct}% (정상)",
      "effect": "RTP 포트 고갈 임박 — 신규 미디어 세션 실패 위험",
      "recommended_action": "동시 세션/누수 점검, 포트 풀 증설"
    }
  ],
