{
  "id": "cims",
  "label": "CIMS",
  "modules": [
    { "name": "csp",    "port": 5060, "proto": "udp", "controllable": true },
    { "name": "isp",    "port": 5060, "proto": "udp" },
    { "name": "psp",    "port": 5060, "proto": "udp" },
    { "name": "cmp",    "port": 9000, "proto": "udp", "controllable": true },
    { "name": "imp",    "port": 9000, "proto": "udp" },
    { "name": "pmp",    "port": 9000, "proto": "udp" },
    { "name": "csc",    "port": 4421, "proto": "tcp", "controllable": true },
    { "name": "cwrtc",  "controllable": true },
    { "name": "phone",  "controllable": true },
    { "name": "cspsim" }
  ],
  "alert_rules": [
    { "type": "process_down", "code": "CIMS-PRC-001", "perceived_severity": "critical",
      "event_type": "processingError", "probable_cause": "softwareError", "mo_class": "software",
      "check": "process_down", "target": "csp", "mo_instance": "cims/csp", "metric": "프로세스 가용성",
      "msg_open": "{mo} 프로세스 응답 없음", "msg_close": "{mo} 정상화",
      "effect": "CSP 호처리(SIP 시그널링) 중단", "recommended_action": "csp 재기동, 로그/코어 확인, HA 절체 점검" },
    { "type": "process_down", "code": "CIMS-PRC-001", "perceived_severity": "critical",
      "event_type": "processingError", "probable_cause": "softwareError", "mo_class": "software",
      "check": "process_down", "target": "cmp", "mo_instance": "cims/cmp", "metric": "프로세스 가용성",
      "msg_open": "{mo} 프로세스 응답 없음", "msg_close": "{mo} 정상화",
      "effect": "CMP RTP 릴레이/미디어 처리 중단", "recommended_action": "cmp 재기동, 로그 확인, HA 절체 점검" },
    { "type": "connection_lost", "code": "CIMS-COM-001", "perceived_severity": "critical",
      "event_type": "communications", "probable_cause": "communicationsSubsystemFailure", "mo_class": "service",
      "check": "db_down", "mo_instance": "cims/db", "metric": "DB 연결",
      "msg_open": "{mo} 연결 끊김", "msg_close": "{mo} 연결 복구",
      "effect": "가입자/그룹 조회·인증 실패", "recommended_action": "DB 가용성/방화벽/연결설정 확인" },
    { "type": "threshold_crossed", "code": "CIMS-QOS-001", "perceived_severity": "warning",
      "event_type": "qualityOfService", "probable_cause": "resourceAtOrNearingCapacity", "mo_class": "service",
      "check": "rtp_pct_gte", "threshold": 80, "unit": "%", "mo_instance": "cims/rtp_ports", "metric": "RTP 포트 사용률",
      "msg_open": "{mo} 사용률 {pct}% ({threshold}% 초과)", "msg_close": "{mo} 사용률 {pct}% (정상)",
      "effect": "RTP 포트 고갈 임박 — 신규 미디어 세션 실패 위험", "recommended_action": "동시 세션/누수 점검, 포트 풀 증설" }
  ],
  "data_sources": [
    { "id": "cims.msg.sip", "label": "SIP 메시지", "shapes": ["time-bar", "table"],
      "endpoint": "/stats/messages/sip", "query": ["date"],
      "map": {
        "time-bar": { "from": "buckets", "label": ["hour"], "value": "count" },
        "table": { "fromObject": "method_counts", "columns": ["메서드", "건수"] } } },
    { "id": "cims.msg.cmp", "label": "CMP 메시지", "shapes": ["time-bar", "table"],
      "endpoint": "/stats/messages/cmp", "query": ["date"],
      "map": {
        "time-bar": { "from": "buckets", "label": ["hour"], "value": "count" },
        "table": { "fromObject": "method_counts", "columns": ["메서드", "건수"] } } },
    { "id": "cims.msg.csc", "label": "CSC 메시지", "shapes": ["time-bar", "table"],
      "endpoint": "/stats/messages/csc", "query": ["date"],
      "map": {
        "time-bar": { "from": "buckets", "label": ["hour"], "value": "count" },
        "table": { "fromObject": "method_counts", "columns": ["메서드", "건수"] } } },
    { "id": "cims.msg.https", "label": "HTTPS 메시지", "shapes": ["time-bar", "table"],
      "endpoint": "/stats/messages/https", "query": ["date"],
      "map": {
        "time-bar": { "from": "buckets", "label": ["hour"], "value": "count" },
        "table": { "fromObject": "method_counts", "columns": ["메서드", "건수"] } } },
    { "id": "cims.svc.volte", "label": "VoLTE 서비스", "shapes": ["kpi", "time-bar", "distribution"],
      "endpoint": "/stats/service/volte", "query": ["date", "granularity"],
      "map": {
        "kpi": { "items": [
          { "label": "호 시도", "path": "volte.total_attempts", "unit": "건" },
          { "label": "호 성공률", "path": "volte.success_rate", "unit": "%" },
          { "label": "평균 통화시간", "path": "volte.avg_duration_sec", "format": "duration" },
          { "label": "성공", "path": "volte.total_success", "unit": "건" } ] },
        "time-bar": { "from": "volte.buckets", "label": ["hour", "date"], "value": "attempts" },
        "distribution": { "fromObject": "volte.end_reasons", "totalPath": "volte.total_attempts" } } },
    { "id": "cims.svc.ptt", "label": "PTT 서비스", "shapes": ["kpi", "time-bar", "distribution"],
      "endpoint": "/stats/service/ptt", "query": ["date", "granularity"],
      "map": {
        "kpi": { "items": [
          { "label": "그룹콜 수", "path": "ptt.total_calls", "unit": "건" },
          { "label": "평균 세션 시간", "path": "ptt.avg_duration_sec", "format": "duration" } ] },
        "time-bar": { "from": "ptt.buckets", "label": ["hour", "date"], "value": "calls" },
        "distribution": { "fromObject": "ptt.by_group", "totalPath": "ptt.total_calls" } } },
    { "id": "cims.msg-summary", "label": "메시지 합계 (전 interface)", "shapes": ["time-bar"],
      "endpoint": "/stats/messages", "query": ["date"],
      "map": { "time-bar": { "from": "buckets", "label": ["hour"], "value": "count" } } }
  ],
  "shareable_apis": [
    { "id": "share.stats.volte", "method": "GET", "path": "/stats/service/volte", "category": "stats",
      "summary": "VoLTE 서비스 통계 (일간 KPI/시간대 버킷/종료사유 분포)", "auth": "Bearer JWT",
      "audience": "VoLTE/PTT 사용관리 웹", "response_desc": "VoLTE 집계 객체",
      "params": [
        { "name": "date", "in": "query", "type": "string", "required": false, "desc": "YYYY-MM-DD (기본 오늘)" },
        { "name": "granularity", "in": "query", "type": "string", "required": false, "enum": ["1h", "1d", "1M"], "desc": "집계 단위" } ],
      "example": { "volte": { "total_attempts": 1234, "total_success": 1210, "success_rate": 0.98, "avg_duration_sec": 73,
        "buckets": [{ "hour": "09", "attempts": 120 }], "end_reasons": { "normal": 1180, "busy": 30 } } } },
    { "id": "share.stats.ptt", "method": "GET", "path": "/stats/service/ptt", "category": "stats",
      "summary": "PTT 서비스 통계 (그룹콜/평균 세션/그룹별 분포)", "auth": "Bearer JWT",
      "audience": "VoLTE/PTT 사용관리 웹", "response_desc": "PTT 집계 객체",
      "params": [
        { "name": "date", "in": "query", "type": "string", "required": false, "desc": "YYYY-MM-DD (기본 오늘)" },
        { "name": "granularity", "in": "query", "type": "string", "required": false, "enum": ["1h", "1d", "1M"], "desc": "집계 단위" } ],
      "example": { "ptt": { "total_calls": 420, "avg_duration_sec": 15,
        "buckets": [{ "hour": "09", "calls": 40 }], "by_group": { "g-1001": 220, "g-1002": 200 } } } },
    { "id": "share.stats.summary", "method": "GET", "path": "/stats/service/summary", "category": "stats",
      "summary": "VoLTE+PTT 종합 통계", "auth": "Bearer JWT",
      "params": [
        { "name": "date", "in": "query", "type": "string", "required": false, "desc": "YYYY-MM-DD" },
        { "name": "granularity", "in": "query", "type": "string", "required": false, "enum": ["1h", "1d", "1M"] } ] },
    { "id": "share.stats.live", "method": "GET", "path": "/stats/service/live", "category": "stats",
      "summary": "실시간 VoLTE/PTT 세션 + 용량 + 이상징후", "auth": "Bearer JWT",
      "example": { "voip": { "active": 12, "capacity": 500 }, "ptt": { "active": 3 } } },
    { "id": "share.stats.trend", "method": "GET", "path": "/stats/service/trend", "category": "stats",
      "summary": "서비스 지표 시계열 추이", "auth": "Bearer JWT",
      "params": [ { "name": "window", "in": "query", "type": "string", "required": false, "desc": "추이 구간(예: 1h/24h)" } ] },
    { "id": "share.stats.events", "method": "GET", "path": "/stats/service/events", "category": "stats",
      "summary": "최근 서비스 이벤트", "auth": "Bearer JWT",
      "params": [ { "name": "limit", "in": "query", "type": "integer", "required": false, "desc": "최대 건수" } ] },
    { "id": "share.stats.org", "method": "GET", "path": "/stats/service/org", "category": "stats",
      "summary": "조직별 사용 통계", "auth": "Bearer JWT" },
    { "id": "share.stats.subscribers", "method": "GET", "path": "/stats/subscribers", "category": "stats",
      "summary": "가입자 현황 목록 (VoLTE/PTT 보유 여부)", "auth": "Bearer JWT", "response_desc": "가입자 페이지",
      "params": [
        { "name": "status", "in": "query", "type": "string", "required": false, "desc": "필터: 등록상태" },
        { "name": "q", "in": "query", "type": "string", "required": false, "desc": "검색어" },
        { "name": "org", "in": "query", "type": "string", "required": false, "desc": "조직 id" },
        { "name": "page", "in": "query", "type": "integer", "required": false },
        { "name": "limit", "in": "query", "type": "integer", "required": false } ],
      "example": { "total": 2, "items": [ { "name": "홍길동", "volte": true, "ptt": false } ] } },
    { "id": "share.stats.health", "method": "GET", "path": "/stats/health", "category": "stats",
      "summary": "시스템 헬스 + KPI 카운트 (csp/cmp/db)", "auth": "Bearer JWT",
      "example": { "csp": "up", "cmp": "up", "db": "up", "subscribers": 2, "groups": 5 } },
    { "id": "share.stats.messages", "method": "GET", "path": "/stats/messages", "category": "stats",
      "summary": "전 인터페이스 메시지 합계 (시간대 버킷)", "auth": "Bearer JWT",
      "params": [ { "name": "date", "in": "query", "type": "string", "required": false, "desc": "YYYY-MM-DD" } ] },
    { "id": "share.stats.messages.iface", "method": "GET", "path": "/stats/messages/{iface}", "category": "stats",
      "summary": "인터페이스별 메시지 통계", "auth": "Bearer JWT",
      "params": [
        { "name": "iface", "in": "path", "type": "string", "required": true, "enum": ["sip", "cmp", "csc", "https"], "desc": "인터페이스" },
        { "name": "date", "in": "query", "type": "string", "required": false, "desc": "YYYY-MM-DD" } ] },

    { "id": "share.history.calllogs", "method": "GET", "path": "/call/logs", "category": "history",
      "summary": "호 로그 (VoLTE/PTT) — 필터/페이지네이션", "auth": "Bearer JWT", "response_desc": "호 로그 페이지",
      "params": [
        { "name": "call_type", "in": "query", "type": "string", "required": false, "enum": ["voip", "ptt"], "desc": "호 종류" },
        { "name": "state", "in": "query", "type": "string", "required": false, "desc": "호 상태" },
        { "name": "msisdn", "in": "query", "type": "string", "required": false, "desc": "번호" },
        { "name": "group_id", "in": "query", "type": "string", "required": false, "desc": "PTT 그룹 id" },
        { "name": "date", "in": "query", "type": "string", "required": false, "desc": "YYYY-MM-DD" },
        { "name": "from_dt", "in": "query", "type": "string", "required": false, "desc": "시작 일시" },
        { "name": "to_dt", "in": "query", "type": "string", "required": false, "desc": "종료 일시" },
        { "name": "limit", "in": "query", "type": "integer", "required": false },
        { "name": "offset", "in": "query", "type": "integer", "required": false } ],
      "example": { "total": 1, "items": [ { "call_id": "abc123", "caller": "01000000001", "callee": "01000000002",
        "call_type": "voip", "state": "ended", "duration_sec": 73, "end_reason": "normal", "start": "2026-07-22T09:00:00Z" } ] } },
    { "id": "share.history.flow.list", "method": "GET", "path": "/flow/list", "category": "history",
      "summary": "해당 날짜에 플로우가 있는 call_id 목록", "auth": "Bearer JWT",
      "params": [ { "name": "date", "in": "query", "type": "string", "required": false, "desc": "YYYY-MM-DD" } ] },
    { "id": "share.history.flow", "method": "GET", "path": "/flow/{call_id}", "category": "history",
      "summary": "단일 호의 SIP 메시지 플로우", "auth": "Bearer JWT",
      "params": [
        { "name": "call_id", "in": "path", "type": "string", "required": true, "desc": "호 식별자" },
        { "name": "date", "in": "query", "type": "string", "required": false, "desc": "YYYY-MM-DD" },
        { "name": "call_type", "in": "query", "type": "string", "required": false, "enum": ["voip", "ptt"] },
        { "name": "hour", "in": "query", "type": "string", "required": false, "desc": "시(hour) 버킷" } ] },
    { "id": "share.history.ptt", "method": "GET", "path": "/ptt/history", "category": "history",
      "summary": "PTT 세션 이력 (그룹별)", "auth": "Bearer JWT",
      "params": [
        { "name": "group_id", "in": "query", "type": "string", "required": false, "desc": "그룹 id (없으면 summary)" },
        { "name": "date", "in": "query", "type": "string", "required": false, "desc": "YYYY-MM-DD" },
        { "name": "days", "in": "query", "type": "integer", "required": false, "desc": "조회 일수" } ] },

    { "id": "share.recording.list", "method": "GET", "path": "/recordings", "category": "recording",
      "summary": "녹취 목록 (통화 내용물) — 필터/페이지네이션", "auth": "Bearer JWT", "response_desc": "녹취 페이지",
      "params": [
        { "name": "call_type", "in": "query", "type": "string", "required": false, "enum": ["voip", "ptt"] },
        { "name": "caller", "in": "query", "type": "string", "required": false, "desc": "발신 번호" },
        { "name": "group_id", "in": "query", "type": "string", "required": false, "desc": "PTT 그룹 id" },
        { "name": "from_dt", "in": "query", "type": "string", "required": false },
        { "name": "to_dt", "in": "query", "type": "string", "required": false },
        { "name": "limit", "in": "query", "type": "integer", "required": false },
        { "name": "offset", "in": "query", "type": "integer", "required": false } ],
      "example": { "total": 1, "items": [ { "id": "rec-001", "call_type": "voip", "caller": "01000000001",
        "duration_sec": 73, "created": "2026-07-22T09:00:00Z" } ] } },
    { "id": "share.recording.item", "method": "GET", "path": "/recordings/{id}", "category": "recording",
      "summary": "녹취 상세 메타데이터", "auth": "Bearer JWT",
      "params": [ { "name": "id", "in": "path", "type": "string", "required": true, "desc": "녹취 id/세션 경로" } ] },
    { "id": "share.recording.segments", "method": "GET", "path": "/recordings/{id}/segments", "category": "recording",
      "summary": "녹취 세그먼트 목록 (오디오/비디오 스트림 경로)", "auth": "Bearer JWT",
      "params": [ { "name": "id", "in": "path", "type": "string", "required": true, "desc": "녹취 id" } ] },

    { "id": "share.subscriber.users", "method": "GET", "path": "/users", "category": "subscriber",
      "summary": "가입자 목록 (개인 + call/ptt 회선) — 자격증명 미포함", "auth": "Bearer JWT", "response_desc": "가입자 목록",
      "example": { "items": [ { "pid": "p-001", "name": "홍길동", "org_id": "o-1",
        "call": [ { "msisdn": "01000000001" } ], "ptt": [ { "msisdn": "9001" } ] } ] } },
    { "id": "share.subscriber.groups", "method": "GET", "path": "/ptt/groups", "category": "subscriber",
      "summary": "PTT/MCPTT 그룹 목록", "auth": "Bearer JWT",
      "example": { "items": [ { "id": "g-1001", "name": "1팀", "member_count": 12 } ] } },
    { "id": "share.subscriber.orgs", "method": "GET", "path": "/organizations", "category": "subscriber",
      "summary": "조직/부서 트리", "auth": "Bearer JWT",
      "example": { "items": [ { "id": "o-1", "name": "본사", "parent_id": null } ] } }
  ]
}
