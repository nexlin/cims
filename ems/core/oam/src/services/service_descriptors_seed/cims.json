{
  "id": "cims",
  "label": "CIMS",
  "modules": [
    {
      "name": "csp",
      "port": 5060,
      "proto": "udp",
      "controllable": true,
      "health": {
        "collection_file": "config/local_nodes.jsonl",
        "field": "bind_port",
        "match": {
          "enabled": true,
          "is_primary": true,
          "protocol": "UDP"
        }
      }
    },
    {
      "name": "isp",
      "port": 5060,
      "proto": "udp",
      "health": {
        "collection_file": "config/local_nodes.jsonl",
        "field": "bind_port",
        "match": {
          "enabled": true,
          "is_primary": true,
          "protocol": "UDP"
        }
      }
    },
    {
      "name": "psp",
      "port": 5060,
      "proto": "udp",
      "health": {
        "collection_file": "config/local_nodes.jsonl",
        "field": "bind_port",
        "match": {
          "enabled": true,
          "is_primary": true,
          "protocol": "UDP"
        }
      }
    },
    {
      "name": "cmp",
      "port": 9000,
      "proto": "udp",
      "controllable": true
    },
    {
      "name": "imp",
      "port": 9000,
      "proto": "udp"
    },
    {
      "name": "pmp",
      "port": 9000,
      "proto": "udp"
    },
    {
      "name": "csc",
      "port": 4421,
      "proto": "tcp",
      "controllable": true,
      "health": {
        "config_key": "Server.Port"
      }
    },
    {
      "name": "oam",
      "port": 4419,
      "proto": "tcp",
      "controllable": true,
      "health": {
        "config_key": "Server.Port",
        "http_path": "/health",
        "startup_grace_sec": 180
      },
      "safety": {
        "class": "shared_writer",
        "requires_leader_lease": true
      }
    },
    {
      "name": "oam-svc",
      "port": 4480,
      "proto": "tcp",
      "controllable": true,
      "health": {
        "config_key": "Server.Port",
        "http_path": "/health",
        "startup_grace_sec": 180
      },
      "safety": {
        "class": "shared_writer",
        "requires_leader_lease": true
      }
    },
    {
      "name": "cwrtc",
      "controllable": true
    },
    {
      "name": "phone",
      "controllable": true
    },
    {
      "name": "cspsim"
    }
  ],
  "alert_rules": [
    {
      "type": "process_unresponsive",
      "code": "A-PRC-004",
      "perceived_severity": "major",
      "event_type": "processingError",
      "probable_cause": "responseTimeExcessive",
      "mo_class": "service",
      "check": "process_unresponsive",
      "target": "csp",
      "metric": "프로세스 응답성",
      "msg_open": "{mo} 관리 프로브(STATS) 무응답",
      "msg_close": "{mo} 응답 정상화",
      "effect": "CSP 제어/관측 불가 — hang·과부하 의심, 호처리 영향 가능",
      "recommended_action": "csp 프로세스 상태·부하 확인(process_down 동반 여부), 필요 시 재기동"
    },
    {
      "type": "process_unresponsive",
      "code": "A-PRC-004",
      "perceived_severity": "major",
      "event_type": "processingError",
      "probable_cause": "responseTimeExcessive",
      "mo_class": "service",
      "check": "process_unresponsive",
      "target": "cmp",
      "metric": "프로세스 응답성",
      "msg_open": "{mo} 관리 프로브(STATS) 무응답",
      "msg_close": "{mo} 응답 정상화",
      "effect": "CMP 미디어 노드 제어/관측 불가 — hang·과부하 의심",
      "recommended_action": "cmp 프로세스 상태·부하 확인(process_down 동반 여부), 필요 시 재기동"
    },
    {
      "type": "connection_lost",
      "code": "A-COM-001",
      "perceived_severity": "critical",
      "event_type": "communications",
      "probable_cause": "communicationsSubsystemFailure",
      "mo_class": "service",
      "check": "db_down",
      "metric": "DB 연결",
      "msg_open": "{mo} 연결 끊김",
      "msg_close": "{mo} 연결 복구",
      "effect": "가입자/그룹 조회·인증 실패",
      "recommended_action": "DB 가용성/방화벽/연결설정 확인"
    },
    {
      "type": "threshold_crossed",
      "code": "A-QOS-024",
      "perceived_severity": "warning",
      "event_type": "qualityOfService",
      "probable_cause": "resourceAtOrNearingCapacity",
      "mo_class": "service",
      "check": "rtp_pct_gte",
      "thresholds": {
        "minor": 80,
        "major": 90,
        "critical": 95
      },
      "unit": "%",
      "metric": "RTP 포트 사용률(노드별)",
      "msg_open": "{mo} 사용률 {pct}% ({threshold}% 초과)",
      "msg_close": "{mo} 사용률 {pct}% (정상)",
      "effect": "RTP 포트 고갈 임박 — 신규 미디어 세션 실패 위험",
      "recommended_action": "동시 세션/누수 점검, 포트 풀 증설"
    }
  ],
  "data_sources": [
    {
      "id": "cims.msg.sip",
      "label": "SIP 메시지",
      "shapes": [
        "time-bar",
        "series-bar",
        "distribution",
        "table",
        "matrix"
      ],
      "endpoint": "/stats/messages/sip",
      "query": [
        "from",
        "to",
        "granularity"
      ],
      "map": {
        "time-bar": {
          "from": "buckets",
          "label": [
            "label",
            "hour"
          ],
          "value": "count"
        },
        "table": {
          "fromObject": "method_counts",
          "columns": [
            "메서드",
            "건수"
          ]
        },
        "distribution": {
          "fromObject": "method_counts",
          "totalPath": "total",
          "partsObject": "method_service",
          "series": [
            {
              "key": "volte",
              "label": "VoLTE",
              "value": "volte"
            },
            {
              "key": "ptt",
              "label": "PTT",
              "value": "ptt"
            },
            {
              "key": "unknown",
              "label": "미분류",
              "value": "unknown",
              "color": "chart-muted"
            }
          ]
        },
        "series-bar": {
          "from": "buckets",
          "label": [
            "label",
            "hour"
          ],
          "unit": "건",
          "series": [
            {
              "key": "volte",
              "label": "VoLTE",
              "value": "volte"
            },
            {
              "key": "ptt",
              "label": "PTT",
              "value": "ptt"
            },
            {
              "key": "unknown",
              "label": "미분류",
              "value": "unknown",
              "color": "chart-muted"
            }
          ]
        },
        "matrix": {
          "from": "buckets",
          "label": [
            "bucket",
            "label",
            "hour",
            "date"
          ],
          "cells": [
            "in",
            "out"
          ],
          "limit": 14,
          "unit": "건"
        }
      }
    },
