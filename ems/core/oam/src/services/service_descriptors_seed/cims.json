{
  "id": "cims",
  "label": "CIMS",
  "modules": [
    {
      "name": "csp",
      "port": 5060,
      "proto": "udp",
      "controllable": true,
      "health": {
        "collection_file": "config/local_nodes.jsonl",
        "field": "bind_port",
        "match": {
          "enabled": true,
          "is_primary": true,
          "protocol": "UDP"
        }
      }
    },
    {
      "name": "isp",
      "port": 5060,
      "proto": "udp",
      "health": {
        "collection_file": "config/local_nodes.jsonl",
        "field": "bind_port",
        "match": {
          "enabled": true,
          "is_primary": true,
          "protocol": "UDP"
        }
      }
    },
    {
      "name": "psp",
      "port": 5060,
      "proto": "udp",
      "health": {
        "collection_file": "config/local_nodes.jsonl",
        "field": "bind_port",
        "match": {
          "enabled": true,
          "is_primary": true,
          "protocol": "UDP"
        }
      }
    },
    {
      "name": "cmp",
      "port": 9000,
      "proto": "udp",
      "controllable": true
    },
    {
      "name": "imp",
      "port": 9000,
      "proto": "udp"
    },
    {
      "name": "pmp",
      "port": 9000,
      "proto": "udp"
    },
    {
      "name": "csc",
      "port": 4421,
      "proto": "tcp",
      "controllable": true,
      "health": {
        "config_key": "Server.Port"
      },
      "safety": {
        "class": "read_only",
        "reads_shared_store": true
      }
    },
    {
      "name": "oam",
      "port": 4419,
      "proto": "tcp",
      "controllable": true,
      "health": {
        "config_key": "Server.Port",
        "http_path": "/health",
        "startup_grace_sec": 180
      },
      "safety": {
        "class": "shared_writer",
        "requires_leader_lease": true
      }
    },
    {
      "name": "oam-svc",
      "port": 4480,
      "proto": "tcp",
      "controllable": true,
      "health": {
        "config_key": "Server.Port",
