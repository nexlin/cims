<!-- 공통 스타일 — 와이어프레임(설계 정본 §3.1)의 언어: 패널(Pnl)·소구획(Sub)·버튼(Btn*)·배지(Badge*)·칩·미터·점 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DispatchDesktop.Converters">

    <c:ElapsedConverter x:Key="Elapsed" />
    <c:UserPartConverter x:Key="UserPart" />
    <c:CountToVisibilityConverter x:Key="CountToVis" />
    <c:ZeroToVisibilityConverter x:Key="ZeroToVis" />
    <c:StringToVisibilityConverter x:Key="StrToVis" />
    <c:InverseBoolConverter x:Key="Not" />
    <c:BoolToVisibilityConverter x:Key="BoolToVis" />
    <c:InverseBoolToVisibilityConverter x:Key="NotToVis" />
    <c:EqualsConverter x:Key="Eq" />
    <c:EqualsToVisibilityConverter x:Key="EqToVis" />
    <c:LevelToWidthConverter x:Key="LevelWidth" />
    <c:NullToVisibilityConverter x:Key="NullToVis" />
    <c:NotNullToVisibilityConverter x:Key="NotNullToVis" />
    <c:RegStateToBrushConverter x:Key="RegBrush" />
    <c:RouteIconConverter x:Key="RouteIcon" />
    <c:RatioToLengthConverter x:Key="RatioLen" />
    <c:ScaleToLengthConverter x:Key="ScaleLen" />
    <c:HalfRadiusConverter x:Key="HalfRadius" />
    <c:InitialConverter x:Key="Initial" />
    <c:PickConverter x:Key="Pick" />
    <c:SameRefConverter x:Key="SameRef" />
    <BooleanToVisibilityConverter x:Key="B2V" />

    <FontFamily x:Key="Font.Ui">Noto Sans KR, Pretendard, Malgun Gothic, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">JetBrains Mono, Cascadia Mono, Consolas, D2Coding, monospace</FontFamily>

    <Style TargetType="Window" x:Key="Window.Base">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Muted">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Mono">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="MonoMuted" BasedOn="{StaticResource Mono}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="H2">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBlock" x:Key="SectionHeader">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Hint">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 패널 (도킹 단위) -->
    <Style TargetType="Border" x:Key="Pnl">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- 소구획 -->
    <Style TargetType="Border" x:Key="Sub">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style TargetType="Border" x:Key="SubHeader">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <!-- 카드 -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 버튼 -->
    <Style TargetType="Button" x:Key="Btn">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="Btn.Pri" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
    </Style>
    <Style TargetType="Button" x:Key="Btn.Danger" BasedOn="{StaticResource Btn}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Emg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Emg}" />
    </Style>
    <Style TargetType="Button" x:Key="Btn.Mon" BasedOn="{StaticResource Btn}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Mon}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Mon}" />
    </Style>
    <Style TargetType="Button" x:Key="Btn.Sm" BasedOn="{StaticResource Btn}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="Button" x:Key="Btn.Sm.Pri" BasedOn="{StaticResource Btn.Pri}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="Button" x:Key="Btn.Xs" BasedOn="{StaticResource Btn}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style TargetType="Button" x:Key="Btn.Xs.Danger" BasedOn="{StaticResource Btn.Danger}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style TargetType="Button" x:Key="Btn.Xs.Mon" BasedOn="{StaticResource Btn.Mon}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style TargetType="Button" x:Key="Btn.Xs.Pri" BasedOn="{StaticResource Btn.Pri}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>
    <!-- 평면 버튼(.link/.chip 래퍼) — 크롬 없음. 기본 WPF 템플릿은 Background=Transparent 여도 호버에 사각 음영을 그려 칩 모양과 어긋난다 -->
    <Style TargetType="Button" x:Key="Btn.Flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 글자 링크형 평면 버튼 — 호버에 글자색만 진해진다 -->
    <Style TargetType="Button" x:Key="Btn.Link" BasedOn="{StaticResource Btn.Flat}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Text}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button" x:Key="Btn.Ghost" BasedOn="{StaticResource Btn}">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>
    <Style TargetType="Button" x:Key="Btn.Xs.Ghost" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>
    <!-- 세그먼트 토글(예시 .seg) — 바깥 진한 테두리 한 겹, 선택 = Primary 연한 배경 + Primary 글자 -->
    <Style TargetType="RadioButton" x:Key="Seg">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" Padding="10,0" Height="24">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Border" x:Key="SegGroup">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 배지 -->
    <!-- 배지(예시 .badge) — 18px 각진 라벨(모서리 4), 연한 배경 + 진한 글자. 알약형 아님 -->
    <Style TargetType="Border" x:Key="Badge">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Muted}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- .badge.own — 중립, 본문색 글자 -->
    <Style TargetType="Border" x:Key="Badge.Own" BasedOn="{StaticResource Badge}">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>
    <!-- .badge.temp — 애드혹(애드혹 그룹 통화, ad hoc group call) -->
    <Style TargetType="Border" x:Key="Badge.Temp" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.HeldSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Held}" />
    </Style>
    <!-- .badge.pin — 외곽선 + 모노(핀 번호·핫키) -->
    <Style TargetType="Border" x:Key="Badge.Pin" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="TextElement.FontWeight" Value="Medium" />
        <Setter Property="TextElement.FontSize" Value="10.5" />
    </Style>
    <Style TargetType="Border" x:Key="Badge.Pilot" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.RingSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Ring}" />
    </Style>
    <Style TargetType="Border" x:Key="Badge.Talk" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.TalkSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Talk}" />
    </Style>
    <Style TargetType="Border" x:Key="Badge.Held" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.HeldSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Held}" />
    </Style>
    <Style TargetType="Border" x:Key="Badge.Mon" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.MonSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Mon}" />
    </Style>
    <Style TargetType="Border" x:Key="Badge.Listen" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.ListenSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Listen}" />
    </Style>
    <Style TargetType="Border" x:Key="Badge.Member" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Primary}" />
    </Style>
    <Style TargetType="Border" x:Key="Badge.Emg" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.EmgSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Emg}" />
    </Style>
    <!-- 채움형 긴급(배너·고정 행처럼 강하게 알릴 곳) -->
    <Style TargetType="Border" x:Key="Badge.Emg.Solid" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Brush.Emg}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.OnAccent}" />
    </Style>

    <!-- 칩 · 알약 -->
    <!-- .chip — 24px, 연한 배경, 테두리 없음(상단 바 상태 칩·스레드 칩) -->
    <Style TargetType="Border" x:Key="Pill">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.FontWeight" Value="Medium" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- .chip.ghost — 외곽선만 -->
    <Style TargetType="Border" x:Key="Pill.Ghost" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>
    <!-- .mchip — 관제 그룹원 띠: 라운드 사각(모서리 7), 연한 바탕 + 테두리, 상태 = 테두리색·연한 배경 -->
    <Style TargetType="Border" x:Key="MemberChip">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.BgSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Hover}" /></Trigger>
        </Style.Triggers>
    </Style>
    <!-- .m / .tchip — 22px 로스터·대상 칩: 연한 바탕 + 테두리, 상태색은 쓰는 곳의 트리거가 덮는다 -->
    <Style TargetType="Border" x:Key="Chip">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource Brush.BgSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,5,5" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 점 -->
    <Style TargetType="Ellipse" x:Key="Dot">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Wire}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- 미터 (ProgressBar 0~1) -->
    <Style TargetType="ProgressBar" x:Key="Meter">
        <Setter Property="Height" Value="9" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Talk}" />
        <Setter Property="Background" Value="{DynamicResource Brush.MeterTrack}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 입력(폼 필드 Field·FieldCombo·FieldPw)은 Controls.xaml — 기본 컨트롤 테마 템플릿을 BasedOn 으로 물려받아야 하므로 그 사전에 함께 둔다 -->


    <!-- 목록 — 선택 강조 없는 얇은 ListBox -->
    <Style TargetType="ListBox" x:Key="PlainList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 고르는 목록 — PlainList 는 행이 포커스를 받지 않아(Focusable=False) WPF 가 마우스 클릭으로 선택하지 못한다(ListBoxItem 은 Focus() 성공 시에만
         선택한다). SelectedItem 을 쓰는 목록(이력 행·세션 카드·세그먼트·관리 조직/구성원)은 이 스타일 — 포커스 가능 + 마우스오버/선택 표시(좌측 3px 띠) -->
    <Style TargetType="ListBox" x:Key="SelectList" BasedOn="{StaticResource PlainList}">
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="True" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="3,0,0,0" SnapsToDevicePixels="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 내역 행 -->
    <Style TargetType="Border" x:Key="LogRow">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style TargetType="Border" x:Key="LogHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.BgSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <!-- 팝오버 본문(§4.4 공통) — 앵커 아래, 그림자. 폭은 쓰는 곳이 정한다(발신 520 · ▦ 500 · 문자 440 · DTMF/전달 280) -->
    <Style TargetType="Border" x:Key="PopPanel">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,4,12,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" /></Setter.Value></Setter>
    </Style>
    <!-- 패널 안 섹션 라벨("청취 범위 · 3", "대표번호 대기열 1") -->
    <Style TargetType="TextBlock" x:Key="SectionLabel">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        <Setter Property="Margin" Value="2,6,0,4" />
    </Style>
    <!-- ══ 시안 «모드마다 한 화면»(§3.2 시각 언어) — 먹(Ink) 채움·외곽선 알약, 각진 필터 칩, 19px 라벨, 둥근 발언 대상 ✓ ══ -->
    <Style TargetType="TextBlock" x:Key="Title16">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Soft">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSoft}" />
    </Style>

    <!-- 알약 버튼 — 기본 = 흰 바탕 + 먹 외곽선 1.5. 모서리 = 높이/2 -->
    <Style TargetType="Button" x:Key="Pill.Line">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource HalfRadius}}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="Pill.Ink" BasedOn="{StaticResource Pill.Line}">
        <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnInk}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="Button" x:Key="Pill.Soft" BasedOn="{StaticResource Pill.Line}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style TargetType="Button" x:Key="Pill.Red" BasedOn="{StaticResource Pill.Line}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Emg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Emg}" />
    </Style>
    <Style TargetType="Button" x:Key="Pill.RedFill" BasedOn="{StaticResource Pill.Line}">
        <Setter Property="Background" Value="{DynamicResource Brush.Emg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="Button" x:Key="Pill.On" BasedOn="{StaticResource Pill.Line}">
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="Button" x:Key="Pill.Talk" BasedOn="{StaticResource Pill.Line}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.TalkInk}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TalkInk}" />
    </Style>
    <!-- 알약 크기 — 조작 행 30 / 패널 행동 36(기본 32) / 바닥 행동 44 -->
    <Style TargetType="Button" x:Key="Pill.Ink.Sm" BasedOn="{StaticResource Pill.Ink}"><Setter Property="Height" Value="30" /><Setter Property="FontSize" Value="12" /></Style>
    <Style TargetType="Button" x:Key="Pill.Line.Sm" BasedOn="{StaticResource Pill.Line}"><Setter Property="Height" Value="30" /><Setter Property="FontSize" Value="12" /></Style>
    <Style TargetType="Button" x:Key="Pill.Soft.Sm" BasedOn="{StaticResource Pill.Soft}"><Setter Property="Height" Value="30" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="10,0" /></Style>
    <Style TargetType="Button" x:Key="Pill.Red.Sm" BasedOn="{StaticResource Pill.Red}"><Setter Property="Height" Value="30" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="10,0" /></Style>
    <Style TargetType="Button" x:Key="Pill.Ink.Lg" BasedOn="{StaticResource Pill.Ink}"><Setter Property="Height" Value="44" /><Setter Property="FontSize" Value="13.5" /><Setter Property="Padding" Value="20,0" /></Style>
    <Style TargetType="Button" x:Key="Pill.Line.Lg" BasedOn="{StaticResource Pill.Line}"><Setter Property="Height" Value="44" /><Setter Property="FontSize" Value="13.5" /><Setter Property="Padding" Value="20,0" /></Style>
    <Style TargetType="Button" x:Key="Pill.Soft.Lg" BasedOn="{StaticResource Pill.Soft}"><Setter Property="Height" Value="44" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="20,0" /></Style>

    <!-- 네모 버튼(모서리 8) — [발신]·[응답]·통화 카드 조작 -->
    <Style TargetType="Button" x:Key="Rect.Soft">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="Rect.Line" BasedOn="{StaticResource Rect.Soft}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style TargetType="Button" x:Key="Rect.Ink" BasedOn="{StaticResource Rect.Soft}">
        <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnInk}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style TargetType="Button" x:Key="Rect.Red" BasedOn="{StaticResource Rect.Soft}">
        <Setter Property="Background" Value="{DynamicResource Brush.Emg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style TargetType="ToggleButton" x:Key="Rect.Toggle">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.Ink}" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Ink}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnInk}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 필터 칩(모서리 6, 28px) — 켜짐 = 먹 바탕 + 흰 굵은 글자. RadioButton·CheckBox·ToggleButton 공용 -->
    <Style TargetType="ToggleButton" x:Key="FilterChip">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSoft}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Ink}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnInk}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 19px 라벨(모서리 4) — 외곽선(개별·애드혹) · 먹(일제) · 빨강(긴급) · 주황(임박) -->
    <Style TargetType="Border" x:Key="Tag">
        <Setter Property="Height" Value="19" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Faint}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSoft}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style TargetType="Border" x:Key="Tag.Ink" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{DynamicResource Brush.Ink}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.OnInk}" />
    </Style>
    <Style TargetType="Border" x:Key="Tag.Emg" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{DynamicResource Brush.Emg}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Emg}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.OnAccent}" />
    </Style>
    <Style TargetType="Border" x:Key="Tag.Peril" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{DynamicResource Brush.Peril}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Peril}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.OnPeril}" />
    </Style>
    <Style TargetType="Border" x:Key="Tag.Red" BasedOn="{StaticResource Tag}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Emg}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Emg}" />
    </Style>
    <Style TargetType="Border" x:Key="Tag.Mon" BasedOn="{StaticResource Tag}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Mon}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Mon}" />
    </Style>
    <Style TargetType="Border" x:Key="Tag.Pilot" BasedOn="{StaticResource Tag}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Peril}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.RingInk}" />
    </Style>
    <Style TargetType="Border" x:Key="Tag.Listen" BasedOn="{StaticResource Tag}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Listen}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Listen}" />
        <Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="8,0" />
    </Style>
    <!-- 수 배지(먹 둥근 8) — 미읽음·세그먼트 수 -->
    <Style TargetType="Border" x:Key="Count">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinHeight" Value="17" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.OnInk}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>
    <!-- 아바타(원 34 · 그룹은 쓰는 곳이 모서리 8) -->
    <Style TargetType="Border" x:Key="Avatar">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        <Setter Property="TextElement.FontSize" Value="13" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 발언 대상 ✓(원 34) — 빔 = 흰 바탕 + 흐린 ✓ · 켬 = 남색 채움 + 흰 ✓ · 비활성(일제 수신) = 점선 -->
    <Style TargetType="ToggleButton" x:Key="TargetCheck">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="E" Fill="{DynamicResource Brush.Surface}" Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1.5" />
                        <Path x:Name="Ck" Data="M5,12 L10,17 L20,7" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Brush.Faint}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="E" Property="Stroke" Value="{DynamicResource Brush.Primary}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="E" Property="Fill" Value="{DynamicResource Brush.Primary}" />
                            <Setter TargetName="E" Property="StrokeThickness" Value="0" />
                            <Setter TargetName="Ck" Property="Stroke" Value="{DynamicResource Brush.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="E" Property="StrokeDashArray" Value="2 2" />
                            <Setter TargetName="Ck" Property="Stroke" Value="{DynamicResource Brush.Border}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 원형 아이콘 버튼(34) — 음소거·바로 걸기·사람 메뉴. .Red = 음소거 중(빨강 채움) -->
    <Style TargetType="Button" x:Key="RoundBtn">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSoft}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource HalfRadius}}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="RoundBtn.Red" BasedOn="{StaticResource RoundBtn}">
        <Setter Property="Background" Value="{DynamicResource Brush.Emg}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
    </Style>

    <!-- 왼쪽 레일 항목(§3.4) — 알약 56×32 안 아이콘 + 아래 글자(Tag). 선택 = 알약 채움 + 굵은 글자 -->
    <Style TargetType="ToggleButton" x:Key="RailItem">
        <Setter Property="Width" Value="72" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Background="Transparent">
                        <Border x:Name="Pill" Width="56" Height="32" CornerRadius="16" Background="Transparent" HorizontalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="Lbl" Text="{TemplateBinding Tag}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.Border}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.BorderStrong}" />
                            <Setter TargetName="Lbl" Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 탭 줄 모드 세그먼트 [무전|통화] — 먹 외곽선 한 겹 안의 칸, 선택 = 먹 채움 -->
    <Style TargetType="RadioButton" x:Key="ModeSeg">
        <Setter Property="Width" Value="104" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.Ink}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnInk}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 탭 줄 오른쪽 끝 목록 버튼([사용자]/[주소록]) — 열린 동안 먹 채움 -->
    <Style TargetType="ToggleButton" x:Key="ListToggle">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.Ink}" BorderThickness="1.5" CornerRadius="18" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Ink}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnInk}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 목록 행 버튼(스레드·기록·사용자·주소록·이벤트 행) — 크롬 없음, 호버 = 연한 바탕. 선택 표시는 쓰는 곳 트리거 -->
    <Style TargetType="Button" x:Key="RowBtn" BasedOn="{StaticResource Btn.Flat}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 칸 경계 끌기(§3.3) — 1px 선 위에 겹친 투명 손잡이 -->
    <Style TargetType="GridSplitter" x:Key="Seam">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ShowsPreview" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>