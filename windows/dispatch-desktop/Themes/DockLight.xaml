<!-- 도킹 테마(Light) — AvalonDock VS2013 Light 사전 위에 우리 제목줄 스타일을 얹는다. DockingManager.Theme = DockTheme 으로 놓으면 별창에도 같이 적용된다 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adc="clr-namespace:AvalonDock.Controls;assembly=AvalonDock">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/AvalonDock.Themes.VS2013;component/LightTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- 패널 머리(예시 .ph) — 흰 표면 38px: ⋮⋮ 그립·제목 · 패널이 Resources[PanelHeader] 로 선언한 머리 내용 · [별창][자동 숨김] 아이콘 버튼 -->
    <Style TargetType="{x:Type adc:AnchorablePaneTitle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type adc:AnchorablePaneTitle}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Height="38" Padding="8,0,6,0" SnapsToDevicePixels="True">
                        <DockPanel VerticalAlignment="Center">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0">
                                <Button Style="{DynamicResource IconBtn}" ToolTip="별창으로" Command="{Binding LayoutItem.FloatCommand, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Out}" />
                                </Button>
                                <Button Style="{DynamicResource IconBtn}" ToolTip="자동 숨김" Command="{Binding LayoutItem.AutoHideCommand, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Pin}" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding Model.Title, RelativeSource={RelativeSource TemplatedParent}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ContentPresenter Content="{Binding Model.Content.Resources[PanelHeader], RelativeSource={RelativeSource TemplatedParent}}"
                                              DataContext="{Binding Model.Content.DataContext, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
