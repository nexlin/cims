<Window x:Class="DispatchDesktop.Shell.GroupEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:GroupEditViewModel}"
        Style="{StaticResource Window.Base}" Title="{Binding Title}" Width="760" Height="640" MinWidth="640" MinHeight="520" WindowStartupLocation="CenterOwner">
    <!-- PTT 그룹 생성·편집 — GMS 그룹 문서 폼(§4.1). 왼쪽 속성 · 오른쪽 멤버(후보 ↔ 선택) · 하단 저장 -->
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Btn}" Content="취소" IsCancel="True" Margin="0,0,6,0" />
                <Button Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Pri}">
                            <Setter Property="Content" Value="저장" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNew}" Value="True"><Setter Property="Content" Value="그룹 만들기" /></DataTrigger>
                                <DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Content" Value="저장 중…" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Emg}" Text="{Binding Error}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </DockPanel>
        <Grid IsEnabled="{Binding Loaded}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- 속성 -->
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="그룹 이름" Style="{StaticResource Hint}" />
                <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />
                <TextBlock Text="그룹 id (XCAP 문서 이름)" Style="{StaticResource Hint}" />
                <TextBox Style="{StaticResource Field}" Text="{Binding GroupId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,2" />
                <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding Uri}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />
                <TextBlock Text="세션 종류" Style="{StaticResource Hint}" />
                <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding SessionTypes}" SelectedItem="{Binding SessionType}" Margin="0,2,0,10" />
                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="그룹 우선순위" Style="{StaticResource Hint}" />
                        <TextBox Style="{StaticResource Field}" Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="최대 참가자 (0=제한 없음)" Style="{StaticResource Hint}" />
                        <TextBox Style="{StaticResource Field}" Text="{Binding MaxParticipants, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                    </StackPanel>
                </UniformGrid>
                <CheckBox Content="긴급 그룹콜 허용" IsChecked="{Binding EmergencyCall}" Margin="0,0,0,4" />
                <CheckBox Content="긴급 경보 허용" IsChecked="{Binding EmergencyAlert}" Margin="0,0,0,4" />
                <CheckBox Content="메시지(SDS) 허용" IsChecked="{Binding AllowSds}" Margin="0,0,0,4" />
                <CheckBox Content="파일 전송(FD) 허용" IsChecked="{Binding AllowFd}" Margin="0,0,0,4" />
                <CheckBox Content="영상" IsChecked="{Binding VideoEnabled}" Margin="0,0,0,4" />
                <CheckBox Content="참여 전 affiliation 필요" IsChecked="{Binding RequireAffiliation}" Margin="0,0,0,4" />
                <CheckBox Content="미디어 암호화" IsChecked="{Binding Encryption}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="저장하면 GMS 그룹 문서로 서버에 올라가고(XCAP PUT), 멤버 단말에는 문서 변경 통지가 갑니다. 편집·삭제는 내가 만든 그룹만 됩니다." />
            </StackPanel>
            <!-- 멤버 -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Xs}" Content="표시된 전원 추가" Command="{Binding AddAllShownCommand}" Margin="6,0,0,0" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="PTT 주소록" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox DockPanel.Dock="Top" Style="{StaticResource Field}" Height="26" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="이름·번호 검색" Margin="0,0,0,4" />
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Candidates}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GroupCandidateRow}">
                                <Border Style="{StaticResource LogRow}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Xs.Pri}" Content="추가" Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                            <TextBlock Style="{StaticResource MonoMuted}" FontSize="11">
                                                <Run Text="{Binding DisplayNumber, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding OrgPath, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <DockPanel Grid.Column="1">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" Height="26">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="멤버" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding MemberCountText}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="의장(chair) 은 발언 우선순위가 높습니다. 클릭해 역할을 바꿉니다." Margin="0,0,0,4" />
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Members}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GroupMemberRow}">
                                <Border Style="{StaticResource LogRow}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Btn.Xs}" Content="{Binding RoleText}" Command="{Binding DataContext.ToggleChairCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,4,0" ToolTip="의장/참가자 전환" />
                                            <Button Style="{StaticResource Btn.Xs.Danger}" Content="제거" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" FontWeight="Medium" />
                                                <TextBlock Style="{StaticResource Muted}" Text=" (나)" FontSize="12" Visibility="{Binding IsMe, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding DisplayNumber}" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
