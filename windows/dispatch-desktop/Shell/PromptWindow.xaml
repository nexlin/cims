<Window x:Class="DispatchDesktop.Shell.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Base}" Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="Label" Style="{StaticResource Muted}" Margin="0,0,0,6" />
        <TextBox x:Name="Box" Style="{StaticResource Field}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource Btn}" Content="취소" IsCancel="True" Margin="0,0,6,0" />
            <Button Style="{StaticResource Btn.Pri}" Content="확인" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
