<Window x:Class="DispatchDesktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:DispatchDesktop.Views"
        xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
        xmlns:svc="clr-namespace:DispatchDesktop.Services"
        xmlns:m="clr-namespace:DispatchDesktop.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Style="{StaticResource Window.Base}" Title="CIMS 관제조작반" Width="1920" Height="1080" MinWidth="1440" MinHeight="760" WindowStartupLocation="CenterScreen">
    <!-- 주 창(§3) — «모드마다 한 화면»: 왼쪽 레일 80([관제][이력][더보기]) · 상단 바 56 · 배너 층(긴급·임박 꽉 찬 면 · 착신 옅은 면, 어느 화면에서나) ·
         탭 줄 48([무전|통화] + 오른쪽 끝 목록 버튼) · 본문(모드 화면 한 장 / 레일 화면) + 오른쪽 패널 440(오른쪽 칸만 민다) · 발언 바 80(모든 화면) · 토스트(우하단) ·
         통합 검색 Ctrl+K · 사람 메뉴 -->
    <Grid>
        <DockPanel>
            <!-- ═══ 왼쪽 레일 ═══ -->
            <Border DockPanel.Dock="Left" Width="80" Background="{DynamicResource Brush.Rail}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,12,0,0">
                    <Border Width="48" Height="40" CornerRadius="8" Background="{DynamicResource Brush.Fill}" Margin="0,0,0,20">
                        <TextBlock Text="CIMS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.OnFill}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <RadioButton Style="{StaticResource RailItem}" Tag="관제" IsChecked="{Binding IsDispatch, Mode=OneWay}" Command="{Binding ShowScreenCommand}" CommandParameter="{x:Static m:AppScreen.Dispatch}"
                                  ToolTip="관제 F1 — [무전] 채널·메시지·이벤트 / [통화] 통화·기록">
                        <Grid>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Headset}" Width="22" Height="22" StrokeThickness="2" />
                            <Border Style="{StaticResource Count}" Margin="0,-12,-26,0" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{DynamicResource Brush.Rail}" BorderThickness="1.5"
                                    Visibility="{Binding DispatchBadge, Converter={StaticResource CountToVis}}" ToolTip="안 읽은 무전 메시지 + 대표번호 대기열 + 안 읽은 문자">
                                <TextBlock Text="{Binding DispatchBadge}" />
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailItem}" Tag="이력" IsChecked="{Binding IsHistory, Mode=OneWay}" Command="{Binding ShowScreenCommand}" CommandParameter="{x:Static m:AppScreen.History}"
                                  ToolTip="이력 F2 — 끝난 통화·PTT 세션의 날짜별 조회·녹취 재생">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.History}" Width="22" Height="22" StrokeThickness="2" />
                    </RadioButton>
                    <Grid>
                        <ToggleButton x:Name="MoreBtn" Style="{StaticResource RailItem}" Tag="더보기" IsChecked="{Binding IsMore, Mode=OneWay}" Click="MoreBtn_Click" ToolTip="PTT 그룹 F3 · 관리 F4 · 설정">
                            <Grid>
                                <Path Style="{StaticResource Icon.Filled}" Data="{StaticResource Icon.DotsH}" Width="22" Height="22" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Emg}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-14,0"
                                         Visibility="{Binding AdminEditing, Converter={StaticResource BoolToVis}}" ToolTip="저장하지 않은 관리 폼이 있습니다" />
                            </Grid>
                        </ToggleButton>
                        <Popup x:Name="MorePop" PlacementTarget="{Binding ElementName=MoreBtn}" Placement="Right" HorizontalOffset="6" StaysOpen="False" AllowsTransparency="True">
                            <Border Style="{StaticResource DropPanel}" MinWidth="220">
                                <StackPanel>
                                    <Button Style="{StaticResource DropItem}" Click="MoreItem_Click" Command="{Binding ShowScreenCommand}" CommandParameter="{x:Static m:AppScreen.PttGroups}">
                                        <DockPanel Width="190"><TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoMuted}" Text="F3" FontSize="11" /><TextBlock Text="PTT 그룹" /></DockPanel>
                                    </Button>
                                    <Button Style="{StaticResource DropItem}" Click="MoreItem_Click" Command="{Binding ShowScreenCommand}" CommandParameter="{x:Static m:AppScreen.Admin}" IsEnabled="{Binding CanManage}"
                                            ToolTip="{Binding ManageHint}" ToolTipService.ShowOnDisabled="True">
                                        <DockPanel Width="190"><TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoMuted}" Text="F4" FontSize="11" /><TextBlock Text="관리 — 조직 · 구성원 · 번호" /></DockPanel>
                                    </Button>
                                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="6,4" />
                                    <Button Style="{StaticResource DropItem}" Content="설정…" Click="MoreItem_Click" Command="{Binding Desk.OpenSettingsCommand}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Border>

            <DockPanel>
                <!-- ═══ 상단 바 ═══ -->
                <Border DockPanel.Dock="Top" Height="56" Padding="20,0,8,0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 감청 중 N — 진행 중인 감청·청취, 누르면 그 창 -->
                            <Grid Margin="0,0,10,0" Visibility="{Binding Desk.HasMonitors, Converter={StaticResource BoolToVis}}">
                                <ToggleButton x:Name="MonDrop" Style="{StaticResource DropButton}" Height="32" Foreground="{DynamicResource Brush.Mon}" BorderBrush="{DynamicResource Brush.Mon}" Background="{DynamicResource Brush.MonSoft}"
                                              ToolTip="감청·청취 중 — 누르면 그 창으로">
                                    <StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource Dot}" Width="8" Height="8" Fill="{DynamicResource Brush.Mon}" /><TextBlock FontWeight="SemiBold"><Run Text="감청 중 " /><Run Text="{Binding Desk.MonitorCount, Mode=OneWay}" /></TextBlock><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12" Margin="4,0,0,0" /></StackPanel>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=MonDrop}" PlacementTarget="{Binding ElementName=MonDrop}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Style="{StaticResource DropPanel}">
                                        <ItemsControl ItemsSource="{Binding Desk.Monitors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource DropItem}" Content="{Binding Title}" Click="DropItem_Click"
                                                            Command="{Binding DataContext.Desk.ActivateMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                            </Grid>
                            <!-- 통합 검색 Ctrl+K -->
                            <Button Width="320" Height="36" Cursor="Hand" Command="{Binding ToggleSearchCommand}" ToolTip="통합 검색 — 사람·그룹 → 개별 통화·애드혹·통화·문자·무전 메시지 (Ctrl+K)" Margin="0,0,6,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.Surface}" Padding="10,0">
                                            <DockPanel VerticalAlignment="Center">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource NavKey}"><TextBlock Text="Ctrl+K" /></Border>
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Search}" Width="16" Height="16" StrokeThickness="2" Margin="0,0,8,0" TextElement.Foreground="{DynamicResource Brush.Muted}" />
                                                <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="이름 · 내선 · PTT 번호 · 채널" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" /></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- 세션 메뉴 ⋮ -->
                            <Grid>
                                <ToggleButton x:Name="SessionDrop" Width="44" Height="44" Cursor="Hand" Focusable="False" ToolTip="오디오 · 설정 · 로그아웃 · 종료">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                                                <Path Style="{StaticResource Icon.Filled}" Data="{StaticResource Icon.DotsV}" Width="20" Height="20" TextElement.Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" /></Trigger></ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=SessionDrop}" PlacementTarget="{Binding ElementName=SessionDrop}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-200">
                                    <Border Style="{StaticResource DropPanel}" MinWidth="240">
                                        <StackPanel>
                                            <Button Style="{StaticResource DropItem}" Click="DropItem_Click" Command="{Binding Desk.OpenSettingsCommand}" ToolTip="{Binding Desk.AudioTip}">
                                                <StackPanel><TextBlock Text="오디오" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Muted}" FontSize="11.5" Text="{Binding Desk.AudioSummary}" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DropItem}" Click="DropItem_Click" Command="{Binding Desk.OpenSettingsCommand}">
                                                <StackPanel><TextBlock Text="설정…" /><TextBlock Style="{StaticResource Muted}" FontSize="11.5" Text="{Binding Desk.PttHotKey}" /></StackPanel>
                                            </Button>
                                            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="6,4" />
                                            <Button Style="{StaticResource DropItem}" Content="로그아웃" Click="DropItem_Click" Command="{Binding Desk.LogoutCommand}" />
                                            <Button Style="{StaticResource DropItem}" Content="앱 종료" Click="DropItem_Click" Command="{Binding Desk.ExitCommand}" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                        <!-- 신원 — 이름(크게) · 소속 · 대표번호 · 등록 점등(PTT · 전화) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding Desk}">
                            <TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding PttNumberFull}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="{Binding DeskLine}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Ellipse Style="{StaticResource RegDot}" Tag="{Binding PttState}" Margin="0,0,4,0" ToolTip="{Binding PttTip}"
                                     Visibility="{Binding HasPtt, Converter={StaticResource BoolToVis}}" />
                            <Ellipse Style="{StaticResource RegDot}" Tag="{Binding VolteState}" ToolTip="{Binding VolteTip}"
                                     Visibility="{Binding HasVolte, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ═══ 배너 층 — 긴급·임박·경보(꽉 찬 면, 닫기 없음) · 착신(옅은 면 [응답][거절]) · 경고(서버 인증서·자격). 최신 위, 어느 화면에서나 ═══ -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Notify.Banners}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:Banner}">
                            <Grid>
                                <!-- 두 줄 배너(64) -->
                                <Border x:Name="Bar" Height="64" Padding="20,0,14,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.RingEdge}" Background="{DynamicResource Brush.RingBanner}"
                                        TextElement.Foreground="{DynamicResource Brush.Ink}" Visibility="{Binding IsWarning, Converter={StaticResource NotToVis}}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Mono}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"
                                                       Text="{Binding Elapsed, Mode=OneWay, Converter={StaticResource Elapsed}}" Visibility="{Binding ShowElapsed, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource Pill.Call.Lg}" MinWidth="104" FontSize="15" Content="응답" Margin="0,0,8,0" ToolTip="F9"
                                                    Command="{Binding DataContext.AnswerBannerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource Pill.Line.Lg}" FontWeight="Normal" FontSize="14" Content="거절"
                                                    Command="{Binding DataContext.RejectBannerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVis}}" />
                                            <!-- «새 영상»(§10.3) — [보기] = 그 채널 상세를 열고 그 송출을 본다 · [닫기] = 배너만 내린다(채널 «영상 n» 목록에서 다시 [보기]) -->
                                            <Button Style="{StaticResource Pill.Listen}" Height="44" MinWidth="104" FontSize="15" Content="보기" Margin="0,0,8,0" ToolTip="이 영상 보기(Receive Media Request — TS 24.581 §6.2.5.3.3) — 채널 상세가 열린다"
                                                    Background="{DynamicResource Brush.ListenFill}" Foreground="{DynamicResource Brush.OnAccent}" BorderThickness="0"
                                                    Command="{Binding DataContext.AcceptVideoBannerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" />
                                            <Button x:Name="Cancel" Style="{StaticResource Pill.Line.Lg}" FontSize="14" Content="{Binding CancelText}" Margin="0,0,8,0" BorderBrush="{Binding (TextElement.Foreground), ElementName=Bar}"
                                                    Foreground="{Binding (TextElement.Foreground), ElementName=Bar}" Background="Transparent"
                                                    Command="{Binding DataContext.CancelBannerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" ToolTip="긴급·임박 = 조건 해제 요청(내가 올린 긴급) · 경보 = 경보 취소(남의 경보면 제3자 취소)" />
                                            <Button x:Name="Go" Style="{StaticResource Pill.Ink.Lg}" FontSize="14" Content="채널로 이동"
                                                    Command="{Binding DataContext.GoToChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource Pill.Line.Lg}" FontWeight="Normal" FontSize="14" Content="닫기" Margin="8,0,0,0" BorderBrush="{Binding (TextElement.Foreground), ElementName=Bar}"
                                                    Foreground="{Binding (TextElement.Foreground), ElementName=Bar}" Background="Transparent"
                                                    Command="{Binding DataContext.DismissBannerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding ShowDismiss, Converter={StaticResource BoolToVis}}" ToolTip="{Binding DismissTip}" />
                                        </StackPanel>
                                        <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Brush.Peril}" Margin="0,0,14,0" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="L1" Text="{Binding Line1}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.RingInk}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Line2}" FontSize="19" FontWeight="Bold" LineHeight="23" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <!-- 경고 한 줄(서버 인증서 만료 §8.6.2 · 자격 갱신 실패) — 닫기 없음 -->
                                <Border x:Name="Warn" Padding="20,10,14,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.EmgEdge}" Background="{DynamicResource Brush.EmgSoft}"
                                        TextElement.Foreground="{DynamicResource Brush.Emg}" Visibility="{Binding IsWarning, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Warn}" Width="16" Height="16" Margin="0,0,10,0" StrokeThickness="2" />
                                        <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" VerticalAlignment="Center">
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="Bold" /><Run Text=" · " /><Run Text="{Binding Subtitle, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEmg}" Value="True">
                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.EmgSoft}" /><Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource Brush.EmgEdge}" />
                                    <Setter TargetName="Bar" Property="TextElement.Foreground" Value="{DynamicResource Brush.EmgInk}" /><Setter TargetName="L1" Property="Foreground" Value="{DynamicResource Brush.EmgInk}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Emg}" />
                                    <Setter TargetName="Go" Property="Background" Value="{DynamicResource Brush.EmgFill}" /><Setter TargetName="Go" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPeril}" Value="True">
                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Peril}" /><Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource Brush.PerilEdge}" />
                                    <Setter TargetName="Bar" Property="TextElement.Foreground" Value="{DynamicResource Brush.OnPeril}" /><Setter TargetName="L1" Property="Foreground" Value="{DynamicResource Brush.OnPeril}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.OnPeril}" />
                                    <Setter TargetName="Go" Property="Background" Value="{DynamicResource Brush.OnPeril}" /><Setter TargetName="Go" Property="Foreground" Value="{DynamicResource Brush.Peril}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.MonSoft}" /><Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource Brush.MonEdge}" />
                                    <Setter TargetName="Bar" Property="TextElement.Foreground" Value="{DynamicResource Brush.MonInk}" /><Setter TargetName="L1" Property="Foreground" Value="{DynamicResource Brush.MonInk}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Mon}" />
                                    <Setter TargetName="Go" Property="Background" Value="{DynamicResource Brush.MonFill}" /><Setter TargetName="Go" Property="Foreground" Value="{DynamicResource Brush.OnMon}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDirect}" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.HeldSoft}" /><Setter TargetName="L1" Property="Foreground" Value="{DynamicResource Brush.Held}" /><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Held}" /><Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource Brush.Border}" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.ListenSoft}" /><Setter TargetName="L1" Property="Foreground" Value="{DynamicResource Brush.ListenInk}" /><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Listen}" /><Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource Brush.Border}" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsPtt}" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.ListenSoft}" /><Setter TargetName="L1" Property="Foreground" Value="{DynamicResource Brush.Listen}" /><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Listen}" /><Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource Brush.Border}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Critical}" Value="True">
                                    <Setter TargetName="Warn" Property="Background" Value="{DynamicResource Brush.EmgFill}" /><Setter TargetName="Warn" Property="TextElement.Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══ 발언 바(모든 화면) ═══ -->
                <v:TalkBarView DockPanel.Dock="Bottom" DataContext="{Binding TalkBar}" />

                <!-- ═══ 탭 줄 — [무전|통화] + 오른쪽 끝 목록 버튼(관제 화면만) ═══ -->
                <Border DockPanel.Dock="Top" Height="48" Padding="16,0,12,0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                        Visibility="{Binding IsDispatch, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ListToggle}" IsChecked="{Binding ListOpen, Mode=OneWay}" Command="{Binding ToggleListCommand}" VerticalAlignment="Center"
                                      ToolTip="사람 찾기 — 무전 [사용자] · 통화 [주소록] (오른쪽 패널)">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Width="16" Height="16" StrokeThickness="2" Margin="0,0,6,0">
                                    <Path.Data><Binding Path="IsPtt" Converter="{StaticResource Pick}" ConverterParameter="M17,21 V19 A4,4 0 0 0 13,15 H5 A4,4 0 0 0 1,19 V21 M9,3 A4,4 0 1 0 9,11 A4,4 0 1 0 9,3 Z M23,21 V19 A4,4 0 0 0 20,15.1 M16,3.1 A4,4 0 0 1 16,10.9|M5,3 H19 V21 H5 Z M12,7.4 A2.6,2.6 0 1 0 12,12.6 A2.6,2.6 0 1 0 12,7.4 Z M8.5,16.5 C9.2,14.9 10.5,14.1 12,14.1 C13.5,14.1 14.8,14.9 15.5,16.5 M3,7 H5 M3,12 H5 M3,17 H5" /></Path.Data>
                                </Path>
                                <TextBlock Text="{Binding ListText}" />
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Height="36" CornerRadius="9" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Fill}" Padding="2" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource ModeSeg}" IsChecked="{Binding IsPtt, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="ptt" ToolTip="무전 — 말하고 듣기">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="무전" />
                                            <Border Style="{StaticResource Count}" Margin="6,0,0,0" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                    Visibility="{Binding PttBadge, Converter={StaticResource CountToVis}}">
                                                <TextBlock Text="{Binding PttBadge}" Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                            </Border>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ModeSeg}" IsChecked="{Binding IsCall, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="call" ToolTip="통화 — 걸고 받기">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="통화" />
                                            <Border Style="{StaticResource Count}" Margin="6,0,0,0" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                    Visibility="{Binding CallBadge, Converter={StaticResource CountToVis}}">
                                                <TextBlock Text="{Binding CallBadge}" Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                            </Border>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding ModeHint}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ═══ 본문 + 오른쪽 패널 — 패널은 본문 위에 겹친다(본문 배치는 그대로, 오른쪽 끝에서 밀려 들어오고 나간다 — §3.6) ═══ -->
                <Grid x:Name="Body" Background="{DynamicResource Brush.Surface}" ClipToBounds="True">
                        <Grid Visibility="{Binding IsDispatch, Converter={StaticResource BoolToVis}}">
                            <v:PttModeView Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}" />
                            <v:CallModeView Visibility="{Binding IsCall, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <v:ScreenView x:Name="ScreenHost" Screen="{Binding Screen}" Visibility="{Binding IsDispatch, Converter={StaticResource NotToVis}}" />
                        <v:SlideOverPanel HorizontalAlignment="Right" IsOpen="{Binding Panel.IsOpen}">
                            <v:SidePanelView />
                        </v:SlideOverPanel>
                        <!-- 토스트 — 본문 우하단(패널이 열려 있으면 패널 왼쪽) -->
                        <ItemsControl ItemsSource="{Binding Notify.Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="440">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Margin" Value="0,0,12,12" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Panel.IsOpen}" Value="True"><Setter Property="Margin" Value="0,0,452,12" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:Toast}">
                                    <Border x:Name="T" CornerRadius="8" Padding="14,10,8,10" Margin="0,6,0,0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                            TextElement.Foreground="{DynamicResource Brush.Ink}">
                                        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.22" /></Border.Effect>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Flat}" Width="26" Height="26" VerticalAlignment="Top" Foreground="{Binding (TextElement.Foreground), ElementName=T}"
                                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="닫기">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.X}" Width="14" Height="14" StrokeThickness="2.4" />
                                            </Button>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Flat}" VerticalAlignment="Top" Margin="0,3,6,0" FontSize="12" Foreground="{Binding (TextElement.Foreground), ElementName=T}"
                                                    Command="{Binding DataContext.ToggleToastDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="▸상세" />
                                            </Button>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" FontWeight="Bold" />
                                                <TextBlock Style="{StaticResource Mono}" Text="{Binding Detail}" FontSize="11.5" TextWrapping="Wrap" Opacity="0.85" Margin="0,4,0,0" Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True"><Setter TargetName="T" Property="Background" Value="{DynamicResource Brush.EmgSoft}" /><Setter TargetName="T" Property="BorderBrush" Value="{DynamicResource Brush.EmgEdge}" /><Setter TargetName="T" Property="TextElement.Foreground" Value="{DynamicResource Brush.EmgInk}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsWarn}" Value="True"><Setter TargetName="T" Property="Background" Value="{DynamicResource Brush.RingBanner}" /><Setter TargetName="T" Property="BorderBrush" Value="{DynamicResource Brush.RingEdge}" /><Setter TargetName="T" Property="TextElement.Foreground" Value="{DynamicResource Brush.RingInk}" /></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </Grid>
            </DockPanel>
        </DockPanel>

        <!-- 통합 검색 Ctrl+K(§4.1) — 사람·그룹 검색 → 행동. ↑↓ 이동 · Enter 첫 행동 · Esc 닫기 -->
        <Popup x:Name="SearchPop" IsOpen="{Binding People.SearchOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Body}" Placement="Center" VerticalOffset="-180" StaysOpen="False" AllowsTransparency="True" Opened="SearchPop_Opened">
            <Border Style="{StaticResource PopPanel}" Width="640" Margin="12" DataContext="{Binding People}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource NavKey}"><TextBlock Text="Esc" /></Border>
                            <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Height="32" FontSize="14" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown" Tag="이름 · 내선 · PTT 번호 · 그룹" />
                        </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="12,6,12,8" Text="↑↓ 이동 · Enter 첫 행동(개별 통화/통화/채널로) · 사람 행 = 소속 · PTT 상태 · 내선 상태" />
                    <ListBox Style="{StaticResource SelectList}" ItemsSource="{Binding Results}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" MaxHeight="420" Margin="4">
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type vm:PersonEntry}">
                                <Border Style="{StaticResource LogRow}" Padding="10,6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource Pill.Soft.Sm}"><Setter Property="Height" Value="26" /><Setter Property="Margin" Value="4,0,0,0" /><Setter Property="Focusable" Value="False" /></Style></StackPanel.Resources>
                                            <Button Content="통화" Command="{Binding DataContext.CallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding HasLine}" />
                                            <Button Content="문자" Command="{Binding DataContext.SmsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding HasLine}" />
                                            <Button Content="개별 통화" Command="{Binding DataContext.PrivateCallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding HasPtt}" />
                                            <Button Content="무전 메시지" Command="{Binding DataContext.SdsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding HasPtt}" />
                                            <Button Content="애드혹에 추가" Command="{Binding DataContext.AddToAdhocCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding HasPtt}" />
                                        </StackPanel>
                                        <Border Style="{StaticResource Avatar}" Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0" Tag="{Binding Name, Converter={StaticResource AvatarHue}}">
                                            <TextBlock Text="{Binding Initial}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Head}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Head}" />
                                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:GroupEntry}">
                                <Border Style="{StaticResource LogRow}" Padding="10,6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Pill.Soft.Sm}" Height="26" Content="채널로" Focusable="False" Command="{Binding DataContext.ChannelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="4,0,0,0" />
                                            <Button Style="{StaticResource Pill.Soft.Sm}" Height="26" Content="멤버 추가" Focusable="False" Command="{Binding DataContext.AddMemberCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="4,0,0,0"
                                                    Visibility="{Binding Group.IsOwner, Converter={StaticResource BoolToVis}}" ToolTip="[PTT 그룹] 화면 편집 폼" />
                                        </StackPanel>
                                        <Border Style="{StaticResource Avatar}" Width="28" Height="28" CornerRadius="6" Margin="0,0,8,0" Tag="{Binding Name, Converter={StaticResource AvatarHue}}">
                                            <TextBlock Text="G" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Meta}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
        <!-- 사람 메뉴(§4.1) — 채널 상세 로스터·사용자·주소록·그룹원 칸·기록 머리. 머리 = 이름 · PTT 번호 · 내선, 회선이 없는 항목은 비활성 -->
        <Popup IsOpen="{Binding People.MenuOpen, Mode=TwoWay}" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource DropPanel}" MinWidth="240" DataContext="{Binding People}">
                <StackPanel DataContext="{Binding MenuEntry}">
                    <TextBlock Text="{Binding Head}" FontWeight="SemiBold" Margin="10,6,10,0" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Sub}" Margin="10,0,10,4" Visibility="{Binding Sub, Converter={StaticResource StrToVis}}" />
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="6,2" />
                    <Button Style="{StaticResource DropItem}" IsEnabled="{Binding HasLine}" Command="{Binding DataContext.CallCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}">
                        <DockPanel Width="210"><TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoMuted}" FontSize="11.5" Text="{Binding DisplayExtension}" /><TextBlock Text="통화" /></DockPanel>
                    </Button>
                    <Button Style="{StaticResource DropItem}" IsEnabled="{Binding HasLine}" Command="{Binding DataContext.SmsCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}">
                        <DockPanel Width="210"><TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoMuted}" FontSize="11.5" Text="{Binding DisplayExtension}" /><TextBlock Text="문자" /></DockPanel>
                    </Button>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="6,2" />
                    <Button Style="{StaticResource DropItem}" IsEnabled="{Binding HasPtt}" Command="{Binding DataContext.PrivateCallCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}">
                        <DockPanel Width="210"><TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoMuted}" FontSize="11.5" Text="{Binding DisplayPtt}" /><TextBlock Text="개별 통화" /></DockPanel>
                    </Button>
                    <Button Style="{StaticResource DropItem}" IsEnabled="{Binding HasPtt}" Command="{Binding DataContext.SdsCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}">
                        <DockPanel Width="210"><TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoMuted}" FontSize="11.5" Text="{Binding DisplayPtt}" /><TextBlock Text="무전 메시지" /></DockPanel>
                    </Button>
                    <Button Style="{StaticResource DropItem}" Content="애드혹에 추가" IsEnabled="{Binding HasPtt}" Command="{Binding DataContext.AddToAdhocCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}" />
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="6,2" />
                    <Button Style="{StaticResource DropItem}" Command="{Binding DataContext.RecordCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}">
                        <DockPanel Width="210"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11.5" Text="[통화] 기록에서" /><TextBlock Text="기록 보기" /></DockPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
