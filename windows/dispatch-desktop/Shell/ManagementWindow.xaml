<Window x:Class="DispatchDesktop.Shell.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
        xmlns:m="clr-namespace:DispatchDesktop.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ManagementViewModel}"
        Style="{StaticResource Window.Base}" Title="{Binding Title}" Width="1180" Height="760" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterOwner">
    <!-- 관리 창(§4.5) — ① 조직/구성원·번호 ② PTT 그룹 ③ 이력·녹취. 앞 둘은 관리 범위(dispatch.directoryAdmin) 가 있을 때 활성 -->
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="{Binding ManageHint}" Foreground="{DynamicResource Brush.Emg}" TextWrapping="Wrap"
                   Visibility="{Binding ManageHint, Converter={StaticResource StrToVis}}" Margin="0,0,0,6" />
        <TabControl SelectedIndex="{Binding Tab}">
            <!-- ① 조직/구성원 -->
            <TabItem Header="조직 · 구성원 · 번호" IsEnabled="{Binding CanManage}" DataContext="{Binding Directory}">
                <DockPanel Margin="10" IsEnabled="{Binding Busy, Converter={StaticResource Not}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Sm}" Content="↻ 새로고침" Command="{Binding RefreshCommand}" />
                        <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" Width="220" Height="26" Margin="0,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="이름·아이디·번호 검색" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding ScopeText}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Emg}" Text="{Binding Error}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>
                        <!-- 조직 트리 -->
                        <DockPanel Grid.Column="0" Margin="0,0,10,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn.Xs.Pri}" Content="새 조직" Command="{Binding NewOrgCommand}" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource Btn.Xs}" Content="편집" Command="{Binding BeginEditOrgCommand}" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource Btn.Xs.Danger}" Content="삭제" Command="{Binding DeleteOrgCommand}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="조직" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Orgs}" SelectedItem="{Binding SelectedOrg}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OrgRow}">
                                        <Border Style="{StaticResource LogRow}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding CountText}" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" ToolTip="{Binding Code}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <!-- 구성원 -->
                        <DockPanel Grid.Column="1" Margin="0,0,10,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn.Xs.Pri}" Content="새 구성원" Command="{Binding NewMemberCommand}" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource Btn.Xs}" Content="편집" Command="{Binding EditMemberCommand}" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource Btn.Xs.Danger}" Content="삭제" Command="{Binding DeleteMemberCommand}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="구성원" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Run Text="{Binding Members.Count, Mode=OneWay}" /><Run Text="명" />
                                </TextBlock>
                            </DockPanel>
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}" MouseDoubleClick="Members_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MemberRow}">
                                        <Border Style="{StaticResource LogRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Title}" FontSize="12" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding OrgPath}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Hint}" Text="VoLTE" FontSize="10" />
                                                    <TextBlock Style="{StaticResource Mono}" Text="{Binding VolteText}" FontSize="12" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Hint}" Text="PTT" FontSize="10" />
                                                    <TextBlock Style="{StaticResource Mono}" Text="{Binding PttText}" FontSize="12" />
                                                </StackPanel>
                                                <Border Grid.Column="3" Style="{StaticResource Badge}" VerticalAlignment="Center" Visibility="{Binding Flags, Converter={StaticResource StrToVis}}"><TextBlock Text="{Binding Flags}" /></Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <!-- 편집 폼 -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                            <Grid>
                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"
                                           Text="조직이나 구성원을 골라 [편집], 또는 [새 조직]/[새 구성원].&#10;&#10;번호(VoLTE·PTT 회선)는 구성원 편집 폼에서 개설·변경·삭제합니다. 새 회선과 번호 변경에는 SIP 비밀번호가 필요합니다(서버가 H(A1) 로만 보관).">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OrgEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <DataTrigger Binding="{Binding MemberEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 조직 폼 -->
                                <StackPanel Visibility="{Binding OrgEditing, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding OrgFormTitle}" Margin="0,0,0,8" />
                                    <TextBlock Text="코드 (불변 키)" Style="{StaticResource Hint}" />
                                    <TextBox Style="{StaticResource Field}" Text="{Binding OrgCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding OrgIsNew}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,8" />
                                    <TextBlock Text="이름" Style="{StaticResource Hint}" />
                                    <TextBox Style="{StaticResource Field}" Text="{Binding OrgName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                                    <TextBlock Text="상위 조직" Style="{StaticResource Hint}" />
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Orgs}" SelectedItem="{Binding OrgParent}" DisplayMemberPath="Label" Margin="0,2,0,8" />
                                    <TextBlock Text="정렬 순서" Style="{StaticResource Hint}" />
                                    <TextBox Style="{StaticResource Field}" Text="{Binding OrgSort, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="0,2,0,12" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource Btn}" Content="취소" Command="{Binding CancelOrgCommand}" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource Btn.Pri}" Content="저장" Command="{Binding SaveOrgCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                <!-- 구성원 폼 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding MemberEditing, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding MemberFormTitle}" Margin="0,0,0,8" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="이름" Style="{StaticResource Hint}" />
                                                <TextBox Style="{StaticResource Field}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="직함" Style="{StaticResource Hint}" />
                                                <TextBox Style="{StaticResource Field}" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="소속 조직" Style="{StaticResource Hint}" />
                                        <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Orgs}" SelectedItem="{Binding EditOrg}" DisplayMemberPath="Label" Margin="0,2,0,8" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="로그인 아이디 (단말 로그인)" Style="{StaticResource Hint}" />
                                                <TextBox Style="{StaticResource Field}" Text="{Binding EditLoginId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="로그인 비밀번호 (변경 시만)" Style="{StaticResource Hint}" />
                                                <PasswordBox x:Name="LoginPw" Style="{StaticResource FieldPw}" PasswordChanged="LoginPw_Changed" Margin="0,2,0,8" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <!-- VoLTE 회선 -->
                                        <Border Style="{StaticResource Sub}" Margin="0,4,0,6" Padding="8">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionHeader}" Text="VoLTE 번호" Margin="0,0,0,4" />
                                                <TextBlock Text="번호 (E.164, 비우면 회선 삭제)" Style="{StaticResource Hint}" />
                                                <TextBox Style="{StaticResource Field}" Text="{Binding VolteNumber, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,6" />
                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="접속서비스" Style="{StaticResource Hint}" />
                                                        <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding VolteServices}" SelectedItem="{Binding VolteService}" DisplayMemberPath="Label" Margin="0,2,0,6" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="SIP transport" Style="{StaticResource Hint}" />
                                                        <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Transports}" SelectedItem="{Binding VolteTransport}" Margin="0,2,0,6" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock Text="SIP 비밀번호 (개설·번호 변경 시 필수)" Style="{StaticResource Hint}" />
                                                <PasswordBox x:Name="VoltePw" Style="{StaticResource FieldPw}" PasswordChanged="VoltePw_Changed" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <!-- PTT 회선 -->
                                        <Border Style="{StaticResource Sub}" Margin="0,0,0,8" Padding="8">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionHeader}" Text="PTT 번호" Margin="0,0,0,4" />
                                                <TextBlock Text="번호 (E.164, 비우면 회선 삭제)" Style="{StaticResource Hint}" />
                                                <TextBox Style="{StaticResource Field}" Text="{Binding PttNumber, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,6" />
                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="접속서비스" Style="{StaticResource Hint}" />
                                                        <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding PttServices}" SelectedItem="{Binding PttService}" DisplayMemberPath="Label" Margin="0,2,0,6" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="SIP transport" Style="{StaticResource Hint}" />
                                                        <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Transports}" SelectedItem="{Binding PttTransport}" Margin="0,2,0,6" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock Text="SIP 비밀번호 (개설·번호 변경 시 필수)" Style="{StaticResource Hint}" />
                                                <PasswordBox x:Name="PttPw" Style="{StaticResource FieldPw}" PasswordChanged="PttPw_Changed" Margin="0,2,0,6" />
                                                <CheckBox Content="PTT 그룹 생성 자격 (allow-create-group)" IsChecked="{Binding AllowCreateGroup}" Margin="0,0,0,2" />
                                                <CheckBox Content="원격 청취 자격 (allow-ambient-listening — 관제사)" IsChecked="{Binding AllowAmbientListening}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource Btn}" Content="취소" Command="{Binding CancelMemberCommand}" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource Btn.Pri}" Content="저장" Command="{Binding SaveMemberCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ② PTT 그룹 -->
            <TabItem Header="PTT 그룹" DataContext="{Binding Groups}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Sm}" Content="↻" ToolTip="목록 새로고침" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource Btn.Sm.Pri}" Content="새 그룹" Command="{Binding NewGroupCommand}" Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" Width="220" Height="26" Margin="0,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="그룹 이름·id 검색" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Hint}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Emg}" Text="{Binding Error}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    </DockPanel>
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Groups}" SelectedItem="{Binding Selected}" MouseDoubleClick="Groups_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GroupAdminRow}">
                                <Border Style="{StaticResource LogRow}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Btn.Xs}" Content="편집" Command="{Binding DataContext.EditGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,4,0" />
                                            <Button Style="{StaticResource Btn.Xs.Danger}" Content="삭제" Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Meta}" FontSize="12" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource MonoMuted}" FontSize="11">
                                                <Run Text="{Binding Id, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding OrgPath, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- ③ 이력·녹취 -->
            <TabItem Header="세션 이력 · 녹취" DataContext="{Binding History}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Sm.Pri}" Content="조회" Command="{Binding QueryCommand}" />
                        <ComboBox Style="{StaticResource FieldCombo}" Width="130" ItemsSource="{Binding Kinds}" SelectedIndex="{Binding KindIndex}" Margin="0,0,8,0" />
                        <DatePicker SelectedDate="{Binding Date}" Width="140" Margin="0,0,8,0" />
                        <TextBox Style="{StaticResource Field}" Width="220" Height="26" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="상대·그룹 검색" Margin="0,0,8,0" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Emg}" Text="{Binding Error}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0" Style="{StaticResource PlainList}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Margin="0,0,10,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HistoryRow}">
                                    <Border Style="{StaticResource LogRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Mono}" Text="{Binding TimeText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding KindText}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Parties}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource Muted}" Text="{Binding EventText}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Style="{StaticResource Mono}" Text="{Binding DurationText}" FontSize="12" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource Badge.Emg}" Margin="0,0,4,0" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}"><TextBlock Text="긴급" /></Border>
                                                <Border Style="{StaticResource Badge.Mon}" Visibility="{Binding HasRecording, Converter={StaticResource BoolToVis}}"><TextBlock Text="녹취" /></Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 녹취 재생 -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="녹취" Margin="0,0,0,4" />
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="{Binding RecordingStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding PlayingLabel}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,6" Visibility="{Binding PlayingLabel, Converter={StaticResource StrToVis}}" />
                                    <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Width="0" Height="0" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource Btn.Sm}" Content="다시 변환" ToolTip="변환 실패 표식을 지우고 다시 변환 요청" Command="{Binding RetryTranscodeCommand}" IsEnabled="{Binding CanPlay}" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource Btn.Sm}" Content="정지" Command="{Binding StopCommand}" IsEnabled="{Binding IsPlaying}" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource Btn.Sm.Pri}" Content="▶ 재생" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}" />
                                    </StackPanel>
                                </StackPanel>
                                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}" MouseDoubleClick="Segments_DoubleClick"
                                         Visibility="{Binding HasRecording, Converter={StaticResource BoolToVis}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type m:RecordingSegment}">
                                            <Border Style="{StaticResource LogRow}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding DurationText}" FontSize="12" VerticalAlignment="Center" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource MonoMuted}" FontSize="11">
                                                            <Run Text="{Binding Start, Mode=OneWay, StringFormat=HH:mm:ss}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
