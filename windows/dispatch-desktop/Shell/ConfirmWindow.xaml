<Window x:Class="DispatchDesktop.Shell.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Base}" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <!-- 확인 대화상자 — 시스템 MessageBox 대신(테마를 따르지 않아 어둡게에서 흰 창이 뜬다). 되돌릴 수 없는 일(삭제)은 빨강 버튼·기본 버튼 = 취소 -->
    <StackPanel Margin="18,16">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock x:Name="Body" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource Brush.TextSoft}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="Cancel" Style="{StaticResource Btn}" Content="취소" IsCancel="True" Margin="0,0,6,0" MinWidth="72" />
            <Button x:Name="Ok" Style="{StaticResource Btn.Pri}" Content="확인" Click="Ok_Click" MinWidth="72" />
        </StackPanel>
    </StackPanel>
</Window>
