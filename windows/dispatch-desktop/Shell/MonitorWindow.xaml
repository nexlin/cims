<Window x:Class="DispatchDesktop.Shell.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MonitorWindowViewModel}"
        Style="{StaticResource Window.Base}" Title="{Binding Title}" Width="440" Height="260" MinWidth="360" MinHeight="200" ShowActivated="False" ShowInTaskbar="True">
    <!-- 감청 창 (§5) — VoLTE 감청 / PTT 청취. 듣기만 하는 세션 하나 = 창 하나. 닫기 = 종료. -->
    <DockPanel Margin="12">
        <!-- 제목 줄 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding Elapsed, Converter={StaticResource Elapsed}}" FontSize="16" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource Dot}" Fill="{DynamicResource Brush.Mon}" />
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Badge.Mon}"><TextBlock Text="{Binding Badge}" /></Border>
                <Border Style="{StaticResource Badge.Emg}" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}"><TextBlock Text="긴급" /></Border>
            </StackPanel>
        </DockPanel>
        <!-- 하단 조작 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Danger}" Content="청취 종료" Command="{Binding StopCommand}" />
            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Sm}" Content="{Binding RouteLabel}" Command="{Binding ToggleRouteCommand}" IsEnabled="{Binding CanToggleRoute}" ToolTip="출력 라우트: 헤드셋 / 데스크 스피커" Margin="0,0,8,0" />
            <TextBlock DockPanel.Dock="Left" Text="음량" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Slider Minimum="0" Maximum="2" Value="{Binding Volume}" VerticalAlignment="Center" Width="120" HorizontalAlignment="Left" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Text="{Binding ClosingNote}" Visibility="{Binding ClosingNote, Converter={StaticResource StrToVis}}" Foreground="{DynamicResource Brush.Emg}" />
        <!-- 본문 -->
        <Grid>
            <!-- VoLTE: caller / callee 두 줄 -->
            <StackPanel Visibility="{Binding IsVolte, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CallerName}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Value="{Binding CallerLevel, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0" />
                    <Ellipse Grid.Column="2" Style="{StaticResource Dot}">
                        <Ellipse.Resources><Style TargetType="Ellipse" BasedOn="{StaticResource Dot}"><Style.Triggers><DataTrigger Binding="{Binding CallerActive}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Talk}" /></DataTrigger></Style.Triggers></Style></Ellipse.Resources>
                    </Ellipse>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CalleeName}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Value="{Binding CalleeLevel, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0" />
                    <Ellipse Grid.Column="2" Style="{StaticResource Dot}">
                        <Ellipse.Resources><Style TargetType="Ellipse" BasedOn="{StaticResource Dot}"><Style.Triggers><DataTrigger Binding="{Binding CalleeActive}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Talk}" /></DataTrigger></Style.Triggers></Style></Ellipse.Resources>
                    </Ellipse>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"><Run Text="[양쪽] · " /><Run Text="{Binding VideoNote, Mode=OneWay}" /></TextBlock>
            </StackPanel>
            <!-- PTT 청취 -->
            <StackPanel Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}">
                <TextBlock FontSize="15" Margin="0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="발언자 없음" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasSpeaker}" Value="True"><Setter Property="Text" Value="{Binding Speaker, StringFormat=발언 {0}}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding SpeakerElapsed, Converter={StaticResource Elapsed}}" Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"><Run Text="참가자 " /><Run Text="{Binding Participants, Mode=OneWay}" /></TextBlock>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="발언 요청 불가(Permission=0) — 청취 전용" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
