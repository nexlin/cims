<Window x:Class="DispatchDesktop.Shell.ScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:DispatchDesktop.Views"
        xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Style="{StaticResource Window.Base}" Width="1180" Height="760" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterOwner" ShowActivated="True">
    <!-- 화면 별창(§3.4) — [이력]·[PTT 그룹]·[관리] 를 주 창 밖(두 번째 모니터)에. 같은 ScreenView 를 IsFloating 으로 쓴다. 닫으면 주 창 화면으로 돌아온다 -->
    <DockPanel>
        <v:DispatchStripView DockPanel.Dock="Top" />
        <v:ScreenView x:Name="Host" IsFloating="True" />
    </DockPanel>
</Window>
