<UserControl x:Class="DispatchDesktop.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:m="clr-namespace:DispatchDesktop.Models"
             xmlns:v="clr-namespace:DispatchDesktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MessagesViewModelBase}" x:Name="Root">
    <!-- 메시지 공용 뷰 — 스레드 칩 → 말풍선 → 입력 (MCData SDS ① / SMS·LMS ③) -->
    <Border Style="{StaticResource Sub}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource SubHeader}">
                <DockPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Title, ElementName=Root}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Subtitle, ElementName=Root}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Badge.Pilot}" HorizontalAlignment="Right" Visibility="{Binding UnreadTotal, Converter={StaticResource CountToVis}}">
                        <TextBlock Text="{Binding UnreadTotal}" />
                    </Border>
                </DockPanel>
            </Border>
            <!-- 스레드 칩 -->
            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="8,6,8,0">
                <ItemsControl ItemsSource="{Binding Threads}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:MessageThread}">
                            <Button Command="{Binding DataContext.SelectThreadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                <Border x:Name="Chip" Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock Text="{Binding Unread}" Margin="5,0,0,0" FontWeight="Bold" Foreground="{DynamicResource Brush.Ring}" Visibility="{Binding Unread, Converter={StaticResource CountToVis}}" />
                                    </StackPanel>
                                </Border>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{x:Static v:MessagesView.SameRef}">
                                            <Binding />
                                            <Binding Path="DataContext.Selected" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                    <Setter TargetName="Chip" Property="TextElement.Foreground" Value="{DynamicResource Brush.Primary}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- 입력 -->
            <Border DockPanel.Dock="Bottom" Padding="8,6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Pri}" Content="전송" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" Margin="6,0,0,0" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" Text="{Binding CountText, ElementName=Root}" />
                    <TextBox x:Name="Input" Style="{StaticResource Field}" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" KeyDown="Input_KeyDown"
                             IsEnabled="{Binding HasSelection}" ToolTip="{Binding InputTip, ElementName=Root}" />
                </DockPanel>
            </Border>
            <!-- 말풍선 -->
            <ListBox x:Name="List" Style="{StaticResource PlainList}" ItemsSource="{Binding Selected.Messages}" Margin="8,4" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Message}">
                        <Grid Margin="0,2">
                            <Border x:Name="Bubble" CornerRadius="10" Padding="10,6" MaxWidth="320" HorizontalAlignment="Left" Background="{DynamicResource Brush.Surface2}">
                                <StackPanel>
                                    <TextBlock x:Name="From" Style="{StaticResource Muted}" FontSize="11" Text="{Binding PeerName}" Visibility="{Binding IsOut, Converter={StaticResource NotToVis}}" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    <TextBlock Visibility="{Binding IsAttachment, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource Brush.Primary}"><Run Text="📎 " /><Run Text="{Binding FileName, Mode=OneWay}" /></TextBlock>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Text="{Binding Time, StringFormat=HH:mm}" />
                                        <Button Content="{Binding StateMark}" FontSize="10.5" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                Command="{Binding DataContext.ResendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsOut, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource Brush.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOut}" Value="True">
                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
