<UserControl x:Class="DispatchDesktop.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:m="clr-namespace:DispatchDesktop.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MessagesViewModelBase}" x:Name="Root"
             AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
    <!-- 대화 말풍선(§4.4) — [무전] «메시지» 오른쪽. 받은 말 = 회색(그룹이면 보낸 사람), 보낸 말 = 남색 + 상태(✓ · ✓✓ · 실패 [재전송]), 파일 = 이름·크기 + [받기]/열기·폴더.
         파일은 끌어 놓아도 보낸다(MCData FD) -->
    <Grid>
        <TextBlock Style="{StaticResource Hint}" Text="왼쪽에서 대화를 고르세요" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSelection, Converter={StaticResource NotToVis}}" />
        <ListBox x:Name="List" Style="{StaticResource PlainList}" ItemsSource="{Binding Selected.Messages}" Padding="18,10" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type m:Message}">
                    <StackPanel x:Name="Wrap" Margin="0,0,0,8" HorizontalAlignment="Left" MaxWidth="480">
                        <TextBlock x:Name="From" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSoft}" Text="{Binding PeerName}" Margin="0,0,0,2"
                                   Visibility="{Binding DataContext.Selected.IsGroup, ElementName=Root, Converter={StaticResource BoolToVis}}" />
                        <Border x:Name="Bubble" CornerRadius="10" Padding="12,8" Background="{DynamicResource Brush.Surface2}" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock x:Name="Body" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="21" Visibility="{Binding Text, Converter={StaticResource StrToVis}}" />
                                <!-- 파일 — 이름(누르면 열기, 안 받았으면 받기) · 크기 · 진행 · [받기] / 폴더 -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsAttachment, Converter={StaticResource BoolToVis}}">
                                    <Path x:Name="Clip" Style="{StaticResource Icon}" Data="{StaticResource Icon.Clip}" Width="16" Height="16" Margin="0,0,10,0" StrokeThickness="2" TextElement.Foreground="{DynamicResource Brush.TextSoft}" />
                                    <Button Style="{StaticResource Btn.Flat}" Foreground="{Binding (TextElement.Foreground), ElementName=Body}" ToolTip="{Binding FileName}"
                                            Command="{Binding DataContext.OpenFileCommand, ElementName=Root}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding FileName}" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                    </Button>
                                    <TextBlock x:Name="Size" FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Run Text="{Binding FileSizeText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding TransferNote, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Style="{StaticResource Pill.Line}" Height="26" Padding="10,0" FontSize="12" FontWeight="Normal" BorderThickness="1" Content="받기" Margin="10,0,0,0"
                                            Command="{Binding DataContext.DownloadFileCommand, ElementName=Root}" CommandParameter="{Binding}" Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource IconBtn}" Width="24" Height="24" Margin="6,0,0,0" ToolTip="폴더에서 보기"
                                            Command="{Binding DataContext.ShowFileCommand, ElementName=Root}" CommandParameter="{Binding}" Visibility="{Binding HasLocalFile, Converter={StaticResource BoolToVis}}">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Folder}" Width="13" Height="13" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="Meta" Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding Time, StringFormat=HH:mm}" />
                            <TextBlock x:Name="State" Style="{StaticResource Muted}" FontSize="11" Margin="4,0,0,0" Text="{Binding StateMark}" Visibility="{Binding IsOut, Converter={StaticResource BoolToVis}}" />
                            <Button x:Name="Resend" Style="{StaticResource Pill.Red}" Height="22" Padding="9,0" FontSize="11" BorderThickness="1" Content="재전송" Margin="6,0,0,0" Visibility="Collapsed"
                                    Command="{Binding DataContext.ResendCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsOut}" Value="True">
                            <Setter TargetName="Wrap" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Meta" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Brush.Primary}" />
                            <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                            <Setter TargetName="Clip" Property="TextElement.Foreground" Value="{DynamicResource Brush.OnAccent}" />
                            <Setter TargetName="Size" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                            <Setter TargetName="From" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter TargetName="State" Property="Text" Value="· 실패" />
                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Brush.Emg}" />
                            <Setter TargetName="Resend" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
