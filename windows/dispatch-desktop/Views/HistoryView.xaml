<UserControl x:Class="DispatchDesktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:m="clr-namespace:DispatchDesktop.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SessionHistoryViewModel}">
    <!-- [이력] 화면 본문(§4.6) — 콘솔 VoLTE/PTT 이력과 같은 구성: 도구줄 · 시간대 밴드(그날의 분포 = 필터) · 통화 = 전체 폭 표(한 줄이 곧 상세, 녹취는 아래 띠) ·
         PTT = 좌 세션 카드 + 우 선택 세션 패널(지표 → 참여자 → 발언 타임라인 → 이벤트 타임라인 → 녹취, 1 : 3 드래그 조절). 진행 중·오늘은 관제 ②④ 가 정본 -->
    <UserControl.Resources>
        <!-- 시간대 밴드 한 칸 -->
        <DataTemplate x:Key="HourCellTpl" DataType="{x:Type vm:HourCell}">
            <Grid Height="32" Margin="1,0" ToolTip="{Binding Tip}" Cursor="Hand" Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectHourCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Hour}" />
                </Grid.InputBindings>
                <Border CornerRadius="4" Background="{DynamicResource Brush.BgSoft}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                <Border CornerRadius="4" Background="{DynamicResource Brush.Primary}" Opacity="{Binding Ratio}" />
                <Border CornerRadius="4" BorderBrush="{DynamicResource Brush.Text}" BorderThickness="2" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Height="14" />
                    <TextBlock Text="{Binding Hour}" FontSize="9" HorizontalAlignment="Center" Opacity=".8" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- 통화 표 행 -->
        <DataTemplate x:Key="CallRowTpl" DataType="{x:Type vm:HistoryRow}">
            <Border Style="{StaticResource LogRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Badge}" HorizontalAlignment="Left" Padding="6,1"><TextBlock Text="{Binding TypeText}" FontSize="10" /></Border>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding CallerLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" /><Run Text=" → " Foreground="{DynamicResource Brush.Muted}" /><Run Text="{Binding CalleeLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Talk}" />
                    </TextBlock>
                    <Border Grid.Column="2" Style="{StaticResource Badge}" HorizontalAlignment="Center" Padding="6,1" Visibility="{Binding IsLive, Converter={StaticResource NotToVis}}"><TextBlock Text="{Binding StateText}" FontSize="10" /></Border>
                    <Border Grid.Column="2" Style="{StaticResource Badge.Talk}" HorizontalAlignment="Center" Padding="6,1" Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding StateText}" FontSize="10" /></Border>
                    <TextBlock Grid.Column="3" Style="{StaticResource Mono}" Text="{Binding InviteText}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Mono}" Text="{Binding AnswerText}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Style="{StaticResource Mono}" Text="{Binding EndText}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Style="{StaticResource Mono}" Text="{Binding DurationText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="7" Style="{StaticResource Muted}" Text="{Binding EndReasonText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Style="{StaticResource Badge.Emg}" Margin="0,0,4,0" Padding="6,1" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}"><TextBlock Text="긴급" FontSize="10" /></Border>
                        <Border Style="{StaticResource Badge.Mon}" Margin="0" Padding="6,1" Visibility="{Binding HasRecording, Converter={StaticResource BoolToVis}}"><TextBlock Text="녹취" FontSize="10" /></Border>
                        <TextBlock Style="{StaticResource Muted}" Text="—" Visibility="{Binding HasRecording, Converter={StaticResource NotToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- PTT 세션 요약 카드 — 무엇을·언제·얼마나 한 덩어리 -->
        <DataTemplate x:Key="PttCardTpl" DataType="{x:Type vm:HistoryRow}">
            <Border Style="{StaticResource LogRow}" Padding="10,7">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Badge.Member}" Padding="6,1"><TextBlock Text="{Binding SessionKindText}" FontSize="10" /></Border>
                            <Border Style="{StaticResource Badge.Held}" Padding="6,1" Visibility="{Binding IsDuplex, Converter={StaticResource BoolToVis}}"><TextBlock Text="전이중" FontSize="10" /></Border>
                            <Border Style="{StaticResource Badge.Talk}" Padding="6,1" Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"><TextBlock Text="진행중" FontSize="10" /></Border>
                            <Border Style="{StaticResource Badge}" Padding="6,1" Visibility="{Binding IsLive, Converter={StaticResource NotToVis}}"><TextBlock Text="종료" FontSize="10" /></Border>
                            <Border Style="{StaticResource Badge.Emg}" Padding="6,1" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}"><TextBlock Text="긴급" FontSize="10" /></Border>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Mon}" Margin="6,0,0,0" Padding="6,1" VerticalAlignment="Center" Visibility="{Binding HasRecording, Converter={StaticResource BoolToVis}}"><TextBlock Text="녹취" FontSize="10" /></Border>
                        <TextBlock Text="{Binding TargetText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource MonoMuted}" FontSize="11.5" Margin="0,3,0,0" Text="{Binding SubText}" />
                    <DockPanel Margin="0,3,0,0">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" Visibility="{Binding HasInitiator, Converter={StaticResource BoolToVis}}">
                            <Run Text="개시 " /><Run Text="{Binding InitiatorLabel, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,0,10,0"><Run Text="턴 " /><Run Text="{Binding TurnCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" /></TextBlock>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,0,10,0"><Run Text="화자 " /><Run Text="{Binding SpeakerCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" /></TextBlock>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,0,10,0"><Run Text="발화 " /><Run Text="{Binding SpeechText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" /></TextBlock>
                            <Border Style="{StaticResource Badge.Held}" Padding="6,0" Visibility="{Binding ShowConcurrent, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="9"><Run Text="동시 " /><Run Text="{Binding MaxConcurrent, Mode=OneWay}" /></TextBlock>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="10">
        <!-- 도구줄 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Sm.Pri}" Content="조회" Command="{Binding QueryCommand}" />
            <Border Style="{StaticResource SegGroup}" Margin="0,0,8,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Seg}" Content="통화 (VoLTE)" IsChecked="{Binding KindIndex, Converter={StaticResource Eq}, ConverterParameter=0}" />
                    <RadioButton Style="{StaticResource Seg}" Content="PTT 세션" IsChecked="{Binding KindIndex, Converter={StaticResource Eq}, ConverterParameter=1}" />
                </StackPanel>
            </Border>
            <Button Style="{StaticResource Btn.Sm}" Command="{Binding ShiftDateCommand}" CommandParameter="-1" ToolTip="전날" Margin="0,0,4,0" Padding="7,0"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronLeft}" /></Button>
            <DatePicker SelectedDate="{Binding Date}" Width="140" VerticalAlignment="Center" />
            <Button Style="{StaticResource Btn.Sm}" Command="{Binding ShiftDateCommand}" CommandParameter="1" ToolTip="다음 날" Margin="4,0,4,0" Padding="7,0"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronRight}" /></Button>
            <Button Style="{StaticResource Btn.Sm}" Content="오늘" Command="{Binding ShiftDateCommand}" CommandParameter="0" Margin="0,0,8,0" />
            <TextBox Style="{StaticResource Field}" Width="220" Height="26" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="상대·그룹·참여자 검색" Margin="0,0,8,0" />
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Emg}" Text="{Binding Error}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </DockPanel>

        <!-- 시간대 밴드 — 그날의 분포이자 필터(클릭 = 그 시간대만, 다시 클릭 = 해제) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Sub}" Padding="10,6" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Width="110" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Hint}" Text="시간대별 건수" />
                    <TextBlock Style="{StaticResource Hint}" Text="진할수록 많음 · 클릭 = 그 시간대만" FontSize="10" Opacity=".8" TextWrapping="Wrap" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Xs}" Content="전체 시간" Margin="8,0,0,0" VerticalAlignment="Center"
                        Command="{Binding SelectHourCommand}" CommandParameter="{Binding SelectedHour}" Visibility="{Binding HasHourFilter, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Hours}" ItemTemplate="{StaticResource HourCellTpl}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="24" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 좌 목록 | 경계(드래그) | 우 패널 — 열 폭은 코드비하인드가 종류에 맞춰 놓는다. 통화는 한 줄이 곧 상세라 표가 전체 폭(우 패널 없음, 녹취는 표 아래 띠),
             PTT 는 세션 패널이 주역이라 목록 1 : 패널 3(경계 드래그로 조절, 더블클릭 = 기본) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListCol" Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PaneCol" Width="380" />
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False"
                          ToolTip="드래그로 폭 조정 · 더블클릭으로 기본 폭" MouseDoubleClick="Splitter_DoubleClick" Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent" Cursor="SizeWE"><Rectangle Width="1" Fill="{DynamicResource Brush.Border}" HorizontalAlignment="Center" /></Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>
            <!-- 재생기 — 보이지 않는다. 통화/PTT 패널의 재생 버튼·턴 막대가 VM 이벤트로 이 요소를 튼다 -->
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Width="0" Height="0" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed" />

            <!-- 좌 — 통화 표 -->
            <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Sub}" Margin="0" Visibility="{Binding IsCall, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <!-- 녹취 띠 — 통화는 상세가 따로 없어 한 줄이 전부다. 행을 고르면 표 아래에 녹취 상태(없으면 "녹취 없음")·있으면 세그먼트와 재생 -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="10,6"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding SelectedHasRecording, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource Btn.Xs}" Content="다시 변환" ToolTip="변환 실패 표식을 지우고 다시 변환 요청" Command="{Binding RetryTranscodeCommand}" IsEnabled="{Binding CanPlay}" Margin="0,0,4,0" />
                                <Button Style="{StaticResource Btn.Xs}" Content="정지" Command="{Binding StopCommand}" IsEnabled="{Binding IsPlaying}" Margin="0,0,4,0" />
                                <Button Style="{StaticResource Btn.Xs.Pri}" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon.Filled}" Data="{StaticResource Icon.Play}" Width="10" Height="10" Margin="0,0,4,0" /><TextBlock Text="재생" /></StackPanel></Button>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionHeader}" Text="녹취" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Muted}" Text="{Binding Selected.Parties}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Hint}" Text="{Binding RecordingStatus}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding PlayingLabel}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding PlayingLabel, Converter={StaticResource StrToVis}}" />
                            <ListBox Style="{StaticResource SelectList}" ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}" MouseDoubleClick="Segments_DoubleClick"
                                     VerticalAlignment="Center" Visibility="{Binding HasRecording, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:RecordingSegment}">
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,0" ToolTip="{Binding Status}">
                                            <TextBlock FontSize="12">
                                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="Medium" /><Run Text=" " /><Run Text="{Binding Start, Mode=OneWay, StringFormat=HH:mm:ss}" Foreground="{DynamicResource Brush.Muted}" /><Run Text=" " /><Run Text="{Binding DurationText, Mode=OneWay}" Foreground="{DynamicResource Brush.Muted}" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Style="{StaticResource LogHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Hint}" Text="유형" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Text="발신 → 착신" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Text="상태" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Hint}" Text="시작" />
                            <TextBlock Grid.Column="4" Style="{StaticResource Hint}" Text="응답" />
                            <TextBlock Grid.Column="5" Style="{StaticResource Hint}" Text="종료" />
                            <TextBlock Grid.Column="6" Style="{StaticResource Hint}" Text="통화시간" HorizontalAlignment="Right" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="7" Style="{StaticResource Hint}" Text="종료사유" />
                            <TextBlock Grid.Column="8" Style="{StaticResource Hint}" Text="녹취" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Text="조건에 맞는 통화가 없습니다" Margin="12" Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVis}}" />
                    <ListBox Style="{StaticResource SelectList}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource CallRowTpl}" />
                </DockPanel>
            </Border>

            <!-- 좌 — PTT 세션 카드 -->
            <Border Grid.Column="0" Style="{StaticResource Sub}" Margin="0,0,4,0" Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource LogHeader}">
                        <TextBlock Style="{StaticResource Hint}" Text="세션 — 최근이 위 · 선택하면 오른쪽에 참여자·발언·이벤트" />
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Text="조건에 맞는 세션이 없습니다" Margin="12" Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVis}}" />
                    <ListBox Style="{StaticResource SelectList}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource PttCardTpl}" />
                </DockPanel>
            </Border>

            <!-- 우 — PTT: 선택 세션 패널 (콘솔 SessionPane: 머리 → 지표 → 참여자 → 발언 타임라인 → 이벤트 타임라인 → 녹취) -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="4,0,0,0" Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="왼쪽에서 세션을 고르면 참여자·발언·이벤트가 여기 나옵니다" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource NotToVis}}" />
                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" DataContext="{Binding}">
                        <!-- 머리 — 세션 정체성 + 동작 -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource SubHeader}" Padding="12,8">
                            <DockPanel DataContext="{Binding Selected}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Btn.Xs}" ToolTip="재생 가능한 세그먼트를 순서대로 재생"
                                            Command="{Binding DataContext.PlayAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            IsEnabled="{Binding DataContext.HasRecording, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon.Filled}" Data="{StaticResource Icon.Play}" Width="10" Height="10" Margin="0,0,4,0" /><TextBlock Text="전체" /></StackPanel></Button>
                                    <Button Style="{StaticResource Btn.Xs}" Content="정지" Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            IsEnabled="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Badge.Member}" Padding="6,1"><TextBlock Text="{Binding SessionKindText}" FontSize="10" /></Border>
                                    <Border Style="{StaticResource Badge.Held}" Padding="6,1" Visibility="{Binding IsDuplex, Converter={StaticResource BoolToVis}}"><TextBlock Text="전이중 · 통화" FontSize="10" /></Border>
                                    <Border Style="{StaticResource Badge.Talk}" Padding="6,1" Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"><TextBlock Text="진행중" FontSize="10" /></Border>
                                    <Border Style="{StaticResource Badge}" Padding="6,1" Visibility="{Binding IsLive, Converter={StaticResource NotToVis}}"><TextBlock Text="종료" FontSize="10" /></Border>
                                    <TextBlock Text="{Binding TargetText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" Margin="0,0,6,0" />
                                    <Border Style="{StaticResource Badge}" Padding="6,1" ToolTip="세션 당시 동시 발언 정책 (TS 24.380)" Visibility="{Binding HasFloorPolicy, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding FloorPolicyText}" FontSize="9" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- 지표 -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource SubHeader}" Padding="12,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="{Binding DetailStatus}" VerticalAlignment="Center" Visibility="{Binding DetailStatus, Converter={StaticResource StrToVis}}" />
                                <ItemsControl ItemsSource="{Binding Metrics}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MetricItem}">
                                            <StackPanel Margin="0,0,18,0" ToolTip="{Binding Hint}">
                                                <TextBlock Style="{StaticResource Hint}" Text="{Binding Key}" FontSize="10" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Mono}" FontSize="15" FontWeight="Bold">
                                                    <Run Text="{Binding Value, Mode=OneWay}" /><Run Text="{Binding Suffix, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.Muted}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                        <!-- 녹취(아래 고정) -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,8">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource Btn.Xs}" Content="다시 변환" ToolTip="변환 실패 표식을 지우고 다시 변환 요청" Command="{Binding RetryTranscodeCommand}" IsEnabled="{Binding CanPlay}" Margin="0,0,4,0" />
                                        <Button Style="{StaticResource Btn.Xs.Pri}" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon.Filled}" Data="{StaticResource Icon.Play}" Width="10" Height="10" Margin="0,0,4,0" /><TextBlock Text="세그먼트 재생" /></StackPanel></Button>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="녹취" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding RecordingStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding PlayingLabel}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding PlayingLabel, Converter={StaticResource StrToVis}}" />
                                <ListBox Style="{StaticResource SelectList}" ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}" MouseDoubleClick="Segments_DoubleClick"
                                         MaxHeight="96" Margin="0,4,0,0" Visibility="{Binding HasRecording, Converter={StaticResource BoolToVis}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type m:RecordingSegment}">
                                            <Border Style="{StaticResource LogRow}" Padding="6,2">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding DurationText}" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="Medium" /><Run Text=" · " Foreground="{DynamicResource Brush.Muted}" /><Run Text="{Binding Start, Mode=OneWay, StringFormat=HH:mm:ss}" Foreground="{DynamicResource Brush.Muted}" /><Run Text=" · " Foreground="{DynamicResource Brush.Muted}" /><Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource Brush.Muted}" />
                                                    </TextBlock>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <!-- 본문 3구획 — 참여자 / 발언 타임라인 / 이벤트 타임라인 -->
                        <Grid Margin="12,8,12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MaxHeight="190" />
                                <RowDefinition Height="Auto" MaxHeight="260" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- ① 참여자 -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <Run Text="참여자" FontWeight="SemiBold" FontSize="13" /><Run Text="  " /><Run Text="{Binding Participants.Count, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" /><Run Text="명" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Text="참여자 기록이 없습니다" Visibility="{Binding HasParticipants, Converter={StaticResource NotToVis}}" />
                                <Border Style="{StaticResource Sub}" Visibility="{Binding HasParticipants, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Participants}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ParticipantRow}">
                                                    <Border Style="{StaticResource LogRow}" Padding="8,3">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center">
                                                                <Run Text="턴 " /><Run Text="{Binding Turns, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" /><Run Text=" · 발화 " /><Run Text="{Binding SpeechText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                                                            </TextBlock>
                                                            <Rectangle DockPanel.Dock="Left" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding HasSpoken, Converter={StaticResource BoolToVis}}" />
                                                            <Rectangle DockPanel.Dock="Left" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.Surface2}" Stroke="{DynamicResource Brush.Border}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding HasSpoken, Converter={StaticResource NotToVis}}" />
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                                            <Border Style="{StaticResource Badge}" Padding="5,0" Margin="6,0,0,0" Visibility="{Binding IsInitiator, Converter={StaticResource BoolToVis}}"><TextBlock Text="개시자" FontSize="9" /></Border>
                                                            <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding RangeText}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                            <!-- ② 발언 타임라인 — 화자 레인 · 막대 클릭 = 그 턴 재생. 확대: [−][+][1:1] · Ctrl+휠(커서 기준) · 빈 곳 드래그 = 가로 이동(콘솔 LaneTimebar) -->
                            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasLanes, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource MonoMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Run Text="{Binding AxisStartText, Mode=OneWay}" /><Run Text=" ~ " /><Run Text="{Binding AxisEndText, Mode=OneWay}" />
                                        </TextBlock>
                                        <Button Style="{StaticResource Btn.Xs}" Content="−" Width="24" ToolTip="축소 (Ctrl+휠)" Command="{Binding TalkZoomOutCommand}" />
                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding TalkZoomText}" FontSize="11" Width="38" TextAlignment="Center" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource Btn.Xs}" Content="+" Width="24" ToolTip="확대 (Ctrl+휠)" Command="{Binding TalkZoomInCommand}" />
                                        <Button Style="{StaticResource Btn.Xs}" Content="1:1" ToolTip="세션 전체 보기" Command="{Binding TalkZoomResetCommand}" Margin="4,0,0,0"
                                                Visibility="{Binding IsTalkZoomed, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock>
                                        <Run Text="발언 타임라인" FontWeight="SemiBold" FontSize="13" /><Run Text="  화자 레인 · 막대 클릭 = 재생 · Ctrl+휠 확대 · 드래그 이동" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="발언 녹취가 없습니다" Visibility="{Binding HasLanes, Converter={StaticResource NotToVis}}" />
                                <!-- 좌 화자 라벨(고정) | 우 트랙(가로 스크롤, 폭 = 뷰포트 × 배율). 행 높이 24 로 두 열을 맞춘다 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasLanes, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,18,0,0">
                                            <ItemsControl ItemsSource="{Binding Lanes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SpeakerLane}">
                                                        <StackPanel Orientation="Horizontal" Height="24">
                                                            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="150" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <ScrollViewer x:Name="LaneScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                      PreviewMouseWheel="LaneScroll_PreviewMouseWheel" PreviewMouseLeftButtonDown="LaneScroll_MouseDown"
                                                      PreviewMouseMove="LaneScroll_MouseMove" PreviewMouseLeftButtonUp="LaneScroll_MouseUp" Background="Transparent">
                                            <StackPanel x:Name="LaneTracks">
                                                <StackPanel.Width>
                                                    <MultiBinding Converter="{StaticResource ScaleLen}">
                                                        <Binding Path="TalkZoom" />
                                                        <Binding Path="ViewportWidth" ElementName="LaneScroll" />
                                                    </MultiBinding>
                                                </StackPanel.Width>
                                                <!-- 눈금 행 -->
                                                <ItemsControl ItemsSource="{Binding AxisTicks}" Height="18" ClipToBounds="True">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Top" Value="0" />
                                                            <Setter Property="Canvas.Left">
                                                                <Setter.Value>
                                                                    <MultiBinding Converter="{StaticResource RatioLen}">
                                                                        <Binding Path="Ratio" />
                                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                    </MultiBinding>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:AxisTick}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Rectangle Width="1" Height="18" Fill="{DynamicResource Brush.Border}" />
                                                                <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource Brush.Muted}" Margin="2,0,0,0" VerticalAlignment="Top" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Lanes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:SpeakerLane}">
                                                            <Border Height="24" Background="{DynamicResource Brush.BgSoft}" CornerRadius="3" Margin="0,0,0,0" BorderBrush="{DynamicResource Brush.Surface}" BorderThickness="0,1,0,1">
                                                                <ItemsControl ItemsSource="{Binding Bars}">
                                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas ClipToBounds="True" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="ContentPresenter">
                                                                            <Setter Property="Canvas.Top" Value="3" />
                                                                            <Setter Property="Canvas.Left">
                                                                                <Setter.Value>
                                                                                    <MultiBinding Converter="{StaticResource RatioLen}">
                                                                                        <Binding Path="LeftRatio" />
                                                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                                    </MultiBinding>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </ItemsControl.ItemContainerStyle>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type vm:TurnBar}">
                                                                            <Border Height="16" MinWidth="3" CornerRadius="2" Background="{Binding Color}" ToolTip="{Binding Tooltip}" Cursor="Hand" Tag="turn">
                                                                                <Border.Width>
                                                                                    <MultiBinding Converter="{StaticResource RatioLen}">
                                                                                        <Binding Path="WidthRatio" />
                                                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                                    </MultiBinding>
                                                                                </Border.Width>
                                                                                <Border.InputBindings>
                                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PlayTurnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                                </Border.InputBindings>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </ScrollViewer>
                            </DockPanel>
                            <!-- ③ 이벤트 타임라인 — 발언권 중재 + 입퇴장 -->
                            <DockPanel Grid.Row="2">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding ShowFloorLayer}" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock FontSize="11"><Run Text="발언권 " /><Run Text="{Binding FloorCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding ShowMemberLayer}" VerticalAlignment="Center">
                                            <TextBlock FontSize="11"><Run Text="멤버 " /><Run Text="{Binding MemberEventCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                        </CheckBox>
                                    </StackPanel>
                                    <TextBlock>
                                        <Run Text="이벤트 타임라인" FontWeight="SemiBold" FontSize="13" /><Run Text="  발언권 중재 · 입퇴장" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="표시할 항목이 없습니다" Visibility="{Binding HasTimeline, Converter={StaticResource NotToVis}}" />
                                <Border Style="{StaticResource Sub}" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}">
                                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Timeline}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TimelineItem}">
                                                <Border Style="{StaticResource LogRow}" Padding="8,3">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource MonoMuted}" Text="{Binding TimeText}" FontSize="11" Width="64" VerticalAlignment="Center" />
                                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Who, Mode=OneWay}" FontWeight="Medium" /><Run Text=" " /><Run Text="{Binding Text, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource Brush.Muted}" FontSize="11" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
