<UserControl x:Class="DispatchDesktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:m="clr-namespace:DispatchDesktop.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SessionHistoryViewModel}">
    <!-- [이력] 화면 본문(§4.6) — 콘솔 VoLTE/PTT 이력과 같은 구성: 도구줄 · 시간대 밴드(그날의 분포 = 필터) · 통화 = 전체 폭 표(한 줄이 곧 상세, 녹취는 아래 띠) ·
         PTT = 좌 세션 카드 + 우 선택 세션 패널(지표 → 참여자 → 발언 타임라인 → 이벤트 타임라인 → 녹취, 1 : 3 드래그 조절). 진행 중·오늘은 관제 ②④ 가 정본 -->
    <UserControl.Resources>
        <!-- 시간대 밴드 한 칸 — 연한 남색 농도(글자가 늘 읽히는 범위) · 고른 칸 = 관제 카드 선택과 같은 남색 테두리 -->
        <DataTemplate x:Key="HourCellTpl" DataType="{x:Type vm:HourCell}">
            <Grid x:Name="Cell" Height="34" Margin="1.5,0" ToolTip="{Binding Tip}" Cursor="Hand" Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectHourCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Hour}" />
                </Grid.InputBindings>
                <Border CornerRadius="6" Background="{DynamicResource Brush.BgSoft}" />
                <Border CornerRadius="6" Background="{DynamicResource Brush.Primary}" Opacity="{Binding Ratio}" />
                <Border x:Name="Edge" CornerRadius="6" BorderBrush="Transparent" BorderThickness="2.5" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CountText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" Height="15" />
                    <TextBlock x:Name="H" Text="{Binding Hour}" FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" /><Setter TargetName="H" Property="Foreground" Value="{DynamicResource Brush.PrimaryInk}" /></DataTrigger>
                <DataTrigger Binding="{Binding Count}" Value="0"><Setter TargetName="Cell" Property="Cursor" Value="Arrow" /><Setter TargetName="H" Property="Foreground" Value="{DynamicResource Brush.Faint}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- 통화 결과 태그 — 응답(회색) · 통화 중/호출 중(초록) · 부재/실패/취소(주황) · 거절/오류(빨강): 관제 상태색 -->
        <Style x:Key="ResultTag" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultTone}" Value="talk">
                    <Setter Property="Background" Value="{DynamicResource Brush.TalkSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.TalkEdge}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TalkInk}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultTone}" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource Brush.RingSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.RingEdge}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.RingInk}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultTone}" Value="bad">
                    <Setter Property="Background" Value="{DynamicResource Brush.EmgSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.EmgEdge}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.EmgInk}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 통화 카드 — 무전 카드와 같은 모양(두 줄): 1줄 결과 · 발신 → 착신 · 영상/긴급/녹취 · 시각 · 2줄 통화 시간·울림 또는 끝난 이유 -->
        <DataTemplate x:Key="CallCardTpl" DataType="{x:Type vm:HistoryRow}">
            <Border x:Name="Card" Margin="8,3,8,3" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.Surface}"
                    Padding="12,7,10,7" Cursor="Hand">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoMuted}" Text="{Binding StartClock}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Border Style="{StaticResource Tag.Held}" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"><TextBlock Text="영상" /></Border>
                            <Border Style="{StaticResource Tag.Emg}" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}"><TextBlock Text="긴급" /></Border>
                            <Border Style="{StaticResource Tag.Mon}" Visibility="{Binding HasRecording, Converter={StaticResource BoolToVis}}" ToolTip="녹취 있음"><TextBlock Text="녹취" /></Border>
                        </StackPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource ResultTag}" Margin="0,0,8,0"><TextBlock Text="{Binding ResultText}" /></Border>
                        <TextBlock x:Name="Name" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                            <Run Text="{Binding CallerLabel, Mode=OneWay}" /><Run Text=" → " Foreground="{DynamicResource Brush.Faint}" FontWeight="Normal" /><Run Text="{Binding CalleeLabel, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding CallSub}" Style="{StaticResource Muted}" FontSize="12.5" Margin="2,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Hover}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsEmergency}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Emg}" /><Setter TargetName="Card" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.EmgSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" /><Setter TargetName="Card" Property="BorderThickness" Value="2.5" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- 녹취 재생 바(§4.6) — 통화·무전 공용, DataContext = 화면 VM. 막대 = 녹취 전체(무전은 세션 시간축), 누른 곳부터 재생 · 마우스를 올리면 그 지점 시각.
             무전은 막대 위에 누가 언제 말했는지 색 막대(겹치면 두 줄) + 이전/다음 발언 · 말 없는 구간 건너뛰기 -->
        <DataTemplate x:Key="PlayerTpl" DataType="{x:Type vm:SessionHistoryViewModel}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasPlayer, Converter={StaticResource BoolToVis}}">
                        <CheckBox IsChecked="{Binding SkipGaps}" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}"
                                  ToolTip="켜면 발언 사이의 말 없는 시간을 건너뛰고 다음 발언으로 바로 넘어갑니다"><TextBlock Text="말 없는 구간 건너뛰기" FontSize="12" /></CheckBox>
                        <Border Style="{StaticResource SegGroup}" Margin="0,0,8,0" ToolTip="재생 속도">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Seg}" Content="1×" IsChecked="{Binding SpeedIndex, Converter={StaticResource Eq}, ConverterParameter=0}" />
                                <RadioButton Style="{StaticResource Seg}" Content="1.5×" IsChecked="{Binding SpeedIndex, Converter={StaticResource Eq}, ConverterParameter=1}" />
                                <RadioButton Style="{StaticResource Seg}" Content="2×" IsChecked="{Binding SpeedIndex, Converter={StaticResource Eq}, ConverterParameter=2}" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource Btn.Xs}" Content="다시 변환" ToolTip="변환 실패 표식을 지우고 다시 변환 요청" Command="{Binding RetryTranscodeCommand}" IsEnabled="{Binding CanPlay}" />
                    </StackPanel>
                    <TextBlock Text="녹취" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding RecordingStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <StackPanel Visibility="{Binding HasPlayer, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <!-- 통화 막대 -->
                    <Grid Height="24" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Bar_MouseDown" MouseMove="Bar_MouseMove" MouseLeave="Bar_MouseLeave"
                          Visibility="{Binding IsCall, Converter={StaticResource BoolToVis}}">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.MeterTrack}" VerticalAlignment="Center" />
                        <Canvas ClipToBounds="False">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Primary}" Canvas.Top="10">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource RatioLen}"><Binding Path="HeadRatio" /><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" /></MultiBinding>
                                </Border.Width>
                            </Border>
                            <Ellipse Width="16" Height="16" Fill="{DynamicResource Brush.Surface}" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="3" Canvas.Top="4">
                                <Canvas.Left>
                                    <MultiBinding Converter="{StaticResource RatioLen}"><Binding Path="HeadRatio" /><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" /></MultiBinding>
                                </Canvas.Left>
                                <Ellipse.RenderTransform><TranslateTransform X="-8" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Border Canvas.Top="-26" CornerRadius="5" Background="{DynamicResource Brush.Ink}" Padding="8,3" IsHitTestVisible="False" Visibility="{Binding HasHover, Converter={StaticResource BoolToVis}}">
                                <Canvas.Left>
                                    <MultiBinding Converter="{StaticResource RatioLen}"><Binding Path="HoverRatio" /><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" /></MultiBinding>
                                </Canvas.Left>
                                <Border.RenderTransform><TranslateTransform X="-50" /></Border.RenderTransform>
                                <TextBlock Text="{Binding HoverText}" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Brush.Surface}" />
                            </Border>
                        </Canvas>
                    </Grid>
                    <!-- 무전 막대 — 발언 막대 + 재생 헤드 -->
                    <Border Height="46" CornerRadius="6" Background="{DynamicResource Brush.BgSoft}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                            Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}">
                        <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Bar_MouseDown" MouseMove="Bar_MouseMove" MouseLeave="Bar_MouseLeave">
                            <ItemsControl ItemsSource="{Binding PlayerBlocks}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Top" Value="5" />
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource RatioLen}"><Binding Path="LeftRatio" /><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" /></MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers><DataTrigger Binding="{Binding Row}" Value="1"><Setter Property="Canvas.Top" Value="24" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlayerBlock}">
                                        <Border Height="15" MinWidth="3" CornerRadius="3" Background="{Binding Color}" Opacity="0.8">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource RatioLen}"><Binding Path="WidthRatio" /><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" /></MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Canvas ClipToBounds="False" IsHitTestVisible="False">
                                <Rectangle Width="2" Height="52" Canvas.Top="-4" Fill="{DynamicResource Brush.Ink}">
                                    <Canvas.Left>
                                        <MultiBinding Converter="{StaticResource RatioLen}"><Binding Path="HeadRatio" /><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" /></MultiBinding>
                                    </Canvas.Left>
                                    <Rectangle.RenderTransform><TranslateTransform X="-1" /></Rectangle.RenderTransform>
                                </Rectangle>
                                <Border Canvas.Top="-30" CornerRadius="5" Background="{DynamicResource Brush.Ink}" Padding="8,3" Visibility="{Binding HasHover, Converter={StaticResource BoolToVis}}">
                                    <Canvas.Left>
                                        <MultiBinding Converter="{StaticResource RatioLen}"><Binding Path="HoverRatio" /><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" /></MultiBinding>
                                    </Canvas.Left>
                                    <Border.RenderTransform><TranslateTransform X="-60" /></Border.RenderTransform>
                                    <TextBlock Text="{Binding HoverText}" FontSize="11.5" Foreground="{DynamicResource Brush.Surface}" />
                                </Border>
                            </Canvas>
                        </Grid>
                    </Border>
                    <DockPanel Margin="0,3,0,0" Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoMuted}" Text="{Binding AxisEndText}" FontSize="11.5" />
                        <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding AxisStartText}" FontSize="11.5" />
                    </DockPanel>
                    <!-- 조작 줄 -->
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoMuted}" FontSize="12" VerticalAlignment="Center" Visibility="{Binding IsCall, Converter={StaticResource BoolToVis}}">
                            <Run Text="실제 시각 " FontFamily="{StaticResource Font.Ui}" /><Run Text="{Binding HeadWallText, Mode=OneWay}" />
                        </TextBlock>
                        <Border x:Name="Now" DockPanel.Dock="Right" CornerRadius="6" Padding="10,4" Background="{DynamicResource Brush.Surface2}" VerticalAlignment="Center"
                                Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="NowText" Text="{Binding NowSpeakerText}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Sm}" Content="−10초" Command="{Binding Back10Command}" Margin="0,0,6,0" Visibility="{Binding IsCall, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Btn.Sm}" Content="이전 발언" Command="{Binding PrevTurnCommand}" Margin="0,0,6,0" Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Btn.Sm.Pri}" Command="{Binding TogglePlayCommand}" MinWidth="96" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="PlayIcon" Style="{StaticResource Icon.Filled}" Data="{StaticResource Icon.Play}" Width="11" Height="11" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding PlayLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Sm}" Content="+10초" Command="{Binding Fwd10Command}" Margin="0,0,10,0" Visibility="{Binding IsCall, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Btn.Sm}" Content="다음 발언" Command="{Binding NextTurnCommand}" Margin="0,0,10,0" Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center">
                                <Run Text="{Binding HeadPosText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" / " Foreground="{DynamicResource Brush.Faint}" /><Run Text="{Binding BarLenText, Mode=OneWay}" Foreground="{DynamicResource Brush.Faint}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource MonoMuted}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding HeadWallText}" Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Playing}" Value="True"><Setter TargetName="PlayIcon" Property="Data" Value="{StaticResource Icon.Pause}" /></DataTrigger>
                <DataTrigger Binding="{Binding NowSpeaking}" Value="True">
                    <Setter TargetName="Now" Property="Background" Value="{DynamicResource Brush.TalkSoft}" /><Setter TargetName="NowText" Property="Foreground" Value="{DynamicResource Brush.TalkInk}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- 무전 세션 카드 — 관제 채널 카드(§4 공통)와 같은 모양: 1줄 상태 점 · 이름 · 라벨(영상/개별/애드혹/전이중/진행 중/긴급) · 시각 · 2줄 개시·참여 · 3줄 길이·발언(영상 세션은 송출).
             고른 카드 = 남색 테두리 2.5 + 연한 남색 면, 긴급 = 빨강 테두리 2 + 연한 빨강 면 -->
        <DataTemplate x:Key="PttCardTpl" DataType="{x:Type vm:HistoryRow}">
            <Grid x:Name="Root" Margin="8,3,8,3">
            <!-- 빈 세션 묶음 머리 — 뒤에 겹친 카드 두 장(묶였다는 표시) -->
            <Border Margin="10,0,10,-8" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Surface}"
                    Visibility="{Binding IsBundle, Converter={StaticResource BoolToVis}}" />
            <Border Margin="5,0,5,-4" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.Surface}"
                    Visibility="{Binding IsBundle, Converter={StaticResource BoolToVis}}" />
            <!-- 펼친 묶음 안의 한 줄 — 시각 범위·길이 / 발언 0회 -->
            <Border x:Name="Member" Margin="18,0,0,0" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Surface2}"
                    Padding="10,4,10,4" Cursor="Hand" Visibility="{Binding IsBundleMember, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding MemberStat}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding RangeText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <Border x:Name="Card" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.Surface}"
                    Padding="12,7,10,7" Cursor="Hand" ToolTip="{Binding RangeText}" Visibility="{Binding IsCard, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel>
                        <!-- 이름이 길면 이름만 줄인다 — 라벨·시각은 오른쪽에 붙어 잘리지 않는다 -->
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoMuted}" Text="{Binding ClockText}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Border Style="{StaticResource Tag}" Visibility="{Binding IsBundle, Converter={StaticResource BoolToVis}}" ToolTip="같은 그룹·같은 개시자가 연달아 연 빈 세션(발언 없이 끝난 세션)"><TextBlock Text="{Binding BundleTagText}" /></Border>
                            <Border Style="{StaticResource Tag.Teal}" Visibility="{Binding IsMcVideo, Converter={StaticResource BoolToVis}}" ToolTip="MCVideo 그룹 영상 호 — 같은 그룹의 영상 세션"><TextBlock Text="영상" /></Border>
                            <Border Style="{StaticResource Tag}" Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVis}}"><TextBlock Text="개별" /></Border>
                            <Border Style="{StaticResource Tag}" Visibility="{Binding IsAdhoc, Converter={StaticResource BoolToVis}}"><TextBlock Text="애드혹" /></Border>
                            <Border Style="{StaticResource Tag.Held}" Visibility="{Binding IsDuplex, Converter={StaticResource BoolToVis}}"><TextBlock Text="전이중" /></Border>
                            <Border Style="{StaticResource Tag.Talk}" Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"><TextBlock Text="진행 중" /></Border>
                            <Border Style="{StaticResource Tag.Emg}" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}"><TextBlock Text="긴급" /></Border>
                            <Border Style="{StaticResource Tag.Mon}" Visibility="{Binding HasRecording, Converter={StaticResource BoolToVis}}" ToolTip="녹취 있음"><TextBlock Text="녹취" /></Border>
                        </StackPanel>
                        <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="9" Height="9" Fill="{DynamicResource Brush.Muted}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="Name" Text="{Binding TargetText}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding WhoLine}" FontSize="12.5" Margin="16,2,0,0" Foreground="{DynamicResource Brush.TextSoft}" TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="16,1,0,0">
                        <!-- 묶음 머리만 — 그 묶음을 펼친다/접는다 -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Xs}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                Command="{Binding DataContext.ToggleBundleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding IsBundle, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding BundleToggleText}" VerticalAlignment="Center" />
                                <Path x:Name="Chev" Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronDown}" Width="11" Height="11" Margin="4,0,0,0" RenderTransformOrigin="0.5,0.5" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding StatLine}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Talk}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Hover}" /><Setter TargetName="Member" Property="Background" Value="{DynamicResource Brush.Hover}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBundle}" Value="True"><Setter TargetName="Root" Property="Margin" Value="8,3,8,11" /></DataTrigger>
                <DataTrigger Binding="{Binding IsBundleMember}" Value="True"><Setter TargetName="Root" Property="Margin" Value="8,1,8,1" /></DataTrigger>
                <DataTrigger Binding="{Binding BundleExpanded}" Value="True"><Setter TargetName="Chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter></DataTrigger>
                <DataTrigger Binding="{Binding IsEmergency}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Emg}" /><Setter TargetName="Card" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.EmgSoft}" /><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Emg}" />
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Brush.EmgInk}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" /><Setter TargetName="Card" Property="BorderThickness" Value="2.5" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                    <Setter TargetName="Member" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" /><Setter TargetName="Member" Property="BorderThickness" Value="1.5" />
                    <Setter TargetName="Member" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- 카드 목록의 항목 그릇 — 선택·호버는 카드가 그린다(목록 줄의 왼쪽 막대·면 없음) -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 카드 목록 = 시간대(밴드와 같은 축)로 묶는다 — 머리 "03시 · 60건" (통화·무전 공용). 건수는 행 수가 아니라 세션 수(빈 세션 묶음은 묶은 수) -->
        <vm:HourGroupCountConverter x:Key="HourCount" />
        <GroupStyle x:Key="HourGroup">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <DockPanel Margin="12,8,14,3">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12">
                            <TextBlock.Text><MultiBinding Converter="{StaticResource HourCount}"><Binding Path="Items" /><Binding Path="ItemCount" /></MultiBinding></TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSoft}" />
                    </DockPanel>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
        <CollectionViewSource x:Key="RowsByHour" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="HourKey" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <DockPanel Margin="10">
        <!-- 도구줄 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Sm}" Command="{Binding QueryCommand}" ToolTip="이 날짜를 다시 조회 — 날짜·종류를 바꾸면 저절로 조회합니다" Padding="7,0"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.RotateCw}" /></Button>
            <!-- 관제 탭 줄과 같은 [무전|통화] — 같은 순서·같은 모양(남색 외곽선 안, 고른 칸 = 남색 채움) -->
            <Border Height="36" CornerRadius="9" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Fill}" Padding="2" Margin="0,0,12,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource ModeSeg}" Content="무전" ToolTip="지난 무전 세션" IsChecked="{Binding KindIndex, Converter={StaticResource Eq}, ConverterParameter=1}" />
                    <RadioButton Style="{StaticResource ModeSeg}" Content="통화" ToolTip="지난 통화" IsChecked="{Binding KindIndex, Converter={StaticResource Eq}, ConverterParameter=0}" />
                </StackPanel>
            </Border>
            <Button Style="{StaticResource Btn.Sm}" Command="{Binding ShiftDateCommand}" CommandParameter="-1" ToolTip="전날" Margin="0,0,4,0" Padding="7,0"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronLeft}" /></Button>
            <DatePicker SelectedDate="{Binding Date}" Width="140" VerticalAlignment="Center" />
            <Button Style="{StaticResource Btn.Sm}" Command="{Binding ShiftDateCommand}" CommandParameter="1" ToolTip="다음 날" Margin="4,0,4,0" Padding="7,0"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronRight}" /></Button>
            <Button Style="{StaticResource Btn.Sm}" Content="오늘" Command="{Binding ShiftDateCommand}" CommandParameter="0" Margin="0,0,8,0" />
            <TextBox Style="{StaticResource Field}" Width="220" Height="26" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="이름 · 번호 · 그룹" Margin="0,0,8,0" />
            <!-- 무전만 — 서비스 거르기 [전체|무전|영상]: 음성 무전(MCPTT) 세션과 영상(MCVideo) 세션. 서버가 서비스 축을 실어 줄 때만 보인다 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding HasServiceAxis, Converter={StaticResource BoolToVis}}">
                <RadioButton Style="{StaticResource FilterChip}" Content="전체" IsChecked="{Binding ServiceFilter, Converter={StaticResource Eq}, ConverterParameter=all, Mode=OneWay}" Command="{Binding SetServiceFilterCommand}" CommandParameter="all" />
                <RadioButton Style="{StaticResource FilterChip}" Content="무전" IsChecked="{Binding ServiceFilter, Converter={StaticResource Eq}, ConverterParameter=ptt, Mode=OneWay}" Command="{Binding SetServiceFilterCommand}" CommandParameter="ptt"
                             ToolTip="음성 무전(MCPTT) 세션만" />
                <RadioButton Style="{StaticResource FilterChip}" Content="영상" IsChecked="{Binding ServiceFilter, Converter={StaticResource Eq}, ConverterParameter=mcvideo, Mode=OneWay}" Command="{Binding SetServiceFilterCommand}" CommandParameter="mcvideo"
                             ToolTip="영상(MCVideo) 세션만" />
            </StackPanel>
            <!-- 무전만 — 빈 세션 묶기(기본 켬): 목록에서 연달아 나오는 같은 그룹·같은 개시자의 빈 세션(발언 없이 끝난 세션)을 한 장으로 -->
            <ToggleButton Style="{StaticResource FilterChip}" Content="빈 세션 묶기" IsChecked="{Binding GroupSilent}" Margin="0,0,8,0" VerticalAlignment="Center"
                          ToolTip="연달아 나오는 같은 그룹·같은 개시자의 빈 세션(발언 없이 끝난 세션)을 한 장으로 묶는다 · 끄면 한 장씩"
                          Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Emg}" Text="{Binding Error}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </DockPanel>

        <!-- 시간대 밴드 — 그날의 분포이자 필터(클릭 = 그 시간대만, 다시 클릭 = 해제) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Sub}" Padding="10,8" Margin="0,0,0,8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="1.5,0,1.5,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Xs}" Content="전체 시간" Margin="8,0,0,0" VerticalAlignment="Center"
                            Command="{Binding SelectHourCommand}" CommandParameter="{Binding SelectedHour}" Visibility="{Binding HasHourFilter, Converter={StaticResource BoolToVis}}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="{Binding BandHint}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionHeader}" Text="{Binding BandTitle}" Margin="0,0,10,0" />
                    <!-- 무전만 — 무엇을 셀지: 성립한 세션 수 / 발언 수(세션 시작 시간대에 넣는다). 제목 글자가 고정이라 전환 자리가 움직이지 않는다 -->
                    <Border DockPanel.Dock="Left" Style="{StaticResource SegGroup}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Seg}" Content="세션 수" ToolTip="그 시간에 시작해 성립한 무전 세션 수 · 칸을 누르면 그 시간의 세션 전부" IsChecked="{Binding BandMode, Converter={StaticResource Eq}, ConverterParameter=0}" />
                            <RadioButton Style="{StaticResource Seg}" Content="발언 수" ToolTip="그 시간에 시작한 세션들에서 말한 횟수의 합 · 칸을 누르면 그 시간의 발언 있는 세션만" IsChecked="{Binding BandMode, Converter={StaticResource Eq}, ConverterParameter=1}" />
                        </StackPanel>
                    </Border>
                    <Grid />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Hours}" ItemTemplate="{StaticResource HourCellTpl}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="24" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 좌 목록 | 경계(드래그) | 우 패널 — 열 폭은 코드비하인드가 종류에 맞춰 놓는다. 통화는 한 줄이 곧 상세라 표가 전체 폭(우 패널 없음, 녹취는 표 아래 띠),
             PTT 는 세션 패널이 주역이라 목록 1 : 패널 3(경계 드래그로 조절, 더블클릭 = 기본) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListCol" Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PaneCol" Width="380" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False"
                          ToolTip="드래그로 폭 조정 · 더블클릭으로 기본 폭" MouseDoubleClick="Splitter_DoubleClick">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent" Cursor="SizeWE"><Rectangle Width="1" Fill="{DynamicResource Brush.Border}" HorizontalAlignment="Center" /></Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>
            <!-- 영상 칸 + 재생기 — 녹취 재생 바·턴 막대가 VM 이벤트로 재생기를 열고·옮기고·멈춘다. 영상이 있는 녹취(영상 통화 · MCVideo 송출 구간)를
                 틀 때만 칸이 열리고(폭 0 ↔ 372, 왼쪽 두 칸이 그만큼 준다) 소리만 있는 녹취는 닫힌 채 소리만 난다. 재생기는 늘 트리에 둔다 -->
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"
                    Width="{Binding ShowVideo, Converter={StaticResource Pick}, ConverterParameter=372|0}"
                    Margin="{Binding ShowVideo, Converter={StaticResource Pick}, ConverterParameter='8,0,0,0|0'}"
                    BorderThickness="{Binding ShowVideo, Converter={StaticResource Pick}, ConverterParameter=1|0}">
                <DockPanel Width="370">
                    <Border DockPanel.Dock="Top" Style="{StaticResource SubHeader}" Padding="14,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Xs}" Content="정지" Command="{Binding StopCommand}" ToolTip="재생을 멈추고 영상 칸을 닫는다" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="녹취 영상" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border Style="{StaticResource Tag.Teal}" Visibility="{Binding Playing, Converter={StaticResource BoolToVis}}"><TextBlock Text="재생 중" /></Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MonoMuted}" FontSize="12" Margin="14,0,14,12"><Run Text="{Binding HeadPosText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding BarLenText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding HeadWallText, Mode=OneWay}" /></TextBlock>
                    <Border Margin="12" CornerRadius="8" Background="{DynamicResource Brush.Ink}" ClipToBounds="True">
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed" />
                    </Border>
                </DockPanel>
            </Border>

            <!-- 좌 — 통화 카드(시간대 묶음) -->
            <Border Grid.Column="0" Style="{StaticResource Sub}" Margin="0,0,4,0" Visibility="{Binding IsCall, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="이 날에 맞는 통화가 없습니다" Margin="12" Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVis}}" />
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Source={StaticResource RowsByHour}}" IsSynchronizedWithCurrentItem="False" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource CallCardTpl}"
                             ItemContainerStyle="{StaticResource CardItem}" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel" Padding="0,4">
                        <ListBox.GroupStyle><StaticResource ResourceKey="HourGroup" /></ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 우 — 통화: 고른 통화 상세 (머리 → 숫자 칸 → 당사자 → 진행 → 녹취). 영상 호도 같은 칸(종류 «영상»·태그) -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="4,0,0,0" Visibility="{Binding IsCall, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="왼쪽에서 통화를 고르면 여기 나옵니다" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource NotToVis}}" />
                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Border DockPanel.Dock="Top" Style="{StaticResource SubHeader}" Padding="16,10">
                            <DockPanel DataContext="{Binding Selected}">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoMuted}" Text="{Binding DayClock}" FontSize="12.5" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontWeight="Bold" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" Margin="0,0,10,0">
                                        <Run Text="{Binding CallerLabel, Mode=OneWay}" /><Run Text=" → " Foreground="{DynamicResource Brush.Faint}" FontWeight="Normal" /><Run Text="{Binding CalleeLabel, Mode=OneWay}" />
                                    </TextBlock>
                                    <Border Style="{StaticResource ResultTag}"><TextBlock Text="{Binding ResultText}" /></Border>
                                    <Border Style="{StaticResource Tag.Held}" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"><TextBlock Text="영상" /></Border>
                                    <Border Style="{StaticResource Tag.Emg}" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}"><TextBlock Text="긴급" /></Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- 녹취 재생 바(아래 고정) -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,10,16,12">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlayerTpl}" Focusable="False" />
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16,14,16,14" DataContext="{Binding Selected}">
                                <!-- 숫자 칸 — 울린 시간 · 통화 시간 · 끝난 이유 · 종류 -->
                                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,18">
                                    <Border Margin="0,0,8,0" Padding="14,8" CornerRadius="8" Background="{DynamicResource Brush.Surface2}" ToolTip="호출부터 응답까지 — 응답이 없으면 끊길 때까지">
                                        <StackPanel><TextBlock Style="{StaticResource Muted}" Text="울린 시간" FontSize="11.5" /><TextBlock Text="{Binding RingText}" FontSize="18" FontWeight="Bold" /></StackPanel>
                                    </Border>
                                    <Border Margin="0,0,8,0" Padding="14,8" CornerRadius="8" Background="{DynamicResource Brush.Surface2}">
                                        <StackPanel><TextBlock Style="{StaticResource Muted}" Text="통화 시간" FontSize="11.5" /><TextBlock Text="{Binding DurationText}" FontSize="18" FontWeight="Bold" /></StackPanel>
                                    </Border>
                                    <Border Margin="0,0,8,0" Padding="14,8" CornerRadius="8" Background="{DynamicResource Brush.Surface2}">
                                        <StackPanel><TextBlock Style="{StaticResource Muted}" Text="끝난 이유" FontSize="11.5" /><TextBlock Text="{Binding EndReasonText}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" /></StackPanel>
                                    </Border>
                                    <Border Padding="14,8" CornerRadius="8" Background="{DynamicResource Brush.Surface2}">
                                        <StackPanel><TextBlock Style="{StaticResource Muted}" Text="종류" FontSize="11.5" /><TextBlock Text="{Binding TypeText}" FontSize="18" FontWeight="Bold" /></StackPanel>
                                    </Border>
                                </UniformGrid>
                                <!-- 당사자 -->
                                <TextBlock Text="당사자" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="12,10" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Margin="0,0,10,0" Tag="{Binding CallerLabel, Converter={StaticResource AvatarHue}}"><TextBlock Text="{Binding CallerInitial}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Muted}" Text="발신" FontSize="11.5" />
                                                <TextBlock Text="{Binding CallerLabel}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding CallerNumber}" FontSize="12" Visibility="{Binding HasCallerNumber, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="→" FontSize="18" Foreground="{DynamicResource Brush.Faint}" VerticalAlignment="Center" Margin="12,0" />
                                    <Border Grid.Column="2" Padding="12,10" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Margin="0,0,10,0" Tag="{Binding CalleeLabel, Converter={StaticResource AvatarHue}}"><TextBlock Text="{Binding CalleeInitial}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Muted}" Text="착신" FontSize="11.5" />
                                                <TextBlock Text="{Binding CalleeLabel}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding CalleeNumber}" FontSize="12" Visibility="{Binding HasCalleeNumber, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                                <!-- 진행 — 울림(주황) : 통화(남색) 막대 + 호출·응답·종료 시각 -->
                                <TextBlock Text="진행" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                <Border CornerRadius="5" Height="10" Background="{DynamicResource Brush.Surface2}" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding RingStar}" /><ColumnDefinition Width="{Binding TalkStar}" /></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource Brush.RingEdge}" CornerRadius="5,0,0,5" ToolTip="울림" />
                                        <Border x:Name="TalkBar" Grid.Column="1" Background="{DynamicResource Brush.Primary}" CornerRadius="0,5,5,0" ToolTip="통화" />
                                    </Grid>
                                </Border>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="12.5"><Run Text="호출 " Foreground="{DynamicResource Brush.Muted}" /><Run Text="{Binding InviteText, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" /></TextBlock>
                                    <TextBlock Grid.Column="1" FontSize="12.5" HorizontalAlignment="Center"><Run Text="응답 " Foreground="{DynamicResource Brush.Muted}" /><Run Text="{Binding AnswerText, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" /></TextBlock>
                                    <TextBlock Grid.Column="2" FontSize="12.5" HorizontalAlignment="Right"><Run Text="종료 " Foreground="{DynamicResource Brush.Muted}" /><Run Text="{Binding EndText, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" /></TextBlock>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 좌 — PTT 세션 카드 -->
            <Border Grid.Column="0" Style="{StaticResource Sub}" Margin="0,0,4,0" Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="이 날에 맞는 무전이 없습니다" Margin="12" Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVis}}" />
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Source={StaticResource RowsByHour}}" IsSynchronizedWithCurrentItem="False" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource PttCardTpl}"
                             ItemContainerStyle="{StaticResource CardItem}" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel" Padding="0,4">
                        <ListBox.GroupStyle><StaticResource ResourceKey="HourGroup" /></ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 우 — PTT: 선택 세션 패널 (콘솔 SessionPane: 머리 → 지표 → 참여자 → 발언 타임라인 → 이벤트 타임라인 → 녹취) -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="4,0,0,0" Visibility="{Binding IsPtt, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="왼쪽에서 세션을 고르면 참여자·발언·이벤트가 여기 나옵니다" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource NotToVis}}" />
                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" DataContext="{Binding}">
                        <!-- 머리 — 세션 정체성 + 동작 -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource SubHeader}" Padding="12,8">
                            <DockPanel DataContext="{Binding Selected}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Btn.Xs}" ToolTip="재생 가능한 세그먼트를 순서대로 재생"
                                            Command="{Binding DataContext.PlayAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            IsEnabled="{Binding DataContext.HasPlayer, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon.Filled}" Data="{StaticResource Icon.Play}" Width="10" Height="10" Margin="0,0,4,0" /><TextBlock Text="처음부터" /></StackPanel></Button>
                                    <Button Style="{StaticResource Btn.Xs}" Content="정지" Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            IsEnabled="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TargetText}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" Margin="0,0,8,0" />
                                    <Border Style="{StaticResource Tag}"><TextBlock Text="{Binding SessionKindText}" /></Border>
                                    <Border Style="{StaticResource Tag.Teal}" ToolTip="MCVideo 그룹 영상 호 — 세그먼트 = 송출 구간(재생하면 오른쪽에 영상 칸)"
                                            Visibility="{Binding DataContext.IsVideoSession, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"><TextBlock Text="영상" /></Border>
                                    <Border Style="{StaticResource Tag}" ToolTip="세션 당시 MCVideo 호 방식 · 동시 송출 상한" Visibility="{Binding HasMcvText, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding McvText}" FontWeight="Normal" /></Border>
                                    <Border Style="{StaticResource Tag.Held}" Visibility="{Binding IsDuplex, Converter={StaticResource BoolToVis}}"><TextBlock Text="전이중" /></Border>
                                    <Border Style="{StaticResource Tag.Talk}" Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"><TextBlock Text="진행 중" /></Border>
                                    <Border Style="{StaticResource Tag.Emg}" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}"><TextBlock Text="긴급" /></Border>
                                    <Border Style="{StaticResource Tag}" ToolTip="세션 당시 동시 발언 정책 (TS 24.380)" Visibility="{Binding HasFloorPolicy, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding FloorPolicyText}" FontWeight="Normal" /></Border>
                                    <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding RangeText}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- 지표 -->
                        <Border DockPanel.Dock="Top" Padding="12,10,12,2">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="{Binding DetailStatus}" VerticalAlignment="Center" Visibility="{Binding DetailStatus, Converter={StaticResource StrToVis}}" />
                                <ItemsControl ItemsSource="{Binding Metrics}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MetricItem}">
                                            <Border MinWidth="112" Margin="0,0,8,8" Padding="12,6" CornerRadius="8" Background="{DynamicResource Brush.Surface2}" ToolTip="{Binding Hint}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Key}" FontSize="11.5" />
                                                    <TextBlock FontSize="18" FontWeight="Bold">
                                                        <Run Text="{Binding Value, Mode=OneWay}" /><Run Text="{Binding Suffix, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource Brush.Muted}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                        <!-- 녹취 재생 바(아래 고정) -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,10,12,12">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlayerTpl}" Focusable="False" />
                        </Border>
                        <!-- 본문 3구획 — 참여자 / 발언 타임라인 / 이벤트 타임라인. 칸이 낮으면(작은 창·배너 둘) 구획이 0 으로 눌리지 않게 최소 높이를 두고 세로로 넘긴다 -->
                        <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="DetailScroll_SizeChanged">
                        <Grid x:Name="DetailBody" Margin="12,8,12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MaxHeight="190" />
                                <RowDefinition Height="Auto" MaxHeight="260" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- ① 참여자 — 관제 화면의 이름표(아바타 색 = 이름에서). 말한 사람은 아래 발언 레인과 같은 색 점, 입장~퇴장·발언은 툴팁 -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Run Text="참여자" FontWeight="Bold" FontSize="13" /><Run Text="  " /><Run Text="{Binding Participants.Count, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Text="참여자 기록이 없습니다" Visibility="{Binding HasParticipants, Converter={StaticResource NotToVis}}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasParticipants, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding Participants}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ParticipantRow}">
                                                <Border Margin="0,0,6,6" Padding="3,3,10,3" CornerRadius="15" Background="{DynamicResource Brush.BgSoft}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ToolTip="{Binding Tip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Style="{StaticResource Avatar}" Width="24" Height="24" CornerRadius="12" Margin="0,0,7,0" Tag="{Binding Label, Converter={StaticResource AvatarHue}}">
                                                            <TextBlock Text="{Binding Initial}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                                        <Border Style="{StaticResource Tag.Ink}" Margin="6,0,0,0" Visibility="{Binding IsInitiator, Converter={StaticResource BoolToVis}}"><TextBlock Text="개시" /></Border>
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Color}" Margin="7,0,4,0" VerticalAlignment="Center" Visibility="{Binding HasSpoken, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="{Binding HasSpoken, Converter={StaticResource BoolToVis}}">
                                                            <Run Text="{Binding Word, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Turns, Mode=OneWay}" /><Run Text="회" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            <!-- ② 발언 타임라인(영상 세션은 «송출» — 누가 언제 영상을 보냈나) — 화자 레인 · 막대 클릭 = 그 턴 재생. 확대: [−][+][1:1] · Ctrl+휠(커서 기준) · 빈 곳 드래그 = 가로 이동(콘솔 LaneTimebar) -->
                            <DockPanel Grid.Row="1" Margin="0,0,0,12">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasLanes, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource MonoMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Run Text="{Binding AxisStartText, Mode=OneWay}" /><Run Text=" ~ " /><Run Text="{Binding AxisEndText, Mode=OneWay}" />
                                        </TextBlock>
                                        <ToggleButton Style="{StaticResource FilterChip}" Content="틈 줄임" IsChecked="{Binding CompactGaps}" Height="24" FontSize="11.5" Margin="0,0,8,0"
                                                      ToolTip="말(송출)이 없는 구간을 짧게 접어 말한 구간을 넓게 본다 — 끄면 시간에 비례한 축" />
                                        <Button Style="{StaticResource Btn.Xs}" Content="−" Width="24" ToolTip="축소 (Ctrl+휠)" Command="{Binding TalkZoomOutCommand}" />
                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding TalkZoomText}" FontSize="11" Width="38" TextAlignment="Center" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource Btn.Xs}" Content="+" Width="24" ToolTip="확대 (Ctrl+휠)" Command="{Binding TalkZoomInCommand}" />
                                        <Button Style="{StaticResource Btn.Xs}" Content="1:1" ToolTip="세션 전체 보기" Command="{Binding TalkZoomResetCommand}" Margin="4,0,0,0"
                                                Visibility="{Binding IsTalkZoomed, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock>
                                        <Run Text="{Binding TurnWord, Mode=OneWay}" FontWeight="Bold" FontSize="13" /><Run Text="{Binding TurnsHint, Mode=OneWay}" FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" />
                                    </TextBlock>
                                </DockPanel>
                                <Border CornerRadius="8" Background="{DynamicResource Brush.BgSoft}" Padding="10,12" Visibility="{Binding HasLanes, Converter={StaticResource NotToVis}}"><TextBlock Style="{StaticResource Hint}" Text="{Binding NoTurnsText}" HorizontalAlignment="Center" /></Border>
                                <!-- 좌 화자 라벨(고정) | 우 트랙(가로 스크롤, 폭 = 뷰포트 × 배율). 행 높이 24 로 두 열을 맞춘다 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasLanes, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,18,0,0">
                                            <ItemsControl ItemsSource="{Binding Lanes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SpeakerLane}">
                                                        <StackPanel Orientation="Horizontal" Height="24">
                                                            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="150" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <ScrollViewer x:Name="LaneScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                      PreviewMouseWheel="LaneScroll_PreviewMouseWheel" PreviewMouseLeftButtonDown="LaneScroll_MouseDown"
                                                      PreviewMouseMove="LaneScroll_MouseMove" PreviewMouseLeftButtonUp="LaneScroll_MouseUp" Background="Transparent">
                                            <StackPanel x:Name="LaneTracks">
                                                <StackPanel.Width>
                                                    <MultiBinding Converter="{StaticResource ScaleLen}">
                                                        <Binding Path="TalkZoom" />
                                                        <Binding Path="ViewportWidth" ElementName="LaneScroll" />
                                                    </MultiBinding>
                                                </StackPanel.Width>
                                                <!-- 눈금 행 -->
                                                <ItemsControl ItemsSource="{Binding AxisTicks}" Height="18" ClipToBounds="True">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Top" Value="0" />
                                                            <Setter Property="Canvas.Left">
                                                                <Setter.Value>
                                                                    <MultiBinding Converter="{StaticResource RatioLen}">
                                                                        <Binding Path="Ratio" />
                                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                    </MultiBinding>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:AxisTick}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Rectangle Width="1" Height="18" Fill="{DynamicResource Brush.Border}" />
                                                                <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource Brush.Muted}" Margin="2,0,0,0" VerticalAlignment="Top" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Grid>
                                                <ItemsControl ItemsSource="{Binding Lanes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:SpeakerLane}">
                                                            <Border Height="24" Background="{DynamicResource Brush.BgSoft}" CornerRadius="3" Margin="0,0,0,0" BorderBrush="{DynamicResource Brush.Surface}" BorderThickness="0,1,0,1">
                                                                <ItemsControl ItemsSource="{Binding Bars}">
                                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas ClipToBounds="True" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="ContentPresenter">
                                                                            <Setter Property="Canvas.Top" Value="3" />
                                                                            <Setter Property="Canvas.Left">
                                                                                <Setter.Value>
                                                                                    <MultiBinding Converter="{StaticResource RatioLen}">
                                                                                        <Binding Path="LeftRatio" />
                                                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                                    </MultiBinding>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </ItemsControl.ItemContainerStyle>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type vm:TurnBar}">
                                                                            <Border Height="16" MinWidth="3" CornerRadius="2" Background="{Binding Color}" ToolTip="{Binding Tooltip}" Cursor="Hand" Tag="turn">
                                                                                <Border.Width>
                                                                                    <MultiBinding Converter="{StaticResource RatioLen}">
                                                                                        <Binding Path="WidthRatio" />
                                                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                                    </MultiBinding>
                                                                                </Border.Width>
                                                                                <Border.InputBindings>
                                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PlayTurnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                                </Border.InputBindings>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- 줄인 틈(«틈 줄임») — 말이 없어 짧게 접은 구간. 레인 전체 높이의 흰 띠 + 가운데 "⋯", 툴팁에 실제 시각·길이 -->
                                                <ItemsControl x:Name="GapLayer" ItemsSource="{Binding AxisGaps}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas ClipToBounds="True" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Top" Value="0" />
                                                            <Setter Property="Canvas.Left">
                                                                <Setter.Value>
                                                                    <MultiBinding Converter="{StaticResource RatioLen}">
                                                                        <Binding Path="LeftRatio" />
                                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                    </MultiBinding>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:AxisGap}">
                                                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1,0,1,0" ToolTip="{Binding Tip}"
                                                                    Height="{Binding ActualHeight, ElementName=GapLayer}">
                                                                <Border.Width>
                                                                    <MultiBinding Converter="{StaticResource RatioLen}">
                                                                        <Binding Path="WidthRatio" />
                                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                    </MultiBinding>
                                                                </Border.Width>
                                                                <TextBlock Text="⋯" FontSize="12" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </ScrollViewer>
                            </DockPanel>
                            <!-- ③ 이벤트 타임라인 — 발언권 중재 + 입퇴장 -->
                            <DockPanel Grid.Row="2">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding ShowFloorLayer}" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock FontSize="11.5"><Run Text="발언권 " /><Run Text="{Binding FloorCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding ShowMemberLayer}" VerticalAlignment="Center">
                                            <TextBlock FontSize="11.5"><Run Text="입퇴장 " /><Run Text="{Binding MemberEventCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                        </CheckBox>
                                    </StackPanel>
                                    <TextBlock>
                                        <Run Text="이벤트" FontWeight="Bold" FontSize="13" />
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="표시할 항목이 없습니다" Visibility="{Binding HasTimeline, Converter={StaticResource NotToVis}}" />
                                <Border Style="{StaticResource Sub}" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}">
                                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Timeline}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TimelineItem}">
                                                <Border Style="{StaticResource LogRow}" Padding="8,3">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource MonoMuted}" Text="{Binding TimeText}" FontSize="12" Width="70" VerticalAlignment="Center" />
                                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Text, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource Brush.Muted}" FontSize="11" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </DockPanel>
                        </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
