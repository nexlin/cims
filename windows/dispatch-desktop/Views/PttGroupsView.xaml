<UserControl x:Class="DispatchDesktop.Views.PttGroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:v="clr-namespace:DispatchDesktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GroupAdminViewModel}">
    <!-- [PTT 그룹] 화면 본문(§4.7) — 관제 화면과 같은 시각 언어(알약 버튼 · 각진 필터 칩 · 19px 라벨 · 아바타 · 흰 카드).
         왼쪽 그룹 목록(검색 · [전체|멤버|내 소유] · 행 = 그룹 아바타 + 이름·관계 라벨 + id·서비스 칩 + 인원) | 오른쪽 선택 그룹 카드.
         카드 = 상세(머리: 이름·라벨·[채널로][편집][삭제] / 정보 칸 여섯 · 능력 칩 · 멤버 2열과 참여 상태) 또는 같은 자리의 편집 폼(GroupEditView — 별창 없음).
         행 한 번 클릭 = 상세, 더블클릭 = 편집. 편집 중엔 목록·[+ 새 그룹]이 잠긴다(저장·취소로 나온다). -->
    <UserControl.Resources>
        <!-- 정보 칸 — 연한 면 위에 작은 이름표 + 값 -->
        <Style TargetType="Border" x:Key="InfoTile">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style TargetType="TextBlock" x:Key="InfoLabel">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSoft}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style TargetType="TextBlock" x:Key="InfoValue">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,14,16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" MaxWidth="420" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" MinWidth="560" />
        </Grid.ColumnDefinitions>

        <!-- ═══ 목록 ═══ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,14,12,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconBtn}" Width="32" Height="32" ToolTip="목록 새로고침" Command="{Binding RefreshCommand}" IsEnabled="{Binding ListEnabled}" Margin="0,0,6,0"
                                    AutomationProperties.Name="목록 새로고침">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.RotateCw}" Width="16" Height="16" StrokeThickness="2" />
                            </Button>
                            <Button Style="{StaticResource Pill.Ink.Sm}" Padding="12,0" Command="{Binding NewGroupCommand}" IsEnabled="{Binding IsEditing, Converter={StaticResource Not}}"
                                    Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}" ToolTip="새 PTT 그룹 — 오른쪽에 폼이 열린다">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Plus}" Width="13" Height="13" StrokeThickness="2.4" Margin="0,0,5,0" />
                                    <TextBlock Text="새 그룹" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Title16}">
                            <Run Text="그룹" /><Run Text=" " /><Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSoft}" />
                        </TextBlock>
                    </DockPanel>
                    <Grid Margin="0,12,0,0">
                        <TextBox Style="{StaticResource Field}" Height="34" Padding="32,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="그룹 이름 · id 검색" />
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Search}" Width="15" Height="15" StrokeThickness="2" HorizontalAlignment="Left" Margin="11,0,0,0"
                              TextElement.Foreground="{DynamicResource Brush.Muted}" IsHitTestVisible="False" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <RadioButton Style="{StaticResource FilterChip}" Content="전체" IsChecked="{Binding ListFilter, Converter={StaticResource Eq}, ConverterParameter=all, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="all" />
                        <RadioButton Style="{StaticResource FilterChip}" Content="멤버" IsChecked="{Binding ListFilter, Converter={StaticResource Eq}, ConverterParameter=member, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="member"
                                     ToolTip="내가 멤버인 그룹" />
                        <RadioButton Style="{StaticResource FilterChip}" Content="내 소유" IsChecked="{Binding ListFilter, Converter={StaticResource Eq}, ConverterParameter=mine, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="mine"
                                     ToolTip="내가 만든 그룹" />
                    </StackPanel>
                    <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="8" Background="{DynamicResource Brush.EmgSoft}" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource Brush.EmgInk}" TextWrapping="Wrap" />
                    </Border>
                    <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="8" Background="{DynamicResource Brush.PrimarySoft}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="편집 중 — 저장하거나 취소하면 다른 그룹을 고를 수 있습니다" FontSize="12" Foreground="{DynamicResource Brush.PrimaryInk}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                <Grid>
                    <ListBox Style="{StaticResource SelectList}" ItemsSource="{Binding Groups}" SelectedItem="{Binding Selected}" MouseDoubleClick="Groups_DoubleClick" IsEnabled="{Binding ListEnabled}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GroupAdminRow}">
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="13,11,14,11">
                                    <DockPanel>
                                        <!-- 그룹 아바타(모서리 8) — 색 = 이름 해시 -->
                                        <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Width="36" Height="36" CornerRadius="8" Margin="0,0,11,0" Tag="{Binding Name, Converter={StaticResource AvatarHue}}">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSoft}" ToolTip="편성 멤버 수">
                                            <Run Text="{Binding MemberCount, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Brush.Text}" /><Run Text="명" />
                                        </TextBlock>
                                        <StackPanel VerticalAlignment="Center">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" MaxWidth="190" />
                                                <!-- 관계 라벨(이름 바로 옆) — 멤버(연한 남색) · 청취 범위(청록) · 소유 · 범위 -->
                                                <Border DockPanel.Dock="Left" Margin="7,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMemberRelation}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryEdge}" />
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.PrimaryInk}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Relation}" Value="청취 범위">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.ListenSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.ListenSoft}" />
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.ListenInk}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Relation}" />
                                                </Border>
                                            </DockPanel>
                                            <DockPanel Margin="0,4,0,0">
                                                <!-- 서비스 칩(§10.6) — 음성(MCPTT, 늘) · 영상(MCVideo 로 알려진 그룹) -->
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Tag.Teal}" Height="17" Margin="4,0,0,0" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="MCVideo 그룹 영상 — 같은 그룹에서 음성 무전과 따로 영상 호"><TextBlock Text="영상" FontSize="10.5" /></Border>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Height="17" Margin="6,0,0,0" ToolTip="MCPTT 음성 무전"><TextBlock Text="음성" FontSize="10.5" /></Border>
                                                <TextBlock Style="{StaticResource MonoMuted}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Id, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding OrgPath, Mode=OneWay}" FontFamily="{StaticResource Font.Ui}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Hint}" Text="조건에 맞는 그룹이 없습니다" HorizontalAlignment="Center" Margin="0,28,0,0" VerticalAlignment="Top"
                               Visibility="{Binding HasGroups, Converter={StaticResource NotToVis}}" />
                </Grid>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- ═══ 선택 그룹 카드 — 상세 또는 편집 폼 ═══ -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Users}" Width="36" Height="36" StrokeThickness="1.6" Opacity="0.35" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="그룹을 고르면 여기에 상세가 보입니다" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 상세(보기) -->
                <DockPanel Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVis}}">
                    <!-- 머리: 아바타 · 이름 · 라벨 · id — [채널로][편집][삭제] -->
                    <Border DockPanel.Dock="Top" Padding="20,16,16,16" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Pill.Line}" Height="36" Padding="16,0" Content="채널로" Command="{Binding GoToChannelCommand}" Margin="0,0,8,0"
                                        ToolTip="관제 [무전] 의 채널 상세로 — 멤버 그룹은 내 채널, 청취 범위 그룹은 타 채널(합류하지 않는다)" />
                                <Button Style="{StaticResource Pill.Ink}" Height="36" Padding="16,0" Command="{Binding EditGroupCommand}" Margin="0,0,8,0" ToolTip="이 자리에서 그룹 문서를 편집(GMS XCAP)"
                                        Visibility="{Binding Selected.CanManage, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Edit}" Width="14" Height="14" StrokeThickness="2" Margin="0,0,6,0" />
                                        <TextBlock Text="편집" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Pill.Red}" Height="36" Padding="16,0" Content="삭제" Command="{Binding DeleteGroupCommand}"
                                        Visibility="{Binding Selected.CanManage, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Width="46" Height="46" CornerRadius="10" Margin="0,0,14,0" Tag="{Binding Selected.Name, Converter={StaticResource AvatarHue}}">
                                <TextBlock Text="{Binding Selected.Name, Converter={StaticResource Initial}}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Selected.Name}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                    <Border Style="{StaticResource Tag.Ink}" Margin="10,0,0,0" Visibility="{Binding Selected.IsMemberRelation, Converter={StaticResource BoolToVis}}"><TextBlock Text="멤버" /></Border>
                                    <Border Style="{StaticResource Tag}" Margin="6,0,0,0" Visibility="{Binding Selected.IsMemberRelation, Converter={StaticResource NotToVis}}"><TextBlock Text="{Binding Selected.Relation}" /></Border>
                                    <Border Style="{StaticResource Tag.Teal}" Margin="6,0,0,0" Visibility="{Binding Selected.IsVideo, Converter={StaticResource BoolToVis}}"><TextBlock Text="영상" /></Border>
                                    <Border Style="{StaticResource Tag.Talk}" Margin="6,0,0,0" Visibility="{Binding DetailHasSession, Converter={StaticResource BoolToVis}}"><TextBlock Text="세션 진행 중" /></Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource MonoMuted}" FontSize="12" Margin="0,4,0,0" Text="{Binding DetailIdLine}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- 바닥 안내 — 목록 범위 -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="20,9" Visibility="{Binding Hint, Converter={StaticResource StrToVis}}">
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,12,16">
                            <Border Margin="0,0,8,12" Padding="12,9" CornerRadius="8" Background="{DynamicResource Brush.EmgSoft}" Visibility="{Binding DetailError, Converter={StaticResource StrToVis}}">
                                <TextBlock Text="{Binding DetailError}" FontSize="12.5" Foreground="{DynamicResource Brush.EmgInk}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Text="그룹 문서 조회 중…" Margin="0,0,0,10" Visibility="{Binding DetailLoading, Converter={StaticResource BoolToVis}}" />
                            <!-- 정보 칸 여섯 -->
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource InfoTile}"><StackPanel><TextBlock Style="{StaticResource InfoLabel}" Text="소유자" /><TextBlock Style="{StaticResource InfoValue}" Text="{Binding DetailOwnerText}" ToolTip="{Binding DetailOwnerText}" /></StackPanel></Border>
                                <Border Style="{StaticResource InfoTile}"><StackPanel><TextBlock Style="{StaticResource InfoLabel}" Text="소속" /><TextBlock Style="{StaticResource InfoValue}" Text="{Binding DetailOrg}" ToolTip="{Binding DetailOrg}" /></StackPanel></Border>
                                <Border Style="{StaticResource InfoTile}"><StackPanel><TextBlock Style="{StaticResource InfoLabel}" Text="세션 종류" /><TextBlock Style="{StaticResource InfoValue}" Text="{Binding DetailSessionType}" /></StackPanel></Border>
                                <Border Style="{StaticResource InfoTile}"><StackPanel><TextBlock Style="{StaticResource InfoLabel}" Text="그룹 우선순위" /><TextBlock Style="{StaticResource InfoValue}" Text="{Binding DetailPriority}" /></StackPanel></Border>
                                <Border Style="{StaticResource InfoTile}"><StackPanel><TextBlock Style="{StaticResource InfoLabel}" Text="긴급" /><TextBlock Style="{StaticResource InfoValue}" Text="{Binding DetailEmergency}" /></StackPanel></Border>
                                <Border Style="{StaticResource InfoTile}" ToolTip="이 관제석의 청취가 그룹 로스터에 보이는가(관제 역할의 listen_visibility)"><StackPanel><TextBlock Style="{StaticResource InfoLabel}" Text="청취 노출" /><TextBlock Style="{StaticResource InfoValue}" Text="{Binding DetailListenVisibility}" /></StackPanel></Border>
                            </UniformGrid>
                            <!-- 능력 칩 -->
                            <ItemsControl ItemsSource="{Binding DetailCapabilities}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tag}" Height="24" Padding="9,0" Margin="0,0,6,6"><TextBlock Text="{Binding}" FontSize="11.5" /></Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 멤버 — 2열, 참여 › 미참가 순 -->
                            <DockPanel Margin="0,14,8,8">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding DetailAffiliationText}" FontSize="12" VerticalAlignment="Center" ToolTip="지금 이 그룹에 참여(affiliation) 중인 멤버 수" />
                                <TextBlock Text="{Binding DetailMemberCount}" FontWeight="Bold" FontSize="14" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding DetailMembers}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GroupDetailMember}">
                                        <Border x:Name="Row" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="2,8,6,8" Margin="0,0,16,0">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0" Tag="{Binding Label, Converter={StaticResource AvatarHue}}">
                                                    <TextBlock Text="{Binding Label, Converter={StaticResource Initial}}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <!-- 상태 — 발언 중(녹색 라벨) · 참여(녹색 점) · 미참가(흐림) -->
                                                <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Border Style="{StaticResource Tag.Talk}" Margin="0" Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}"><TextBlock Text="발언 중" /></Border>
                                                    <TextBlock x:Name="St" Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Brush.TextSoft}" Visibility="{Binding IsSpeaking, Converter={StaticResource NotToVis}}" />
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="Nm" Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text=" (나)" FontSize="12" Foreground="{DynamicResource Brush.TextSoft}" VerticalAlignment="Center" Visibility="{Binding IsMe, Converter={StaticResource BoolToVis}}" />
                                                        <Border Style="{StaticResource Tag}" Height="17" Margin="6,0,0,0" Visibility="{Binding IsChair, Converter={StaticResource BoolToVis}}"><TextBlock Text="의장" FontSize="10.5" /></Border>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding Number}" FontSize="11.5" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAbsent}" Value="True"><Setter TargetName="Row" Property="Opacity" Value="0.55" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="참여"><Setter TargetName="St" Property="Foreground" Value="{DynamicResource Brush.TalkInk}" /></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- 편집 폼 — 같은 자리 -->
                <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding EditorTitle}" FontWeight="Bold" FontSize="19" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <v:GroupEditView DataContext="{Binding Editor}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
