<UserControl x:Class="DispatchDesktop.Views.PttGroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GroupAdminViewModel}">
    <!-- [PTT 그룹] 화면 본문(§4.7) — 왼쪽 표(그룹·id·소속·멤버·관계·소유자 + 행 [편집][삭제]) | 오른쪽 선택 그룹 상세(소유자·소속·정책·청취 노출·
         멤버와 참여 상태·[채널로]·[편집…]). 행 한 번 클릭 = 상세, 편집은 종전 GroupEditWindow(GMS XCAP) -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="520" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" MaxWidth="520" MinWidth="360" />
        </Grid.ColumnDefinitions>
        <!-- 목록 -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource LogHeader}" Padding="12,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Style="{StaticResource SegGroup}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Seg}" Content="전체" IsChecked="{Binding ListFilter, Converter={StaticResource Eq}, ConverterParameter=all, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="all" />
                                    <RadioButton Style="{StaticResource Seg}" Content="멤버" IsChecked="{Binding ListFilter, Converter={StaticResource Eq}, ConverterParameter=member, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="member" />
                                    <RadioButton Style="{StaticResource Seg}" Content="내 소유" IsChecked="{Binding ListFilter, Converter={StaticResource Eq}, ConverterParameter=mine, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="mine" />
                                </StackPanel>
                            </Border>
                            <TextBox Style="{StaticResource Field}" Width="220" Height="26" Margin="0,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="그룹명·id 검색" />
                            <Button Style="{StaticResource Btn.Sm}" Content="↻" ToolTip="목록 새로고침" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource Btn.Sm.Pri}" Content="+ 새 그룹" Command="{Binding NewGroupCommand}" Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" FontSize="13">
                            <Run Text="그룹" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="개" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Emg}" Text="{Binding Error}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    </DockPanel>
                </Border>
                <!-- 열 머리 -->
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Hint}" Text="그룹" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Text="id" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Text="소속" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Hint}" Text="멤버" />
                        <TextBlock Grid.Column="4" Style="{StaticResource Hint}" Text="관계" />
                        <TextBlock Grid.Column="5" Style="{StaticResource Hint}" Text="소유자" />
                    </Grid>
                </Border>
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Groups}" SelectedItem="{Binding Selected}" MouseDoubleClick="Groups_DoubleClick" IsEnabled="{Binding Busy, Converter={StaticResource Not}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GroupAdminRow}">
                            <Border Style="{StaticResource LogRow}" Padding="12,0" Height="40">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource MonoMuted}" Text="{Binding Id}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="{Binding OrgPath}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource Mono}" Text="{Binding MemberCount}" FontSize="12.5" VerticalAlignment="Center" />
                                    <Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMemberRelation}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Relation}" Value="청취 범위"><Setter Property="Background" Value="{DynamicResource Brush.ListenSoft}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Relation}" />
                                    </Border>
                                    <TextBlock Grid.Column="5" Style="{StaticResource Muted}" Text="{Binding OwnerText}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource Btn.Xs}" Content="편집" Command="{Binding DataContext.EditGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,4,0" />
                                        <Button Style="{StaticResource Btn.Xs.Danger}" Content="삭제" Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <!-- 상세 -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <TextBlock Style="{StaticResource Hint}" Text="그룹을 고르면 여기에 상세가 보입니다." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasDetail, Converter={StaticResource NotToVis}}" />
                <DockPanel Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                    <!-- 머리: 이름 · id · 배지 -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource LogHeader}" Padding="12,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Badge.Member}" Visibility="{Binding Selected.IsMemberRelation, Converter={StaticResource BoolToVis}}"><TextBlock Text="멤버" /></Border>
                                <Border Style="{StaticResource Badge.Talk}" Margin="4,0,0,0" Visibility="{Binding DetailHasSession, Converter={StaticResource BoolToVis}}"><TextBlock Text="세션 진행 중" /></Border>
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{Binding Selected.Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" /><Run Text="  " />
                                <Run Text="{Binding Selected.Id, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <!-- 바닥: 힌트 + 버튼 -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Btn}" Content="채널로" Command="{Binding GoToChannelCommand}" ToolTip="관제 캔버스의 채널 카드로 — 멤버 그룹이면 합류" Margin="0,0,6,0" />
                                <Button Style="{StaticResource Btn.Pri}" Content="편집…" Command="{Binding EditGroupCommand}" Visibility="{Binding Selected.CanManage, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="주소록 [그룹] 탭의 빠른 경로는 그대로" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,10">
                            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Emg}" Text="{Binding DetailError}" Margin="0,0,0,6" Visibility="{Binding DetailError, Converter={StaticResource StrToVis}}" />
                            <TextBlock Style="{StaticResource Hint}" Text="문서 조회 중…" Margin="0,0,0,6" Visibility="{Binding DetailLoading, Converter={StaticResource BoolToVis}}" />
                            <UniformGrid Columns="2" Margin="0,0,0,4">
                                <TextBlock FontSize="12.5" Margin="0,0,0,6"><Run Text="소유자 " Foreground="{DynamicResource Brush.Muted}" /><Run Text="{Binding DetailOwner, Mode=OneWay}" FontWeight="Medium" /></TextBlock>
                                <TextBlock FontSize="12.5" Margin="0,0,0,6"><Run Text="소속 " Foreground="{DynamicResource Brush.Muted}" /><Run Text="{Binding DetailOrg, Mode=OneWay}" FontWeight="Medium" /></TextBlock>
                                <TextBlock FontSize="12.5" Margin="0,0,0,6" TextWrapping="Wrap"><Run Text="{Binding DetailPolicy, Mode=OneWay}" /></TextBlock>
                                <TextBlock FontSize="12.5" Margin="0,0,0,6"><Run Text="청취 노출 " Foreground="{DynamicResource Brush.Muted}" /><Run Text="{Binding DetailListenVisibility, Mode=OneWay}" FontWeight="Medium" /></TextBlock>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding DetailCapability}" Margin="0,0,0,8" Visibility="{Binding DetailCapability, Converter={StaticResource StrToVis}}" />
                            <DockPanel Margin="0,4,0,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding DetailAffiliationText}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DetailMemberCount}" FontWeight="SemiBold" FontSize="13" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding DetailMembers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GroupDetailMember}">
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,7">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                            <Setter Property="Text" Value="{Binding Status}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSpeaking}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Talk}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="참여"><Setter Property="Text" Value="" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMe}" Value="True"><Setter Property="Text" Value="나" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock VerticalAlignment="Center">
                                                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="Medium" /><Run Text=" " />
                                                    <Run Text="{Binding Number, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" />
                                                    <Run Text="{Binding ChairText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
