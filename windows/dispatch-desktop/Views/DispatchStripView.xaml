<UserControl x:Class="DispatchDesktop.Views.DispatchStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <!-- 관제 요약 띠(§3.5) — 관제 밖 화면 상단 32px 상시: 선택 채널 + 발언 상태 + PTT · 대표번호 대기열 · 내 통화 · 감청 창 · [관제로 F1] -->
    <Border Height="32" Background="{DynamicResource Brush.BgSoft}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="14,0">
        <DockPanel VerticalAlignment="Center" DataContext="{Binding Summary}">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Sm}" Height="24" Command="{Binding DataContext.ReturnToDispatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="관제 캔버스로 (F1)">
                <TextBlock><Run Text="관제로" /><Run Text="  F1" Foreground="{DynamicResource Brush.Muted}" FontFamily="{StaticResource Font.Mono}" FontSize="11" /></TextBlock>
            </Button>
            <StackPanel Orientation="Horizontal">
                <!-- 선택 채널 -->
                <TextBlock Style="{StaticResource Muted}" Text="선택 채널" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ChannelName}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                <Border Style="{StaticResource Badge.Emg}" Margin="6,0,0,0" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}"><TextBlock Text="긴급" /></Border>
                <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding ChannelHotKey}" FontSize="11" VerticalAlignment="Center" Margin="6,0,14,0" />
                <!-- 발언 상태 -->
                <Border Style="{StaticResource Badge.Talk}" Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}"><TextBlock Text="내 발언 중" /></Border>
                <Border Style="{StaticResource Badge.Pilot}" Visibility="{Binding IsRequesting, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding FloorText}" /></Border>
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Badge.Talk}"><TextBlock Text="발언" /></Border>
                    <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
                <ProgressBar Style="{StaticResource Meter}" Width="48" Height="6" Value="{Binding TalkGauge, Mode=OneWay}" Maximum="1" Margin="8,0,6,0" VerticalAlignment="Center" Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding SpeakerElapsed, Converter={StaticResource Elapsed}}" FontSize="12" VerticalAlignment="Center" Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVis}}" />
                <!-- PTT (누르는 동안) -->
                <Button x:Name="PttBtn" Height="24" Padding="12,0" Margin="10,0,0,0" FontSize="12" FontWeight="Bold" IsEnabled="{Binding CanPtt}" ToolTip="누르는 동안 발언 요청 — 핫키도 관제 밖에서 그대로 동작"
                        PreviewMouseLeftButtonDown="Ptt_Down" PreviewMouseLeftButtonUp="Ptt_Up" MouseLeave="Ptt_Leave" Content="{Binding PttText}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Sm}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Talk}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Talk}" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRequesting}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.RingSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Ring}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Ring}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Border Width="1" Height="18" Background="{DynamicResource Brush.Border}" Margin="16,0" />
                <!-- 대표번호 대기열 · 내 통화 -->
                <TextBlock Style="{StaticResource Muted}" Text="대표번호 대기열" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding QueueCount}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers><DataTrigger Binding="{Binding QueueBusy}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Ring}" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Style="{StaticResource Muted}" Text="내 통화" FontSize="12.5" VerticalAlignment="Center" Margin="18,0,6,0" />
                <TextBlock Text="{Binding CallsText}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                <Border Width="1" Height="18" Background="{DynamicResource Brush.Border}" Margin="16,0" />
                <!-- 감청 창 -->
                <TextBlock Style="{StaticResource Muted}" Text="감청 창" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding MonitorCount}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Brush.Mon}" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
