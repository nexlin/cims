<UserControl x:Class="DispatchDesktop.Views.PttMessagesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:v="clr-namespace:DispatchDesktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:McDataMessagesViewModel}">
    <!-- ④ PTT 메시지(§4.4) — 머리 [<포커스 채널> 따라가기] 스위치 · 미읽음 배지, 본문 = MessagesView(스레드 칩 → 말풍선 → 입력, MCData SDS) -->
    <UserControl.Resources>
        <!-- 패널 머리 — 도킹 제목줄(MainWindow·DockTheme 의 AnchorablePaneTitle 템플릿)이 Resources[PanelHeader] 를 제목 옆에 그린다. 본문 위에 머리 줄을 따로 두지 않는다 -->
        <DockPanel x:Key="PanelHeader" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Muted}" Text="SDS" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Pilot}" Margin="6,0,0,0" Visibility="{Binding UnreadTotal, Converter={StaticResource CountToVis}}" ToolTip="미읽음">
                <TextBlock Text="{Binding UnreadTotal}" />
            </Border>
            <!-- 따라가기 토글 — 켜면 ① 포커스 카드의 그룹 스레드로 이동 -->
            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding FollowChannel, Mode=OneWay}" Command="{Binding ToggleFollowCommand}" ToolTip="포커스 채널의 스레드를 따라간다 / 끄면 스레드 선택이 고정된다">
                <TextBlock Text="{Binding FollowText}" />
            </CheckBox>
        </DockPanel>
    </UserControl.Resources>
    <Border Style="{StaticResource Pnl}">
        <DockPanel>
            <v:MessagesView HeaderVisible="False" InputTip="메시지… (Enter 전송 · Shift+Enter 줄바꿈)" Margin="6" />
        </DockPanel>
    </Border>
</UserControl>
