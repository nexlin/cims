<UserControl x:Class="DispatchDesktop.Views.DirectoryAdminView" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DirectoryAdminViewModel}">
    <!-- [관리] 화면 본문(§4.5) — 관제 화면과 같은 시각 언어(알약 버튼 · 19px 라벨 · 아바타 · 흰 카드 · 절 카드).
         세 카드: 조직(«전체» + 트리, 선택 = 하위 포함 필터) | 구성원 표(검색 · 번호 열 셋 · 자격 라벨) | 편집 폼(구성원 = 기본 + 회선 카드 셋, 조직 = 한 절).
         서버가 관리 범위로 걸러 준 것만 보인다. 행 한 번 클릭 = 오른쪽 폼에 바로 편집 -->
    <UserControl.Resources>
        <!-- 번호 칸 — 회선이 없으면("–") 흐리게 -->
        <Style TargetType="TextBlock" x:Key="NumCell" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Text" Value="–"><Setter Property="Foreground" Value="{DynamicResource Brush.Wire}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock" x:Key="ColHead">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 회선 상태 라벨 — 개설됨(녹색) / 미개설(무채). Tag = "on"(저장된 회선 있음) | "off" -->
        <Style TargetType="Border" x:Key="LineState" BasedOn="{StaticResource Tag}">
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="on">
                    <Setter Property="Background" Value="{DynamicResource Brush.TalkSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.TalkSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TalkInk}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 폼 안 경고 띠 — 접속서비스 후보 없음 -->
        <Style TargetType="Border" x:Key="WarnBand">
            <Setter Property="Background" Value="{DynamicResource Brush.EmgSoft}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,14,16,14" IsEnabled="{Binding Busy, Converter={StaticResource Not}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="408" />
        </Grid.ColumnDefinitions>

        <!-- ═══ 조직 — «전체» + 트리, 바닥 = 고른 조직 [편집][삭제] ═══ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,14,12,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Pill.Line.Sm}" Padding="11,0" Command="{Binding NewOrgCommand}" ToolTip="새 조직 — 고른 조직 아래에 만든다(오른쪽에 폼)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Plus}" Width="12" Height="12" StrokeThickness="2.4" Margin="0,0,4,0" />
                            <TextBlock Text="새 조직" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Title16}">
                        <Run Text="조직" /><Run Text=" " /><Run Text="{Binding OrgCount, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSoft}" />
                    </TextBlock>
                </DockPanel>
                <!-- 바닥: 고른 조직 + [편집][삭제] · 범위 안내 -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="16,10,12,12">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding HasSelectedOrg}">
                                <Button Style="{StaticResource Pill.Line.Sm}" Padding="12,0" Content="편집" Command="{Binding BeginEditOrgCommand}" Margin="0,0,6,0" />
                                <Button Style="{StaticResource Pill.Red.Sm}" Padding="12,0" Content="삭제" Command="{Binding DeleteOrgCommand}" ToolTip="하위 조직·구성원이 남아 있으면 지울 수 없다" />
                            </StackPanel>
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SelectedOrg.Name, FallbackValue='조직을 고르세요', TargetNullValue='조직을 고르세요'}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,9,0,0" TextWrapping="Wrap" Text="전화 그룹 편성(멤버 · 대표번호)과 역할은 운영 콘솔에서 합니다." />
                    </StackPanel>
                </Border>
                <DockPanel>
                    <!-- «전체» — 조직 필터 풀기 -->
                    <Button DockPanel.Dock="Top" Command="{Binding ClearOrgCommand}" Cursor="Hand" Focusable="False" ToolTip="범위 안 구성원 전부">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="13,9,14,9" SnapsToDevicePixels="True">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalMemberCount}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                                        <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource Icon.Users}" Width="15" Height="15" StrokeThickness="2" Margin="0,0,9,0"
                                              TextElement.Foreground="{DynamicResource Brush.Muted}" />
                                        <TextBlock Text="전체" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" /></Trigger>
                                    <DataTrigger Binding="{Binding IsAllOrgs}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ListBox Style="{StaticResource SelectList}" ItemsSource="{Binding Orgs}" SelectedItem="{Binding SelectedOrg}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OrgRow}">
                                <!-- 깊이만큼 들여 쓴다(DepthIndent — 9 + 14·깊이) -->
                                <Border Padding="4,4,5,4" ToolTip="{Binding Code}">
                                    <DockPanel Margin="{Binding Depth, Converter={StaticResource DepthIndent}}">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                                        <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource Icon.Folder}" Width="14" Height="14" StrokeThickness="2" Margin="0,0,8,0"
                                              TextElement.Foreground="{DynamicResource Brush.Wire}" />
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- ═══ 구성원 — 머리(«구성원 N» · 범위 · [↻] · [+ 새 구성원]) + 검색, 열 = 이름·직함·소속 | VoLTE | VoIP | PTT | 자격.
             좁으면(IsNarrow — 작은 창) 번호·자격 열을 접고 이름 아래 한 줄로 ═══ -->
        <Border x:Name="MemberCard" Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0" SizeChanged="MemberCard_SizeChanged">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,14,12,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconBtn}" Width="32" Height="32" ToolTip="새로고침" Command="{Binding RefreshCommand}" Margin="0,0,6,0" AutomationProperties.Name="새로고침">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.RotateCw}" Width="16" Height="16" StrokeThickness="2" />
                            </Button>
                            <Button Style="{StaticResource Pill.Ink.Sm}" Padding="12,0" Command="{Binding NewMemberCommand}" ToolTip="새 구성원 — 오른쪽에 폼이 열린다">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Plus}" Width="13" Height="13" StrokeThickness="2.4" Margin="0,0,5,0" />
                                    <TextBlock Text="새 구성원" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Title16}">
                            <Run Text="구성원" /><Run Text=" " /><Run Text="{Binding MemberCount, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSoft}" />
                        </TextBlock>
                        <TextBlock Text="{Binding MemberScope}" FontSize="12.5" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="12,2,12,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Grid Margin="0,12,0,0" HorizontalAlignment="Left" Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=260|340}">
                        <TextBox Style="{StaticResource Field}" Height="34" Padding="32,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="이름 · 아이디 · 번호 검색" />
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Search}" Width="15" Height="15" StrokeThickness="2" HorizontalAlignment="Left" Margin="11,0,0,0"
                              TextElement.Foreground="{DynamicResource Brush.Muted}" IsHitTestVisible="False" />
                    </Grid>
                    <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="8" Background="{DynamicResource Brush.EmgSoft}" Visibility="{Binding ShowListError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource Brush.EmgInk}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                <!-- 열 머리 -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.BgSoft}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,1" Padding="19,7,14,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=0|126}" />
                            <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=0|110}" />
                            <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=0|126}" />
                            <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=0|150}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColHead}" Text="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter='이름 · 직함 · 소속 · 번호|이름 · 직함 · 소속'}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="VoLTE" Visibility="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=Collapsed|Visible}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="VoIP" Visibility="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=Collapsed|Visible}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="PTT" Visibility="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=Collapsed|Visible}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" Text="자격" Visibility="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=Collapsed|Visible}" />
                    </Grid>
                </Border>
                <Grid>
                    <ListBox Style="{StaticResource SelectList}" ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}" MouseDoubleClick="Members_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MemberRow}">
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="13,9,14,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=0|126}" />
                                            <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=0|110}" />
                                            <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=0|126}" />
                                            <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=0|150}" />
                                        </Grid.ColumnDefinitions>
                                        <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Margin="0,0,11,0" Tag="{Binding Name, Converter={StaticResource AvatarHue}}">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource Brush.TextSoft}" Margin="7,0,0,1" VerticalAlignment="Bottom" />
                                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=Visible|Collapsed}">
                                                        <Border Style="{StaticResource Tag.Ink}" Visibility="{Binding CanCreateGroup, Converter={StaticResource BoolToVis}}"><TextBlock Text="그룹 생성" /></Border>
                                                        <Border Style="{StaticResource Tag.Teal}" Visibility="{Binding CanAmbientListen, Converter={StaticResource BoolToVis}}"><TextBlock Text="원격 청취" /></Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding OrgPath}" FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Mono}" Text="{Binding NumbersLine}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                           Visibility="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=Visible|Collapsed}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource NumCell}" Text="{Binding VolteCell}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource NumCell}" Text="{Binding VoipCell}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource NumCell}" Text="{Binding PttCell}" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource Tag.Ink}" Visibility="{Binding CanCreateGroup, Converter={StaticResource BoolToVis}}" ToolTip="PTT 그룹 생성 자격(allow-create-group)"><TextBlock Text="그룹 생성" /></Border>
                                            <Border Style="{StaticResource Tag.Teal}" Visibility="{Binding CanAmbientListen, Converter={StaticResource BoolToVis}}" ToolTip="원격 청취 자격(allow-ambient-listening) — 역할 배정의 결과"><TextBlock Text="원격 청취" /></Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Hint}" Text="조건에 맞는 구성원이 없습니다" HorizontalAlignment="Center" Margin="0,28,0,0" VerticalAlignment="Top"
                               Visibility="{Binding HasMembers, Converter={StaticResource NotToVis}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═══ 편집 폼 — 자리표시 / 조직 폼 / 구성원 폼 ═══ -->
        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <!-- 자리표시 -->
                <StackPanel VerticalAlignment="Center" Margin="32,0" Visibility="{Binding IsEditing, Converter={StaticResource NotToVis}}">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Edit}" Width="34" Height="34" StrokeThickness="1.6" Opacity="0.35" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Text="구성원을 고르면 여기서 바로 편집합니다" />
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="조직은 고른 뒤 [편집], 새로 만들려면 [새 조직] · [새 구성원].&#10;번호(VoLTE · VoIP · PTT 회선)는 구성원 폼에서 개설 · 변경 · 삭제합니다." />
                </StackPanel>

                <!-- 조직 폼 -->
                <DockPanel Visibility="{Binding OrgEditing, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Top" Padding="18,14,14,14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" Tag="{Binding OrgFormTitle, Converter={StaticResource AvatarHue}}">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Folder}" Width="19" Height="19" StrokeThickness="2" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding OrgFormTitle}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding OrgFormSub}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,12,14,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource Pill.Line}" Height="36" Padding="18,0" Content="취소" Command="{Binding CancelOrgCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Pill.Ink}" Height="36" Padding="20,0" Content="저장" Command="{Binding SaveOrgCommand}" />
                            </StackPanel>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource Brush.Emg}" Text="{Binding Error}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"
                                       Visibility="{Binding ShowFormError, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </Border>
                    <StackPanel Margin="16,16,16,8">
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FormTitle}" Text="조직" />
                                <TextBlock Style="{StaticResource FormLabel}" Text="코드 — 불변 키(만든 뒤 바꿀 수 없음)" />
                                <TextBox Style="{StaticResource Field.Form}" Text="{Binding OrgCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding OrgIsNew}" FontFamily="{StaticResource Font.Mono}" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource FormLabel}" Text="이름" />
                                <TextBox Style="{StaticResource Field.Form}" Text="{Binding OrgName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource FormLabel}" Text="상위 조직" />
                                <ComboBox Style="{StaticResource OrgCombo.Form}" ItemsSource="{Binding Orgs}" SelectedItem="{Binding OrgParent}" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource FormLabel}" Text="정렬 순서" />
                                <TextBox Style="{StaticResource Field.Form}" Text="{Binding OrgSort, UpdateSourceTrigger=PropertyChanged}" Width="96" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- 구성원 폼 -->
                <DockPanel Visibility="{Binding MemberEditing, Converter={StaticResource BoolToVis}}">
                    <!-- 머리: 아바타 · 이름 · 설명 — [삭제] -->
                    <Border DockPanel.Dock="Top" Padding="18,14,14,14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Pill.Red.Sm}" Padding="12,0" Content="삭제" Command="{Binding DeleteMemberCommand}" VerticalAlignment="Center" Margin="10,0,0,0"
                                    Visibility="{Binding MemberIsNew, Converter={StaticResource NotToVis}}" ToolTip="구성원과 VoLTE/VoIP/PTT 회선을 삭제" />
                            <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Width="42" Height="42" CornerRadius="21" Margin="0,0,12,0" Tag="{Binding MemberFormName, Converter={StaticResource AvatarHue}}">
                                <TextBlock Text="{Binding MemberFormName, Converter={StaticResource Initial}}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding MemberFormName}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MemberFormSub}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- 바닥: 오류 + [취소][저장] -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,12,14,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource Pill.Line}" Height="36" Padding="18,0" Content="취소" Command="{Binding CancelMemberCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Pill.Ink}" Height="36" Padding="20,0" Content="저장" Command="{Binding SaveMemberCommand}" />
                            </StackPanel>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource Brush.Emg}" Text="{Binding Error}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"
                                       Visibility="{Binding ShowFormError, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,16,8,8">
                            <!-- 기본 -->
                            <Border Style="{StaticResource FormCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormTitle}" Text="기본" />
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="이름" />
                                            <TextBox Style="{StaticResource Field.Form}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="직함" />
                                            <TextBox Style="{StaticResource Field.Form}" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="소속 조직" />
                                    <ComboBox Style="{StaticResource OrgCombo.Form}" ItemsSource="{Binding Orgs}" SelectedItem="{Binding EditOrg}" Margin="0,0,0,10" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,6,0" ToolTip="단말·관제 앱 로그인에 쓰는 아이디">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="로그인 아이디" />
                                            <TextBox Style="{StaticResource Field.Form}" Text="{Binding EditLoginId, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,0" ToolTip="바꿀 때만 넣는다 — 비우면 그대로">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="로그인 비밀번호(바꿀 때만)" />
                                            <PasswordBox x:Name="LoginPw" Style="{StaticResource FieldPw.Form}" PasswordChanged="LoginPw_Changed" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <!-- VoLTE 회선(이동) — 콘솔 매트릭스와 같게 AKA 는 이 앱이 다루지 않는다(digest 만) -->
                            <Border Style="{StaticResource FormCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource LineState}" Tag="{Binding HasVolte, Converter={StaticResource Pick}, ConverterParameter=on|off}">
                                            <TextBlock Text="{Binding HasVolte, Converter={StaticResource Pick}, ConverterParameter=개설됨|미개설}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource FormTitle}" Text="VoLTE 번호" Margin="0" VerticalAlignment="Center" />
                                            <TextBlock Text="이동" FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="7,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="번호 (E.164 — 비우면 회선 삭제)" />
                                    <TextBox Style="{StaticResource Field.Form}" Text="{Binding VolteNumber, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" Margin="0,0,0,10" />
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="접속서비스" />
                                            <ComboBox Style="{StaticResource FieldCombo.Form}" ItemsSource="{Binding VolteServices}" SelectedItem="{Binding VolteService}" DisplayMemberPath="Label" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="SIP transport" />
                                            <ComboBox Style="{StaticResource FieldCombo.Form}" ItemsSource="{Binding Transports}" SelectedItem="{Binding VolteTransport}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <Border Style="{StaticResource WarnBand}" Visibility="{Binding NoVolteServices, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.EmgInk}" TextWrapping="Wrap"
                                                   Text="접속서비스 목록이 비어 있습니다 — 서버(CSC)가 후보를 내려주지 않아 회선 개설이 실패합니다. 운영자에게 csc.json Provisioning.Services 설정을 요청하세요." />
                                    </Border>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="SIP 비밀번호 (개설 · 번호 변경 때 필수)" />
                                    <PasswordBox x:Name="VoltePw" Style="{StaticResource FieldPw.Form}" PasswordChanged="VoltePw_Changed" />
                                </StackPanel>
                            </Border>
                            <!-- VoIP 회선(유선 — 데스크폰·소프트폰·관제석) — voip 접속서비스 후보만(서버 400 service_kind_mismatch·serviceRef 필수), 기본 TLS(UDP/TCP/TLS/ANY),
                                 IMSI 는 서버가 번호 숫자로, 인증 digest. 픽업 그룹은 서버 파생값(콘솔 전화 그룹 편성)이라 서버가 실어 줄 때만 읽기전용 표시. 내선은 서버 엔티티가 아니다(§13). -->
                            <Border Style="{StaticResource FormCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource LineState}" Tag="{Binding HasVoip, Converter={StaticResource Pick}, ConverterParameter=on|off}">
                                            <TextBlock Text="{Binding HasVoip, Converter={StaticResource Pick}, ConverterParameter=개설됨|미개설}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource FormTitle}" Text="VoIP 번호" Margin="0" VerticalAlignment="Center" />
                                            <TextBlock Text="유선" FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="7,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="번호 (E.164 — 비우면 회선 삭제)" />
                                    <TextBox Style="{StaticResource Field.Form}" Text="{Binding VoipNumber, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" Margin="0,0,0,10" />
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="접속서비스 (유선 voip)" />
                                            <ComboBox Style="{StaticResource FieldCombo.Form}" ItemsSource="{Binding VoipServices}" SelectedItem="{Binding VoipService}" DisplayMemberPath="Label" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,0" ToolTip="ANY = 가입자 지정 없음(접속서비스 기본을 따른다)">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="SIP transport" />
                                            <ComboBox Style="{StaticResource FieldCombo.Form}" ItemsSource="{Binding Transports}" SelectedItem="{Binding VoipTransport}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <Border Style="{StaticResource WarnBand}" Visibility="{Binding NoVoipServices, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.EmgInk}" TextWrapping="Wrap"
                                                   Text="유선(voip) 접속서비스 후보가 없습니다 — 서버(CSC)가 후보를 내려주지 않아 회선 개설이 실패합니다. 운영자에게 접속서비스(kind=voip) 등록을 요청하세요." />
                                    </Border>
                                    <StackPanel Visibility="{Binding HasVoipDerived, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="픽업 그룹 (콘솔 전화 그룹에서 편성 — 읽기 전용)" />
                                        <TextBox Style="{StaticResource Field.Form}" Text="{Binding VoipPickupGroup, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" FontFamily="{StaticResource Font.Mono}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="SIP 비밀번호 (개설 · 번호 변경 때 필수)" />
                                    <PasswordBox x:Name="VoipPw" Style="{StaticResource FieldPw.Form}" PasswordChanged="VoipPw_Changed" />
                                </StackPanel>
                            </Border>
                            <!-- PTT 회선 + PTT 자격 -->
                            <Border Style="{StaticResource FormCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource LineState}" Tag="{Binding HasPtt, Converter={StaticResource Pick}, ConverterParameter=on|off}">
                                            <TextBlock Text="{Binding HasPtt, Converter={StaticResource Pick}, ConverterParameter=개설됨|미개설}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource FormTitle}" Text="PTT 번호" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="번호 (E.164 — 비우면 회선 삭제)" />
                                    <TextBox Style="{StaticResource Field.Form}" Text="{Binding PttNumber, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" Margin="0,0,0,10" />
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="접속서비스" />
                                            <ComboBox Style="{StaticResource FieldCombo.Form}" ItemsSource="{Binding PttServices}" SelectedItem="{Binding PttService}" DisplayMemberPath="Label" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Style="{StaticResource FormLabel}" Text="SIP transport" />
                                            <ComboBox Style="{StaticResource FieldCombo.Form}" ItemsSource="{Binding Transports}" SelectedItem="{Binding PttTransport}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <Border Style="{StaticResource WarnBand}" Visibility="{Binding NoPttServices, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.EmgInk}" TextWrapping="Wrap"
                                                   Text="접속서비스 목록이 비어 있습니다 — 서버(CSC)가 후보를 내려주지 않아 회선 개설이 실패합니다. 운영자에게 csc.json Provisioning.Services 설정을 요청하세요." />
                                    </Border>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="SIP 비밀번호 (개설 · 번호 변경 때 필수)" />
                                    <PasswordBox x:Name="PttPw" Style="{StaticResource FieldPw.Form}" PasswordChanged="PttPw_Changed" Margin="0,0,0,14" />
                                    <CheckBox Style="{StaticResource Switch.Form}" Content="PTT 그룹 생성 자격" IsChecked="{Binding AllowCreateGroup}" ToolTip="allow-create-group — 이 구성원이 PTT 그룹을 만들 수 있다" />
                                    <CheckBox Style="{StaticResource Switch.Form}" Content="원격 청취 자격" IsChecked="{Binding AllowAmbientListening}" IsEnabled="False" Margin="0,0,0,2" ToolTipService.ShowOnDisabled="True"
                                              ToolTip="allow-ambient-listening — 역할 배정의 결과라 여기서 바꾸지 않는다" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="34,0,0,0" Text="원격 청취는 운영 콘솔에서 역할로 부여합니다 — 여기서는 표시만" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="2,0,8,8" TextWrapping="Wrap"
                                       Text="새 회선과 번호 · 접속서비스 변경에는 SIP 비밀번호가 필요합니다(서버가 H(A1) 로만 보관). 착신 응답 등으로 관제 화면에 다녀와도 이 폼은 유지됩니다." />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
