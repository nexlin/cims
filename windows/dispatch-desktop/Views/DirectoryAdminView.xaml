<UserControl x:Class="DispatchDesktop.Views.DirectoryAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DirectoryAdminViewModel}">
    <!-- [관리] 화면 본문(§4.5) — 왼쪽 서브내비(후속 항목 자리) | 조직 트리 · 구성원 목록 · 편집 폼. 서버가 관리 범위로 걸러 준 것만 보인다 -->
    <DockPanel>
        <!-- 서브내비 -->
        <Border DockPanel.Dock="Left" Width="200" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="10,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Text="{Binding ScopeText}" TextWrapping="Wrap" Margin="10,8,10,0" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Text="관제 그룹 편성(멤버·대표번호·범위)은 콘솔 몫." TextWrapping="Wrap" Margin="10,0,10,4" />
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="관리" Margin="10,0,0,8" />
                    <Border Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="6" Padding="10,0" Height="34">
                        <TextBlock Text="조직 · 구성원 · 번호" Foreground="{DynamicResource Brush.Primary}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="6" Padding="10,0" Height="34" ToolTip="구성원 일괄 가져오기(CSV, 콘솔 import 와 같은 형식) — 후속 과제(§13)">
                        <DockPanel VerticalAlignment="Center">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="0"><TextBlock Text="예정" /></Border>
                            <TextBlock Text="CSV 가져오기" Foreground="{DynamicResource Brush.Wire}" FontSize="13.5" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Margin="10" IsEnabled="{Binding Busy, Converter={StaticResource Not}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>
                <!-- 조직 트리 — 머리 [+ 새 조직], 바닥 [편집][삭제](시안 §4.5) -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,10,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource LogHeader}" Padding="12,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Xs}" Content="+ 새 조직" Command="{Binding NewOrgCommand}" />
                                <TextBlock Text="조직" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Xs}" Content="편집" Command="{Binding BeginEditOrgCommand}" Margin="0,0,4,0" />
                                <Button Style="{StaticResource Btn.Xs.Danger}" Content="삭제" Command="{Binding DeleteOrgCommand}" />
                            </StackPanel>
                        </Border>
                        <ListBox Style="{StaticResource SelectList}" ItemsSource="{Binding Orgs}" SelectedItem="{Binding SelectedOrg}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OrgRow}">
                                    <Border Style="{StaticResource LogRow}" Padding="10,0" Height="30">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding CountText}" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" ToolTip="{Binding Code}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <!-- 구성원 표 — 머리 "구성원 N명 · 조직 하위 포함" + 검색 + [+ 새 구성원], 열 = 이름·직함·소속 | VoLTE | PTT | 자격 -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,10,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource LogHeader}" Padding="12,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBox Style="{StaticResource Field}" Width="200" Height="26" Margin="0,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="이름·아이디·번호 검색" />
                                    <Button Style="{StaticResource Btn.Sm}" Content="↻" ToolTip="새로고침" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource Btn.Sm.Pri}" Content="+ 새 구성원" Command="{Binding NewMemberCommand}" />
                                </StackPanel>
                                <TextBlock VerticalAlignment="Center" FontSize="13">
                                    <Run Text="구성원" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding MemberHeader, Mode=OneWay}" Foreground="{DynamicResource Brush.Muted}" FontSize="12.5" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Emg}" Text="{Binding Error}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                            </DockPanel>
                        </Border>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Hint}" Text="이름 · 직함 · 소속" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Text="VoLTE" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Text="PTT" />
                                <TextBlock Grid.Column="3" Style="{StaticResource Hint}" Text="자격" />
                            </Grid>
                        </Border>
                        <ListBox Style="{StaticResource SelectList}" ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}" MouseDoubleClick="Members_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MemberRow}">
                                    <Border Style="{StaticResource LogRow}" Padding="12,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Title}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Bottom" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" Text="{Binding OrgPath}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding VolteCell}" FontSize="12.5" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Mono}" Text="{Binding PttCell}" FontSize="12.5" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource Badge.Member}" Visibility="{Binding CanCreateGroup, Converter={StaticResource BoolToVis}}"><TextBlock Text="그룹 생성" /></Border>
                                                <Border Style="{StaticResource Badge.Listen}" Margin="4,0,0,0" Visibility="{Binding CanAmbientListen, Converter={StaticResource BoolToVis}}"><TextBlock Text="원격 청취" /></Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <!-- 편집 폼 -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"
                                   Text="구성원을 클릭하면 여기서 바로 편집합니다. 조직은 트리에서 골라 [편집], 새로 만들려면 [+ 새 조직]/[+ 새 구성원].&#10;&#10;번호(VoLTE·PTT 회선)는 구성원 폼에서 개설·변경·삭제합니다. 새 회선과 번호 변경에는 SIP 비밀번호가 필요합니다(서버가 H(A1) 로만 보관).">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OrgEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding MemberEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- 조직 폼 -->
                        <StackPanel Visibility="{Binding OrgEditing, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding OrgFormTitle}" Margin="0,0,0,8" />
                            <TextBlock Text="코드 (불변 키)" Style="{StaticResource Hint}" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding OrgCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding OrgIsNew}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,8" />
                            <TextBlock Text="이름" Style="{StaticResource Hint}" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding OrgName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                            <TextBlock Text="상위 조직" Style="{StaticResource Hint}" />
                            <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Orgs}" SelectedItem="{Binding OrgParent}" DisplayMemberPath="Label" Margin="0,2,0,8" />
                            <TextBlock Text="정렬 순서" Style="{StaticResource Hint}" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding OrgSort, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="0,2,0,12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource Btn}" Content="취소" Command="{Binding CancelOrgCommand}" Margin="0,0,6,0" />
                                <Button Style="{StaticResource Btn.Pri}" Content="저장" Command="{Binding SaveOrgCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <!-- 구성원 폼 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding MemberEditing, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,6,0">
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Xs.Danger}" Content="삭제" Command="{Binding DeleteMemberCommand}" Visibility="{Binding MemberIsNew, Converter={StaticResource NotToVis}}" ToolTip="구성원과 VoLTE/PTT 회선을 삭제" />
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding MemberFormTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="이름" Style="{StaticResource Hint}" />
                                        <TextBox Style="{StaticResource Field}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="직함" Style="{StaticResource Hint}" />
                                        <TextBox Style="{StaticResource Field}" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="소속 조직" Style="{StaticResource Hint}" />
                                <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Orgs}" SelectedItem="{Binding EditOrg}" DisplayMemberPath="Label" Margin="0,2,0,8" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="로그인 아이디 (단말 로그인)" Style="{StaticResource Hint}" />
                                        <TextBox Style="{StaticResource Field}" Text="{Binding EditLoginId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="로그인 비밀번호 (변경 시만)" Style="{StaticResource Hint}" />
                                        <PasswordBox x:Name="LoginPw" Style="{StaticResource FieldPw}" PasswordChanged="LoginPw_Changed" Margin="0,2,0,8" />
                                    </StackPanel>
                                </UniformGrid>
                                <!-- VoLTE 회선 -->
                                <Border Style="{StaticResource Sub}" Margin="0,4,0,6" Padding="8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="VoLTE 번호" Margin="0,0,0,4" />
                                        <TextBlock Text="번호 (E.164, 비우면 회선 삭제)" Style="{StaticResource Hint}" />
                                        <TextBox Style="{StaticResource Field}" Text="{Binding VolteNumber, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,6" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="접속서비스" Style="{StaticResource Hint}" />
                                                <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding VolteServices}" SelectedItem="{Binding VolteService}" DisplayMemberPath="Label" Margin="0,2,0,6" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="SIP transport" Style="{StaticResource Hint}" />
                                                <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Transports}" SelectedItem="{Binding VolteTransport}" Margin="0,2,0,6" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Emg}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Text="접속서비스 목록이 비어 있습니다 — 서버(CSC)가 후보를 내려주지 않아 회선 개설이 실패합니다. 운영자에게 csc.json Provisioning.Services 설정을 요청하세요."
                                                   Visibility="{Binding NoVolteServices, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="SIP 비밀번호 (개설·번호 변경 시 필수)" Style="{StaticResource Hint}" />
                                        <PasswordBox x:Name="VoltePw" Style="{StaticResource FieldPw}" PasswordChanged="VoltePw_Changed" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <!-- PTT 회선 -->
                                <Border Style="{StaticResource Sub}" Margin="0,0,0,8" Padding="8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="PTT 번호" Margin="0,0,0,4" />
                                        <TextBlock Text="번호 (E.164, 비우면 회선 삭제)" Style="{StaticResource Hint}" />
                                        <TextBox Style="{StaticResource Field}" Text="{Binding PttNumber, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,6" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="접속서비스" Style="{StaticResource Hint}" />
                                                <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding PttServices}" SelectedItem="{Binding PttService}" DisplayMemberPath="Label" Margin="0,2,0,6" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="SIP transport" Style="{StaticResource Hint}" />
                                                <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Transports}" SelectedItem="{Binding PttTransport}" Margin="0,2,0,6" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Emg}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Text="접속서비스 목록이 비어 있습니다 — 서버(CSC)가 후보를 내려주지 않아 회선 개설이 실패합니다. 운영자에게 csc.json Provisioning.Services 설정을 요청하세요."
                                                   Visibility="{Binding NoPttServices, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="SIP 비밀번호 (개설·번호 변경 시 필수)" Style="{StaticResource Hint}" />
                                        <PasswordBox x:Name="PttPw" Style="{StaticResource FieldPw}" PasswordChanged="PttPw_Changed" Margin="0,2,0,6" />
                                        <CheckBox Style="{StaticResource Switch}" Content="PTT 그룹 생성 자격 (allow-create-group)" IsChecked="{Binding AllowCreateGroup}" Margin="0,2,0,6" />
                                        <CheckBox Style="{StaticResource Switch}" Content="원격 청취 자격 (allow-ambient-listening — 관제사)" IsChecked="{Binding AllowAmbientListening}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" Text="착신 응답 등으로 관제 화면에 다녀와도 이 폼은 유지됩니다." Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource Btn}" Content="취소" Command="{Binding CancelMemberCommand}" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource Btn.Pri}" Content="저장" Command="{Binding SaveMemberCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
