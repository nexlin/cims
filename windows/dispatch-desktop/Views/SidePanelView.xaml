<UserControl x:Class="DispatchDesktop.Views.SidePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:v="clr-namespace:DispatchDesktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}" x:Name="Root">
    <!-- 오른쪽 패널 440(§3.6) — 머리 56([←] · 종류 라벨 · 제목 · 핀 · ×) + 내용 하나: 채널 상세 · 사용자 · 새 PTT 그룹 · 이벤트 상세 · 주소록.
         오른쪽 칸만 민다(왼쪽 칸 1040 은 그대로). 같은 대상 = 닫기 · 다른 대상 = 교체 · 핀 = 모드·레일을 옮겨도 남는다 -->
    <Border Width="440" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Edge}" BorderThickness="1,0,0,0">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.18" Direction="180" /></Border.Effect>
        <DockPanel>
            <!-- 머리 -->
            <Border DockPanel.Dock="Top" Height="56" Padding="10,0,6,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" DataContext="{Binding Panel}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="44" Height="44" Command="{Binding CloseCommand}" ToolTip="패널 닫기">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.X}" Width="20" Height="20" StrokeThickness="2.2" TextElement.Foreground="{DynamicResource Brush.Ink}" />
                    </Button>
                    <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Pinned, Mode=OneWay}" Command="{Binding TogglePinCommand}" Width="40" Height="40" Cursor="Hand" Focusable="False"
                                  Visibility="{Binding HasPin, Converter={StaticResource BoolToVis}}" ToolTip="고정하면 모드·레일을 옮겨도 남는다">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                    <Path x:Name="P" Data="{StaticResource Icon.Pin}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="2" Stroke="{DynamicResource Brush.Muted}" Fill="Transparent"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" /></Trigger>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="P" Property="Fill" Value="{DynamicResource Brush.Primary}" /><Setter TargetName="P" Property="Stroke" Value="{DynamicResource Brush.Primary}" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconBtn}" Width="40" Height="44" Command="{Binding BackCommand}" Visibility="{Binding HasBack, Converter={StaticResource BoolToVis}}" ToolTip="뒤로 — 사용자 목록">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronLeft}" Width="20" Height="20" StrokeThickness="2.2" TextElement.Foreground="{DynamicResource Brush.Ink}" />
                    </Button>
                    <Border DockPanel.Dock="Left" CornerRadius="4" Padding="7,2" Background="{DynamicResource Brush.Surface2}" VerticalAlignment="Center" Margin="4,0,8,0"
                            Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSoft}" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                </DockPanel>
            </Border>

            <Grid>
                <!-- ═══ 채널 상세 ═══ -->
                <DockPanel DataContext="{Binding Panel.Channel}" Visibility="{Binding DataContext.Panel.IsChannel, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding Summary}" Margin="16,10,16,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="16,8,16,0" Visibility="{Binding HasLabels, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource Tag.Emg}" Height="20" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}"><TextBlock Text="긴급" /></Border>
                            <Border Style="{StaticResource Tag.Peril}" Height="20" Visibility="{Binding IsImminentPeril, Converter={StaticResource BoolToVis}}"><TextBlock Text="임박 위험" /></Border>
                            <Border Style="{StaticResource Tag.Ink}" Height="20" Visibility="{Binding IsBroadcast, Converter={StaticResource BoolToVis}}"><TextBlock Text="일제 통화" /></Border>
                        </StackPanel>
                        <!-- 조작 — 카드의 판정 그대로 -->
                        <WrapPanel Margin="16,12,10,0">
                            <Button Style="{StaticResource Pill.Ink}" Height="36" Padding="14,0" Margin="0,0,6,6" Content="참여" Command="{Binding JoinCommand}" Visibility="{Binding ShowJoin, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Pill.Red}" Height="36" Padding="14,0" Margin="0,0,6,6" Content="{Binding EmergencyText}" Command="{Binding EmergencyCommand}" IsEnabled="{Binding CanEmergency}"
                                    ToolTip="{Binding EmergencyTip}" Visibility="{Binding ShowEmergency, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Pill.Line}" Height="36" Padding="14,0" Margin="0,0,6,6" Content="긴급 해제" Command="{Binding CancelEmergencyCommand}"
                                    ToolTip="긴급·임박 조건 해제 요청(TS 24.379 §10.1.1.2.1.4) — 내가 올린 긴급만" Visibility="{Binding ShowCancelEmergency, Converter={StaticResource BoolToVis}}" />
                            <!-- [일제 통화] — 누르는 동안 개시하고 말한다 · 놓으면 끝(잠금 발언이면 클릭 토글) -->
                            <v:HoldButton Height="36" Padding="14,0" Margin="0,0,6,6" Content="{Binding BroadcastText}" IsEnabled="{Binding CanPressBroadcast}" ToolTip="{Binding BroadcastTip}"
                                          DownCommand="{Binding DataContext.PttChannels.BroadcastPressCommand, ElementName=Root}" HoldParameter="{Binding Card}"
                                          UpCommand="{Binding DataContext.PttChannels.BroadcastReleaseCommand, ElementName=Root}" Visibility="{Binding ShowBroadcast, Converter={StaticResource BoolToVis}}">
                                <v:HoldButton.Style>
                                    <Style TargetType="v:HoldButton" BasedOn="{StaticResource Pill.Line}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsBroadcastHeld}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Primary}" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" /><Setter Property="BorderThickness" Value="0" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </v:HoldButton.Style>
                            </v:HoldButton>
                            <Button Height="36" Padding="14,0" Margin="0,0,6,6" Content="{Binding TargetText}" IsEnabled="{Binding CanTarget}" Visibility="{Binding ShowTarget, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.PttChannels.ToggleTargetCommand, ElementName=Root}" CommandParameter="{Binding Card}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Pill.Line}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsTarget}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Primary}" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" /><Setter Property="BorderThickness" Value="0" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Height="36" Padding="14,0" Margin="0,0,6,6" Command="{Binding ToggleMuteCommand}" Visibility="{Binding ShowMute, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Pill.Line}">
                                        <Setter Property="Content" Value="음소거" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsMuted}" Value="True"><Setter Property="Content" Value="음소거 중" /><Setter Property="Background" Value="{DynamicResource Brush.EmgFill}" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" /><Setter Property="BorderThickness" Value="0" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource Pill.Listen}" Height="36" Padding="14,0" Margin="0,0,6,6" Content="청취" Command="{Binding ToggleListenCommand}" IsEnabled="{Binding CanListen}" ToolTip="{Binding ListenTip}"
                                    Visibility="{Binding ShowListen, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Pill.Line}" Height="36" Padding="14,0" Margin="0,0,6,6" Content="청취 중지" Command="{Binding ToggleListenCommand}" Visibility="{Binding ShowStopListen, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Pill.Soft}" Height="36" Padding="14,0" Margin="0,0,6,6" Content="창으로 ↗" Command="{Binding ShowWindowCommand}" ToolTip="청취 창에 띄우기(두 번째 모니터)"
                                    Visibility="{Binding ShowStopListen, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Pill.Soft}" Height="36" Padding="12,0" Margin="0,0,6,6" Command="{Binding ToggleRouteCommand}" IsEnabled="{Binding CanRoute}" ToolTip="출력 — 헤드셋 / 데스크 스피커"
                                    Visibility="{Binding ShowRoute, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{Binding RouteIsSpeaker, Converter={StaticResource RouteIcon}}" Margin="0,0,6,0" /><TextBlock Text="{Binding RouteText}" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Pill.Line}" Height="36" Padding="14,0" Margin="0,0,6,6" Content="{Binding LeaveText}" Command="{Binding LeaveCommand}" Visibility="{Binding ShowLeave, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Pill.Line}" Height="36" Padding="14,0" Margin="0,0,6,6" Content="{Binding MessageText}" Command="{Binding OpenMessagesCommand}" Visibility="{Binding ShowMessage, Converter={StaticResource BoolToVis}}" />
                            <!-- ⋮ 편집 · 삭제(내 소유·관리 범위) -->
                            <Grid Margin="0,0,6,6" Visibility="{Binding ShowMore, Converter={StaticResource BoolToVis}}">
                                <ToggleButton x:Name="More" Width="36" Height="36" Cursor="Hand" Focusable="False" ToolTip="편집 · 삭제">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.Surface}">
                                                <Path Style="{StaticResource Icon.Filled}" Data="{StaticResource Icon.DotsV}" Width="16" Height="16" TextElement.Foreground="{DynamicResource Brush.TextSoft}" HorizontalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" /></Trigger></ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=More}" PlacementTarget="{Binding ElementName=More}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Style="{StaticResource DropPanel}">
                                        <StackPanel>
                                            <Button Style="{StaticResource DropItem}" Content="편집 — [PTT 그룹] 화면" Command="{Binding EditCommand}" Click="More_Click" />
                                            <Button Style="{StaticResource DropItem}" Content="삭제…" Foreground="{DynamicResource Brush.Emg}" Command="{Binding DeleteCommand}" Click="More_Click" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </WrapPanel>
                        <!-- 청취 중인 타 채널 — 청취 전용 안내 · 음량 -->
                        <StackPanel Visibility="{Binding ShowStopListen, Converter={StaticResource BoolToVis}}">
                            <Border Margin="16,6,16,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource Brush.ListenSoft}">
                                <TextBlock Text="청취 전용 — 발언 요청 불가" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Listen}" />
                            </Border>
                            <DockPanel Margin="16,10,16,0" DataContext="{Binding Listen}">
                                <TextBlock DockPanel.Dock="Left" Text="음량" FontSize="12.5" Foreground="{DynamicResource Brush.TextSoft}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Volume, StringFormat=P0}" FontSize="12.5" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                                <Slider Minimum="0" Maximum="2" Value="{Binding Volume}" SmallChange="0.05" LargeChange="0.25" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                        <!-- 영상 채널(MCVideo, §10.3) — 멤버 영상 채널만. «영상 참여» 없음(앱이 영상 호에 함께 합류 — D10), 수신 manual(골라 [보기] — D8) -->
                        <Border Margin="16,14,16,0" Padding="12,10,12,8" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}" Background="{DynamicResource Brush.Surface}"
                                Visibility="{Binding ShowVideo, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="M15,10 L21,6.5 V17.5 L15,14 M3,6 H15 V18 H3 Z" Width="16" Height="16" StrokeThickness="2" Margin="0,0,6,0" TextElement.Foreground="{DynamicResource Brush.Listen}" VerticalAlignment="Center" />
                                    <TextBlock Text="영상" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding VideoSub}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding VideoSub}" />
                                </StackPanel>
                                <!-- 보는 중 — 영상 칸: 기본 세로 480×640(3:4), [↺][↻] 90° 씩 돌리면 가로(4:3)로 칸이 바뀐다(보내는 사람마다 기억). 캡션 = 이름 · 기능 별칭 · 경과.
                                     엔진이 영상을 그리지 못하면 자리 표시(단말 윤곽이 회전을 보여 준다 — 영상 호 소리는 들린다) -->
                                <Border Margin="0,8,0,0" Width="{Binding VideoFrameWidth}" Height="{Binding VideoFrameHeight}" HorizontalAlignment="Center" CornerRadius="8" Background="{DynamicResource Brush.Ink}"
                                        Visibility="{Binding IsVideoReceiving, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Device}" Width="44" Height="44" StrokeThickness="1.4" Opacity="0.55" HorizontalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource Brush.Surface}" Margin="0,0,0,10">
                                                <Path.LayoutTransform><RotateTransform Angle="{Binding VideoRotation}" /></Path.LayoutTransform>
                                            </Path>
                                            <TextBlock Text="{Binding VideoSurfaceText}" Foreground="{DynamicResource Brush.Surface}" Opacity="0.75" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" ToolTip="{Binding VideoRotationTip}">
                                            <Button Style="{StaticResource VideoOverlayBtn}" Command="{Binding RotateVideoCommand}" CommandParameter="ccw" AutomationProperties.Name="반시계 방향 90° 회전" Margin="0,0,4,0">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.RotateCcw}" Width="16" Height="16" StrokeThickness="2" />
                                            </Button>
                                            <Button Style="{StaticResource VideoOverlayBtn}" Command="{Binding RotateVideoCommand}" CommandParameter="cw" AutomationProperties.Name="시계 방향 90° 회전">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.RotateCw}" Width="16" Height="16" StrokeThickness="2" />
                                            </Button>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="8,3" CornerRadius="4" Background="#E6101317">
                                            <TextBlock Text="{Binding ReceivingCaption}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource Pill.Line.Sm}" Padding="12,0" Margin="0,0,6,6" Content="그만 보기" Command="{Binding EndVideoCommand}" ToolTip="이 영상 보기를 끝낸다(영상 호는 남는다 — TS 24.581 §6.2.5.5)"
                                            Visibility="{Binding IsVideoReceiving, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource Pill.Line.Sm}" Padding="12,0" Margin="0,0,6,6" Content="영상 소리" Command="{Binding ToggleVideoVolumeCommand}"
                                            ToolTip="영상 호 소리 크기 — 무전과의 상대 음량(TS 22.280 R-8.3-002)" Visibility="{Binding IsVideoReceiving, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource Pill.Line.Sm}" Padding="12,0" Margin="0,0,6,6" Content="영상 보내기 — 카메라 없음" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="이 PC 에는 영상 송출 장치(카메라·영상 엔진)가 없다 — 말하기는 발언 바 PTT(음성 무전, D11)" Visibility="{Binding VideoConnected, Converter={StaticResource BoolToVis}}" />
                                </WrapPanel>
                                <DockPanel Margin="0,0,0,4" Visibility="{Binding VideoVolumeOpen, Converter={StaticResource BoolToVis}}">
                                    <TextBlock DockPanel.Dock="Left" Text="영상 소리" FontSize="12.5" Foreground="{DynamicResource Brush.TextSoft}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding VideoVolume, StringFormat=P0}" FontSize="12.5" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                                    <Slider Minimum="0" Maximum="2" Value="{Binding VideoVolume}" SmallChange="0.05" LargeChange="0.25" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="보내는 사람 없음 — 누가 보내면 여기에 목록이 생깁니다" Visibility="{Binding ShowNoSender, Converter={StaticResource BoolToVis}}" />
                                <!-- «영상 n» — 보내는 중인 송출 목록 -->
                                <TextBlock Margin="0,4,0,2" FontSize="12" Foreground="{DynamicResource Brush.TextSoft}" Text="{Binding VideoCountText}" Visibility="{Binding HasVideoRows, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding VideoRows}" Visibility="{Binding HasVideoRows, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:VideoTxRow}">
                                            <Border Height="38" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                                                <DockPanel>
                                                    <!-- 보는 중 = 상태 글(버튼 아님) · 그 밖 = [보기]/[바꿔 보기](요청 중엔 흐림) -->
                                                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource Pill.ListenLine.Sm}" Padding="12,0" Content="{Binding ActionText}" IsEnabled="{Binding CanAccept}"
                                                                Command="{Binding DataContext.AcceptVideoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding IsReceiving, Converter={StaticResource NotToVis}}" />
                                                        <TextBlock Text="보는 중" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ListenInk}" Margin="0,0,6,0"
                                                                   Visibility="{Binding IsReceiving, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Meta, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSoft}" FontSize="12" />
                                                    </TextBlock>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <!-- [접속 n | 편성 m] -->
                        <Border Margin="16,14,16,8" Height="34" CornerRadius="9" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Fill}" Padding="2" Visibility="{Binding HasSegment, Converter={StaticResource BoolToVis}}">
                            <UniformGrid Columns="2">
                                <RadioButton Style="{StaticResource ModeSeg}" Width="Auto" FontSize="13" Content="{Binding SegConnected}" IsChecked="{Binding Segment, Converter={StaticResource Eq}, ConverterParameter=connected, Mode=OneWay}" Command="{Binding SetSegmentCommand}" CommandParameter="connected" />
                                <RadioButton Style="{StaticResource ModeSeg}" Width="Auto" FontSize="13" Content="{Binding SegAll}" IsChecked="{Binding Segment, Converter={StaticResource Eq}, ConverterParameter=all, Mode=OneWay}" Command="{Binding SetSegmentCommand}" CommandParameter="all" />
                            </UniformGrid>
                        </Border>
                        <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSoft}" Text="{Binding RosterHead}" Margin="16,14,16,6" Visibility="{Binding HasSegment, Converter={StaticResource NotToVis}}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding MembersNote}" Margin="16,0,16,6" Visibility="{Binding MembersNote, Converter={StaticResource StrToVis}}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChannelPersonRow}">
                                    <Border Height="50" Padding="16,0,12,0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource Tag}" Height="18" Visibility="{Binding IsChair, Converter={StaticResource BoolToVis}}"><TextBlock Text="의장" /></Border>
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.IsMine, ElementName=RosterHost, Converter={StaticResource BoolToVis}}">
                                                    <Button Style="{StaticResource Pill.Soft}" Height="32" Padding="12,0" FontSize="12" Content="개별" Margin="4,0,0,0" Visibility="{Binding CanAct, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.PrivateCallCommand, ElementName=RosterHost}" CommandParameter="{Binding}" ToolTip="개별 통화(반이중)" />
                                                    <Button Style="{StaticResource Pill.Soft}" Height="32" Padding="12,0" FontSize="12" Content="SDS" Margin="6,0,0,0" Visibility="{Binding CanAct, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.SdsCommand, ElementName=RosterHost}" CommandParameter="{Binding}" ToolTip="무전 메시지(1:1)" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border x:Name="Av" Style="{StaticResource Avatar}" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0" Tag="{Binding Name, Converter={StaticResource AvatarHue}}">
                                                <Grid>
                                                <TextBlock x:Name="AvT" Text="{Binding Initial}" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Phone}" Width="14" Height="14" StrokeThickness="2" Visibility="{Binding Initial, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                                                </Grid>
                                            </Border>
                                            <Button Style="{StaticResource Btn.Flat}" HorizontalContentAlignment="Left" Command="{Binding DataContext.PersonMenuCommand, ElementName=RosterHost}" CommandParameter="{Binding}" ToolTip="사람 메뉴">
                                                <StackPanel>
                                                    <TextBlock x:Name="Nm" FontSize="14" FontWeight="Medium"><Run Text="{Binding NameText, Mode=OneWay}" /><Run x:Name="Sp" Text="" Foreground="{DynamicResource Brush.TalkInk}" FontWeight="Bold" /></TextBlock>
                                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding Meta}" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMe}" Value="True">
                                            <Setter TargetName="Av" Property="Background" Value="{DynamicResource Brush.Fill}" /><Setter TargetName="AvT" Property="Foreground" Value="{DynamicResource Brush.OnFill}" />
                                            <Setter TargetName="Nm" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSpeaking}" Value="True"><Setter TargetName="Sp" Property="Text" Value=" · 발언 중" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsAbsent}" Value="True">
                                            <Setter TargetName="Av" Property="Background" Value="{DynamicResource Brush.Panel}" /><Setter TargetName="AvT" Property="Foreground" Value="{DynamicResource Brush.Faint}" />
                                            <Setter TargetName="Nm" Property="Foreground" Value="{DynamicResource Brush.Faint}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <!-- 로스터 줄 명령의 기준(채널 상세 VM) -->
                <FrameworkElement x:Name="RosterHost" DataContext="{Binding Panel.Channel}" Visibility="Collapsed" />

                <!-- ═══ 사용자(무전) ═══ -->
                <DockPanel DataContext="{Binding Users}" Visibility="{Binding DataContext.Panel.IsUsers, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <Grid DockPanel.Dock="Top" Margin="16,12,16,8" Height="40">
                        <Border CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Edge}" />
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Search}" Width="16" Height="16" StrokeThickness="2" HorizontalAlignment="Left" Margin="12,0,0,0" TextElement.Foreground="{DynamicResource Brush.Muted}" />
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="36,0,10,0" FontSize="13.5" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Text}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="13.5" Text="이름 · PTT 번호 · 조직" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Search, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                    </Grid>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Orgs}" Margin="16,0,16,10">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OrgChip}">
                                <RadioButton Style="{StaticResource FilterChip}" Height="30" Margin="0,0,6,6" Content="{Binding Label}" GroupName="UserOrg"
                                             Command="{Binding DataContext.SetOrgCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource SameRef}" Mode="OneWay">
                                            <Binding />
                                            <Binding Path="DataContext.Org" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 바닥 — 고른 사람 · 긴급 · [일제 통화] · [애드혹 열기][그룹으로 저장] -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding ClearPickedCommand}" Visibility="{Binding HasPicked, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="선택 해제" TextDecorations="Underline" FontSize="12.5" />
                                </Button>
                                <TextBlock Text="{Binding PickedText}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <v:HoldButton DockPanel.Dock="Right" Height="32" Padding="14,0" Content="{Binding BroadcastText}" IsEnabled="{Binding CanPressBroadcast}" ToolTip="{Binding BroadcastTip}"
                                              DownCommand="{Binding BroadcastDownCommand}" UpCommand="{Binding BroadcastUpCommand}">
                                    <v:HoldButton.Style>
                                        <Style TargetType="v:HoldButton" BasedOn="{StaticResource Pill.Line}">
                                            <Style.Triggers><DataTrigger Binding="{Binding IsBroadcastHeld}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Primary}" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" /><Setter Property="BorderThickness" Value="0" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </v:HoldButton.Style>
                                </v:HoldButton>
                                <CheckBox Content="긴급으로 열기" IsChecked="{Binding Emergency}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Emg}" ToolTip="애드혹 그룹 통화를 긴급으로 개시" />
                            </DockPanel>
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource Pill.Line.Lg}" Padding="8,0" Margin="0,0,4,0" Content="애드혹 열기 · 지금 한 번" Command="{Binding StartAdhocCommand}" IsEnabled="{Binding CanStart}"
                                        ToolTip="고른 사람으로 애드혹 그룹 통화 — 저장하지 않는다" />
                                <Button Style="{StaticResource Pill.Ink.Lg}" Padding="8,0" Margin="4,0,0,0" Content="그룹으로 저장 ›" Command="{Binding SaveAsGroupCommand}" IsEnabled="{Binding CanSaveGroup}"
                                        ToolTip="고른 사람으로 새 PTT 그룹(GMS)" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Users}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PttUserRow}">
                                    <Border x:Name="Row" Height="48" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="36" Height="36" Margin="0,0,6,0" ToolTip="사람 메뉴"
                                                    Command="{Binding DataContext.MenuCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <Path Style="{StaticResource Icon.Filled}" Data="{StaticResource Icon.DotsV}" Width="16" Height="16" />
                                            </Button>
                                            <Button Style="{StaticResource RowBtn}" Padding="16,0,6,0" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <DockPanel>
                                                    <TextBlock x:Name="St" DockPanel.Dock="Right" Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Brush.Faint}" VerticalAlignment="Center" />
                                                    <Border x:Name="Box" Width="22" Height="22" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource Brush.Edge}" Background="{DynamicResource Brush.Surface}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Path x:Name="Ck" Data="{StaticResource Icon.Check}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource Brush.OnFill}" StrokeThickness="3.5" Visibility="Collapsed"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding Meta}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Checked}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Fill}" /><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Fill}" /><Setter TargetName="Ck" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter TargetName="St" Property="Foreground" Value="{DynamicResource Brush.TalkInk}" /></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ═══ 새 PTT 그룹 ═══ -->
                <DockPanel DataContext="{Binding Panel.Group}" Visibility="{Binding DataContext.Panel.IsGroup, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource Pill.Line.Lg}" FontWeight="Normal" Content="취소" Command="{Binding CancelCommand}" />
                            <Button DockPanel.Dock="Right" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Pill.Ink.Lg}">
                                        <Setter Property="Content" Value="그룹 만들기" />
                                        <Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Content" Value="만드는 중…" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,14,16,14">
                            <TextBlock Text="그룹 이름" FontSize="12" Foreground="{DynamicResource Brush.TextSoft}" Margin="0,0,0,5" />
                            <Grid Height="44" Margin="0,0,0,14">
                                <Border CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Edge}" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="12,0" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                         Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Text}" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="14" Text="예) 3번 게이트 대응" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Name, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                            </Grid>
                            <TextBlock Text="그룹 id — 만든 뒤 바꿀 수 없음" FontSize="12" Foreground="{DynamicResource Brush.TextSoft}" Margin="0,0,0,5" />
                            <Border Height="40" CornerRadius="8" Background="{DynamicResource Brush.Panel}" Padding="12,0" Margin="0,0,0,14">
                                <TextBox Text="{Binding GroupId, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" FontSize="13" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" Foreground="{DynamicResource Brush.TextSoft}" CaretBrush="{DynamicResource Brush.Text}" ToolTip="{Binding Uri}" />
                            </Border>
                            <TextBlock Text="세션 종류" FontSize="12" Foreground="{DynamicResource Brush.TextSoft}" Margin="0,0,0,5" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button Height="36" Padding="14,0" Margin="0,0,6,0" Content="편성(prearranged)" Command="{Binding SetSessionTypeCommand}" CommandParameter="prearranged">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Pill.Soft}"><Style.Triggers><DataTrigger Binding="{Binding IsPrearranged}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Fill}" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnFill}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontWeight" Value="Bold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Height="36" Padding="14,0" Content="채팅(chat)" Command="{Binding SetSessionTypeCommand}" CommandParameter="chat">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Pill.Soft}"><Style.Triggers><DataTrigger Binding="{Binding IsChat}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Fill}" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnFill}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontWeight" Value="Bold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSoft}" Margin="0,0,0,6"><Run Text="멤버 " /><Run Text="{Binding MemberCountText, Mode=OneWay}" /><Run Text=" (나 포함) — 사용자 목록에서 고른 사람" /></TextBlock>
                            <ItemsControl ItemsSource="{Binding Members}" Margin="0,0,0,14">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GroupMemberRow}">
                                        <Border x:Name="Chip" Height="30" CornerRadius="14" Padding="12,0,6,0" Margin="0,0,6,6" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.Surface}"
                                                TextElement.Foreground="{DynamicResource Brush.Text}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="T" Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock x:Name="Role" Text=" · 의장" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed" />
                                                <Button x:Name="X" Style="{StaticResource Btn.Flat}" Width="20" Height="20" Margin="4,0,0,0" ToolTip="멤버에서 빼기"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.X}" Width="11" Height="11" StrokeThickness="2.2" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsChair}" Value="True">
                                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" /><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                                <Setter TargetName="Chip" Property="TextElement.Foreground" Value="{DynamicResource Brush.PrimaryInk}" /><Setter TargetName="Chip" Property="Padding" Value="12,0" />
                                                <Setter TargetName="Role" Property="Visibility" Value="Visible" /><Setter TargetName="T" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMe}" Value="True"><Setter TargetName="X" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Height="44" Cursor="Hand" Command="{Binding DataContext.GroupAdvancedCommand, ElementName=Root}" ToolTip="능력·우선순위·확인 통화·멤버 역할 — [PTT 그룹] 화면에서 이어 쓴다">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Rectangle x:Name="R" RadiusX="8" RadiusY="8" Stroke="{DynamicResource Brush.Faint}" StrokeThickness="1.5" StrokeDashArray="4 3" />
                                            <TextBlock Text="▸ 고급 설정 — SDS · 파일 · 영상 · 암호화 · 긴급 · 우선순위" FontSize="13" Foreground="{DynamicResource Brush.TextSoft}" VerticalAlignment="Center" Margin="14,0" />
                                        </Grid>
                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="R" Property="Stroke" Value="{DynamicResource Brush.Primary}" /></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Emg}" Text="{Binding Error}" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- ═══ 이벤트 상세 ═══ -->
                <DockPanel DataContext="{Binding Panel.Event}" Visibility="{Binding DataContext.Panel.IsEvent, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
                        <UniformGrid Rows="1">
                            <Button Style="{StaticResource Pill.Ink.Lg}" Padding="6,0" Margin="0,0,6,0" FontSize="13" Content="답장" Command="{Binding DataContext.EventReplyCommand, ElementName=Root}" Visibility="{Binding CanReply, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Pill.Line.Lg}" Padding="6,0" Margin="0,0,6,0" FontSize="13" Content="채널 열기" Command="{Binding DataContext.EventChannelCommand, ElementName=Root}" IsEnabled="{Binding HasChannel}" />
                            <Button Style="{StaticResource Pill.Soft.Lg}" Padding="6,0" FontSize="13" Content="이력에서 세션 보기 ›" Command="{Binding DataContext.EventHistoryCommand, ElementName=Root}" />
                        </UniformGrid>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Margin="16,8,16,0">
                        <StackPanel.Resources>
                            <Style TargetType="Border" x:Key="EvField"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="Padding" Value="0,10" /></Style>
                        </StackPanel.Resources>
                        <Border Style="{StaticResource EvField}"><DockPanel><TextBlock Width="72" Style="{StaticResource Muted}" FontSize="13.5" Text="시각" /><TextBlock Style="{StaticResource Mono}" FontSize="13.5" Text="{Binding TimeText}" /></DockPanel></Border>
                        <Border Style="{StaticResource EvField}"><DockPanel><TextBlock Width="72" Style="{StaticResource Muted}" FontSize="13.5" Text="채널" /><TextBlock FontSize="13.5" Text="{Binding Channel}" /></DockPanel></Border>
                        <Border Style="{StaticResource EvField}"><DockPanel><TextBlock Width="72" Style="{StaticResource Muted}" FontSize="13.5" Text="종류" /><TextBlock FontSize="13.5" Text="{Binding KindText}" /></DockPanel></Border>
                        <Border Style="{StaticResource EvField}"><DockPanel><TextBlock Width="72" Style="{StaticResource Muted}" FontSize="13.5" Text="내용" /><TextBlock FontSize="13.5" Text="{Binding Content}" TextWrapping="Wrap" /></DockPanel></Border>
                        <TextBlock Text="앞뒤 이벤트" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSoft}" Margin="0,16,0,6" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,0">
                        <ItemsControl ItemsSource="{Binding Around}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EventRow}">
                                    <Border Height="36" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource Mono}" FontSize="13" Foreground="{DynamicResource Brush.TextSoft}" Text="{Binding Time, StringFormat=HH:mm:ss}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock x:Name="Tx" FontSize="13" Text="{Binding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource SameRef}">
                                                    <Binding Path="Row" />
                                                    <Binding Path="DataContext.Row.Row" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="Tx" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ═══ 주소록(통화) ═══ -->
                <DockPanel DataContext="{Binding CallOriginate}" Visibility="{Binding DataContext.Panel.IsDirectory, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <Grid DockPanel.Dock="Top" Margin="16,12,16,8" Height="40">
                        <Border CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Edge}" />
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Search}" Width="16" Height="16" StrokeThickness="2" HorizontalAlignment="Left" Margin="12,0,0,0" TextElement.Foreground="{DynamicResource Brush.Muted}" />
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="36,0,10,0" FontSize="13.5" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Text}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="13.5" Text="이름 · 번호" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Search, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                    </Grid>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding OrgChips}" Margin="16,0,16,10">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OrgChoice}">
                                <RadioButton Style="{StaticResource FilterChip}" Height="30" Margin="0,0,6,6" Content="{Binding ChipText}" GroupName="DirOrg"
                                             Command="{Binding DataContext.SetOrgCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource SameRef}" Mode="OneWay">
                                            <Binding />
                                            <Binding Path="DataContext.OrgScope" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Text="{Binding SyncText}" Margin="16,6,16,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Book}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BookRow}">
                                    <Border Height="54" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource RoundBtn}" Width="38" Height="38" Margin="0,0,12,0" ToolTip="바로 걸기" Foreground="{DynamicResource Brush.TalkInk}"
                                                    Command="{Binding DataContext.CallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Phone}" Width="16" Height="16" StrokeThickness="2" />
                                            </Button>
                                            <Button Style="{StaticResource RowBtn}" Padding="16,0,6,0" ToolTip="사람 메뉴 — 통화 · 문자 · 개별 통화 · 무전 메시지 · 기록 보기"
                                                    Command="{Binding DataContext.People.OpenMenuForCommand, ElementName=Root}" CommandParameter="{Binding Number}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Brush.TalkInk}" VerticalAlignment="Center" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" />
                                                        <TextBlock Style="{StaticResource Muted}" FontSize="12"><Run Text="{Binding DisplayNumber, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding OrgPath, Mode=OneWay}" /></TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
