<UserControl x:Class="DispatchDesktop.Views.CallModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}" x:Name="Root">
    <!-- [통화] 한 화면(§3.1) — 왼쪽 칸 1040 = «통화»(번호칸·[발신]·[키패드](누를 때만 팝오버)·[픽업] / 대표번호 대기열 · 내 통화 · 진행 중(감청은 행 확장) · 관제 그룹원),
         오른쪽 = «기록»(통화 + 문자를 상대별로 — 목록 300 : 그 상대의 한 줄기, 거르기 전체/통화/문자/부재/대표번호, 오늘 집계 한 줄). 주소록은 탭 줄 [주소록] 패널 -->
    <Grid x:Name="Board" SizeChanged="Board_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="1040" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ 통화 ═══ -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <DockPanel>
                    <!-- 머리 줄 — 번호칸은 300 까지, 칸이 좁으면(작은 창·패널) 150 까지 줄어 버튼이 잘리지 않는다(맨 끝 * = 남는 폭) -->
                    <Border DockPanel.Dock="Top" Height="56" Padding="16,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1000*" MinWidth="158" MaxWidth="308" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Title16}" Text="통화" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Height="38" Margin="0,0,8,0">
                                <Border CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Edge}" Background="{DynamicResource Brush.Surface}" />
                                <TextBox x:Name="NumberBox" Text="{Binding CallOriginate.Number, UpdateSourceTrigger=PropertyChanged}" KeyDown="Number_KeyDown" LostKeyboardFocus="Number_LostFocus"
                                         Margin="10,0" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Height="34"
                                         Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Text}" ToolTip="번호 · 내선 · 이름 또는 sip: URI — Enter = 발신" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="14" Text="번호 · 내선 · 이름 — 숫자를 치면 여기로" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding CallOriginate.Number, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                                <Popup IsOpen="{Binding CallOriginate.HasSuggestions, Mode=OneWay}" PlacementTarget="{Binding ElementName=NumberBox}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                                    <Border Style="{StaticResource PopPanel}" Width="320" Padding="4" MaxHeight="240">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding CallOriginate.Suggestions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:BookRow}">
                                                        <Button Style="{StaticResource DropItem}" Padding="8,4" HorizontalContentAlignment="Stretch" Focusable="False"
                                                                Command="{Binding DataContext.CallOriginate.PickCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Xs.Pri}" Content="발신" Focusable="False" Command="{Binding DataContext.CallOriginate.CallSuggestionCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                                                <TextBlock VerticalAlignment="Center">
                                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Medium" /><Run Text="  " />
                                                                    <Run Text="{Binding DisplayNumber, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Muted}" />
                                                                </TextBlock>
                                                            </DockPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Button Grid.Column="2" Style="{StaticResource Rect.Call}" Height="38" Padding="18,0" FontSize="14" Content="발신" Command="{Binding CallOriginate.DialCommand}" Margin="0,0,8,0" />
                            <ToggleButton Grid.Column="3" Style="{StaticResource Rect.Toggle}" Height="38" IsChecked="{Binding KeypadOpen, Mode=TwoWay}" Margin="0,0,8,0" ToolTip="키패드 — 필요할 때만 (통화 중이면 DTMF)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon.Filled}" Data="{StaticResource Icon.Keypad}" Width="15" Height="15" Margin="0,0,6,0" />
                                    <TextBlock Text="키패드" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Grid.Column="4" Style="{StaticResource Rect.Soft}" Height="38" Padding="12,0" Command="{Binding CallOriginate.PickupCommand}" ToolTip="그룹 픽업(당겨받기) F8 — 가장 오래 울린 호">
                                <TextBlock><Run Text="픽업 " /><Run Text="(가장 오래 울린 호)" /></TextBlock>
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,10,16,14" DataContext="{Binding CallDesk}">
                            <!-- 대표번호 대기열 -->
                            <StackPanel Margin="0,0,0,14" Visibility="{Binding HasDesk, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="14" FontWeight="Bold" Margin="0,0,0,6"><Run Text="대표번호 대기열 " /><Run Text="{Binding QueueCount, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding EmptyQueueText}" Visibility="{Binding QueueEmpty, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding Queue}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:QueueItem}">
                                            <Border CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Ring}" Background="{DynamicResource Brush.RingSoft}" Padding="14,10" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource Rect.Call}" Height="36" Padding="18,0" Content="응답" Command="{Binding AnswerCommand}" Margin="0,0,6,0"
                                                                Visibility="{Binding RingsMe, Converter={StaticResource BoolToVis}}" ToolTip="이 발신자의 내 착신 leg 만 받는다" />
                                                        <Button Style="{StaticResource Rect.Soft}" Height="36" FontWeight="Bold" Content="당겨받기" Command="{Binding PickupCommand}"
                                                                Visibility="{Binding IsRinging, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Bell}" Width="17" Height="17" StrokeThickness="2" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding Caller}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <TextBlock Style="{StaticResource Mono}" FontSize="13" Text="{Binding Elapsed, Converter={StaticResource Elapsed}}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding InfoLine, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <!-- 내 통화 -->
                            <TextBlock FontSize="14" FontWeight="Bold" Margin="0,0,0,6"><Run Text="내 통화 " /><Run Text="{Binding CallCount, Mode=OneWay}" /></TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Text="통화 없음" Margin="0,0,0,14" Visibility="{Binding Calls.Count, Converter={StaticResource ZeroToVis}}" />
                            <ItemsControl ItemsSource="{Binding Calls}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CallCard}">
                                        <Grid Margin="0,0,0,6">
                                            <!-- 펼친 카드(활성·착신·발신·상담) -->
                                            <Border x:Name="Card" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}" Padding="14,10"
                                                    Visibility="{Binding IsCompact, Converter={StaticResource NotToVis}}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" FontSize="13" Foreground="{DynamicResource Brush.TextSoft}" Text="{Binding StateLine}" VerticalAlignment="Center" />
                                                        <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{DynamicResource Brush.TalkInk}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <Button Style="{StaticResource Btn.Flat}" Command="{Binding MenuCommand}" ToolTip="{Binding Session.Info.RemoteUri}" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" />
                                                        </Button>
                                                        <Border Style="{StaticResource Tag.Pilot}" Visibility="{Binding PathBadge, Converter={StaticResource StrToVis}}"><TextBlock Text="{Binding PathBadge}" /></Border>
                                                        <Border Style="{StaticResource Tag}" Visibility="{Binding IsPilotIncoming, Converter={StaticResource NotToVis}}"><TextBlock Text="직접" /></Border>
                                                        <Border Style="{StaticResource Tag.Emg}" Visibility="{Binding Session.Info.Muted, Converter={StaticResource BoolToVis}}"><TextBlock Text="음소거" /></Border>
                                                        <Button Style="{StaticResource IconBtn}" Command="{Binding RouteCommand}" IsEnabled="{Binding CanToggleRoute}" ToolTip="출력 — 헤드셋 / 데스크 스피커" HorizontalAlignment="Left">
                                                            <Path Style="{StaticResource Icon}" Data="{Binding Session.RouteIsSpeaker, Converter={StaticResource RouteIcon}}" />
                                                        </Button>
                                                    </DockPanel>
                                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Session.TransferNote}" Margin="19,4,0,0" Visibility="{Binding HasTransferNote, Converter={StaticResource BoolToVis}}" />
                                                    <DockPanel Margin="0,10,0,0">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Button Style="{StaticResource Rect.Red}" Content="거절" Command="{Binding RejectCommand}" Margin="6,0,0,0" Visibility="{Binding CanAnswer, Converter={StaticResource BoolToVis}}" ToolTip="486 통화 중" />
                                                            <Button Style="{StaticResource Rect.Red}" Content="종료" Padding="18,0" Command="{Binding HangupCommand}" Margin="6,0,0,0" Visibility="{Binding CanAnswer, Converter={StaticResource NotToVis}}" />
                                                        </StackPanel>
                                                        <WrapPanel>
                                                            <WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource Rect.Soft}"><Setter Property="Margin" Value="0,0,6,0" /></Style></WrapPanel.Resources>
                                                            <Button Style="{StaticResource Rect.Call}" Content="응답" Padding="18,0" Margin="0,0,6,0" Command="{Binding AnswerCommand}" Visibility="{Binding CanAnswer, Converter={StaticResource BoolToVis}}" />
                                                            <Button Content="보류" Command="{Binding HoldCommand}" Visibility="{Binding CanHold, Converter={StaticResource BoolToVis}}" />
                                                            <Button Content="보류 해제" Command="{Binding ResumeCommand}" Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" />
                                                            <Button Command="{Binding MuteCommand}" Visibility="{Binding CanHold, Converter={StaticResource BoolToVis}}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource Rect.Soft}">
                                                                        <Setter Property="Margin" Value="0,0,6,0" /><Setter Property="Content" Value="음소거" />
                                                                        <Style.Triggers><DataTrigger Binding="{Binding Session.Info.Muted}" Value="True"><Setter Property="Content" Value="음소거 해제" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <!-- DTMF — 카드 옆 3×4 패드 -->
                                                            <Grid Visibility="{Binding CanHold, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0">
                                                                <ToggleButton x:Name="DtmfBtn" Style="{StaticResource Rect.Toggle}" FontWeight="Normal" Content="DTMF" IsChecked="{Binding DtmfOpen, Mode=TwoWay}" />
                                                                <Popup IsOpen="{Binding DtmfOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=DtmfBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                                                    <Border Style="{StaticResource PopPanel}" Width="220" Padding="8">
                                                                        <StackPanel>
                                                                            <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding DtmfSent}" MinHeight="18" Margin="2,0,2,4" TextAlignment="Right" />
                                                                            <UniformGrid Columns="3" Rows="4">
                                                                                <UniformGrid.Resources>
                                                                                    <Style TargetType="Button" BasedOn="{StaticResource Rect.Soft}"><Setter Property="Margin" Value="2" /><Setter Property="Height" Value="36" /><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Focusable" Value="False" /></Style>
                                                                                </UniformGrid.Resources>
                                                                                <Button Content="1" Command="{Binding DtmfCommand}" CommandParameter="1" /><Button Content="2" Command="{Binding DtmfCommand}" CommandParameter="2" /><Button Content="3" Command="{Binding DtmfCommand}" CommandParameter="3" />
                                                                                <Button Content="4" Command="{Binding DtmfCommand}" CommandParameter="4" /><Button Content="5" Command="{Binding DtmfCommand}" CommandParameter="5" /><Button Content="6" Command="{Binding DtmfCommand}" CommandParameter="6" />
                                                                                <Button Content="7" Command="{Binding DtmfCommand}" CommandParameter="7" /><Button Content="8" Command="{Binding DtmfCommand}" CommandParameter="8" /><Button Content="9" Command="{Binding DtmfCommand}" CommandParameter="9" />
                                                                                <Button Content="*" Command="{Binding DtmfCommand}" CommandParameter="*" /><Button Content="0" Command="{Binding DtmfCommand}" CommandParameter="0" /><Button Content="#" Command="{Binding DtmfCommand}" CommandParameter="#" />
                                                                            </UniformGrid>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Popup>
                                                            </Grid>
                                                            <!-- 전달 — 대상 입력 + 그룹원, [전달](blind) / [상담 전달](attended) -->
                                                            <Grid Visibility="{Binding CanTransfer, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0">
                                                                <ToggleButton x:Name="XferBtn" Style="{StaticResource Rect.Toggle}" FontWeight="Normal" Content="전달" IsChecked="{Binding TransferOpen, Mode=TwoWay}" />
                                                                <Popup IsOpen="{Binding TransferOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=XferBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                                                    <Border Style="{StaticResource PopPanel}" Width="300" Padding="10">
                                                                        <StackPanel>
                                                                            <TextBlock Style="{StaticResource Hint}" Text="전달 대상 — 내선·번호 · 그룹원" Margin="0,0,0,4" />
                                                                            <TextBox Style="{StaticResource Field}" Height="28" Text="{Binding TransferTarget, UpdateSourceTrigger=PropertyChanged}" />
                                                                            <ItemsControl ItemsSource="{Binding DataContext.CallDesk.MemberExtensions, ElementName=Root}" Margin="0,6,0,0">
                                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Button Style="{StaticResource Pill.Soft.Sm}" Height="26" Content="{Binding}" Margin="0,0,4,4" Focusable="False" Command="{Binding DataContext.PickMemberCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                                                <Button Style="{StaticResource Rect.Soft}" Height="30" Content="상담 전달" Command="{Binding ConsultCommand}" Margin="0,0,6,0" ToolTip="원 통화 보류 + 상담 호 → [전달 완결]" />
                                                                                <Button Style="{StaticResource Rect.Ink}" Height="30" Content="전달" Command="{Binding TransferBlindCommand}" ToolTip="blind 전달(REFER)" />
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Popup>
                                                            </Grid>
                                                            <Button Style="{StaticResource Rect.Ink}" Content="전달 완결" Margin="0,0,6,0" Command="{Binding CompleteCommand}" Visibility="{Binding CanComplete, Converter={StaticResource BoolToVis}}" />
                                                            <Button Content="취소" Command="{Binding CancelConsultCommand}" Visibility="{Binding IsConsult, Converter={StaticResource BoolToVis}}" />
                                                        </WrapPanel>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                            <!-- 접은 카드(보류) -->
                                            <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}" Height="48" Padding="14,0" Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}}">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontSize="13" Foreground="{DynamicResource Brush.TextSoft}" Text="{Binding StateLine}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <Button Style="{StaticResource Rect.Soft}" Height="32" Padding="12,0" FontSize="12.5" Content="보류 해제" Command="{Binding ResumeCommand}" Margin="0,0,6,0" />
                                                        <Button Style="{StaticResource Rect.Red}" Height="32" Padding="14,0" FontSize="12.5" Content="종료" Command="{Binding HangupCommand}" />
                                                    </StackPanel>
                                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Muted}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <Button Style="{StaticResource Btn.Flat}" Command="{Binding MenuCommand}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" />
                                                    </Button>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Session.IsActive}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.TalkInk}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Session.IsIncoming}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Peril}" /><Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.RingSoft}" />
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Peril}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Session.IsOutgoing}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Muted}" /></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 진행 중 · 관제 그룹 — 감청은 그 행이 펼쳐진다 -->
                            <StackPanel Margin="0,0,0,14" DataContext="{Binding DataContext.CallActivity, ElementName=Root}" Visibility="{Binding DataContext.CallDesk.HasDesk, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="14" FontWeight="Bold" Margin="0,0,0,6"><Run Text="진행 중 · 관제 그룹 " /><Run Text="{Binding OngoingCount, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Text="진행 중인 통화 없음" Visibility="{Binding Ongoing.Count, Converter={StaticResource ZeroToVis}}" />
                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}" ClipToBounds="True" Visibility="{Binding Ongoing.Count, Converter={StaticResource CountToVis}}">
                                    <ItemsControl ItemsSource="{Binding Ongoing}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CallSessionRow}">
                                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                                    <StackPanel>
                                                        <DockPanel Height="46" Margin="14,0">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="청취 중" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Mon}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}" />
                                                                <Button Style="{StaticResource Rect.Soft}" Height="30" Padding="12,0" FontSize="12.5" FontWeight="Bold" BorderBrush="{DynamicResource Brush.Emg}" Foreground="{DynamicResource Brush.Emg}"
                                                                        Content="청취 종료" Command="{Binding StopMonitorCommand}" Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}" />
                                                                <Button Style="{StaticResource Rect.Soft}" Height="30" Padding="14,0" FontSize="12.5" BorderBrush="{DynamicResource Brush.Listen}" Foreground="{DynamicResource Brush.ListenInk}" Content="청취" Command="{Binding StartMonitorCommand}"
                                                                        IsEnabled="{Binding CanMonitor}" ToolTip="{Binding MonitorTip}" Visibility="{Binding ShowMonitor, Converter={StaticResource BoolToVis}}" />
                                                                <Button Style="{StaticResource Rect.Soft}" Height="30" Padding="12,0" FontSize="12.5" BorderBrush="{DynamicResource Brush.Edge}" Content="지정 픽업" Command="{Binding PickupCommand}"
                                                                        Visibility="{Binding CanPickup, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{DynamicResource Brush.Muted}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                                                            <Border Style="{StaticResource Tag.Pilot}" Visibility="{Binding IsPilotPath, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0"><TextBlock Text="대표" /></Border>
                                                            <TextBlock FontSize="12.5" Foreground="{DynamicResource Brush.TextSoft}" Text="{Binding StateLine}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <!-- 행 확장 — 소스 귀속 두 줄(RFC 5576 caller/callee) · 은닉/투명 · 출력 · [창으로] -->
                                                        <Border Background="{DynamicResource Brush.MonSoft}" BorderBrush="{DynamicResource Brush.MonEdge}" BorderThickness="0,1,0,0" Padding="36,8,14,10"
                                                                Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}">
                                                            <DockPanel DataContext="{Binding Monitor}">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource Btn.Link}" FontSize="12.5" Command="{Binding ToggleRouteCommand}" IsEnabled="{Binding CanToggleRoute}" ToolTip="출력 라우트 바꾸기" Margin="0,0,12,0">
                                                                        <TextBlock><Run Text="{Binding RouteLabel, Mode=OneWay}" /><Run Text=" · 음량 " /><Run Text="{Binding Volume, Mode=OneWay, StringFormat=P0}" /></TextBlock>
                                                                    </Button>
                                                                    <!-- 음량 — 감청 창과 같은 값(0~2). 창을 띄우지 않고도 이 통화만 줄이거나 키운다 -->
                                                                    <Slider Minimum="0" Maximum="2" Value="{Binding Volume}" SmallChange="0.05" LargeChange="0.25" Width="90" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                            ToolTip="이 감청의 음량" />
                                                                    <Button Style="{StaticResource Btn.Link}" FontSize="12.5" Content="창으로 ↗" ToolTip="감청 창에 띄우기(두 번째 모니터)"
                                                                            Command="{Binding DataContext.ShowWindowCommand, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                                                </StackPanel>
                                                                <Border Style="{StaticResource Tag.Mon}" Margin="0,0,18,0"><TextBlock Text="{Binding Badge}" /></Border>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                                                                    <TextBlock Text="{Binding CallerName}" FontSize="12.5" FontWeight="Bold" Margin="0,0,8,0" />
                                                                    <Border Width="110" Height="5" CornerRadius="3" Background="{DynamicResource Brush.MonEdge}" VerticalAlignment="Center">
                                                                        <Border HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource Brush.Mon}" Width="{Binding CallerLevel, Converter={StaticResource LevelWidth}, ConverterParameter=110}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding CalleeName}" FontSize="12.5" FontWeight="Bold" Margin="0,0,8,0" />
                                                                    <Border Width="110" Height="5" CornerRadius="3" Background="{DynamicResource Brush.MonEdge}" VerticalAlignment="Center">
                                                                        <Border HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource Brush.Mon}" Width="{Binding CalleeLevel, Converter={StaticResource LevelWidth}, ConverterParameter=110}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsTalking}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.TalkInk}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRinging}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Peril}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Mon}" /></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                            <!-- 관제 그룹원 — 4열 칸 -->
                            <TextBlock FontSize="14" FontWeight="Bold" Margin="0,0,0,6"><Run Text="관제 그룹원 " /><Run Text="{Binding MemberCount, Mode=OneWay}" /></TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Text="관제 데스크 미배정 — 콘솔 관리 › 역할·전화 그룹에서 배정하면 그룹원·대표번호 대기열·청취가 켜집니다" Visibility="{Binding HasDesk, Converter={StaticResource NotToVis}}" />
                            <ItemsControl ItemsSource="{Binding Members}" Visibility="{Binding HasDesk, Converter={StaticResource BoolToVis}}" Margin="-3,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MemberChip}">
                                        <Border x:Name="Cell" Height="40" Margin="3" CornerRadius="8" Padding="10,0,6,0" Background="{DynamicResource Brush.Panel}" Cursor="Hand"
                                                MouseLeftButtonUp="Member_Click" MouseRightButtonUp="Member_RightClick" ToolTip="누름 = 번호칸에 채움 · 오른쪽 = 사람 메뉴">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Rect.Soft}" Height="28" Padding="8,0" FontSize="11.5" Content="{Binding ActionText}" Command="{Binding ActCommand}"
                                                        IsEnabled="{Binding IsMonitoring, Converter={StaticResource Not}}" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" />
                                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Brush.Border}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ExtText}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding NameText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" MaxWidth="80" />
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Text="{Binding StateLine}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsTalking}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.TalkInk}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsRinging}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Peril}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Mon}" /></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
                <!-- [키패드] 팝오버 — 누를 때만. 통화 중·번호칸이 비면 DTMF -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="340,60,0,0" Width="292" Padding="14" CornerRadius="12" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Visibility="{Binding DataContext.KeypadOpen, ElementName=Root, Converter={StaticResource BoolToVis}}" DataContext="{Binding CallOriginate}">
                    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28" /></Border.Effect>
                    <StackPanel>
                        <Border Height="44" BorderBrush="{DynamicResource Brush.Edge}" BorderThickness="0,0,0,1.5" Margin="0,0,0,10">
                            <TextBlock Text="{Binding PadDisplay}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <UniformGrid Columns="3" Rows="4">
                            <UniformGrid.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource Rect.Soft}">
                                    <Setter Property="Height" Value="48" /><Setter Property="Margin" Value="4" /><Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.Panel}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" /><Setter Property="Focusable" Value="False" />
                                </Style>
                            </UniformGrid.Resources>
                            <Button Content="1" Command="{Binding PadCommand}" CommandParameter="1" /><Button Content="2" Command="{Binding PadCommand}" CommandParameter="2" /><Button Content="3" Command="{Binding PadCommand}" CommandParameter="3" />
                            <Button Content="4" Command="{Binding PadCommand}" CommandParameter="4" /><Button Content="5" Command="{Binding PadCommand}" CommandParameter="5" /><Button Content="6" Command="{Binding PadCommand}" CommandParameter="6" />
                            <Button Content="7" Command="{Binding PadCommand}" CommandParameter="7" /><Button Content="8" Command="{Binding PadCommand}" CommandParameter="8" /><Button Content="9" Command="{Binding PadCommand}" CommandParameter="9" />
                            <Button Content="*" Command="{Binding PadCommand}" CommandParameter="*" /><Button Content="0" Command="{Binding PadCommand}" CommandParameter="0" /><Button Content="#" Command="{Binding PadCommand}" CommandParameter="#" />
                        </UniformGrid>
                        <DockPanel Margin="4,6,4,8">
                            <Button DockPanel.Dock="Left" Style="{StaticResource Rect.Soft}" Width="48" Height="44" FontSize="17" Content="←" Command="{Binding BackspaceCommand}" Focusable="False" Margin="0,0,8,0" ToolTip="한 글자 지우기" />
                            <Button Style="{StaticResource Rect.Call}" Height="44" FontSize="15" Content="발신" Command="{Binding DialCommand}" Focusable="False" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Text="{Binding PadHint}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ 기록 — 통화 + 문자를 상대별로 ═══ (좁으면 머리 여백·칩 여백을 줄이고 [대표번호] = [대표]) -->
        <DockPanel Grid.Column="1" DataContext="{Binding Records}">
            <Border DockPanel.Dock="Top" Height="56" Padding="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter='10,0|16,0'}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Pill.Soft.Sm}" Content="CSV" Command="{Binding ExportCommand}" VerticalAlignment="Center"
                            Visibility="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=Collapsed|Visible}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Title16}" Text="기록" Margin="0,0,12,0" Visibility="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=Collapsed|Visible}" />
                        <RadioButton Style="{StaticResource FilterChip}" Height="30" Padding="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter='7,0|10,0'}" Content="전체" IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=all, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="all" />
                        <RadioButton Style="{StaticResource FilterChip}" Height="30" Padding="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter='7,0|10,0'}" Content="통화" IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=call, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="call" />
                        <RadioButton Style="{StaticResource FilterChip}" Height="30" Padding="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter='7,0|10,0'}" Content="문자" IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=sms, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="sms" />
                        <RadioButton Style="{StaticResource FilterChip}" Height="30" Padding="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter='7,0|10,0'}" Content="{Binding MissedChipText}" IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=missed, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="missed" />
                        <RadioButton Style="{StaticResource FilterChip}" Height="30" Padding="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter='7,0|10,0'}" Content="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=대표|대표번호}" ToolTip="대표번호로 온 통화" IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=pilot, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="pilot" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- 오늘 집계 한 줄 -->
            <Border DockPanel.Dock="Top" Height="34" Padding="16,0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <DockPanel TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Brush.TextSoft}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Command="{Binding OpenHistoryCommand}" ToolTip="끝난 통화의 날짜별 조회·녹취 — [이력] F2">
                        <TextBlock Text="이력에서 보기 ›" TextDecorations="Underline" FontSize="12" />
                    </Button>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="오늘" FontWeight="Bold" /><Run Text="   응대 " /><Run Text="{Binding TodayAnswered, Mode=OneWay}" />
                        <Run Text="   부재 " Foreground="{DynamicResource Brush.Emg}" FontWeight="Bold" /><Run Text="{Binding TodayMissed, Mode=OneWay}" Foreground="{DynamicResource Brush.Emg}" FontWeight="Bold" />
                        <Run Text="   발신 " /><Run Text="{Binding TodayOutgoing, Mode=OneWay}" /><Run Text="   전달 " /><Run Text="{Binding TodayTransfer, Mode=OneWay}" />
                        <Run Text="   감청 " /><Run Text="{Binding TodayMonitor, Mode=OneWay}" /><Run Text="   문자 " /><Run Text="{Binding TodaySms, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RecordCol" Width="300" MinWidth="220" />
                    <ColumnDefinition x:Name="TimelineCol" Width="*" />
                </Grid.ColumnDefinitions>
                <!-- 상대 목록 -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                    <Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="기록 없음" Margin="16,10" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RecordRow}">
                                        <Button x:Name="RowBtn" Style="{StaticResource RowBtn}" Height="62" Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <Border x:Name="Edge" Height="62" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="3,0,0,1" Padding="10,0,12,0">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding TimeText}" HorizontalAlignment="Right" />
                                                        <Border Style="{StaticResource Count}" Margin="0,4,0,0" HorizontalAlignment="Right" Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding Unread}" /></Border>
                                                    </StackPanel>
                                                    <Border Style="{StaticResource Avatar}" Margin="0,0,10,0" Tag="{Binding Name, Converter={StaticResource AvatarHue}}"><Grid><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Phone}" Width="15" Height="15" StrokeThickness="2" Visibility="{Binding Initial, Converter={StaticResource StrToVis}, ConverterParameter=invert}" /></Grid></Border>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="0,0,6,0" />
                                                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Text="{Binding Sub}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <Border x:Name="Kind" Style="{StaticResource Tag}" Height="18" Margin="0,0,6,0"><TextBlock Text="{Binding KindText}" /></Border>
                                                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding Last}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="170" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasUnread}" Value="True"><Setter TargetName="Name" Property="FontWeight" Value="Bold" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Missed"><Setter TargetName="Kind" Property="Style" Value="{StaticResource Tag.Red}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Transfer"><Setter TargetName="Kind" Property="Style" Value="{StaticResource Tag.Held}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Monitor"><Setter TargetName="Kind" Property="Style" Value="{StaticResource Tag.Mon}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Sms"><Setter TargetName="Kind" Property="Style" Value="{StaticResource Tag.Teal}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Live"><Setter TargetName="Kind" Property="Style" Value="{StaticResource Tag.Talk}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="RowBtn" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" /><Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" /></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <GridSplitter x:Name="RecordSeam" Grid.Column="0" Style="{StaticResource Seam}" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,-3,0"
                              ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" Cursor="SizeWE" DragCompleted="RecordSeam_DragCompleted" ToolTip="끌어서 목록 폭 조정" />
                <!-- 그 상대의 한 줄기 -->
                <DockPanel x:Name="Timeline" Grid.Column="1">
                    <Border DockPanel.Dock="Top" Height="56" Padding="18,0,12,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Pill.Talk}" Height="34" Padding="14,0" FontSize="13" Content="전화" Command="{Binding DialCommand}" IsEnabled="{Binding CanDial}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource RoundBtn}" Command="{Binding MenuCommand}" ToolTip="사람 메뉴 — 개별 통화 · 무전 메시지 · 애드혹에 추가">
                                    <Path Style="{StaticResource Icon.Filled}" Data="{StaticResource Icon.DotsV}" Width="15" Height="15" />
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Title16}" Text="{Binding SelName}" Margin="0,0,8,0" />
                                    <Border Style="{StaticResource Tag.Emg}" Height="17" Visibility="{Binding SelExternal, Converter={StaticResource BoolToVis}}"><TextBlock Text="외부망" /></Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding SelDetail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Border Margin="18,0,18,6" Padding="12,8" CornerRadius="8" Background="{DynamicResource Brush.EmgSoft}" Visibility="{Binding SmsBlocked, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BlockText}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Brush.EmgInk}" TextWrapping="Wrap" />
                        </Border>
                        <Border Height="60" Padding="18,0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                            <DockPanel VerticalAlignment="Center">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Pill.Ink}" Height="42" Padding="18,0" FontSize="14" Content="보내기" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" Margin="8,0,0,0" />
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" Text="{Binding CountText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <Grid>
                                    <Border x:Name="SmsBorder" MinHeight="42" CornerRadius="21" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Edge}" Background="{DynamicResource Brush.Surface}" />
                                    <!-- Enter = 보내기, Shift+Enter = 줄바꿈 — 무전 메시지 입력과 같다 -->
                                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Sms_KeyDown" IsEnabled="{Binding SmsBlocked, Converter={StaticResource Not}}" Margin="16,2" FontSize="14"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="38" MaxHeight="84"
                                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Text}" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="14" Text="문자" Margin="18,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding Input, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="왼쪽에서 상대를 고르세요" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSelection, Converter={StaticResource NotToVis}}" />
                        <ScrollViewer x:Name="RecordScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Items}" Margin="18,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RecordItem}">
                                        <Grid Margin="0,0,0,8">
                                            <!-- 통화 — 가운데 알약 -->
                                            <Border HorizontalAlignment="Center" Height="30" CornerRadius="15" Padding="12,0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                    Visibility="{Binding IsCall, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontSize="12.5" Foreground="{DynamicResource Brush.TextSoft}" VerticalAlignment="Center">
                                                    <Run Text="{Binding KindText, Mode=OneWay}" FontWeight="Bold" /><Run Text=" · " /><Run Text="{Binding Text, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource Brush.Muted}" />
                                                </TextBlock>
                                            </Border>
                                            <!-- 받은 문자 -->
                                            <StackPanel HorizontalAlignment="Left" MaxWidth="360" Visibility="{Binding IsIn, Converter={StaticResource BoolToVis}}">
                                                <Border CornerRadius="10" Padding="12,8" Background="{DynamicResource Brush.Surface2}"><TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" LineHeight="21" /></Border>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding TimeText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <!-- 보낸 문자 -->
                                            <StackPanel HorizontalAlignment="Right" MaxWidth="360" Visibility="{Binding IsOut, Converter={StaticResource BoolToVis}}">
                                                <Border CornerRadius="10" Padding="12,8" Background="{DynamicResource Brush.Primary}"><TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource Brush.OnAccent}" /></Border>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding TimeText}" />
                                                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding Message.StateMark}" Margin="4,0,0,0" />
                                                    <Button Style="{StaticResource Pill.Red}" Height="22" Padding="9,0" FontSize="11" BorderThickness="1" Content="재전송" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.ResendCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Message}">
                                                        <Button.Visibility><Binding Path="Message.State" Converter="{StaticResource EqToVis}" ConverterParameter="Failed" /></Button.Visibility>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
