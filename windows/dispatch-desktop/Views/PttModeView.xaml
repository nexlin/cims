<UserControl x:Class="DispatchDesktop.Views.PttModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:m="clr-namespace:DispatchDesktop.Models"
             xmlns:v="clr-namespace:DispatchDesktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}" x:Name="Root">
    <!-- [무전] 한 화면(§3.1) — 왼쪽 칸 1040 고정 = 지금 하는 일, 오른쪽 칸 = 둘러보는 것.
         위 줄(292, 경계 끌기) = 내 채널(카드 4열 × 112, 네 줄 · 조작 하나) | 타 채널(청취, 3열 — 패널이 열리면 1열) /
         아래 줄 = 메시지(대화 목록 300 : 대화 — 카드를 누르면 그 채널 대화로 따라간다) | 이벤트(종류 칩 · 긴급·임박 고정 줄 · 표). 배너가 서면 아래 줄만 준다 -->
    <UserControl.Resources>
        <CollectionViewSource x:Key="CardsSrc" Source="{Binding PttChannels.Cards}" />
        <!-- 내 채널 카드 — 1줄 «핀 번호. 이름» + 라벨 + 미읽음 · 2줄 발언자 · 3줄 접속자 · 4줄 참가·경과 + 조작 하나 -->
        <DataTemplate DataType="{x:Type vm:ChannelCard}">
            <Border x:Name="Card" Height="112" Margin="5" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.Surface}"
                    Padding="12,7,9,5" Cursor="Hand" ToolTip="{Binding DetailTip}" MouseLeftButtonUp="Card_Click">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Height="34" Margin="16,0,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <ToggleButton Style="{StaticResource TargetCheck}" IsChecked="{Binding IsChecked, Mode=OneWay}" IsEnabled="{Binding CanCheck}" ToolTip="{Binding TargetTip}"
                                          Visibility="{Binding ShowTarget, Converter={StaticResource BoolToVis}}"
                                          Command="{Binding DataContext.PttChannels.ToggleTargetCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button Command="{Binding ToggleMuteCommand}" ToolTip="{Binding MuteTip}" Visibility="{Binding ShowMute, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RoundBtn}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsMuted}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.EmgFill}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.MicOff}" Width="17" Height="17" StrokeThickness="2" />
                            </Button>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowJoin, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource Pill.Ink.Sm}" Content="참여" Command="{Binding JoinCommand}" Margin="0,0,6,0" ToolTip="이 그룹 통화에 합류(없으면 개시)" />
                                <Button Style="{StaticResource Pill.Red.Sm}" Content="긴급" Command="{Binding EmergencyCommand}" IsEnabled="{Binding CanEmergency}" ToolTip="{Binding EmergencyTip}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Count}" Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}" ToolTip="안 읽은 무전 메시지">
                                <TextBlock Text="{Binding Unread}" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{DynamicResource Brush.Border}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding NumberedTitle}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Tag}" Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVis}}"><TextBlock Text="개별" /></Border>
                                <Border Style="{StaticResource Tag}" Visibility="{Binding IsAdhoc, Converter={StaticResource BoolToVis}}"><TextBlock Text="애드혹" /></Border>
                                <Border Style="{StaticResource Tag.Ink}" Visibility="{Binding IsBroadcast, Converter={StaticResource BoolToVis}}" ToolTip="일제 통화 — 개시자만 발언하고 나머지는 듣습니다"><TextBlock Text="일제" /></Border>
                                <Border Style="{StaticResource Tag.Emg}" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}"><TextBlock Text="긴급" /></Border>
                                <Border Style="{StaticResource Tag.Peril}" Visibility="{Binding IsImminentPeril, Converter={StaticResource BoolToVis}}"><TextBlock Text="임박" /></Border>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="Sub" Text="{Binding SubLine}" FontSize="13" Margin="16,1,0,0" Foreground="{DynamicResource Brush.TextSoft}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding RosterLine}" Style="{StaticResource Muted}" FontSize="12" Margin="16,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsJoined}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Primary}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsPrivate}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Muted}" /></DataTrigger>
                <DataTrigger Binding="{Binding SubIsMe}" Value="True"><Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource Brush.TalkInk}" /><Setter TargetName="Sub" Property="FontWeight" Value="Bold" /></DataTrigger>
                <DataTrigger Binding="{Binding SubIsWarn}" Value="True"><Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource Brush.Emg}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsImminentPeril}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Peril}" /><Setter TargetName="Card" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.RingSoft}" /><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Peril}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEmergency}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Emg}" /><Setter TargetName="Card" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.EmgSoft}" /><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Emg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" /><Setter TargetName="Card" Property="BorderThickness" Value="2.5" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- [+ 개별 · 애드혹 열기] 타일 — 카드 격자 끝. 사용자 패널로 -->
        <DataTemplate DataType="{x:Type v:AddTile}">
            <Button Height="112" Margin="5" Cursor="Hand" Command="{Binding DataContext.OpenUsersTileCommand, ElementName=Root}" ToolTip="사람을 골라 개별 통화·애드혹 그룹 통화 — 오른쪽 [사용자] 패널">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="R" RadiusX="10" RadiusY="10" Stroke="{DynamicResource Brush.Faint}" StrokeThickness="1.5" StrokeDashArray="4 3" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Brush.TextSoft}">
                                <TextBlock Text="+" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" LineHeight="24" />
                                <TextBlock Text="개별 · 애드혹 열기" FontSize="13.5" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="R" Property="Stroke" Value="{DynamicResource Brush.Primary}" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Board" SizeChanged="Board_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="1040" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="292" MinHeight="200" MaxHeight="520" />
            <RowDefinition Height="*" MinHeight="160" />
        </Grid.RowDefinitions>

        <!-- ═══ 내 채널 ═══ -->
        <Border Grid.Row="0" Grid.Column="0" Padding="16,10,11,6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Height="32" Margin="0,0,5,0">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Text="카드 = 상세 열기 · ✓ = 말하기 · Ctrl+n = 그 채널만" />
                    <TextBlock Style="{StaticResource Title16}"><Run Text="내 채널 " /><Run Text="{Binding PttChannels.Cards.Count, Mode=OneWay}" /></TextBlock>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-5,1,0,0">
                    <ItemsControl>
                        <ItemsControl.ItemsSource>
                            <CompositeCollection>
                                <CollectionContainer Collection="{Binding Source={StaticResource CardsSrc}}" />
                                <v:AddTile />
                            </CompositeCollection>
                        </ItemsControl.ItemsSource>
                        <!-- 카드 4열(1040) — 칸이 좁으면(작은 창에 패널) 열을 줄인다: 카드 최소 폭 230 -->
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid VerticalAlignment="Top"
                            Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ColumnsByWidth}, ConverterParameter=230|4}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ 타 채널 ═══ -->
        <Border Grid.Row="0" Grid.Column="1" Padding="16,10,16,6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" DataContext="{Binding Scoped}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Height="32">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Soft}" FontSize="12" Text="{Binding ListeningText}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="동시 청취 상한(설정)"
                                   Visibility="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=Collapsed|Visible}" />
                        <TextBox Style="{StaticResource Field}" Width="150" Height="28" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" Tag="채널 이름 · id"
                                 Visibility="{Binding SearchOpen, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource IconBtn}" Width="32" Height="32" Command="{Binding ToggleSearchCommand}" ToolTip="채널 이름 검색">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Search}" Width="17" Height="17" StrokeThickness="2" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Title16}" Text="타 채널" Margin="0,0,8,0" />
                        <Border Style="{StaticResource Tag.Listen}" Margin="0,0,8,0"><TextBlock Text="청취 가능" /></Border>
                        <TextBlock Style="{StaticResource Title16}" Text="{Binding ListenCount}" />
                    </StackPanel>
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton Style="{StaticResource FilterChip}" Content="전체" IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=all, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="all" />
                    <RadioButton Style="{StaticResource FilterChip}" Content="활성" IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=active, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="active" />
                    <RadioButton Style="{StaticResource FilterChip}" Content="긴급" IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=emergency, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="emergency" />
                    <RadioButton Style="{StaticResource FilterChip}" Content="청취 중" IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=listening, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="listening" />
                </StackPanel>
                <Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding EmptyText}" Margin="2,6" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-3,0">
                        <ItemsControl ItemsSource="{Binding Listen}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid VerticalAlignment="Top" Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ColumnsByWidth}, ConverterParameter=250|3}" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ScopedCard}">
                                    <Border x:Name="Row" Height="56" Margin="3" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Surface}"
                                            Padding="12,0,8,0" Cursor="Hand" MouseLeftButtonUp="Other_Click">
                                        <DockPanel>
                                            <Button x:Name="Listen" DockPanel.Dock="Right" Style="{StaticResource Pill.ListenLine.Sm}" Content="{Binding ListenText}" Command="{Binding ToggleListenCommand}" ToolTip="{Binding ListenTip}"
                                                    IsEnabled="{Binding CanListen}" />
                                            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{DynamicResource Brush.Border}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SubLine}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasSession}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Muted}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsListening}" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Listen}" /><Setter TargetName="Listen" Property="Style" Value="{StaticResource Pill.Listen.Sm}" />
                                            <Setter TargetName="Listen" Property="IsEnabled" Value="True" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEmergency}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Emg}" /><Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.EmgSoft}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" /><Setter TargetName="Row" Property="BorderThickness" Value="2" /><Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Surface2}" /></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 위/아래 경계(끌기 — 위 줄 높이, §3.3) -->
        <GridSplitter Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Seam}" Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,0,0,-3"
                      ResizeDirection="Rows" ResizeBehavior="CurrentAndNext" Cursor="SizeNS" DragCompleted="TopSeam_DragCompleted" ToolTip="끌어서 위 줄 높이 조정" />

        <!-- ═══ 메시지 — 대화 목록 : 대화 ═══ -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" DataContext="{Binding McData}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ThreadCol" Width="300" MinWidth="220" MaxWidth="480" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Height="48" Margin="16,0,10,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Pill.Line.Sm}" Content="＋ 새 대화" Command="{Binding NewConversationCommand}" ToolTip="사람을 골라 무전 메시지 — [사용자] 패널" />
                            <Button DockPanel.Dock="Right" Command="{Binding ToggleFollowCommand}" Margin="0,0,6,0" ToolTip="카드를 누르면 그 채널 대화로">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Pill.Soft.Sm}">
                                        <Setter Property="Content" Value="따라가기" />
                                        <Style.Triggers><DataTrigger Binding="{Binding FollowChannel}" Value="True"><Setter Property="Content" Value="따라가기 ✓" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Style="{StaticResource Title16}" Text="메시지" />
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,0,0,8">
                            <RadioButton Style="{StaticResource FilterChip}" Padding="9,0" Content="전체" IsChecked="{Binding ThreadFilter, Converter={StaticResource Eq}, ConverterParameter=all, Mode=OneWay}" Command="{Binding SetThreadFilterCommand}" CommandParameter="all" />
                            <RadioButton Style="{StaticResource FilterChip}" Padding="9,0" Content="그룹" IsChecked="{Binding ThreadFilter, Converter={StaticResource Eq}, ConverterParameter=group, Mode=OneWay}" Command="{Binding SetThreadFilterCommand}" CommandParameter="group" />
                            <RadioButton Style="{StaticResource FilterChip}" Padding="9,0" Content="1:1" IsChecked="{Binding ThreadFilter, Converter={StaticResource Eq}, ConverterParameter=one, Mode=OneWay}" Command="{Binding SetThreadFilterCommand}" CommandParameter="one" />
                            <RadioButton Style="{StaticResource FilterChip}" Padding="9,0" Content="{Binding UnreadChipText}" IsChecked="{Binding ThreadFilter, Converter={StaticResource Eq}, ConverterParameter=unread, Mode=OneWay}" Command="{Binding SetThreadFilterCommand}" CommandParameter="unread" />
                        </StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="대화 없음" Margin="16,6" Visibility="{Binding Threads.Count, Converter={StaticResource ZeroToVis}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ThreadsView}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type m:MessageThread}">
                                            <Button x:Name="RowBtn" Style="{StaticResource RowBtn}" Height="60" Command="{Binding DataContext.SelectThreadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <Border x:Name="Edge" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="3,1,0,0" Padding="10,0,12,0" Height="60">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding LastTimeText}" HorizontalAlignment="Right" />
                                                            <Border Style="{StaticResource Count}" Margin="0,4,0,0" HorizontalAlignment="Right" Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding Unread}" /></Border>
                                                        </StackPanel>
                                                        <Border x:Name="Av" Style="{StaticResource Avatar}" Margin="0,0,10,0" Tag="{Binding Title, Converter={StaticResource AvatarHue}}">
                                                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock x:Name="Name" Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="140" Margin="0,0,6,0" />
                                                                <Border Style="{StaticResource Tag}" Height="17" Padding="4,0"><TextBlock Text="{Binding KindText}" /></Border>
                                                            </StackPanel>
                                                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding LastPreview}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter TargetName="Av" Property="CornerRadius" Value="8" /></DataTrigger>
                                                <DataTrigger Binding="{Binding HasUnread}" Value="True"><Setter TargetName="Name" Property="FontWeight" Value="Bold" /></DataTrigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource SameRef}">
                                                            <Binding />
                                                            <Binding Path="DataContext.Selected" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter TargetName="RowBtn" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                                                    <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
                <GridSplitter Grid.Column="0" Style="{StaticResource Seam}" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,-3,0"
                              ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" Cursor="SizeWE" DragCompleted="ThreadSeam_DragCompleted" ToolTip="끌어서 대화 목록 폭 조정" />
                <!-- 대화 -->
                <DockPanel Grid.Column="1">
                    <Border DockPanel.Dock="Top" Height="48" Padding="18,0,12,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Pill.Line.Sm}" Content="채널 정보 ›" Command="{Binding OpenChannelInfoCommand}" Visibility="{Binding IsGroupConv, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Title16}" Text="{Binding Selected.Title}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                <Border x:Name="ConvTag" Height="22" CornerRadius="11" Padding="9,0" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Faint}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSoft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGroupConv}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryEdge}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.PrimaryInk}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ConvLabel}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Text="{Binding ConvSub}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- 빠른 답 · 입력 -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Padding="18,6,18,0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="빠른 답" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ItemsControl ItemsSource="{Binding QuickReplies}" IsEnabled="{Binding HasSelection}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Pill.Soft.Sm}" Content="{Binding}" Margin="0,0,6,0" FontSize="12.5" ToolTip="누르면 곧바로 보낸다"
                                                    Command="{Binding DataContext.QuickReplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DockPanel Height="60" Margin="18,0">
                            <Button DockPanel.Dock="Left" Style="{StaticResource RoundBtn}" Width="42" Height="42" Margin="0,0,8,0" Command="{Binding AttachCommand}" IsEnabled="{Binding CanAttach}" ToolTip="파일 보내기 — 끌어 놓기도 된다">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Clip}" Width="16" Height="16" StrokeThickness="2" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Pill.Ink}" Height="42" Padding="20,0" FontSize="14" Content="보내기" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" Margin="8,0,0,0" />
                            <Grid VerticalAlignment="Center">
                                <Border Height="42" CornerRadius="21" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Edge}" Background="{DynamicResource Brush.Surface}" />
                                <TextBox x:Name="Input" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" KeyDown="Input_KeyDown" IsEnabled="{Binding HasSelection}" Margin="16,0" FontSize="14"
                                         BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Height="38" Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Text}" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="14" Text="{Binding InputHint}" Margin="18,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Input, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                    <v:MessagesView />
                </DockPanel>
            </Grid>
        </Border>

        <!-- ═══ 이벤트 ═══ -->
        <Border Grid.Row="1" Grid.Column="1" Padding="16,0,16,8" DataContext="{Binding PttActivity}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Height="48">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleFollowCommand}" Margin="0,0,6,0" ToolTip="새 줄이 오면 맨 위로">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Pill.Soft.Sm}">
                                    <Setter Property="Content" Value="따라가기" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Follow}" Value="True"><Setter Property="Content" Value="따라가기 ✓" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource Pill.Soft.Sm}" Content="이력에서 보기" Command="{Binding OpenHistoryCommand}" Margin="0,0,6,0" Visibility="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=Collapsed|Visible}" ToolTip="끝난 PTT 세션의 날짜별 조회·녹취 — [이력] F2" />
                        <Button Style="{StaticResource Pill.Soft.Sm}" Content="CSV" Command="{Binding ExportCommand}"
                                Visibility="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=Collapsed|Visible}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Title16}"><Run Text="이벤트 " /><Run Text="{Binding TotalCount, Mode=OneWay}" /></TextBlock>
                </DockPanel>
                <!-- 종류 칩 · 채널 -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <ItemsControl ItemsSource="{Binding Kinds}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EventKindChip}">
                                <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding On}" Margin="0,0,5,0" ToolTip="이 종류 보이기 / 숨기기">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 종류 색 점 — 표의 종류 라벨과 같은 색(범례) -->
                                        <Ellipse x:Name="D" Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Faint}" />
                                        <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Count, Mode=OneWay}" FontWeight="Normal" /></TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Class}" Value="Talk"><Setter TargetName="D" Property="Fill" Value="{DynamicResource Brush.Talk}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Class}" Value="Presence"><Setter TargetName="D" Property="Fill" Value="{DynamicResource Brush.Held}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Class}" Value="Emergency"><Setter TargetName="D" Property="Fill" Value="{DynamicResource Brush.Emg}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Class}" Value="Sds"><Setter TargetName="D" Property="Fill" Value="{DynamicResource Brush.Listen}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Class}" Value="Error"><Setter TargetName="D" Property="Fill" Value="{DynamicResource Brush.Emg}" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid>
                        <ToggleButton x:Name="ChanDrop" Style="{StaticResource FilterChip}" IsChecked="{Binding ChannelMenuOpen}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ChannelText}" /><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronDown}" Width="11" Height="11" Margin="4,0,0,0" /></StackPanel>
                        </ToggleButton>
                        <Popup IsOpen="{Binding ChannelMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ChanDrop}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Style="{StaticResource DropPanel}" MaxHeight="360">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Button Style="{StaticResource DropItem}" Content="전체" Command="{Binding PickChannelCommand}" CommandParameter="" />
                                        <ItemsControl ItemsSource="{Binding Channels}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource DropItem}" Content="{Binding}" Command="{Binding DataContext.PickChannelCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </WrapPanel>
                <!-- 진행 중 긴급·임박 고정 줄 -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Pinned}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PinnedEmergency}">
                            <Border x:Name="Pin" Height="40" Margin="0,0,0,4" CornerRadius="8" Padding="12,0,8,0" Background="{DynamicResource Brush.EmgSoft}">
                                <DockPanel>
                                    <Button x:Name="Go" DockPanel.Dock="Right" Content="채널로" Height="28" Padding="12,0" FontSize="12" Command="{Binding DataContext.ChannelPinnedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Pill.RedFill}">
                                                <Style.Triggers><DataTrigger Binding="{Binding IsPeril}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Peril}" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnPeril}" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Style="{StaticResource Mono}" Text="{Binding Elapsed, Converter={StaticResource Elapsed}}" FontSize="13" FontWeight="SemiBold" Width="52" VerticalAlignment="Center" />
                                    <Border x:Name="Kind" Style="{StaticResource Tag.Emg}" Margin="0,0,10,0"><TextBlock Text="{Binding KindText}" /></Border>
                                    <TextBlock x:Name="Txt" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Emg}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" 진행 중" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPeril}" Value="True">
                                    <Setter TargetName="Pin" Property="Background" Value="{DynamicResource Brush.RingSoft}" /><Setter TargetName="Kind" Property="Style" Value="{StaticResource Tag.Peril}" />
                                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 표 머리 -->
                <Border DockPanel.Dock="Top" Height="28" Padding="8,0" BorderBrush="{DynamicResource Brush.Edge}" BorderThickness="0,0,0,1">
                    <Grid TextElement.FontSize="11" TextElement.Foreground="{DynamicResource Brush.Muted}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=64|74}" />
                            <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=0|80}" />
                            <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=58|64}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="시각" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="채널" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="종류" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="내용" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="이벤트 없음" Margin="8,8" Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVis}}" />
                    <ScrollViewer x:Name="EventsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rows}" VirtualizingPanel.IsVirtualizing="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EventRow}">
                                    <Button x:Name="Row" Style="{StaticResource RowBtn}" Height="40" Command="{Binding DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <Border Height="40" Padding="8,0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=64|74}" />
                                                    <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=0|80}" />
                                                    <ColumnDefinition Width="{Binding IsNarrow, ElementName=Root, Converter={StaticResource Pick}, ConverterParameter=58|64}" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource Brush.TextSoft}" Text="{Binding Time, StringFormat=HH:mm:ss}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" Text="{Binding Channel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <Border x:Name="Kind" Grid.Column="2" Style="{StaticResource Tag}" HorizontalAlignment="Left"><TextBlock Text="{Binding KindText}" /></Border>
                                                <TextBlock x:Name="Txt" Grid.Column="3" FontSize="13" Text="{Binding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <!-- 종류 라벨 색 = 종류 칩의 점 색(발언 녹색 · 입퇴장 파랑 · SDS 청록 · 긴급 빨강 채움 · 오류 연한 빨강) -->
                                        <DataTrigger Binding="{Binding Class}" Value="Talk"><Setter TargetName="Kind" Property="Style" Value="{StaticResource Tag.Talk}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Class}" Value="Presence"><Setter TargetName="Kind" Property="Style" Value="{StaticResource Tag.Held}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Class}" Value="Sds"><Setter TargetName="Kind" Property="Style" Value="{StaticResource Tag.Teal}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsEmergency}" Value="True"><Setter TargetName="Kind" Property="Style" Value="{StaticResource Tag.Emg}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True"><Setter TargetName="Kind" Property="Style" Value="{StaticResource Tag.Red}" /><Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Brush.Emg}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" /><Setter TargetName="Txt" Property="FontWeight" Value="Bold" /></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
