<UserControl x:Class="DispatchDesktop.Views.PttChannelsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             xmlns:v="clr-namespace:DispatchDesktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}" x:Name="Root">
    <!-- ① 내 채널(§4.1) — 머리 → 빠른 발신 줄([PTT 번호·이름·그룹][사설콜 ▾][애드혹 ▾], 팝오버 = PttOriginateView) → 발언 바(PTT 40px · 대상 칩 · 게이지) →
         안내 줄 → 채널 카드(2줄, 포커스 3줄). 카드 왼쪽 체크 = 발언 대상(다중), 카드 클릭 = 포커스(다시 클릭하면 접힘). 필터·검색 없음 — 항상 전부. -->
    <Border Style="{StaticResource Pnl}">
        <DockPanel>
            <!-- 머리 -->
            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource H2}" Text="① 내 채널" Margin="6,0,10,0" />
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center">
                        <Run Text="{Binding PttChannels.Cards.Count, Mode=OneWay}" /><Run Text=" · 발언 대상 " /><Run Text="{Binding TalkBar.TargetCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <!-- 빠른 발신 줄(44) -->
            <Border DockPanel.Dock="Top" Height="44" Padding="8,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Background="{DynamicResource Brush.Surface}">
                <DockPanel VerticalAlignment="Center" x:Name="QuickLine">
                    <ToggleButton DockPanel.Dock="Right" x:Name="AdhocBtn" Style="{StaticResource DropButton}" Height="30" Margin="4,0,0,0" ToolTip="애드혹 그룹통화 — PTT 사용자 N 명(주소록 체크)"
                                  IsChecked="{Binding PttOriginateOpen, Mode=OneWay}" Command="{Binding OpenPttOriginateCommand}" CommandParameter="adhoc">
                        <TextBlock><Run Text="애드혹" /><Run Text=" ▾" Foreground="{DynamicResource Brush.Muted}" /></TextBlock>
                    </ToggleButton>
                    <ToggleButton DockPanel.Dock="Right" x:Name="PrivateBtn" Style="{StaticResource DropButton}" Height="30" Margin="6,0,0,0" ToolTip="사설콜 — PTT 사용자 1명(반이중 floor / 전이중)"
                                  IsChecked="{Binding PttOriginateOpen, Mode=OneWay}" Command="{Binding OpenPttOriginateCommand}" CommandParameter="private">
                        <TextBlock><Run Text="사설콜" /><Run Text=" ▾" Foreground="{DynamicResource Brush.Muted}" /></TextBlock>
                    </ToggleButton>
                    <Grid>
                        <TextBox x:Name="TargetBox" Style="{StaticResource Field}" Height="30" Text="{Binding PttOriginate.Target, UpdateSourceTrigger=PropertyChanged}" KeyDown="Target_KeyDown" LostKeyboardFocus="Target_LostFocus"
                                 ToolTip="PTT 번호 · 이름 · 그룹 — Enter = 사설콜 발신(반이중)" />
                        <TextBlock Style="{StaticResource Hint}" Text="PTT 번호 · 이름 · 그룹" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding PttOriginate.Target, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                        <!-- 입력 중 PTT 주소록 제안 -->
                        <Popup IsOpen="{Binding PttOriginate.HasSuggestions, Mode=OneWay}" PlacementTarget="{Binding ElementName=TargetBox}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                            <Border Style="{StaticResource PopPanel}" Width="{Binding ActualWidth, ElementName=TargetBox}" Padding="4" MaxHeight="220">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding PttOriginate.Suggestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PttUserRow}">
                                                <Button Style="{StaticResource DropItem}" Padding="8,4" HorizontalContentAlignment="Stretch" Focusable="False"
                                                        Command="{Binding DataContext.PttOriginate.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Button Style="{StaticResource Btn.Xs.Pri}" Content="사설콜" Focusable="False" Command="{Binding DataContext.PttOriginate.PrivateToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                            <Button Style="{StaticResource Btn.Xs}" Content="전이중" Focusable="False" Command="{Binding DataContext.PttOriginate.PrivateFullToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                        <TextBlock VerticalAlignment="Center">
                                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Medium" /><Run Text="  " />
                                                            <Run Text="{Binding DisplayNumber, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Muted}" /><Run Text="  " />
                                                            <Run Text="{Binding Status, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Brush.Talk}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                        <!-- [사설콜 ▾]/[애드혹 ▾] 팝오버(폭 520) — 애드혹 구성 중엔 바깥 클릭에 닫히지 않고 [취소]로만 -->
                        <Popup IsOpen="{Binding PttOriginateOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=QuickLine}" Placement="Bottom" AllowsTransparency="True"
                               StaysOpen="{Binding PttOriginate.IsComposingAdhoc, Mode=OneWay}" HorizontalOffset="0">
                            <Border Style="{StaticResource PopPanel}" Width="520" Height="540">
                                <v:PttOriginateView DataContext="{Binding PttOriginate}" />
                            </Border>
                        </Popup>
                    </Grid>
                </DockPanel>
            </Border>
            <!-- 발언 바(52) -->
            <Border DockPanel.Dock="Top" Height="52" Padding="8,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Background="{DynamicResource Brush.BgSoft}" DataContext="{Binding TalkBar}">
                <DockPanel VerticalAlignment="Center">
                    <!-- PTT 버튼 — 누르는 동안 요청, 떼면 해제(잠금 발언 설정 시 클릭 토글) -->
                    <Button DockPanel.Dock="Left" IsEnabled="{Binding CanPtt}" PreviewMouseLeftButtonDown="Ptt_Down" PreviewMouseLeftButtonUp="Ptt_Up" MouseLeave="Ptt_Leave" TouchDown="Ptt_TouchDown" TouchUp="Ptt_TouchUp"
                            ToolTip="누르는 동안 발언 대상 전부에 발언권 요청 — 떼면 해제">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Ptt}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRequesting}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Ring}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Ring}" /><Setter Property="Background" Value="{DynamicResource Brush.RingSoft}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsSpeaking}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Talk}" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding AllDeniedFlash}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Emg}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Emg}" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsLocked}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Held}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PttText}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource NavKey}" Margin="8,0,0,0" Background="Transparent"><TextBlock Text="{Binding HotKeyText}" FontSize="10.5" /></Border>
                        </StackPanel>
                    </Button>
                    <!-- 오른쪽: 남은 발언 게이지 · [모두 해제] -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Hint}" Text="남은 발언" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ProgressBar Width="60" Height="6" Value="{Binding MinGauge, Mode=OneWay}" VerticalAlignment="Center">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
                                        <Style.Triggers><DataTrigger Binding="{Binding TalkLimitNear}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Emg}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding SpeakerElapsed, Converter={StaticResource Elapsed}}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource Btn.Xs}" Content="모두 해제" Command="{Binding ClearAllCommand}" Visibility="{Binding HasTargets, Converter={StaticResource BoolToVis}}" ToolTip="발언 대상 체크 전부 해제" />
                    </StackPanel>
                    <!-- 대상 칩 -->
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Hint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ItemsControl ItemsSource="{Binding Targets}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TalkTargetChip}">
                                    <Border x:Name="Chip" Style="{StaticResource Chip}" Margin="0,0,5,0" Cursor="Hand" ToolTip="클릭 = 카드 포커스 · × = 체크 해제">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="Dot" Style="{StaticResource Dot}" Width="8" Height="8" Margin="0,0,5,0" />
                                            <Button Content="{Binding Name}" Command="{Binding DataContext.FocusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Foreground="{DynamicResource Brush.Text}" FontSize="12" FontWeight="Medium" />
                                            <TextBlock x:Name="St" Text="{Binding StateText}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="{Binding StateText, Converter={StaticResource StrToVis}}" />
                                            <Button Content="×" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="4,0,0,0" Cursor="Hand" Foreground="{DynamicResource Brush.Muted}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsGranted}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Talk}" /><Setter TargetName="St" Property="Foreground" Value="{DynamicResource Brush.Talk}" /><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Talk}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsRequesting}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Ring}" /><Setter TargetName="St" Property="Foreground" Value="{DynamicResource Brush.Ring}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsQueued}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Ring}" /><Setter TargetName="St" Property="Foreground" Value="{DynamicResource Brush.Ring}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsDenied}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Emg}" /><Setter TargetName="St" Property="Foreground" Value="{DynamicResource Brush.Emg}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsEmergency}" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Emg}" /></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- 안내 줄(24) -->
            <Border DockPanel.Dock="Top" Height="24" Padding="10,0">
                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="멤버 그룹 · 내가 건 사설콜·애드혹 — 항상 전부 · ☑ 발언 대상 · 클릭 = 포커스 · Ctrl+n 포커스+단일 대상 · Ctrl+Shift+n 체크" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Border>
            <!-- 카드 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,8">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="4,10" Text="멤버 그룹이 없습니다 — GMS 그룹에 멤버로 편성되면 여기 카드가 생깁니다" Visibility="{Binding PttChannels.Cards.Count, Converter={StaticResource ZeroToVis}}" />
                    <ItemsControl ItemsSource="{Binding PttChannels.Cards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChannelCard}">
                                <Border x:Name="Card" Style="{StaticResource ChannelCard}" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                                    <StackPanel>
                                        <!-- 1줄: ☑ · 점 · 이름 · 배지 · ✉ n ── 핀 · 경과 -->
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource NavKey}" Margin="0,0,8,0" ToolTip="Ctrl+n = 포커스 + 단일 발언 대상 · Ctrl+Shift+n = 체크 토글"><TextBlock><Run Text="Ctrl+" /><Run Text="{Binding Index, Mode=OneWay}" /></TextBlock></Border>
                                                <TextBlock x:Name="Elapsed" Style="{StaticResource MonoMuted}" Text="{Binding ElapsedText}" FontSize="12.5" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" IsEnabled="{Binding CanCheck}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="발언 대상(PTT 를 누르면 여기로 요청)"
                                                          Command="{Binding DataContext.PttChannels.ToggleTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Ellipse x:Name="Dot" Style="{StaticResource StateDot}" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                                <Border Style="{StaticResource Badge.Member}" Visibility="{Binding IsMember, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding MemberText}" /></Border>
                                                <Border Style="{StaticResource Badge.Listen}" Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVis}}"><TextBlock><Run Text="사설콜 " /><Run Text="{Binding Duplex, Mode=OneWay}" /></TextBlock></Border>
                                                <Border Style="{StaticResource Badge}" Visibility="{Binding IsAdhoc, Converter={StaticResource BoolToVis}}"><TextBlock Text="임시" /></Border>
                                                <Border Style="{StaticResource Badge.Emg}" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}"><TextBlock Text="긴급" /></Border>
                                                <Border Style="{StaticResource Badge.Pilot}" Visibility="{Binding IsImminentPeril, Converter={StaticResource BoolToVis}}"><TextBlock Text="임박" /></Border>
                                                <Button Style="{StaticResource Btn.Xs}" Height="20" Padding="6,0" Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}" ToolTip="미읽음 SDS — ④ 스레드로"
                                                        Command="{Binding DataContext.PttChannels.OpenThreadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Foreground="{DynamicResource Brush.Ring}"><Run Text="✉ " /><Run Text="{Binding Unread, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- 2줄: 발언 <이름> ▮▮▮ mm:ss · 보조 / 마지막 세션 -->
                                        <StackPanel Orientation="Horizontal" Margin="26,3,0,0">
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVis}}">
                                                <Ellipse Style="{StaticResource Dot}" Width="7" Height="7" Fill="{DynamicResource Brush.Talk}" />
                                                <TextBlock FontSize="12.5" VerticalAlignment="Center"><Run Text="발언 " Foreground="{DynamicResource Brush.Muted}" /><Run Text="{Binding Speaker, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                                <ProgressBar Style="{StaticResource Meter}" Width="36" Height="6" Value="{Binding TalkGauge, Mode=OneWay}" Margin="6,0" VerticalAlignment="Center" Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Style="{StaticResource MonoMuted}" Text="{Binding SpeakerElapsed, Converter={StaticResource Elapsed}}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                <TextBlock Style="{StaticResource Muted}" Text=" · " FontSize="12.5" VerticalAlignment="Center" Visibility="{Binding Line2, Converter={StaticResource StrToVis}}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Line2}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Emg}" Text="{Binding FloorNote}" Visibility="{Binding FloorNote, Converter={StaticResource StrToVis}}" />
                                        </StackPanel>
                                        <!-- 3줄(포커스만): 로스터 칩 · 애드혹 칩 · 남은 발언 · 조작 -->
                                        <StackPanel Margin="26,6,0,0" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding RosterPreview}" Visibility="{Binding IsMember, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:RosterRow}">
                                                        <Button Command="{Binding DataContext.PttChannels.PersonMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip="{Binding Number}">
                                                            <Border x:Name="RChip" Style="{StaticResource Chip}" Padding="7,2" Margin="0,0,4,4">
                                                                <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" 청취" FontSize="10" x:Name="Lst" /></TextBlock>
                                                            </Border>
                                                        </Button>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsListener}" Value="False"><Setter TargetName="Lst" Property="Text" Value="" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSpeaking}" Value="True"><Setter TargetName="RChip" Property="Background" Value="{DynamicResource Brush.TalkSoft}" /><Setter TargetName="RChip" Property="BorderBrush" Value="{DynamicResource Brush.Talk}" /><Setter TargetName="RChip" Property="TextElement.Foreground" Value="{DynamicResource Brush.Talk}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMe}" Value="True"><Setter TargetName="RChip" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" /><Setter TargetName="RChip" Property="TextElement.Foreground" Value="{DynamicResource Brush.Primary}" /></DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding AdhocChips}" Visibility="{Binding IsAdhoc, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Chip}" Padding="7,2" Margin="0,0,4,4"><TextBlock Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <DockPanel Margin="0,2,0,0">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource Btn.Xs}" Command="{Binding ToggleRouteCommand}" IsEnabled="{Binding CanToggleRoute}" Margin="0,0,4,0" ToolTip="출력 라우트: 헤드셋 / 데스크 스피커" Visibility="{Binding IsJoined, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock><Run Text="🎧" /><Run Text="/" /><Run Text="🔊" /></TextBlock>
                                                    </Button>
                                                    <Button Style="{StaticResource Btn.Xs}" Margin="0,0,4,0" Visibility="{Binding HasRosterMore, Converter={StaticResource BoolToVis}}" ToolTip="로스터 전체는 [PTT 그룹] 화면 상세" Command="{Binding DataContext.GroupsScreen.GoToChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <TextBlock><Run Text="로스터 전체 +" /><Run Text="{Binding RosterMore, Mode=OneWay}" /></TextBlock>
                                                    </Button>
                                                    <Button Content="참여" Command="{Binding JoinCommand}" Margin="0,0,4,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Xs.Pri}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions><Condition Binding="{Binding IsMember}" Value="True" /><Condition Binding="{Binding IsJoined}" Value="False" /></MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Style="{StaticResource Btn.Xs}" Content="음소거" Command="{Binding ToggleMuteCommand}" Margin="0,0,4,0" Visibility="{Binding IsFullDuplex, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource Btn.Xs.Danger}" Content="긴급 호출" Command="{Binding EmergencyCommand}" Margin="0,0,4,0" Visibility="{Binding IsMember, Converter={StaticResource BoolToVis}}" ToolTip="이 그룹에 긴급 그룹콜 개시(자격 필요)" />
                                                    <Button Style="{StaticResource Btn.Xs}" Content="편집" Margin="0,0,4,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.PttChannels.EditGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Content="이탈" Command="{Binding LeaveCommand}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Xs}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions><Condition Binding="{Binding IsMember}" Value="True" /><Condition Binding="{Binding IsJoined}" Value="True" /></MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Style="{StaticResource Btn.Xs.Danger}" Content="종료" Command="{Binding LeaveCommand}" Visibility="{Binding IsMember, Converter={StaticResource NotToVis}}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource Hint}" Text="남은 발언" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <ProgressBar Width="80" Height="6" Value="{Binding TalkGauge, Mode=OneWay}" VerticalAlignment="Center">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
                                                                <Style.Triggers><DataTrigger Binding="{Binding TalkLimitNear}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Emg}" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsJoined}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Talk}" /><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Brush.Talk}" /><Setter TargetName="Elapsed" Property="Foreground" Value="{DynamicResource Brush.Text}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsPrivate}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Listen}" /><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Brush.Listen}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" /><Setter TargetName="Card" Property="BorderThickness" Value="2" /><Setter TargetName="Card" Property="Padding" Value="7,5" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked}" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.BgSoft}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsImminentPeril}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Ring}" /><Setter TargetName="Card" Property="BorderThickness" Value="2" /><Setter TargetName="Card" Property="Padding" Value="7,5" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsEmergency}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Emg}" /><Setter TargetName="Card" Property="BorderThickness" Value="2" /><Setter TargetName="Card" Property="Padding" Value="7,5" /><Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.EmgSoft}" /><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Emg}" /><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Brush.Emg}" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
