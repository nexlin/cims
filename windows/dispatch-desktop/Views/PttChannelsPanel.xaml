<UserControl x:Class="DispatchDesktop.Views.PttChannelsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DispatchDesktop.ViewModels"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <!-- PTT 채널 패널 (§4.1 왼쪽) — 관제사가 발언하는 세션 카드: 멤버 그룹 + 사설콜 + 애드혹 -->
    <Border Style="{StaticResource Pnl}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource H2}" Text="PTT 채널" Margin="6,0,10,0" />
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center">
                        <Run Text="참여 " /><Run Text="{Binding PttChannels.JoinedCount, Mode=OneWay}" />
                    </TextBlock>
                    <Border Style="{StaticResource SegGroup}" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Seg}" Content="카드" IsChecked="{Binding PttChannels.ViewMode, Converter={StaticResource Eq}, ConverterParameter=card}"
                                         Command="{Binding PttChannels.SetViewModeCommand}" CommandParameter="card" />
                            <RadioButton Style="{StaticResource Seg}" Content="타일" IsChecked="{Binding PttChannels.ViewMode, Converter={StaticResource Eq}, ConverterParameter=tile}"
                                         Command="{Binding PttChannels.SetViewModeCommand}" CommandParameter="tile" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8">
                <ItemsControl ItemsSource="{Binding PttChannels.Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChannelCard}">
                            <Border x:Name="Card" Style="{StaticResource Card}" MouseLeftButtonDown="Card_MouseLeftButtonDown" Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 제목 줄 -->
                                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Index, StringFormat={}{0}}" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" Margin="0,0,8,0" />
                                        <Border Style="{StaticResource Badge.Member}" Visibility="{Binding IsMember, Converter={StaticResource BoolToVis}}"><TextBlock Text="멤버" /></Border>
                                        <Border Style="{StaticResource Badge.Listen}" Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVis}}"><TextBlock Text="사설콜" /></Border>
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding Duplex}" /></Border>
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding IsAdhoc, Converter={StaticResource BoolToVis}}"><TextBlock Text="임시" /></Border>
                                        <Border Style="{StaticResource Badge.Emg}" Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}"><TextBlock Text="긴급" /></Border>
                                        <Border Style="{StaticResource Badge.Pilot}" Visibility="{Binding IsImminentPeril, Converter={StaticResource BoolToVis}}"><TextBlock Text="임박" /></Border>
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding MemberText}" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="12" />
                                    </StackPanel>
                                    <!-- 상태 줄 -->
                                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="0,4,0,0">
                                        <Ellipse>
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource Dot}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsJoined}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Talk}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEmergency}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Emg}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding SessionText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVis}}">
                                            <Run Text="발언 " /><Run Text="{Binding Speaker, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                                            <Run Text=" " /><Run Text="{Binding SpeakerElapsed, Mode=OneWay, Converter={StaticResource Elapsed}}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource MonoMuted}" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding IsJoined, Converter={StaticResource BoolToVis}}"
                                                   Text="{Binding Elapsed, Converter={StaticResource Elapsed}}" />
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12">
                                            <Run Text="참가 " /><Run Text="{Binding Participants, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- 게이지·사유·칩·로스터 -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,6,0,0">
                                        <ProgressBar Value="{Binding TalkGauge, Mode=OneWay}" Width="180" HorizontalAlignment="Left" Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding TalkLimitNear}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Emg}" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding FloorNote}" Visibility="{Binding FloorNote, Converter={StaticResource StrToVis}}" Foreground="{DynamicResource Brush.Emg}" />
                                        <ItemsControl ItemsSource="{Binding AdhocChips}" Visibility="{Binding IsAdhoc, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Chip}"><TextBlock Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Roster}" Visibility="{Binding ShowRoster, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:RosterRow}">
                                                    <Border Style="{StaticResource Chip}" ToolTip="{Binding Uri}">
                                                        <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StatusText, Mode=OneWay}" FontSize="10" /></TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <!-- 하단 조작 -->
                                    <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Margin="0,6,0,0">
                                        <Button Style="{StaticResource Btn.Xs}" Command="{Binding ToggleRouteCommand}" IsEnabled="{Binding CanToggleRoute}" Margin="0,0,6,0" ToolTip="출력 라우트: 헤드셋(라우트 0) / 데스크 스피커">
                                            <TextBlock><Run Text="🎧" /><Run Text="/" /><Run Text="🔊" /></TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource Btn.Xs}" Content="로스터 ▾" Command="{Binding ToggleRosterViewCommand}" Margin="0,0,6,0" Visibility="{Binding IsMember, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="참여" Command="{Binding JoinCommand}" Margin="0,0,6,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Xs}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions><Condition Binding="{Binding IsMember}" Value="True" /><Condition Binding="{Binding IsJoined}" Value="False" /></MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Style="{StaticResource Btn.Xs}" Content="음소거" Command="{Binding ToggleMuteCommand}" Margin="0,0,6,0" Visibility="{Binding IsFullDuplex, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="이탈" Command="{Binding LeaveCommand}" Margin="0,0,6,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Xs}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions><Condition Binding="{Binding IsMember}" Value="True" /><Condition Binding="{Binding IsJoined}" Value="True" /></MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Style="{StaticResource Btn.Xs.Danger}" Content="종료" Command="{Binding LeaveCommand}" Margin="0,0,6,0" Visibility="{Binding IsMember, Converter={StaticResource NotToVis}}" />
                                        <Button Style="{StaticResource Btn.Xs.Danger}" Content="긴급 호출" Command="{Binding EmergencyCommand}" Visibility="{Binding IsMember, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <!-- PTT 버튼 (누르는 동안 요청, 떼면 해제) -->
                                    <Button Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Width="96" MinHeight="64" Margin="10,0,0,0" Content="{Binding PttText}" FontWeight="Bold"
                                            PreviewMouseLeftButtonDown="Ptt_Down" PreviewMouseLeftButtonUp="Ptt_Up" MouseLeave="Ptt_Leave" TouchDown="Ptt_TouchDown" TouchUp="Ptt_TouchUp"
                                            Visibility="{Binding ShowPtt, Converter={StaticResource BoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRequesting}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.RingSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Ring}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsQueued}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.HeldSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Held}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSpeaking}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Talk}" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Talk}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding DeniedFlash}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Emg}" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.PttChannels.IsTile, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Width" Value="160" /><Setter Property="MinHeight" Value="110" /><Setter Property="FontSize" Value="18" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEmergency}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Emg}" />
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.EmgSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsImminentPeril}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Ring}" />
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
