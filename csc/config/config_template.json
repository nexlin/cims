        {
          "key": "IdMs.AccessTokenTtl",
          "label": "Access Token TTL (s)",
          "type": "int",
          "default": 3600,
          "min": 60,
          "max": 604800,
          "restart": true
        },
        {
          "key": "IdMs.RefreshTokenTtl",
          "label": "Refresh Token TTL (s)",
          "type": "int",
          "default": 604800,
          "min": 600,
          "restart": true
        }
      ],
      "scope": "service"
    },
    {
      "key": "service_log",
      "title": "서비스 로그",
      "description": "녹취·msg·flow 로그의 공통 저장 루트. CSP·CMP·CSC 가 같은 경로를 쓰고 OAM 이 조회하므로 그룹 공통(service)으로 관리한다.",
      "fields": [
        {
          "key": "ServiceLogging.Dir",
          "label": "서비스 로그 루트",
          "type": "path",
          "default": "service_log",
          "deploy_value": "@SERVICE_LOG_DIR@",
          "restart": true,
          "help": "CSP·CMP 와 동일 경로여야 함 (CSC msg.jsonl 등 기록)."
        }
      ],
      "scope": "service"
    },
    {
      "key": "fm",
      "title": "FM 자기보고 (알람/이벤트 push)",
      "description": "모듈 내부 알람/이벤트를 OAM FM ingest 로 push — alarm_self_reporting.md. 카탈로그는 config/fm_catalog.json (기동 시 FM_REGISTER 로 등록).",
      "fields": [
        {
          "key": "SystemId",
          "label": "System ID",
          "type": "string",
          "default": "csc_01",
          "restart": true,
          "help": "노드 논리 ID — FM hdr.node 및 flow 로그 파일명에 사용. 다중 배치 시 노드별 분리 (csc_01/csc_02).",
          "scope": "system"
        },
        {
          "key": "Fm.Enable",
          "label": "FM 자기보고 사용",
          "type": "bool",
          "default": "true",
          "restart": true,
          "help": "끄면 자기보고 알람(DB 연결 등)·이벤트가 OAM 에 보고되지 않음 (외부 관측 폴링만 동작)."
        },
        {
          "key": "Fm.OamIp",
          "label": "OAM FM ingest 주소",
          "type": "string",
          "default": "127.0.0.1",
          "deploy_value": "@OAM_IP@",
          "restart": true,
          "help": "OAM(oam-svc) FM 수신 주소. 관리평면 이중화 환경에서는 VIP."
        },
        {
          "key": "Fm.OamPort",
          "label": "OAM FM ingest 포트",
          "type": "int",
          "default": 9010,
          "min": 1,
          "max": 65535,
          "restart": true,
          "help": "OAM FmIngest.Port 와 일치해야 함."
        },
        {
          "key": "Fm.SyncSec",
          "label": "활성 알람 동기화 주기 (초)",
          "type": "int",
          "default": 60,
          "min": 10,
          "max": 600,
          "restart": true,
          "advanced": true,
          "help": "FM_SYNC 주기 초기값 — FM_REGISTER 응답으로 OAM 이 지시하는 값이 우선."
        }
      ],
      "scope": "system"
    },
    {
      "key": "_infra",
      "title": "Infrastructure (내부 전용)",
