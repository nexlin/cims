{
  "version": 1,
  "sections": [
    {
      "key": "network",
      "title": "네트워크",
      "fields": [
        {
          "key": "Server.Ip", "label": "Admin API 바인딩 IP",
          "type": "string", "default": "0.0.0.0",
          "required": true, "restart": true
        },
        {
          "key": "Server.Port", "label": "Admin API 포트",
          "type": "int", "default": 4420, "min": 1, "max": 65535,
          "required": true, "restart": true
        },
        {
          "key": "McpttServer.Ip", "label": "MCPTT API 바인딩 IP",
          "type": "string", "default": "0.0.0.0", "restart": true
        },
        {
          "key": "McpttServer.Port", "label": "MCPTT API 포트",
          "type": "int", "default": 4430, "min": 1, "max": 65535,
          "restart": true
        }
      ]
    },
    {
      "key": "notify",
      "title": "CSP Notify",
      "description": "가입자/그룹 변경 실시간 반영 대상",
      "fields": [
        {
          "key": "CspNotify.Ip", "label": "CSP IP",
          "type": "string", "default": "127.0.0.1", "restart": false,
          "reload_hint": "런타임 리로드 가능"
        },
        {
          "key": "CspNotify.Port", "label": "CSP Notify 포트",
          "type": "int", "default": 4421, "min": 1, "max": 65535,
          "restart": false
        }
      ]
    },
    {
      "key": "log",
      "title": "로깅",
      "fields": [
        {
          "key": "Log.Level", "label": "로그 레벨",
          "type": "enum", "options": ["DEBUG","INFO","WARN","ERROR"],
          "default": "INFO",
          "restart": false
        },
        {
          "key": "Log.File", "label": "로그 파일 경로(상대)",
          "type": "string", "default": "log/csc.log", "restart": true
        }
      ]
    },
    {
      "key": "db",
      "title": "데이터베이스",
      "fields": [
        { "key": "CimsDatabase.Host",     "label": "DB Host",     "type": "string",   "default": "127.0.0.1", "restart": true },
        { "key": "CimsDatabase.Port",     "label": "DB Port",     "type": "int",      "default": 3306, "restart": true },
        { "key": "CimsDatabase.User",     "label": "DB User",     "type": "string",   "default": "cims", "restart": true },
        { "key": "CimsDatabase.Password", "label": "DB Password", "type": "password", "default": "", "restart": true },
        { "key": "CimsDatabase.Db",       "label": "DB Name",     "type": "string",   "default": "cims", "restart": true }
      ]
    },
    {
      "key": "agent",
      "title": "Agent mTLS",
      "fields": [
        {
          "key": "Agent.MtlsEnabled", "label": "mTLS 활성 (enroll 시 agent cert 발급)",
          "type": "bool", "default": false, "restart": true
        }
      ]
    }
  ]
}
