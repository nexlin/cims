{
  "_comment": "Per-node HA configuration (B 옵션 통합). Copy to ha.json on each node, adjust per-node fields (node_name / local_ip / peer_ip / initial_state). 신규 서비스 추가 = services 항목 1개 추가.",

  "node_name": "node-a",
  "interface": "ens160",

  "local_ip": "10.0.0.11",
  "peer_ip":  "10.0.0.12",

  "initial_state": "MASTER",
  "vip_mask": "24",
  "auth_pass": "REPLACE_ME_8CHAR",

  "ha_log_dir": "/var/log/cims-ha",
  "cims_home":  "/opt/cims",
  "cims_user":  "cims",

  "services": {
    "csc": { "enabled": true, "vrid": 51, "vip": "10.0.0.100", "priority": 100, "port": 4420, "proto": "tcp" },
    "csp": { "enabled": true, "vrid": 52, "vip": "10.0.0.101", "priority": 100, "port": 5060, "proto": "udp" },
    "psp": { "enabled": true, "vrid": 53, "vip": "10.0.0.102", "priority": 100, "port": 5060, "proto": "udp", "bind_ip": "" }
  }
}
