#!/usr/bin/env bash
# agent/bin/cims-svc — CIMS 서비스 lifecycle 운영 도구
#
# 사용법:
#   cims-svc start  <svc>     # 서비스 시작
#   cims-svc stop   <svc>     # 서비스 중지
#   cims-svc restart <svc>    # 재시작
#   cims-svc status           # 전체 상태
#   cims-svc log    <svc>     # 로그 tail -f
#
#   <svc> = all | cmp | cmdp | csp | oam | csc | console
#         | pmp | imp | psp | isp                  (변종 — 배포본 전용)
#         | cwrtc | phone                          (재설계 예정 — all/status 제외, 명시 지정만)
#         | tb | tb-csc | tb-console               (Test-Bed)
#
# OAM 분리 Phase 3b: oam = OAM REST API 서버 (Agent / HA / 배포 / 검증, port 4419)
#                    csc = CSC REST API 서버 (가입자 / MCPTT, port 4421 admin + 4430 mcptt)
#
# 배포본 위치: ${install_path}/agent/bin/cims-svc
# 개발 환경: ${repo_root}/build/dist/agent/bin/cims-svc (cims.sh sync 로 동기화)

set -euo pipefail

# caller 의 restrictive umask 가 run/·log/ 모드로 전파되지 않게 고정 — keepalived
# (v2.3.x, umask 0177) 의 notify 경유 호출이 탐색비트 없는 0600 디렉토리를 만들면
# 이후 모듈 기동(로그 리다이렉트·pidfile 생성)이 EACCES 로 영구 실패한다.
umask 0022

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# DIST_DIR 결정 우선순위:
#   1) 환경변수 CIMS_DIST_DIR (cims_agent 등 외부 caller 의 명시적 install_path)
#   2) 소스 트리 직접 (agent/bin/cims-svc, <repo>/CMakeLists.txt) → build/dist
#   3) 그 외 (build/dist 안, 배포본) → agent 부모
# 소스 트리 경로(SRC_*)는 취급하지 않는다 — 엔진은 dist 계약만 (vite dev 등은 cims.sh).
if [[ -n "${CIMS_DIST_DIR:-}" ]]; then
    DIST_DIR="$CIMS_DIST_DIR"
else
    _AGENT_PARENT="$(cd "$SCRIPT_DIR/../.." && pwd)"
    if [[ -f "$_AGENT_PARENT/CMakeLists.txt" ]]; then
        DIST_DIR="$_AGENT_PARENT/build/dist"
    else
        DIST_DIR="$_AGENT_PARENT"
    fi
fi

PID_DIR="$DIST_DIR/run"
LOG_DIR="$DIST_DIR/log"
mkdir -p "$PID_DIR" "$LOG_DIR"
# 과거 umask 전파 사고로 0600 이 된 기존 디렉토리 자가 교정 (mkdir -p 는 기존 모드 불변)
chmod u+rwx,go+rx "$PID_DIR" "$LOG_DIR" 2>/dev/null || true

# 색상 / 로깅 helpers — lifecycle.sh 가 사용 (ANSI-C 인용 — heredoc 에서도 렌더링)
RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'

info()    { echo -e "${CYAN}[INFO]${NC}  $*"; }
ok()      { echo -e "${GREEN}[OK]${NC}    $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC}  $*"; }
err()     { echo -e "${RED}[ERROR]${NC} $*" >&2; }
header()  { echo -e "\n${BOLD}$*${NC}"; }

# lifecycle library
source "$SCRIPT_DIR/../lib/lifecycle.sh"
# 노드 TLS 인증서 보증 — 관리평면 모듈 기동 전 선행 조건 (cert.sh 머리말 참조)
source "$SCRIPT_DIR/../lib/cert.sh"

usage() {
    cat <<EOF
사용법: cims-svc <subcommand> [args]

  start    [svc|all]      서비스 시작 (기본: all)
  stop     [svc|all]      서비스 중지
  restart  [svc|all]      재시작
  status                  전체 상태
  log      <svc>          로그 tail -f

  svc: cmp|pmp|imp|cmdp|csp|psp|isp|oam|csc|console|tb-csc|tb-console
       all = cmp cmdp csp oam csc console
       tb  = tb-csc tb-console
       (변종 pmp|imp|psp|isp 는 배포본 전용, cwrtc|phone 은 재설계 예정 — 명시 지정만)

DIST_DIR=$DIST_DIR
EOF
}

case "${1:-help}" in
    start)    shift; header "=== CIMS 시작 ==="; cmd_start "$@"; echo ""; cmd_status ;;
    stop)     shift; cmd_stop "$@"; echo ""; cmd_status ;;
    restart)  shift; header "=== CIMS 재시작 ==="; cmd_restart "$@"; echo ""; cmd_status ;;
    status)   cmd_status ;;
    log)      shift; cmd_log "${1:-csp}" ;;
    help|--help|-h) usage ;;
    *)        err "알 수 없는 subcommand: $1"; usage; exit 1 ;;
esac
