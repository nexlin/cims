#!/usr/bin/env bash
# agent/bin/cims-notify — generic keepalived state transition hook
#
# 사용법: (keepalived 의 vrrp_instance notify 에서 호출)
#   cims-notify <svc> <TYPE> <NAME> <STATE> <PRIORITY>
#
# keepalived 가 인자 4개 (TYPE/NAME/STATE/PRIORITY) 를 자동 전달. <svc> 는
# keepalived 설정 시 cims-notify 호출 라인에 명시 (`notify
# "${BIN_DIR}/cims-notify Control"`) — ha.json services.<svc> 키 (그룹명).
#
# 동작 — keepalived 는 기본적으로 VIP 만 옮기고 서비스는 건드리지 않는다:
#   ha.json services.<svc>.cold_modules[] 에 등록된 모듈만 절체 대상 (cold-spare).
#     MASTER        → 각 cold 모듈을 cims-svc start (선언 순서)
#     BACKUP|FAULT  → 각 cold 모듈을 cims-svc stop (역순)
#   cold_modules 미지정/빈 목록 → 전이 로그만 기록 (hot — 양쪽 상시 기동, VIP-only).
#   STOP (keepalived 자체 종료) → 무변경.
#
# 모듈 제어는 cims@ systemd 유닛 대신 cims-svc 직접 호출 — 단일 lifecycle 경로
# (pid/health-gate/supervised 일관). keepalived 가 root 로 실행하므로 runuser 로
# ${CIMS_USER} 강등해 실행한다.
#
# 옛 notify_{csc,csp,psp}.sh (각 서비스별 분리) 의 대체.

set -euo pipefail

SVC="${1:-}"
TYPE="${2:-}"
NAME="${3:-}"
STATE="${4:-}"
PRIO="${5:-}"

if [[ -z "$SVC" || -z "$STATE" ]]; then
    echo "usage: cims-notify <svc> <TYPE> <NAME> <STATE> <PRIORITY>" >&2
    exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# ha.json lookup — 스테이징 레이아웃(/etc/keepalived/bin/ → ../ha.json) 우선,
# 없으면 개발/번들 레이아웃(agent/bin/ → ../keepalived/ha.json). cims-health 와 동일.
if [[ -f "$SCRIPT_DIR/../ha.json" ]]; then
    HA_JSON="$(cd "$SCRIPT_DIR/.." && pwd)/ha.json"
else
    HA_JSON="$(cd "$SCRIPT_DIR/../keepalived" 2>/dev/null && pwd)/ha.json"
fi

LOG="${HA_LOG_DIR:-/var/log/cims-ha}/notify_${SVC}.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null

log() { echo "$(date -Iseconds) ${TYPE} ${NAME} -> ${STATE} (prio=${PRIO}) :: $*" >> "$LOG"; }

# ha.json 에서 cold_modules / cims_home / cims_user lookup.
# 출력: CIMS_HOME|CIMS_USER|MOD1,MOD2,...
IFS='|' read -r CIMS_HOME CIMS_USER COLD < <(python3 - "$HA_JSON" "$SVC" <<'PY'
import json, sys, os
ha_json, svc = sys.argv[1], sys.argv[2]
home, user, cold = "/opt/cims", "cims", []
if os.path.isfile(ha_json):
    try:
        cfg = json.load(open(ha_json))
        home = cfg.get("cims_home", home)
        user = cfg.get("cims_user", user)
        s = (cfg.get("services") or {}).get(svc) or {}
        cold = [str(m).strip() for m in (s.get("cold_modules") or []) if str(m).strip()]
    except Exception:
        pass
print(f"{home}|{user}|{','.join(cold)}")
PY
)

# cims-svc 위치 — 버전화 레이아웃(agent/current) 우선, flat legacy fallback.
CIMS_SVC=""
for cand in "$CIMS_HOME/agent/current/bin/cims-svc" "$CIMS_HOME/agent/bin/cims-svc"; do
    if [[ -x "$cand" ]]; then CIMS_SVC="$cand"; break; fi
done

_svc_ctl() {  # <start|stop> <module>
    local act="$1" mod="$2"
    if [[ -z "$CIMS_SVC" ]]; then
        log "FAIL: cims-svc 미발견 (CIMS_HOME=$CIMS_HOME) — $act $mod 스킵"
        return 0
    fi
    if runuser -u "$CIMS_USER" -- "$CIMS_SVC" "$act" "$mod" >>"$LOG" 2>&1; then
        log "$act $mod OK"
    else
        log "FAIL: cims-svc $act $mod rc=$?"
    fi
}

case "$STATE" in
    MASTER)
        # 승격 시각 기록 — cims-health 가 grace_sec 동안 검사 실패를 유예하는 기준점
        # (cold 모듈 기동 시간 흡수). mtime 기준이라 내용은 로그 용도.
        date -Iseconds > "$(dirname "$LOG")/master_at_${SVC}" 2>/dev/null || true
        if [[ -n "${COLD:-}" ]]; then
            log "MASTER 승격 → cold 모듈 기동: ${COLD}"
            IFS=',' read -r -a MODS <<< "$COLD"
            for m in "${MODS[@]}"; do
                if [[ -n "$m" ]]; then _svc_ctl start "$m"; fi
            done
        else
            log "MASTER 승격 — cold_modules 없음, VIP 인수만 (서비스 무접촉)"
        fi
        ;;
    BACKUP|FAULT)
        if [[ -n "${COLD:-}" ]]; then
            log "${STATE} 강등 → cold 모듈 정지 (역순): ${COLD}"
            IFS=',' read -r -a MODS <<< "$COLD"
            for (( i=${#MODS[@]}-1; i>=0; i-- )); do
                if [[ -n "${MODS[$i]}" ]]; then _svc_ctl stop "${MODS[$i]}"; fi
            done
        else
            log "${STATE} 강등 — cold_modules 없음, VIP 반납만 (서비스 무접촉)"
        fi
        ;;
    STOP)
        log "keepalived 자체 종료 — 서비스 상태 유지 (운영자가 직접 제어)"
        ;;
    *)
        log "알 수 없는 상태 — 무시"
        ;;
esac
exit 0
