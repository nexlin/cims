#!/usr/bin/env bash
# agent/bin/cims-health — generic listen probe (keepalived vrrp_script 가 호출)
#
# 사용법:
#   cims-health <svc>
#     <svc> = ha.json services.<svc> 에 등록된 slug (그룹명)
#
# 동작 (상태 인지 — cold-spare 정합):
#   0) 이 노드가 해당 서비스의 VIP 를 보유하지 않으면 무조건 PASS —
#      standby 는 cold 모듈이 정지 상태인 것이 정상이라, 포트 검사를 하면
#      영구 FAULT 로 승격 자격을 잃는 데드락이 된다 (헬스는 VIP 보유자만 검사).
#   1) VIP 보유 노드: ha.json services.<svc>.{port, proto, bind_ip} lookup 후
#      `ss -ln{t,u}` 로 binding 확인 (listen 중이면 PASS)
#      — services.<svc>.health_module/health_config_key 가 렌더돼 있으면(csc 등
#        설정 단일키 모듈) 검사 시점에 노드 로컬 배포 config.json
#        (${cims_home}/modules/<mod>/current/<mod>/config.json) 의 그 키에서 포트를
#        직접 읽는다 — 배포기록↔실파일 포트 드리프트가 나도 헬스는 모듈이 실제
#        bind 하는 포트를 본다 (드리프트 노출은 config_out_of_sync 알람 몫).
#        읽기 실패 시 ha.json port → 내장 default 순 fallback.
#   2) tracked_modules 가 지정되면 `pgrep -x <mod>` 도 모두 PASS 해야 rc=0
#   실패 시 rc=1 → keepalived FAULT → VIP 이양 → 피어가 승격.
#
# 옛 check_{csc,csp,psp}.sh (각 서비스별 분리) 의 대체.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# ha.json lookup — 스테이징 레이아웃(/etc/keepalived/bin/ → ../ha.json, cims-ha apply
# 가 함께 복사) 우선, 없으면 개발/번들 레이아웃(agent/bin/ → ../keepalived/ha.json).
if [[ -f "$SCRIPT_DIR/../ha.json" ]]; then
    HA_JSON="$(cd "$SCRIPT_DIR/.." && pwd)/ha.json"
else
    HA_JSON="$(cd "$SCRIPT_DIR/../keepalived" 2>/dev/null && pwd)/ha.json"
fi

SVC="${1:-}"
[[ -z "$SVC" ]] && { echo "usage: cims-health <svc>" >&2; exit 2; }

# ha.json 에서 port / proto / bind_ip / vips / tracked_modules lookup. 미존재 시 default.
# 출력 형식: PORT|PROTO|BIND_IP|VIP1,VIP2|MOD1,MOD2  (빈값 케이스에서 split 충돌 회피)
IFS='|' read -r PORT PROTO BIND_IP VIPS TRACKED < <(python3 - "$HA_JSON" "$SVC" <<'PY'
import json, sys, os
ha_json, svc = sys.argv[1], sys.argv[2]
defaults = {"csc": (4421, "tcp", ""),
            "csp": (5060, "udp", ""),
            "psp": (5060, "udp", "")}
port, proto, bind_ip = defaults.get(svc, (0, "udp", ""))
vips, tracked = [], []
if os.path.isfile(ha_json):
    try:
        cfg = json.load(open(ha_json))
        s = (cfg.get("services") or {}).get(svc) or {}
        port = s.get("port", port)
        proto = s.get("proto", proto)
        bind_ip = s.get("bind_ip", bind_ip)
        vips = [str(v.get("ip")).strip() for v in (s.get("vips") or [])
                if isinstance(v, dict) and v.get("ip")]
        if s.get("vip"):
            vips.append(str(s["vip"]).strip())
        fo = s.get("failover_options") or {}
        tracked = [str(m).strip() for m in (fo.get("tracked_modules") or []) if str(m).strip()]
        # 진실 기반 포트 — 모듈이 실제 읽는 배포 config.json 의 키에서 유도.
        # (OAM 이 수동 health.port 오버라이드 시 health_module 을 렌더하지 않음.)
        mod, key = s.get("health_module"), s.get("health_config_key")
        if mod and key:
            try:
                home = cfg.get("cims_home") or "/opt/cims"
                base = os.path.join(home, "modules", mod, "current")
                for rel in (os.path.join(mod, "config.json"), "config.json"):
                    p = os.path.join(base, rel)
                    if not os.path.isfile(p):
                        continue
                    mc = json.load(open(p))
                    v = mc.get(key)                      # flat dot-key (배포 표준)
                    if v is None:
                        cur = mc                         # nested fallback
                        for part in key.split("."):
                            cur = cur.get(part) if isinstance(cur, dict) else None
                            if cur is None:
                                break
                        v = cur
                    if v and 0 < int(v) < 65536:
                        port = int(v)
                    break
            except Exception:
                pass                                     # ha.json port 그대로
    except Exception:
        pass
print(f"{port}|{proto}|{bind_ip}|{','.join(vips)}|{','.join(tracked)}")
PY
)

# 0) VIP 보유 검사 — 미보유(BACKUP/standby)면 서비스 상태와 무관하게 PASS.
#    (VIP 미정의 그룹은 판정 불가 → 종전대로 포트 검사로 진행.)
if [[ -n "${VIPS:-}" ]]; then
    LOCAL_ADDRS=$(ip -o addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
    HOLD=0
    IFS=',' read -r -a VIPARR <<< "$VIPS"
    for v in "${VIPARR[@]}"; do
        if [[ -n "$v" ]] && grep -qxF "$v" <<< "$LOCAL_ADDRS"; then HOLD=1; break; fi
    done
    if [[ $HOLD -eq 0 ]]; then
        exit 0      # standby — cold 모듈 정지가 정상, 헬스는 VIP 보유자만 검사
    fi
fi

if [[ -z "${PORT:-}" || "$PORT" == "0" ]]; then
    echo "cims-health: port unknown for svc=$SVC" >&2
    exit 2
fi

case "$PROTO" in
    tcp) FLAG="-lnt" ;;
    udp|*) FLAG="-lnu" ;;
esac

# 1) port listen 검사
if [[ -n "$BIND_IP" ]]; then
    ss $FLAG "src ${BIND_IP}:${PORT}" 2>/dev/null | awk 'NR>1 {found=1} END {exit found?0:1}' \
        || { echo "cims-health: $SVC port ${BIND_IP}:${PORT}/${PROTO} not listening" >&2; exit 1; }
else
    ss $FLAG "sport = :${PORT}" 2>/dev/null | awk 'NR>1 {found=1} END {exit found?0:1}' \
        || { echo "cims-health: $SVC port :${PORT}/${PROTO} not listening" >&2; exit 1; }
fi

# 2) tracked_modules pgrep 검사 (지정된 경우만)
if [[ -n "${TRACKED:-}" ]]; then
    IFS=',' read -r -a MODS <<< "$TRACKED"
    for m in "${MODS[@]}"; do
        [[ -z "$m" ]] && continue
        if ! pgrep -x "$m" >/dev/null 2>&1; then
            echo "cims-health: $SVC tracked module '$m' not running" >&2
            exit 1
        fi
    done
fi

exit 0
