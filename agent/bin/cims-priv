#!/usr/bin/env bash
# agent/bin/cims-priv — agent 가 root 권한이 필요한 인프라 작업만 위임받아 수행
#
# sudoers NOPASSWD 화이트리스트 단일 entry 대상. 각 subcommand 가 자체적으로
# 인자 검증 (iface 패턴, CIDR 형식, lo 거부) 을 수행하므로 wildcard sudoers 에서도
# 임의 명령 주입 위험 없음.
#
# 사용법 (agent 내부 호출):
#   sudo -n cims-priv ip-add <iface> <cidr>
#   sudo -n cims-priv ip-del <iface> <cidr>
#   sudo -n cims-priv route-add <dest_cidr> <via> <dev>
#   sudo -n cims-priv route-del <dest_cidr> <via> <dev>
#   sudo -n cims-priv keepalived-unmask               # 설치 중단으로 남은 mask 잔재 해제
#   sudo -n cims-priv policy-rc-clear                 # 구버전이 남긴 policy-rc.d 잔재 제거
#   sudo -n cims-priv setcap-net-admin <bin>          # csp/cspsim 에 CAP_NET_ADMIN (IMS AKA+IPsec XFRM)
#   sudo -n cims-priv version
#
# ip-add 는 항상 'label <iface>:cims' 를 부여 — collect_interfaces 가 label 로
# managed IP 식별. ip-del 은 label 무관하게 동작 (단 agent 가 호출 전 managed
# 여부 검증한다는 전제).
# route-add 는 default gateway (0.0.0.0/0 또는 'default') 를 거부 — mgmt 망 단절
# 위험. specific subnet route 만 허용.

set -euo pipefail

IP_CMD="/usr/bin/ip"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENDOR_DIR="$SELF_DIR/../vendor"

err()  { echo "[ERROR] $*" >&2; }
info() { echo "[INFO]  $*"; }
ok()   { echo "[OK]    $*"; }

# ── 인자 검증 ───────────────────────────────────────
valid_iface() {
    # IFNAMSIZ = 16 → 최대 15자. lo / dash-prefix 거부 (인자 주입 차단).
    [[ "$1" =~ ^[a-zA-Z0-9_.-]{1,15}$ ]] || { err "invalid iface: $1"; return 1; }
    [[ "$1" == "lo" ]]   && { err "lo not allowed"; return 1; }
    [[ "$1" =~ ^- ]]     && { err "iface cannot start with dash: $1"; return 1; }
    return 0
}

valid_cidr() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]] \
        || { err "invalid cidr: $1"; return 1; }
    return 0
}

# 네트워크 튜닝 sysctl 키 allowlist — net.core.* / net.ipv4.* 중 안전한 성능 키만 허용.
# (임의 sysctl 쓰기 차단 — wildcard sudoers 에서도 주입 위험 없도록.)
NET_SYSCTL_FILE="/etc/sysctl.d/99-cims-net-tuning.conf"
valid_sysctl_key() {
    case "$1" in
        net.core.netdev_max_backlog|net.core.netdev_budget|net.core.netdev_budget_usecs|\
        net.core.rmem_max|net.core.wmem_max|net.core.rmem_default|net.core.wmem_default|\
        net.core.optmem_max|net.core.somaxconn|net.core.busy_poll|net.core.busy_read) return 0 ;;
        # 기능 키 — VIP 를 설정값으로 bind 하는 모듈(csp LocalIp=VIP 등)이 VIP 취득
        # 전에도 기동 가능해야 한다 (워크플로: start → VIP 적용). cims-ha apply 도
        # 설정하지만 그건 VIP 적용 후라 순서가 늦다 — agent 가 기동 시 선행 보장.
        net.ipv4.ip_nonlocal_bind) return 0 ;;
        *) err "sysctl key not in allowlist: $1"; return 1 ;;
    esac
}
valid_uint() {
    [[ "$1" =~ ^[0-9]{1,12}$ ]] || { err "invalid uint: $1"; return 1; }
    return 0
}
# rps_cpus 마스크 — 16진 비트마스크(콤마 그룹 허용), 예 "ff", "fff,ffffffff". "0"=비활성.
valid_rps_mask() {
    [[ "$1" =~ ^[0-9a-fA-F]+(,[0-9a-fA-F]+)*$ ]] || { err "invalid rps mask: $1"; return 1; }
    return 0
}

# ── 액션 ────────────────────────────────────────────
# CAP_NET_ADMIN 파일 capability — IMS AKA+IPsec(sip_access_security.md §8.3)의 커널 XFRM SA 프로그래밍.
#   대상은 csp/cspsim 실행 파일뿐(basename 고정, 일반 파일, '..' 없음). 파일이 교체(업그레이드)되면
#   capability 가 사라지므로 agent 가 설치/기동마다 다시 건다. setcap 이 없으면 rc=4.
do_setcap_net_admin() {
    local path="$1"
    [[ "$path" == /* && "$path" != *..* ]] || { err "setcap-net-admin: absolute path without '..' required"; exit 2; }
    local base; base="$(basename "$path")"
    [[ "$base" == "csp" || "$base" == "cspsim" ]] || { err "setcap-net-admin: only csp/cspsim binaries"; exit 2; }
    [[ -f "$path" && ! -L "$path" ]] || { err "setcap-net-admin: not a regular file: $path"; exit 2; }
    local setcap_cmd; setcap_cmd="$(command -v setcap 2>/dev/null || true)"
    [[ -n "$setcap_cmd" ]] || { err "setcap not installed (libcap2-bin)"; exit 4; }
    if "$setcap_cmd" cap_net_admin+ep "$path"; then
        ok "cap_net_admin+ep $path"
    else
        err "setcap failed: $path"
        exit 3
    fi
}

do_ip_add() {
    local iface="$1" cidr="$2"
    valid_iface "$iface" || exit 2
    valid_cidr "$cidr"   || exit 2
    # label = "<iface>:cims" — collect_interfaces 가 label 로 cims-managed 식별.
    # IFNAMSIZ=16 제약상 label 도 16 자 미만이어야. iface 최대 15자 + ':cims' 5자 = 최대 20자 가능 →
    # iface 이름이 11자 이상이면 label 충돌 위험. 그 경우엔 label 생략 (관리 식별 불가하므로 skip 안 함).
    local label_arg=()
    if (( ${#iface} <= 10 )); then
        label_arg=(label "${iface}:cims")
    fi
    if "$IP_CMD" addr add "$cidr" dev "$iface" "${label_arg[@]}" 2>/tmp/cims-priv.err; then
        ok "$iface += $cidr${label_arg:+ (label=${iface}:cims)}"
    else
        # kernel 이 같은 IP/dev 충돌 시 두 가지 메시지 중 하나 반환 — 둘 다 already-present 로 처리
        if grep -qE "File exists|Address already assigned" /tmp/cims-priv.err 2>/dev/null; then
            info "$iface: $cidr already present (skip)"
        else
            err "ip addr add $cidr dev $iface: $(cat /tmp/cims-priv.err 2>/dev/null)"
            exit 3
        fi
    fi
    rm -f /tmp/cims-priv.err
}

# 'default' 또는 CIDR 모두 dst 로 허용. default → 'default' literal 그대로 전달.
valid_dst() {
    [[ "$1" == "default" || "$1" == "0.0.0.0/0" ]] && return 0
    valid_cidr "$1"
}

do_route_add() {
    local dest="$1" via="$2" dev_="$3"
    valid_dst "$dest"      || exit 2
    [[ "$via" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || { err "invalid via: $via"; exit 2; }
    valid_iface "$dev_"    || exit 2
    # 'replace' 단일 verb — default / specific 모두 idempotent. 같은 dst 의 옛 entry 덮어쓰기 →
    # UI 의 [수정] 흐름 (op='add' 1회) 으로 via/dev 변경 가능.
    if "$IP_CMD" route replace "$dest" via "$via" dev "$dev_" 2>/tmp/cims-priv.err; then
        ok "route += $dest via $via dev $dev_"
    else
        err "ip route replace $dest via $via dev $dev_: $(cat /tmp/cims-priv.err 2>/dev/null)"
        exit 3
    fi
    rm -f /tmp/cims-priv.err
}

do_route_del() {
    local dest="$1" via="$2" dev_="$3"
    valid_dst "$dest"      || exit 2
    [[ "$via" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || { err "invalid via: $via"; exit 2; }
    valid_iface "$dev_"    || exit 2
    if "$IP_CMD" route del "$dest" via "$via" dev "$dev_" 2>/dev/null; then
        ok "route -= $dest via $via dev $dev_"
    else
        info "route $dest via $via dev $dev_ not present (skip)"
    fi
}

do_ip_del() {
    local iface="$1" cidr="$2"
    valid_iface "$iface" || exit 2
    valid_cidr "$cidr"   || exit 2
    if "$IP_CMD" addr del "$cidr" dev "$iface" 2>/dev/null; then
        ok "$iface -= $cidr"
    else
        info "$iface: $cidr not present (skip)"
    fi
}

# ── mount 검증/액션 ─────────────────────────────────
#   콘솔에서 agent 로 마운트 추가 — fstab 에 기록(영속 → 부팅 시 OS 자동 마운트)하고
#   즉시 mount. 네트워크 FS 는 _netdev,nofail 강제(마운트 실패/지연이 부팅을 막지 않도록).
FSTAB="/etc/fstab"
CIMS_MNT_TAG="cims-managed"

valid_fstype() {
    case "$1" in
        nfs|nfs4|cifs|ext4|ext3|xfs|btrfs) return 0 ;;
        *) err "unsupported fstype: $1 (nfs|nfs4|cifs|ext4|ext3|xfs|btrfs)"; return 1 ;;
    esac
}

valid_target() {
    [[ "$1" =~ ^/[A-Za-z0-9._/-]+$ ]] || { err "invalid target path: $1"; return 1; }
    [[ "$1" == *..* ]] && { err "target must not contain '..': $1"; return 1; }
    case "$1" in
        /|/etc|/etc/*|/boot|/boot/*|/usr|/usr/*|/bin|/bin/*|/sbin|/sbin/*|/lib|/lib/*|/lib64|/lib64/*|/var|/var/*|/root|/root/*|/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*|/home|/home/*)
            err "target in protected path denied: $1"; return 1 ;;
    esac
    return 0
}

valid_nospace() { [[ -n "$1" && ! "$1" =~ [[:space:]] ]] || { err "invalid (empty/contains space): '$1'"; return 1; }; }

# 패키지 판정(_pkg_*)과 dpkg 직렬화(_cims_dpkg)는 lib/pkgstate.sh 가 정본 — cims-ha 와
# 규칙을 공유한다. 한쪽만 고친 판정이 반대편에서 재발하는 것을 구조로 막는다.
source "$SELF_DIR/../lib/pkgstate.sh"

# cims-ha 가 dpkg 구간에 만든 policy-rc.d(exit 101) 잔재 제거.
#   상위(agent)가 타임아웃으로 cims-ha 를 **kill** 하면 스크립트의 trap 이 실행되지 않아
#   파일이 남고, 그러면 **그 호스트의 모든 패키지 서비스 자동기동이 차단**된다(실측 사고).
#   우리 마커가 있는 파일만 지운다 — 타 도구/운영자가 만든 파일은 건드리지 않는다.
POLICY_RC_PATH="/usr/sbin/policy-rc.d"
POLICY_RC_MARK="cims-ha managed"

do_policy_rc_clear() {
    if [[ ! -e "$POLICY_RC_PATH" ]]; then
        info "policy-rc.d 없음 (정상)"
        return 0
    fi
    if grep -qF "$POLICY_RC_MARK" "$POLICY_RC_PATH" 2>/dev/null; then
        rm -f "$POLICY_RC_PATH" && ok "cims 소유 policy-rc.d 잔재 제거 — 서비스 자동기동 차단 해제"
    else
        info "policy-rc.d 가 cims 소유 아님 — 보존"
    fi
}

_fstab_drop_target() {   # stdout: 주어진 target 의 cims-managed 라인을 제외한 fstab 내용
    awk -v tgt="$1" -v tag="$CIMS_MNT_TAG" '!($2==tgt && index($0,tag)>0)' "$FSTAB"
}

# 네트워크 FS 클라이언트(mount.nfs/mount.cifs)가 없으면 vendor (offline) deb 로
# 자동 설치 — private/air-gapped 환경엔 apt repo 가 없으므로. keepalived(cims-ha
# install)와 동일 패턴. vendor deb 도 없으면 명확한 에러로 실패(부팅 무영향: nofail).
ensure_fs_client() {
    local fstype="$1" helper vdir
    case "$fstype" in
        nfs|nfs4) helper="mount.nfs";  vdir="$VENDOR_DIR/nfs"  ;;
        cifs)     helper="mount.cifs"; vdir="$VENDOR_DIR/cifs" ;;
        *)        return 0 ;;
    esac
    if command -v "$helper" >/dev/null 2>&1 || [[ -x "/sbin/$helper" ]]; then
        return 0
    fi
    if ls "$vdir"/*.deb >/dev/null 2>&1; then
        info "$helper 미설치 — vendor offline 설치 ($vdir)"
        # 우리 쪽 다른 dpkg 작업(keepalived 설치 등)과 겹치지 않게 락을 잡고 실행한다 —
        # agent job worker 가 module/ha 레인으로 병렬 실행되므로 동시 호출이 가능하다.
        if ! _cims_dpkg dpkg -i --force-confmiss --force-confnew --force-overwrite "$vdir"/*.deb >/tmp/cims-priv.err 2>&1; then
            _cims_dpkg apt-get -o DPkg::Lock::Timeout=100 -y --fix-broken install >/dev/null 2>&1 || true
            _cims_dpkg dpkg -i --force-confmiss --force-confnew --force-overwrite "$vdir"/*.deb >/tmp/cims-priv.err 2>&1 || {
                err "$fstype client vendor 설치 실패: $(tail -3 /tmp/cims-priv.err 2>/dev/null)"
                return 1
            }
        fi
        ok "$fstype client 설치 완료 (vendor): $helper"
    else
        err "$helper 미설치 + vendor deb 없음 ($vdir) — '$fstype' mount 불가. agent 패키지에 vendor/nfs/*.deb 동봉 필요"
        return 1
    fi
    return 0
}

do_mount_add() {
    local fstype="$1" source="$2" target="$3" options="${4:-defaults}"
    valid_fstype "$fstype"   || exit 2
    valid_target "$target"   || exit 2
    valid_nospace "$source"  || exit 2
    valid_nospace "$options" || exit 2
    case "$fstype" in
        nfs|nfs4|cifs) [[ "$options" == *_netdev* ]] || options="${options},_netdev" ;;
    esac
    [[ "$options" == *nofail* ]] || options="${options},nofail"
    # 네트워크 FS 클라이언트 미설치 시 vendor deb 자동 설치 (air-gapped)
    ensure_fs_client "$fstype" || exit 3
    mkdir -p "$target" 2>/tmp/cims-priv.err || { err "mkdir $target: $(cat /tmp/cims-priv.err 2>/dev/null)"; exit 3; }
    # fstab idempotent update (같은 target 의 cims-managed 라인 교체) + 백업
    local tmp; tmp="$(mktemp)"
    _fstab_drop_target "$target" > "$tmp"
    printf '%s %s %s %s 0 0  # %s\n' "$source" "$target" "$fstype" "$options" "$CIMS_MNT_TAG" >> "$tmp"
    cp "$FSTAB" "${FSTAB}.cims.bak" 2>/dev/null || true
    cat "$tmp" > "$FSTAB"; rm -f "$tmp"
    if mountpoint -q "$target"; then
        info "$target already mounted (fstab 갱신 완료)"
    elif mount "$target" 2>/tmp/cims-priv.err; then
        ok "mounted $source -> $target ($fstype,$options)"
    else
        err "mount $target 실패: $(cat /tmp/cims-priv.err 2>/dev/null) — fstab 등록 유지(nofail 이라 부팅 무영향)"
        exit 3
    fi
    rm -f /tmp/cims-priv.err
}

do_mount_del() {
    local target="$1"
    valid_target "$target" || exit 2
    if mountpoint -q "$target"; then
        umount "$target" 2>/dev/null || umount -l "$target" 2>/dev/null \
            || { err "umount $target 실패 (busy)"; exit 3; }
    fi
    local tmp; tmp="$(mktemp)"
    _fstab_drop_target "$target" > "$tmp"
    cp "$FSTAB" "${FSTAB}.cims.bak" 2>/dev/null || true
    cat "$tmp" > "$FSTAB"; rm -f "$tmp"
    ok "unmounted + fstab 제거: $target"
}

do_net_sysctl() {
    local key="$1" val="$2"
    valid_sysctl_key "$key" || exit 2
    valid_uint "$val"       || exit 2
    # 영속: 관리 conf 에 key 라인 교체(append) — 부팅 시 systemd 가 /etc/sysctl.d 적용.
    # 기존 conf 에서 이 key 라인과 헤더(#)를 제거 후 재구성. grep 무매칭(빈결과) 시
    # exit 1 → set -e 중단 방지로 '|| true'. (구버전 버그: 빈 grep 으로 sysctl 미적용)
    local tmp; tmp="$(mktemp)"
    {
        echo "# cims-managed network tuning (auto)"
        if [[ -f "$NET_SYSCTL_FILE" ]]; then
            grep -vE "^[[:space:]]*${key//./\\.}[[:space:]]*=|^[[:space:]]*#" "$NET_SYSCTL_FILE" || true
        fi
        printf '%s = %s\n' "$key" "$val"
    } > "$tmp"
    mv "$tmp" "$NET_SYSCTL_FILE"
    # 런타임 즉시 적용
    if sysctl -w "$key=$val" >/dev/null 2>/tmp/cims-priv.err; then
        ok "sysctl $key=$val (persisted $NET_SYSCTL_FILE)"
    else
        err "sysctl -w $key=$val: $(cat /tmp/cims-priv.err 2>/dev/null)"; exit 3
    fi
    rm -f /tmp/cims-priv.err
}

# 모든 vendor offline deb(keepalived·nfs·lib류)를 전 노드에 균일 설치 (air-gapped).
# 원칙: "설치는 모든 노드 동일, 실행(서비스 기동)만 config(역할)가 제어" — 기능을
# 안 써서 의존성이 빠진 노드(예: media01 가 HA 미사용이라 libmnl 누락→ip 깨짐) 류
# 버그 원천 차단. idempotent: 이미 정상(ip+keepalived+mount.nfs 존재)이면 skip 하여
# 매 부팅 dpkg 재실행/서비스 교란(특히 HA 노드 keepalived flap)을 피한다.
# keepalived 설치 경로는 **둘**이다: cims-ha install(update_ha 안)과 이 함수(agent 기동마다).
# 그래서 cims-ha 에 넣은 보호(설치 중 서비스 기동 억제·상태 기반 판정·락 즉시 후퇴)를
# 여기에도 같은 방식으로 적용한다 — 한쪽만 고치면 agent 재시작·fresh 노드에서 재발한다.
_KA_MASKED_BY_US=0

# 실행 성공(-v)이 아니라 dpkg 상태가 정본 — 공유 라이브러리 위임.
#   _priv_pkg_ok      = 등록 여부
#   _priv_pkg_healthy = 등록 + **소유 파일 무결**(dpkg -V)
# 완비 판정은 healthy 로 한다. 등록만 보면 "설치됐는데 파일이 지워진" 노드를 정상으로
# 넘겨 재설치가 영영 skip 된다(실측 사고 — keepalived conffile 유실로 기동 불가).
_priv_pkg_ok()      { _pkg_ok "$1"; }
_priv_pkg_healthy() { _pkg_healthy "$1"; }

_priv_mask_ka() {
    if [[ "$(systemctl is-enabled keepalived 2>/dev/null)" == "masked" ]]; then
        _KA_MASKED_BY_US=1     # 잔재 — 우리가 정리한다
    else
        systemctl mask keepalived >/dev/null 2>&1 && _KA_MASKED_BY_US=1
    fi
    trap '_priv_unmask_ka' EXIT TERM INT HUP
}

_priv_unmask_ka() {
    [[ $_KA_MASKED_BY_US -eq 1 ]] || return 0
    systemctl unmask keepalived >/dev/null 2>&1 || true
    _KA_MASKED_BY_US=0
    trap - EXIT TERM INT HUP
}

# dpkg -i (락 경합이면 2 반환 — fix-broken 도 같은 락을 요구하므로 상위가 시도하지 않게)
_priv_dpkg_install() {
    local try out rc
    # 락 대기는 cims-ha 와 같은 기조 — unattended-upgrade 가 수 분간 점유한다(실측).
    for ((try = 1; try <= 5; try++)); do
        # --force-confmiss: 삭제된 conffile 복원. dpkg 는 기본적으로 conffile 삭제를
        # 관리자 의도로 보고 되돌리지 않는다 — 그래서 재설치를 해도 안 살아난다(실측).
        out=$(_cims_dpkg dpkg -i --force-confmiss --force-confnew --force-overwrite "$@" 2>&1); rc=$?
        [[ $rc -eq 0 ]] && return 0
        # 정확 문구만 락으로 본다 — 부분일치(`lock`)는 'block' 같은 무관한 출력도 잡는다.
        if printf '%s' "$out" | grep -qiE 'dpkg frontend lock|Could not get lock|lock .* (is )?held by|dpkg status database is locked|another process (is )?using'; then
            info "dpkg 락 경합 (시도 $try/5) — 20s 후 재시도"; sleep 20; continue
        fi
        printf '%s\n' "$out" | tail -3 > /tmp/cims-priv.err
        return $rc
    done
    echo "dpkg 락이 풀리지 않음 (apt.systemd.daily/unattended-upgrade)" > /tmp/cims-priv.err
    return 2
}

do_module_deps_install() {   # <module-vendor-dir> — 모듈 패키지가 들고 온 deb 를 설치
    local dir="$1"
    [[ "$dir" == /* && "$dir" != *..* ]] || { err "module-deps: absolute path without '..' required"; exit 2; }
    # 모듈 설치 트리 밑만 허용 — 임의 경로의 deb 설치를 특권으로 열어주지 않는다.
    [[ "$dir" == */modules/*/vendor || "$dir" == */modules/*/*/vendor ]] \
        || { err "module-deps: <install>/modules/<mod>/[<ver>/]vendor 경로만 허용: $dir"; exit 2; }
    [[ -d "$dir" ]] || { err "module-deps: not a directory: $dir"; exit 2; }

    local debs=() d
    for d in "$dir"/*.deb; do [[ -e "$d" ]] && debs+=("$d"); done
    [[ ${#debs[@]} -eq 0 ]] && { ok "module deps 없음 ($dir)"; return 0; }

    # 이미 모두 정상 설치면 dpkg 를 부르지 않는다 — 모듈 재설치마다 dpkg 락을 잡을 이유가 없다.
    local missing="" name
    for d in "${debs[@]}"; do
        name=$(dpkg-deb -f "$d" Package 2>/dev/null) || continue
        _pkg_healthy "$name" || missing+=" $name"
    done
    if [[ -z "$missing" ]]; then
        ok "module deps 완비 (${#debs[@]} deb — 설치 불필요)"
        return 0
    fi

    info "module deps 미완비:$missing → offline 설치 (${#debs[@]} deb)"
    local rc=0
    _priv_dpkg_install "${debs[@]}" || rc=$?
    if [[ $rc -eq 2 ]]; then
        err "module deps 설치 보류 — dpkg 락 경합 (다음 설치/기동 시 재시도)"; exit 3
    elif [[ $rc -ne 0 ]]; then
        _cims_dpkg apt-get -o DPkg::Lock::Timeout=100 -y --fix-broken install >/dev/null 2>&1 || true
        if ! _priv_dpkg_install "${debs[@]}"; then
            err "module deps 설치 실패: $(tail -3 /tmp/cims-priv.err 2>/dev/null)"; exit 3
        fi
    fi
    ok "module deps 설치 완료 (${#debs[@]} deb)"
    rm -f /tmp/cims-priv.err
}

do_base_deps_status() {   # 0=완비, 1=미완비. vendor deb 의 Package 들이 설치돼 있는지만 본다.
    local missing="" d name
    for d in "$VENDOR_DIR"/*/*.deb; do
        [[ -e "$d" ]] || continue
        name=$(dpkg-deb -f "$d" Package 2>/dev/null) || continue
        _pkg_healthy "$name" || missing+=" $name"
    done
    if [[ -n "$missing" ]]; then
        info "base deps 미완비:$missing"
        return 1
    fi
    ok "base deps 완비"
    return 0
}

do_ensure_base_deps() {
    local need=0
    "$IP_CMD" -j addr >/dev/null 2>&1                                   || need=1
    # 상태 기반 — iF(half-configured) 도 "미완비" 로 잡힌다. 실행 성공 여부로 판정하면
    # 공유 라이브러리 갱신 순간에 실패해 불필요한 재설치 루프를 만든다.
    _priv_pkg_healthy keepalived                                       || need=1
    { command -v mount.nfs >/dev/null 2>&1 || [[ -x /sbin/mount.nfs ]]; } || need=1
    if [[ $need -eq 0 ]]; then
        ok "base deps 정상 (ip/keepalived/mount.nfs — 설치 불필요)"
        return 0
    fi
    local debs=()
    local d
    for d in "$VENDOR_DIR"/*/*.deb; do [[ -e "$d" ]] && debs+=("$d"); done
    if [[ ${#debs[@]} -eq 0 ]]; then
        err "vendor deb 없음 ($VENDOR_DIR) — agent 패키지 vendor/ 확인"; exit 3
    fi
    # 설치 구간 서비스 기동 억제 — postinst 가 conf(vrrp_instance) 없이 keepalived 를
    # 기동하면 systemd 90초 타임아웃 → configure 실패 → 패키지가 iF 로 갇힌다(실측 사고).
    _priv_mask_ka
    # half-configured 는 재설치가 아니라 configure 완료가 정답.
    if ! _priv_pkg_ok keepalived && dpkg -l keepalived 2>/dev/null | grep -q "^iF"; then
        info "keepalived half-configured(iF) — dpkg --configure 로 복구 시도"
        _cims_dpkg dpkg --configure -a >/dev/null 2>&1 || true
    fi
    if _priv_pkg_healthy keepalived && "$IP_CMD" -j addr >/dev/null 2>&1 \
       && { command -v mount.nfs >/dev/null 2>&1 || [[ -x /sbin/mount.nfs ]]; }; then
        _priv_unmask_ka
        ok "base deps 복구 완료 (configure 만으로 해소 — 재설치 불필요)"
        return 0
    fi
    info "base deps 미완비 — vendor offline 균일 설치 (${#debs[@]} deb)"
    local rc=0
    _priv_dpkg_install "${debs[@]}" || rc=$?
    if [[ $rc -eq 2 ]]; then
        _priv_unmask_ka
        err "base deps 설치 보류 — dpkg 락 경합 (다음 agent 기동/HA 적용 시 재시도)"
        exit 3
    elif [[ $rc -ne 0 ]]; then
        _cims_dpkg apt-get -o DPkg::Lock::Timeout=100 -y --fix-broken install >/dev/null 2>&1 || true
        if ! _priv_dpkg_install "${debs[@]}"; then
            _priv_unmask_ka
            err "base deps 설치 실패: $(tail -3 /tmp/cims-priv.err 2>/dev/null)"; exit 3
        fi
    fi
    _priv_unmask_ka
    # keepalived 는 '설치'만 균일하게. '실행'은 cims-ha(config)가 제어 — config 없는
    # 노드(비-HA)서 dpkg postinst 자동기동 잔재를 비활성화. config 있으면(HA 노드)
    # cims-ha 가 관리하므로 건드리지 않음(VIP flap 방지).
    if [[ ! -f /etc/keepalived/keepalived.conf ]]; then
        systemctl disable --now keepalived >/dev/null 2>&1 || true
    fi
    ok "base deps 설치 완료 (${#debs[@]} deb; keepalived 실행은 config 활성 시 cims-ha 가 기동)"
    rm -f /tmp/cims-priv.err
}

# agent 기동 자가복구 — 설치가 중단돼(SIGKILL 등) 남은 mask 잔재 해제.
# 남으면 apply 의 start 가 "Unit is masked" 로 실패해 VIP 가 안 붙는다.
do_keepalived_unmask() {
    if [[ "$(systemctl is-enabled keepalived 2>/dev/null)" == "masked" ]]; then
        systemctl unmask keepalived >/dev/null 2>&1 \
            && ok "keepalived mask 잔재 해제 (설치 중단으로 남았던 것)" \
            || { err "unmask 실패"; exit 3; }
    else
        info "keepalived mask 잔재 없음 (정상)"
    fi
}

do_net_rps() {
    local iface="$1" mask="$2"
    valid_iface "$iface"   || exit 2
    valid_rps_mask "$mask" || exit 2
    local applied=0 q
    for q in /sys/class/net/"$iface"/queues/rx-*/rps_cpus; do
        [[ -e "$q" ]] || continue
        if echo "$mask" > "$q" 2>/tmp/cims-priv.err; then
            applied=$((applied+1))
        else
            err "rps write $q: $(cat /tmp/cims-priv.err 2>/dev/null)"; exit 3
        fi
    done
    [[ $applied -gt 0 ]] || { err "no rx queues for $iface"; exit 3; }
    ok "rps_cpus=$mask -> $iface ($applied queue)"
    rm -f /tmp/cims-priv.err
}

# ── 프로세스 식별 (읽기 전용) ────────────────────────
# 파일 capability(setcap cap_net_admin 등) 바이너리의 프로세스는 ptrace 접근 검사
# (대상 caps ⊆ 호출자 caps)로 인해 동일 uid 라도 /proc/<pid>/exe 읽기·ss -p 소켓
# 귀속이 거부된다 — lifecycle 의 좀비 정리·start 판정·pidfile 확정이 전부 실명한다.
# root 위임으로 식별만 복원한다. 셋 다 시스템 상태를 변경하지 않는다.
valid_pid() {
    [[ "$1" =~ ^[0-9]{1,9}$ ]] || { err "invalid pid: $1"; return 1; }
    return 0
}

do_proc_exe() {
    local pid="$1"
    valid_pid "$pid" || exit 2
    readlink "/proc/$pid/exe" 2>/dev/null || true
}

do_proc_pids_of() {
    local bin="$1"
    [[ "$bin" == /* && -f "$bin" ]] || { err "invalid bin (절대경로 파일 아님): $bin"; exit 2; }
    local real; real=$(readlink -f "$bin" 2>/dev/null) || exit 0
    local p exe
    for p in /proc/[0-9]*; do
        exe=$(readlink "$p/exe" 2>/dev/null) || continue
        [[ "${exe% (deleted)}" == "$real" ]] && echo "${p##*/}"
    done
    exit 0
}

do_port_owner() {
    local proto="$1" port="$2"
    [[ "$proto" == "udp" || "$proto" == "tcp" ]] || { err "invalid proto: $proto"; exit 2; }
    [[ "$port" =~ ^[0-9]{1,5}$ ]] && (( port > 0 && port < 65536 )) || { err "invalid port: $port"; exit 2; }
    local flag="-ulnp"; [[ "$proto" == "tcp" ]] && flag="-tlnp"
    local pid
    pid=$(ss -H "$flag" 2>/dev/null \
          | awk -v pt="$port" 'match($4,/:([0-9]+)$/,m) && m[1]==pt {match($0,/pid=([0-9]+)/,p); if(p[1]){print p[1]; exit}}')
    [[ -z "$pid" ]] && exit 0
    echo "$pid $(readlink "/proc/$pid/exe" 2>/dev/null || true)"
}

# ── dispatch ────────────────────────────────────────
case "${1:-}" in
    ip-add)
        [[ $# -eq 3 ]] || { err "usage: cims-priv ip-add <iface> <cidr>"; exit 1; }
        do_ip_add "$2" "$3"
        ;;
    ip-del)
        [[ $# -eq 3 ]] || { err "usage: cims-priv ip-del <iface> <cidr>"; exit 1; }
        do_ip_del "$2" "$3"
        ;;
    route-add)
        [[ $# -eq 4 ]] || { err "usage: cims-priv route-add <dest_cidr> <via> <dev>"; exit 1; }
        do_route_add "$2" "$3" "$4"
        ;;
    route-del)
        [[ $# -eq 4 ]] || { err "usage: cims-priv route-del <dest_cidr> <via> <dev>"; exit 1; }
        do_route_del "$2" "$3" "$4"
        ;;
    mount-add)
        [[ $# -ge 4 && $# -le 5 ]] || { err "usage: cims-priv mount-add <fstype> <source> <target> [options]"; exit 1; }
        do_mount_add "$2" "$3" "$4" "${5:-defaults}"
        ;;
    mount-del)
        [[ $# -eq 2 ]] || { err "usage: cims-priv mount-del <target>"; exit 1; }
        do_mount_del "$2"
        ;;
    base-deps-status)
        # 설치하지 않고 **상태만** 판정 (dpkg 락과 무관) — 보증기 루프가 쓴다.
        [[ $# -eq 1 ]] || { err "usage: cims-priv base-deps-status"; exit 1; }
        do_base_deps_status
        ;;
    keepalived-unmask)
        [[ $# -eq 1 ]] || { err "usage: cims-priv keepalived-unmask"; exit 1; }
        do_keepalived_unmask
        ;;
    policy-rc-clear)
        [[ $# -eq 1 ]] || { err "usage: cims-priv policy-rc-clear"; exit 1; }
        do_policy_rc_clear
        ;;
    module-deps-install)
        [[ $# -eq 2 ]] || { err "usage: cims-priv module-deps-install <module-vendor-dir>"; exit 1; }
        do_module_deps_install "$2"
        ;;
    setcap-net-admin)
        [[ $# -eq 2 ]] || { err "usage: cims-priv setcap-net-admin <bin>"; exit 1; }
        do_setcap_net_admin "$2"
        ;;
    net-sysctl)
        [[ $# -eq 3 ]] || { err "usage: cims-priv net-sysctl <key> <value>"; exit 1; }
        do_net_sysctl "$2" "$3"
        ;;
    net-rps)
        [[ $# -eq 3 ]] || { err "usage: cims-priv net-rps <iface> <mask>"; exit 1; }
        do_net_rps "$2" "$3"
        ;;
    ensure-base-deps)
        do_ensure_base_deps
        ;;
    proc-exe)
        [[ $# -eq 2 ]] || { err "usage: cims-priv proc-exe <pid>"; exit 1; }
        do_proc_exe "$2"
        ;;
    proc-pids-of)
        [[ $# -eq 2 ]] || { err "usage: cims-priv proc-pids-of <bin>"; exit 1; }
        do_proc_pids_of "$2"
        ;;
    port-owner)
        [[ $# -eq 3 ]] || { err "usage: cims-priv port-owner <udp|tcp> <port>"; exit 1; }
        do_port_owner "$2" "$3"
        ;;
    version)
        # 버전은 agent 패키지와 항상 일치 — 옆 pkg.json(agent/pkg.json)을 단일 SoT 로 읽는다.
        # (하드코딩 시 agent bump 때마다 desync → 동적 조회로 자동 동기화. python 의존 회피.)
        _priv_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        _priv_ver=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
                    "$_priv_dir/../pkg.json" 2>/dev/null | head -1)
        echo "cims-priv ${_priv_ver:-unknown}"
        ;;
    *)
        err "usage: cims-priv {ip-add|ip-del|route-add|route-del|mount-add|mount-del|net-sysctl|net-rps|ensure-base-deps|setcap-net-admin|proc-exe|proc-pids-of|port-owner|version} ..."
        exit 1
        ;;
esac
