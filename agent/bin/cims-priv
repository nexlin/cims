#!/usr/bin/env bash
# agent/bin/cims-priv — agent 가 root 권한이 필요한 인프라 작업만 위임받아 수행
#
# sudoers NOPASSWD 화이트리스트 단일 entry 대상. 각 subcommand 가 자체적으로
# 인자 검증 (iface 패턴, CIDR 형식, lo 거부) 을 수행하므로 wildcard sudoers 에서도
# 임의 명령 주입 위험 없음.
#
# 사용법 (agent 내부 호출):
#   sudo -n cims-priv ip-add <iface> <cidr>
#   sudo -n cims-priv ip-del <iface> <cidr>
#   sudo -n cims-priv version

set -euo pipefail

IP_CMD="/usr/bin/ip"

err()  { echo "[ERROR] $*" >&2; }
info() { echo "[INFO]  $*"; }
ok()   { echo "[OK]    $*"; }

# ── 인자 검증 ───────────────────────────────────────
valid_iface() {
    # IFNAMSIZ = 16 → 최대 15자. lo / dash-prefix 거부 (인자 주입 차단).
    [[ "$1" =~ ^[a-zA-Z0-9_.-]{1,15}$ ]] || { err "invalid iface: $1"; return 1; }
    [[ "$1" == "lo" ]]   && { err "lo not allowed"; return 1; }
    [[ "$1" =~ ^- ]]     && { err "iface cannot start with dash: $1"; return 1; }
    return 0
}

valid_cidr() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]] \
        || { err "invalid cidr: $1"; return 1; }
    return 0
}

# ── 액션 ────────────────────────────────────────────
do_ip_add() {
    local iface="$1" cidr="$2"
    valid_iface "$iface" || exit 2
    valid_cidr "$cidr"   || exit 2
    if "$IP_CMD" addr add "$cidr" dev "$iface" 2>/tmp/cims-priv.err; then
        ok "$iface += $cidr"
    else
        # kernel 이 같은 IP/dev 충돌 시 두 가지 메시지 중 하나 반환 — 둘 다 already-present 로 처리
        if grep -qE "File exists|Address already assigned" /tmp/cims-priv.err 2>/dev/null; then
            info "$iface: $cidr already present (skip)"
        else
            err "ip addr add $cidr dev $iface: $(cat /tmp/cims-priv.err 2>/dev/null)"
            exit 3
        fi
    fi
    rm -f /tmp/cims-priv.err
}

do_ip_del() {
    local iface="$1" cidr="$2"
    valid_iface "$iface" || exit 2
    valid_cidr "$cidr"   || exit 2
    if "$IP_CMD" addr del "$cidr" dev "$iface" 2>/dev/null; then
        ok "$iface -= $cidr"
    else
        info "$iface: $cidr not present (skip)"
    fi
}

# ── dispatch ────────────────────────────────────────
case "${1:-}" in
    ip-add)
        [[ $# -eq 3 ]] || { err "usage: cims-priv ip-add <iface> <cidr>"; exit 1; }
        do_ip_add "$2" "$3"
        ;;
    ip-del)
        [[ $# -eq 3 ]] || { err "usage: cims-priv ip-del <iface> <cidr>"; exit 1; }
        do_ip_del "$2" "$3"
        ;;
    version)
        echo "cims-priv 0.1.0"
        ;;
    *)
        err "usage: cims-priv {ip-add|ip-del|version} ..."
        exit 1
        ;;
esac
