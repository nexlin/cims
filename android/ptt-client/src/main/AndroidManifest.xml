<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M2 MCPTT: SIP/RTP + floor(UDP) + 마이크 + CSC(HTTPS) + 등록유지 FGS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 화면 최상단 전역 상태 아이콘 배지(다른 앱 위에 표시) — CIMS-Phone 과 동일 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 부팅 자동 로그인 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <!-- CIMS 제품군 내부 기동 권한(signature) — CIMS 오너앱이 로그인 직후 등록유지 서비스를 시작. -->
    <permission
        android:name="com.cims.ue.permission.CIMS_SUITE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.cims.ue.permission.CIMS_SUITE" />

    <!-- 패키지 가시성(API 30+) — 발언 마이크 핸드오프(MIC_YIELD/RESUME) 명시적 브로드캐스트 대상 -->
    <queries>
        <package android:name="com.cims.ue.volte" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CimsPtt">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- exported+signature 권한: CIMS 오너앱(동일 서명)이 로그인 직후 백그라운드 등록을 시작할 수 있게 -->
        <service
            android:name=".PttService"
            android:exported="true"
            android:permission="com.cims.ue.permission.CIMS_SUITE"
            android:foregroundServiceType="microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="mcptt_registration_keepalive" />
        </service>

        <!-- MCData FD 첨부 열기 — files/mcdata/ 를 다른 앱(뷰어)에 공유 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 부팅 자동 로그인 리시버 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 전역 하드웨어 PTT/SOS 키 — 접근성 키 필터(백그라운드에서도 측면 버튼 동작).
             설정→접근성에서 활성화 필요(앱 설정 탭에 바로가기). -->
        <service
            android:name=".PttKeyService"
            android:exported="true"
            android:label="@string/ptt_key_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ptt_key_service" />
        </service>

        <!-- 벤더 PTT 키 브로드캐스트 폴백(정적) — 프로세스 사망 시 down 으로 서비스 재기동.
             실행 중 수신은 PttService 의 동적 등록이 담당. -->
        <receiver
            android:name=".VendorPttReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.PTT.down" />
                <action android:name="android.intent.action.PTT.up" />
                <action android:name="com.android.action.ptt.down" />
                <action android:name="com.android.action.ptt.up" />
                <action android:name="com.motorolasolutions.intent.action.ACTION_PTT_BUTTON_DOWN" />
                <action android:name="com.motorolasolutions.intent.action.ACTION_PTT_BUTTON_UP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
