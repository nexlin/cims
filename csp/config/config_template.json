          { "key": "action",             "label": "동작", "type": "enum", "options": ["allow", "deny"], "default": "deny", "required": true },
          { "key": "tags",               "label": "태그", "type": "string_list", "default": [] },
          { "key": "note",               "label": "메모", "type": "string", "default": "" }
        ]
      },
      "storage": { "kind": "jsonl", "file": "config/acl_policies.jsonl" }
    },
    {
      "key": "access_services",
