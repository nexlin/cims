{
  "version": 2,
  "sections": [
    {
      "key": "sip",
      "title": "SIP Stack",
      "description": "SIP 스택 공통 정책. 수신 엔드포인트(bind_ip/bind_port)는 local_nodes 콜렉션에서 정의되며, CSP 인스턴스의 identity(From/Via/Contact 생성용 Local IP/Port)는 local_nodes 의 primary 항목에서 자동 주입됨.",
      "fields": [
        {
          "key": "Setup.Sip.UdpThreadCount", "label": "UDP 수신 스레드 수 (fallback)",
          "type": "int", "default": 2, "min": 1, "max": 32,
          "restart": true,
          "help": "local_nodes.thread_count 가 SOT. 이 값은 local_nodes 에 thread_count 가 미지정된 리스너용 fallback."
        },
        {
          "key": "Setup.Sip.StackExecutePeriod", "label": "Stack tick (ms)",
          "type": "int", "default": 20, "min": 1, "max": 1000,
          "restart": true
        },
        {
          "key": "Setup.Sip.MinRegisterTimeout", "label": "최소 REGISTER timeout (s)",
          "type": "int", "default": 60, "min": 10,
          "restart": true
        },
        {
          "key": "Setup.Sip.UserTimeout", "label": "User Alive Timeout (s)",
          "type": "int", "default": 3600, "min": 60,
          "restart": true
        },
        {
          "key": "Setup.Sip.StaleCallTimeout", "label": "Stale Call Timeout (s)",
          "type": "int", "default": 300, "min": 0,
          "restart": true,
          "help": "0 = 비활성. 마지막 SIP activity 이후 무응답 통화 자동 종료."
        },
        {
          "key": "Setup.Sip.CallPickupId", "label": "Call Pickup ID",
          "type": "string", "default": "**",
          "restart": true,
          "help": "TAS 의 Call Pickup 기능용 트리거 전화번호."
        },
        {
          "key": "Setup.Sip.SendOptionsPeriod", "label": "UE OPTIONS keepalive (s)",
          "type": "int", "default": 0, "min": 0,
          "restart": true,
          "help": "0 = 비활성. 양의 값이면 등록된 UE 에 주기적으로 OPTIONS 전송."
        }
      ]
    },
    {
      "key": "roles",
      "title": "역할 (Roles)",
      "description": "활성화할 IMS 서버 역할. AccessService 와 무관하게 전역 스위치.",
      "fields": [
        { "key": "Setup.Roles.CSCF",   "label": "CSCF (가입자 등록/인증)", "type": "bool", "default": true,  "restart": true },
        { "key": "Setup.Roles.TAS",    "label": "TAS (VoIP B2BUA)",        "type": "bool", "default": true,  "restart": true },
        { "key": "Setup.Roles.PTT_AS", "label": "PTT-AS (그룹콜)",         "type": "bool", "default": true,  "restart": true },
        { "key": "Setup.Roles.IBCF",   "label": "IBCF (IMS 피어링)",       "type": "bool", "default": false, "restart": true }
      ]
    },
    {
      "key": "rtp_relay",
      "title": "RTP Relay (CMP 연동)",
      "description": "미디어 릴레이용 CMP 연동 정보",
      "fields": [
        { "key": "Setup.RtpRelay.UseRtpRelay", "label": "RTP Relay 사용", "type": "bool",   "default": true,  "restart": true },
        { "key": "Setup.RtpRelay.CmpIp",       "label": "CMP IP",         "type": "string", "default": "127.0.0.1", "deploy_value": "@CMP_IP@", "restart": true },
        { "key": "Setup.RtpRelay.CmpPort",     "label": "CMP 제어 포트",  "type": "int",    "default": 9000, "min": 1, "max": 65535, "restart": true },
        { "key": "Setup.RtpRelay.LocalCmpPort","label": "Local 수신 포트","type": "int",    "default": 9001, "min": 1, "max": 65535, "restart": true }
      ]
    },
    {
      "key": "log",
      "title": "로깅",
      "fields": [
        { "key": "Setup.Log.Folder",        "label": "로그 디렉토리",              "type": "path", "default": "log", "restart": true },
        { "key": "Setup.Log.MaxSize",       "label": "로그 파일 최대 크기 (bytes)", "type": "int",  "default": 10000000, "min": 1000000, "restart": true },
        { "key": "Setup.Log.Level.Debug",   "label": "Debug 로그",    "type": "bool", "default": true,  "restart": false, "reload_hint": "SIGUSR1 로 즉시 반영 (향후 지원)" },
        { "key": "Setup.Log.Level.Info",    "label": "Info 로그",     "type": "bool", "default": true,  "restart": false },
        { "key": "Setup.Log.Level.Network", "label": "Network 로그",  "type": "bool", "default": true,  "restart": false },
        { "key": "Setup.Log.Level.Sql",     "label": "SQL 로그",      "type": "bool", "default": false, "restart": false }
      ]
    },
    {
      "key": "db",
      "title": "데이터베이스",
      "description": "가입자/그룹 조회용 MariaDB",
      "fields": [
        { "key": "Setup.Database.Host",     "label": "DB Host",     "type": "string",   "default": "127.0.0.1", "deploy_value": "@DB_HOST@", "restart": true },
        { "key": "Setup.Database.Port",     "label": "DB Port",     "type": "int",      "default": 3306, "min": 1, "max": 65535, "restart": true },
        { "key": "Setup.Database.User",     "label": "DB User",     "type": "string",   "default": "cims", "deploy_value": "@DB_USER@", "restart": true },
        { "key": "Setup.Database.Password", "label": "DB Password", "type": "password", "default": "", "deploy_value": "@DB_PASSWORD@", "restart": true },
        { "key": "Setup.Database.DbName",   "label": "DB Name",     "type": "string",   "default": "cims", "restart": true }
      ]
    },
    {
      "key": "_infra",
      "title": "Infrastructure (내부 전용)",
      "description": "UI 에 노출하지 않는 배포/인프라 값. configure.sh 가 deploy_value 로 채움.",
      "hidden": true,
      "fields": [
        { "key": "Setup.Sip.LocalIp",           "type": "string",     "default": "0.0.0.0",  "deploy_value": "@CSP_IP@", "hidden": true,
          "help": "primary local_node 가 없을 때 fallback. 정상 경로는 local_nodes 의 primary 항목에서 자동 주입." },
        { "key": "Setup.Sip.UdpPort",           "type": "int",        "default": 5060, "min": 1, "max": 65535, "hidden": true,
          "help": "primary local_node 가 없을 때 fallback. 정상 경로는 local_nodes 의 primary 항목에서 자동 주입." },
        { "key": "Setup.Sip.TcpPort",           "type": "int",        "default": 25061,      "hidden": true },
        { "key": "Setup.Sip.TcpThreadCount",    "type": "int",        "default": 2,          "hidden": true },
        { "key": "Setup.Sip.TcpRecvTimeout",    "type": "int",        "default": 600,        "hidden": true },
        { "key": "Setup.Sip.TlsPort",           "type": "int",        "default": 5061,       "hidden": true },
        { "key": "Setup.Sip.TlsAcceptTimeout",  "type": "int",        "default": 10,         "hidden": true },
        { "key": "Setup.Sip.CertFile",          "type": "path",       "default": "cert/csp.pem", "hidden": true },

        { "key": "Setup.RtpRelay.LocalCmpIp",   "type": "string",     "default": "0.0.0.0",  "deploy_value": "@CSP_IP@", "hidden": true },

        { "key": "Setup.DataFolder.User",       "type": "path",       "default": "user",     "hidden": true },
        { "key": "Setup.DataFolder.Group",      "type": "path",       "default": "group",    "hidden": true },

        { "key": "Setup.Cdr.Folder",            "type": "path",       "default": "log/cdr",  "hidden": true },

        { "key": "Setup.ServiceLogging.Dir",    "type": "path",       "default": "service_log", "deploy_value": "@SERVICE_LOG_DIR@", "hidden": true },
        { "key": "Setup.ServiceLogging.Enable", "type": "string_list","default": ["sip", "cmp", "csc"], "hidden": true },
        { "key": "Setup.ServiceLogging.Recording","type": "bool",     "default": true,       "hidden": true },

        { "key": "Setup.Monitor.Port",          "type": "int",        "default": 16000,      "hidden": true },
        { "key": "Setup.Monitor.ClientIpList",  "type": "string_list","default": ["127.0.0.1"], "deploy_value": ["@CSP_IP@"], "hidden": true },

        { "key": "Setup.Security.DenySipUserAgentList", "type": "string_list", "default": ["friendly-scanner", "sundayddr"], "hidden": true }
      ]
    }
  ],
  "collections": [
    {
      "key": "local_nodes",
      "title": "Local Node (수신 엔드포인트)",
      "description": "CSP 가 수신하는 bind 포트. access/peering/mgmt edge 로 구분.",
      "restart": false,
      "reload_hint": "저장 시 CSP SIGUSR1 로 rebind",
      "schema": {
        "primary_key": ["id"],
        "id_field": "id",
        "id_type": "uuid",
        "unique_keys": [["bind_ip", "bind_port", "protocol"], ["name"]],
        "fields": [
          { "key": "id",              "label": "ID", "type": "string", "readonly": true, "auto": "uuid" },
          { "key": "name",            "label": "이름", "type": "string", "required": true },
          { "key": "enabled",         "label": "활성", "type": "bool", "default": true },
          { "key": "is_primary",      "label": "Primary (CSP identity)", "type": "bool", "default": false,
            "help": "CSP 인스턴스의 From/Via/Contact 에 사용되는 primary local_node. enabled=true 중 정확히 1개 권장. 미지정 시 edge=access && protocol=UDP 인 첫 번째가 암묵적으로 사용됨." },
          { "key": "edge",            "label": "Edge 분류", "type": "enum", "options": ["access", "peering", "mgmt"], "default": "access", "required": true,
            "help": "access=UE 수신, peering=IMS 피어링 수신, mgmt=관리 전용" },
          { "key": "bind_ip",         "label": "바인딩 IP", "type": "string", "default": "0.0.0.0", "required": true },
          { "key": "bind_port",       "label": "포트", "type": "int", "default": 5060, "min": 1, "max": 65535, "required": true },
          { "key": "protocol",        "label": "프로토콜", "type": "enum", "options": ["UDP","TCP","TLS","WS","WSS"], "default": "UDP", "required": true },
          { "key": "thread_count",    "label": "수신 스레드 수", "type": "int", "default": 2, "min": 1, "max": 32,
            "help": "이 리스너의 UDP 수신 스레드 수. 0 또는 미지정 시 Setup.Sip.UdpThreadCount 로 fallback. TCP/TLS 는 R3+ 확장 대상." },
          { "key": "tls_cert_path",   "label": "TLS cert", "type": "path", "advanced": true },
          { "key": "tls_key_path",    "label": "TLS key",  "type": "path", "advanced": true },
          { "key": "tls_ca_path",     "label": "TLS CA",   "type": "path", "advanced": true },
          { "key": "tls_verify_peer", "label": "Peer 검증", "type": "bool", "default": false, "advanced": true },
          { "key": "max_connections", "label": "최대 연결 수", "type": "int", "default": 0, "min": 0, "advanced": true,
            "help": "0 = 무제한. TCP/TLS 에만 적용." },
          { "key": "tags",            "label": "태그", "type": "string_list", "default": [] },
          { "key": "note",            "label": "메모", "type": "string", "default": "" }
        ]
      },
      "storage": { "kind": "jsonl", "file": "config/local_nodes.jsonl" }
    },
    {
      "key": "remote_nodes",
      "title": "Remote Node (피어 서버)",
      "description": "외부 IMS/PBX 피어의 접속 정보. 순수 transport 만 (인증정보는 Route 에서).",
      "restart": false,
      "reload_hint": "저장 시 CSP SIGUSR1 reload",
      "schema": {
        "primary_key": ["id"],
        "id_field": "id",
        "id_type": "uuid",
        "unique_keys": [["name"]],
        "fields": [
          { "key": "id",             "label": "ID", "type": "string", "readonly": true, "auto": "uuid" },
          { "key": "name",           "label": "이름", "type": "string", "required": true },
          { "key": "enabled",        "label": "활성", "type": "bool", "default": true },
          { "key": "ip",             "label": "IP/Host", "type": "string", "required": true },
          { "key": "port",           "label": "포트", "type": "int", "default": 5060, "min": 1, "max": 65535, "required": true },
          { "key": "protocol",       "label": "프로토콜", "type": "enum", "options": ["UDP","TCP","TLS"], "default": "UDP", "required": true },
          { "key": "remote_domain",  "label": "원격 SIP domain", "type": "string", "default": "",
            "help": "피어의 SIP URI host. Outgoing Request-URI/To 에 사용." },
          { "key": "srv_lookup",     "label": "SRV lookup", "type": "bool", "default": false, "advanced": true },
          { "key": "dns_fallback",   "label": "DNS A fallback", "type": "bool", "default": true, "advanced": true },
          { "key": "tls_verify",     "label": "TLS peer 검증", "type": "bool", "default": false, "advanced": true },
          { "key": "tags",           "label": "태그", "type": "string_list", "default": [] },
          { "key": "note",           "label": "메모", "type": "string", "default": "" }
        ]
      },
      "storage": { "kind": "jsonl", "file": "config/remote_nodes.jsonl" }
    },
    {
      "key": "routes",
      "title": "Route (LN ↔ RN 연결)",
      "description": "Local Node 와 Remote Node 간 1:1 연결 파라미터. (local_node_ref, remote_node_ref) unique.",
      "restart": false,
      "reload_hint": "저장 시 CSP SIGUSR1 reload",
      "schema": {
        "primary_key": ["id"],
        "id_field": "id",
        "id_type": "uuid",
        "unique_keys": [["name"], ["local_node_ref", "remote_node_ref"]],
        "fields": [
          { "key": "id",                     "label": "ID", "type": "string", "readonly": true, "auto": "uuid" },
          { "key": "name",                   "label": "이름", "type": "string", "required": true },
          { "key": "enabled",                "label": "활성", "type": "bool", "default": true },
          { "key": "local_node_ref",         "label": "Local Node", "type": "ref", "ref_collection": "local_nodes", "required": true },
          { "key": "remote_node_ref",        "label": "Remote Node", "type": "ref", "ref_collection": "remote_nodes", "required": true },
          { "key": "outbound_proxy_ip",      "label": "outbound proxy IP", "type": "string", "default": "", "advanced": true },
          { "key": "outbound_proxy_port",    "label": "outbound proxy port", "type": "int", "default": 0, "advanced": true },
          { "key": "register_to_remote",     "label": "REGISTER 전송", "type": "bool", "default": false },
          { "key": "register_expires",       "label": "REGISTER expires (s)", "type": "int", "default": 3600, "advanced": true },
          { "key": "auth_user",              "label": "Auth user", "type": "string", "default": "" },
          { "key": "auth_password",          "label": "Auth password", "type": "password", "default": "" },
          { "key": "auth_realm",             "label": "Auth realm", "type": "string", "default": "" },
          { "key": "max_concurrent_calls",   "label": "동시 호 제한", "type": "int", "default": 0, "min": 0, "advanced": true,
            "help": "0 = 무제한" },
          { "key": "cps_limit",              "label": "CPS 제한", "type": "int", "default": 0, "min": 0, "advanced": true },
          { "key": "tags",                   "label": "태그", "type": "string_list", "default": [] },
          { "key": "note",                   "label": "메모", "type": "string", "default": "" }
        ]
      },
      "storage": { "kind": "jsonl", "file": "config/routes.jsonl" }
    },
    {
      "key": "route_sets",
      "title": "Route Set (클러스터 + 분배 정책)",
      "description": "Route 여러 개를 묶어 부하분배/failover. peering 클러스터 단위.",
      "restart": false,
      "reload_hint": "저장 시 CSP SIGUSR1 reload",
      "schema": {
        "primary_key": ["id"],
        "id_field": "id",
        "id_type": "uuid",
        "unique_keys": [["name"]],
        "fields": [
          { "key": "id",                       "label": "ID", "type": "string", "readonly": true, "auto": "uuid" },
          { "key": "name",                     "label": "이름", "type": "string", "required": true },
          { "key": "enabled",                  "label": "활성", "type": "bool", "default": true },
          { "key": "distribution_policy",      "label": "분배 정책", "type": "enum",
            "options": ["failover", "round_robin", "weighted", "hash_by_caller"], "default": "failover", "required": true },
          { "key": "members",                  "label": "Route 멤버", "type": "object_list",
            "required": true,
            "item_schema": {
              "fields": [
                { "key": "route_ref", "label": "Route", "type": "ref", "ref_collection": "routes", "required": true },
                { "key": "priority",  "label": "우선순위", "type": "int", "default": 100, "min": 1,
                  "help": "failover: 낮을수록 먼저 선택" },
                { "key": "weight",    "label": "가중치", "type": "int", "default": 1, "min": 0,
                  "help": "weighted: 비율. 0 = 분배 제외" }
              ]
            }
          },
          { "key": "health_check_mode",        "label": "헬스체크 방식", "type": "enum",
            "options": ["options_ping", "invite_response", "none"], "default": "options_ping" },
          { "key": "health_check_interval_sec","label": "헬스체크 주기 (s)", "type": "int", "default": 30, "min": 1, "advanced": true },
          { "key": "health_check_dead_threshold","label": "dead 판정 임계",   "type": "int", "default": 3,  "min": 1, "advanced": true },
          { "key": "health_check_recovery_probes","label": "recovery 임계",    "type": "int", "default": 1,  "min": 1, "advanced": true },
          { "key": "fallback_policy",          "label": "전체 dead 시",
            "type": "enum", "options": ["reject", "next_policy"], "default": "reject" },
          { "key": "tags",                     "label": "태그", "type": "string_list", "default": [] },
          { "key": "note",                     "label": "메모", "type": "string", "default": "" }
        ]
      },
      "storage": { "kind": "jsonl", "file": "config/route_sets.jsonl" }
    },
    {
      "key": "rules",
      "title": "Rule (원자 조건)",
      "description": "SIP 메시지 요소 1개에 대한 단일 조건. tags 로 용도(acl/routing/transform) 힌트.",
      "restart": false,
      "reload_hint": "저장 시 CSP SIGUSR1 reload",
      "schema": {
        "primary_key": ["id"],
        "id_field": "id",
        "id_type": "uuid",
        "unique_keys": [["name"]],
        "fields": [
          { "key": "id",      "label": "ID", "type": "string", "readonly": true, "auto": "uuid" },
          { "key": "name",    "label": "이름", "type": "string", "required": true },
          { "key": "enabled", "label": "활성", "type": "bool", "default": true },
          { "key": "field",   "label": "대상 필드", "type": "enum", "required": true,
            "options": [
              "from_uri_host", "from_uri_user",
              "to_uri_host",   "to_uri_user",
              "req_uri_host",  "req_uri_user",
              "src_ip",        "dst_ip",
              "user_agent",    "method",
              "p_asserted_identity", "via_host"
            ]
          },
          { "key": "op",      "label": "연산자", "type": "enum", "required": true,
            "options": ["eq", "ne", "prefix", "suffix", "contains", "regex", "in_cidr", "in_list", "exists", "not_exists"]
          },
          { "key": "value",   "label": "값", "type": "string", "default": "",
            "help": "in_list 는 콤마 분리. in_cidr 은 1.2.3.0/24. regex 는 POSIX ERE. exists/not_exists 는 무시." },
          { "key": "tags",    "label": "태그", "type": "string_list", "default": [],
            "help": "권장: acl / routing / transform / inbound-filter / audit" },
          { "key": "note",    "label": "메모", "type": "string", "default": "" }
        ]
      },
      "storage": { "kind": "jsonl", "file": "config/rules.jsonl" }
    },
    {
      "key": "rule_sets",
      "title": "Rule Set (AND/OR 조합)",
      "description": "Rule 들을 flat AND/OR 로 조합. Routing/ACL/Transform 에서 공용.",
      "restart": false,
      "reload_hint": "저장 시 CSP SIGUSR1 reload",
      "schema": {
        "primary_key": ["id"],
        "id_field": "id",
        "id_type": "uuid",
        "unique_keys": [["name"]],
        "fields": [
          { "key": "id",         "label": "ID", "type": "string", "readonly": true, "auto": "uuid" },
          { "key": "name",       "label": "이름", "type": "string", "required": true },
          { "key": "enabled",    "label": "활성", "type": "bool", "default": true },
          { "key": "combinator", "label": "조합자", "type": "enum", "options": ["AND", "OR"], "default": "AND", "required": true },
          { "key": "members",    "label": "Rule 멤버", "type": "object_list", "required": true,
            "item_schema": {
              "fields": [
                { "key": "rule_ref", "label": "Rule", "type": "ref", "ref_collection": "rules", "required": true },
                { "key": "negate",   "label": "NOT", "type": "bool", "default": false }
              ]
            }
          },
          { "key": "tags",       "label": "태그", "type": "string_list", "default": [] },
          { "key": "note",       "label": "메모", "type": "string", "default": "" }
        ]
      },
      "storage": { "kind": "jsonl", "file": "config/rule_sets.jsonl" }
    },
    {
      "key": "routing_policies",
      "title": "Routing Policy",
