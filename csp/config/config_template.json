{
  "version": 2,
  "sections": [
    {
      "key": "sip_stack",
      "title": "SIP Stack",
      "description": "SIP 스택 내부 운용 (스레드/틱). 수신 엔드포인트(bind_ip/bind_port)와 CSP identity 는 local_nodes 콜렉션에서 정의.",
      "fields": [
        {
          "key": "Setup.Sip.UdpThreadCount",
          "label": "UDP 수신 스레드 수 (fallback)",
          "type": "int",
          "default": 2,
          "min": 1,
          "max": 32,
          "restart": true,
          "help": "local_nodes.thread_count 가 SOT. 이 값은 local_nodes 에 thread_count 가 미지정된 리스너용 fallback."
        },
        {
          "key": "Setup.Sip.StackExecutePeriod",
          "label": "Stack tick (ms)",
          "type": "int",
          "default": 20,
          "min": 1,
          "max": 1000,
          "restart": true,
          "help": "psip Stack 내부 타이머 tick 주기. 변경 시 CSP 재기동 필요."
        }
      ],
      "scope": "service"
    },
    {
      "key": "cscf",
      "title": "CSCF (가입자 등록/관리)",
      "description": "REGISTER/SUBSCRIBE 처리 모듈 정책. 역할 토글은 Roles.CSCF.",
      "fields": [
        {
          "key": "Setup.Sip.MinRegisterTimeout",
          "label": "최소 REGISTER timeout (s)",
          "type": "int",
          "default": 60,
          "min": 10,
          "restart": false,
          "reload_hint": "SIGUSR1 로 재로드. 다음 REGISTER 응답부터 적용."
        },
        {
          "key": "Setup.Sip.UserTimeout",
          "label": "User Alive Timeout (s)",
          "type": "int",
          "default": 3600,
          "min": 60,
          "restart": false,
          "reload_hint": "SIGUSR1 로 재로드. 다음 만료 주기부터 적용."
        },
        {
          "key": "Setup.Sip.SendOptionsPeriod",
          "label": "UE OPTIONS keepalive (s)",
          "type": "int",
          "default": 0,
          "min": 0,
          "restart": false,
          "reload_hint": "SIGUSR1 로 재로드. 0 = 비활성. 양의 값이면 등록된 UE 에 주기적 OPTIONS."
        }
      ],
      "scope": "service"
    },
    {
      "key": "tas",
      "title": "TAS (VoLTE 서비스)",
      "description": "VoLTE B2BUA 및 부가 서비스(당겨받기/착신거부/DND) 정책. 역할 토글은 Roles.TAS.",
      "fields": [
        {
          "key": "Setup.Sip.CallPickupId",
          "label": "Call Pickup ID (당겨받기)",
          "type": "string",
          "default": "**",
          "restart": false,
          "reload_hint": "SIGUSR1 로 재로드. 다음 INVITE 부터 적용.",
          "help": "VoLTE 당겨받기 기능 트리거 전화번호."
        },
        {
          "key": "Setup.Sip.StaleCallTimeout",
          "label": "Stale Call Timeout (s)",
          "type": "int",
          "default": 300,
          "min": 0,
          "restart": false,
          "reload_hint": "SIGUSR1 로 재로드. 30 초 주기 체크에서 다음 cycle 부터 적용.",
          "help": "0 = 비활성. 마지막 SIP activity 이후 무응답 통화 자동 종료."
        }
      ],
      "scope": "service"
    },
    {
      "key": "functions",
      "title": "기능 (Functions)",
      "description": "활성화할 IMS 서버 기능. AccessService 와 무관하게 전역 스위치.",
      "fields": [
        {
          "key": "Setup.Roles.CSCF",
          "label": "CSCF (가입자 등록/인증)",
          "type": "bool",
          "default": true,
          "restart": true
        },
        {
          "key": "Setup.Roles.TAS",
          "label": "TAS (VoLTE B2BUA)",
          "type": "bool",
          "default": true,
          "restart": true
        },
        {
          "key": "Setup.Roles.PTT_AS",
          "label": "PTT-AS (그룹콜)",
          "type": "bool",
          "default": true,
          "restart": true
        },
        {
          "key": "Setup.Roles.IBCF",
          "label": "IBCF (IMS 피어링)",
          "type": "bool",
          "default": false,
          "restart": true
        }
      ],
      "scope": "service"
    },
    {
      "key": "media_server",
      "title": "미디어서버 연동",
      "description": "VoLTE/PTT 미디어 relay 및 녹취를 담당하는 미디어서버(CMP) 연동 설정.",
      "fields": [
        {
          "key": "Setup.MediaServer.Enable",
          "label": "미디어서버 사용",
          "type": "bool",
          "default": true,
          "restart": true
        },
        {
          "key": "Setup.MediaServer.Endpoints",
          "label": "미디어서버(CMP) 엔드포인트",
          "type": "object_list",
          "restart": true,
          "help": "미디어서버(CMP) 노드 목록. 첫 행이 primary. 2개 이상이면 Session-ID consistent-hash 로 relay 세션을 분배한다(All-Active). 죽거나(HEARTBEAT 무응답) 포화된(가용 RTP 포트 0) 노드는 헬스체크로 ring 에서 제외되어 신규 세션이 가지 않는다.",
          "item_schema": {
            "fields": [
              {
                "key": "ip",
                "label": "IP",
                "type": "string",
                "required": true,
                "help": "미디어서버(CMP)의 IP 또는 호스트명."
              },
              {
                "key": "port",
                "label": "제어 포트",
                "type": "int",
                "default": 9000,
                "min": 1,
                "max": 65535,
                "help": "미디어서버의 JSON-over-UDP 제어 수신 포트."
              }
            ]
          },
          "default": [
            { "ip": "127.0.0.1", "port": 9000 }
          ],
          "deploy_value": [
            { "ip": "@CMP_IP@", "port": 9000 }
          ]
        },
        {
          "key": "Setup.MediaServer.LocalPort",
          "label": "Local 수신 포트",
          "type": "int",
          "default": 9001,
          "min": 1,
          "max": 65535,
          "restart": true,
          "help": "CSP 가 미디어서버 응답을 받을 로컬 포트."
        },
        {
          "key": "Setup.MediaServer.LocalIp",
          "label": "Local 수신 IP",
          "type": "string",
          "default": "0.0.0.0",
          "deploy_value": "@CSP_IP@",
          "restart": true,
          "help": "CSP 가 미디어서버 응답을 받을 로컬 bind IP. 0.0.0.0 이면 모든 인터페이스.",
          "scope": "system"
        }
      ],
      "scope": "service"
    },
    {
      "key": "xcap",
      "title": "XCAP / CSC 연동 (UE↔CSC)",
      "description": "MCPTT 단말이 그룹문서/사용자 프로파일/서비스 설정을 취득하는 CSC XCAP(MCPTT) 서버. CSP 는 xcap-diff NOTIFY 의 xcap-root URL 로 이 주소를 광고한다.",
      "fields": [
        {
          "key": "Setup.Xcap.Host",
          "label": "XCAP 서버 주소",
          "type": "string",
          "default": "",
          "deploy_value": "@CSC_IP@",
          "restart": true,
          "help": "CSC XCAP(MCPTT) 서버의 IP/호스트명. 비우면 CSP 자기 IP 로 fallback (단일 노드). 단말이 라우팅 가능한 CSC 주소(또는 VIP)로 지정."
        },
        {
          "key": "Setup.Xcap.Port",
          "label": "XCAP 서버 포트",
          "type": "int",
          "default": 4430,
          "min": 1,
          "max": 65535,
          "restart": true,
          "help": "CSC McpttServer 포트 (GMS/CMS/KMS XCAP 라우트 서빙). csc.json McpttServer.Port 와 일치."
        },
        {
          "key": "Setup.Xcap.Scheme",
          "label": "XCAP 스킴",
          "type": "enum",
          "options": [
            "https",
            "http"
          ],
          "default": "https",
          "restart": true,
          "help": "CSC McpttServer 가 TLS(cert 존재) 면 https. 3GPP CSC-2/3 규격 기본은 https."
        }
      ],
      "scope": "service"
    },
    {
      "key": "log",
      "title": "로깅",
      "fields": [
        {
          "key": "Setup.Log.Folder",
          "label": "로그 디렉토리",
          "type": "path",
          "default": "log",
          "restart": true
        },
        {
          "key": "Setup.Log.MaxSize",
          "label": "로그 파일 최대 크기 (bytes)",
          "type": "int",
          "default": 10000000,
          "min": 1000000,
          "restart": true
        },
        {
          "key": "Setup.Log.Level.Debug",
          "label": "Debug 로그",
          "type": "bool",
          "default": true,
          "restart": false,
          "reload_hint": "SIGUSR1 로 즉시 반영 (향후 지원)"
        },
        {
          "key": "Setup.Log.Level.Info",
          "label": "Info 로그",
          "type": "bool",
          "default": true,
          "restart": false
        },
        {
          "key": "Setup.Log.Level.Network",
          "label": "Network 로그",
          "type": "bool",
          "default": true,
          "restart": false
        },
        {
          "key": "Setup.Log.Level.Sql",
          "label": "SQL 로그",
          "type": "bool",
          "default": false,
          "restart": false
        }
      ],
      "scope": "service"
    },
    {
      "key": "db",
      "title": "데이터베이스",
      "description": "가입자/그룹 조회용 MariaDB",
      "fields": [
        {
          "key": "Setup.Database.Host",
          "label": "DB Host",
          "type": "string",
          "default": "127.0.0.1",
          "deploy_value": "@DB_HOST@",
          "restart": true
        },
        {
          "key": "Setup.Database.Port",
          "label": "DB Port",
          "type": "int",
          "default": 3306,
          "min": 1,
          "max": 65535,
          "restart": true
        },
        {
          "key": "Setup.Database.User",
          "label": "DB User",
          "type": "string",
          "default": "cims",
          "deploy_value": "@DB_USER@",
          "restart": true
        },
        {
          "key": "Setup.Database.Password",
          "label": "DB Password",
          "type": "password",
          "default": "",
          "deploy_value": "@DB_PASSWORD@",
          "restart": true
        },
        {
          "key": "Setup.Database.DbName",
          "label": "DB Name",
          "type": "string",
          "default": "cims",
          "restart": true
        }
      ],
      "scope": "service"
    },
    {
      "key": "_infra",
      "title": "Infrastructure (내부 전용)",
      "description": "UI 에 노출하지 않는 배포/인프라 값. configure.sh 가 deploy_value 로 채움. 모든 필드는 hidden: true. UI 렌더링 시 group 속성으로 sub-header 분류.",
      "hidden": true,
      "groups": [
        {
          "key": "sip_fallback",
          "title": "SIP 엔드포인트 (fallback)"
        },
        {
          "key": "data_folder",
          "title": "레거시 데이터 폴더"
        },
        {
          "key": "service_logging",
          "title": "서비스 로깅"
        },
        {
          "key": "monitor",
          "title": "Monitor API"
        },
        {
          "key": "security",
          "title": "보안"
        }
      ],
      "fields": [
        {
          "key": "Setup.Sip.LocalIp",
          "label": "Local IP (fallback)",
          "group": "sip_fallback",
          "type": "string",
          "default": "0.0.0.0",
          "deploy_value": "@CSP_IP@",
          "hidden": true,
          "restart": true,
          "help": "primary local_node 가 없을 때 fallback. 정상 경로는 local_nodes 의 primary 항목에서 자동 주입."
        },
        {
          "key": "Setup.Sip.UdpPort",
          "label": "UDP Port (fallback)",
          "group": "sip_fallback",
          "type": "int",
          "default": 5060,
          "min": 1,
          "max": 65535,
          "hidden": true,
          "restart": true,
          "help": "primary local_node 가 없을 때 fallback."
        },
        {
          "key": "Setup.Sip.TcpPort",
          "label": "TCP Port (fallback)",
          "group": "sip_fallback",
          "type": "int",
          "default": 25061,
          "hidden": true,
          "restart": true,
          "help": "primary local_node TCP 가 없을 때 fallback."
        },
        {
          "key": "Setup.Sip.TcpThreadCount",
          "label": "TCP 수신 스레드",
          "group": "sip_fallback",
          "type": "int",
          "default": 2,
          "hidden": true,
          "restart": true
        },
        {
          "key": "Setup.Sip.TcpRecvTimeout",
          "label": "TCP 수신 timeout (s)",
          "group": "sip_fallback",
          "type": "int",
          "default": 600,
          "hidden": true,
          "restart": true
        },
        {
          "key": "Setup.Sip.TlsPort",
          "label": "TLS Port (fallback)",
          "group": "sip_fallback",
          "type": "int",
          "default": 5061,
          "hidden": true,
          "restart": true,
          "help": "primary local_node TLS 가 없을 때 fallback."
        },
        {
          "key": "Setup.Sip.TlsAcceptTimeout",
          "label": "TLS accept timeout (s)",
          "group": "sip_fallback",
          "type": "int",
          "default": 10,
          "hidden": true,
          "restart": true
        },
        {
          "key": "Setup.Sip.CertFile",
          "label": "TLS 인증서 파일 (fallback)",
          "group": "sip_fallback",
          "type": "path",
          "default": "cert/csp.pem",
          "hidden": true,
          "restart": true,
          "help": "local_node 에 tls_cert_path 미지정 시 stack-global 용."
        },
        {
          "key": "Setup.DataFolder.User",
          "label": "User 데이터 폴더 (legacy)",
          "group": "data_folder",
          "type": "path",
          "default": "user",
          "hidden": true,
          "restart": true,
          "help": "DB 가 SOT. 이 폴더는 DB 미연결 시 fallback."
        },
        {
          "key": "Setup.DataFolder.Group",
          "label": "Group 데이터 폴더 (legacy)",
          "group": "data_folder",
          "type": "path",
          "default": "group",
          "hidden": true,
          "restart": true,
          "help": "DB 가 SOT. 이 폴더는 DB 미연결 시 fallback."
        },
        {
          "key": "Setup.ServiceLogging.Dir",
          "label": "서비스 로그 루트",
          "group": "service_logging",
          "type": "path",
          "default": "service_log",
          "deploy_value": "@SERVICE_LOG_DIR@",
          "hidden": true,
          "restart": true,
          "help": "녹취(call.d/*.rtp) + SIP/미디어서버/CSC msg.jsonl + flow.jsonl 저장 루트."
        },
        {
          "key": "Setup.ServiceLogging.Enable",
          "label": "서비스 로그 인터페이스",
          "group": "service_logging",
          "type": "string_list",
          "default": [
            "sip",
            "cmp",
            "csc"
          ],
          "hidden": true,
          "restart": true
        },
        {
          "key": "Setup.ServiceLogging.Recording",
          "label": "녹취 활성화",
          "group": "service_logging",
          "type": "bool",
          "default": true,
          "hidden": true,
          "restart": true
        },
        {
          "key": "Setup.Monitor.Port",
          "label": "Monitor API Port",
          "group": "monitor",
          "type": "int",
          "default": 16000,
          "hidden": true,
          "restart": true
        },
        {
          "key": "Setup.Monitor.ClientIpList",
          "label": "Monitor 접근 허용 IP",
          "group": "monitor",
          "type": "string_list",
          "default": [
            "127.0.0.1"
          ],
          "deploy_value": [
            "@CSP_IP@"
          ],
          "hidden": true,
          "restart": true
        },
        {
          "key": "Setup.Security.DenySipUserAgentList",
          "label": "차단 User-Agent 목록",
          "group": "security",
          "type": "string_list",
          "default": [
            "friendly-scanner",
            "sundayddr"
          ],
          "hidden": true,
          "restart": false,
          "reload_hint": "SIGUSR1 로 재로드. 다음 request 부터 적용."
        }
      ],
      "scope": "system"
    }
  ],
  "collections": [
    {
      "key": "local_nodes",
      "title": "Local Node (수신 엔드포인트)",
      "description": "CSP 가 수신하는 bind 포트. access/peering/mgmt edge 로 구분.",
      "restart": false,
      "reload_hint": "저장 시 CSP SIGUSR1 로 rebind",
      "schema": {
        "primary_key": [
          "id"
        ],
        "id_field": "id",
        "id_type": "uuid",
        "unique_keys": [
          [
            "bind_ip",
            "bind_port",
            "protocol"
          ],
          [
            "name"
          ]
        ],
        "fields": [
          {
            "key": "id",
            "label": "ID",
            "type": "string",
            "readonly": true,
            "auto": "uuid"
          },
          {
            "key": "name",
            "label": "이름",
            "type": "string",
            "required": true
          },
          {
            "key": "enabled",
            "label": "활성",
            "type": "bool",
            "default": true
          },
          {
            "key": "is_primary",
            "label": "Primary (CSP identity)",
            "type": "bool",
            "default": false,
            "help": "CSP 인스턴스의 From/Via/Contact 에 사용되는 primary local_node. enabled=true 중 정확히 1개 권장. 미지정 시 edge=access && protocol=UDP 인 첫 번째가 암묵적으로 사용됨."
          },
          {
            "key": "edge",
            "label": "Edge 분류",
            "type": "enum",
            "options": [
              "access",
              "peering",
              "mgmt"
            ],
            "default": "access",
            "required": true,
            "help": "access=UE 수신, peering=IMS 피어링 수신, mgmt=관리 전용"
          },
          {
            "key": "bind_ip",
            "label": "바인딩 IP",
            "type": "string",
            "default": "0.0.0.0",
            "required": true
          },
          {
            "key": "bind_port",
            "label": "포트",
            "type": "int",
            "default": 5060,
            "min": 1,
            "max": 65535,
            "required": true
          },
          {
            "key": "protocol",
            "label": "프로토콜",
            "type": "enum",
            "options": [
              "UDP",
              "TCP",
              "TLS",
              "WS",
              "WSS"
            ],
            "default": "UDP",
            "required": true
          },
          {
            "key": "thread_count",
            "label": "수신 스레드 수",
            "type": "int",
            "default": 2,
            "min": 1,
            "max": 32,
            "help": "이 리스너의 UDP 수신 스레드 수. 0 또는 미지정 시 Setup.Sip.UdpThreadCount 로 fallback. TCP/TLS 는 R3+ 확장 대상."
          },
          {
            "key": "tls_cert_path",
            "label": "TLS cert",
            "type": "path",
            "advanced": true
          },
          {
            "key": "tls_key_path",
            "label": "TLS key",
            "type": "path",
            "advanced": true
          },
          {
            "key": "tls_ca_path",
            "label": "TLS CA",
            "type": "path",
            "advanced": true
          },
          {
            "key": "tls_verify_peer",
            "label": "Peer 검증",
            "type": "bool",
            "default": false,
            "advanced": true
          },
          {
            "key": "max_connections",
            "label": "최대 연결 수",
            "type": "int",
            "default": 0,
            "min": 0,
            "advanced": true,
            "help": "0 = 무제한. TCP/TLS 에만 적용."
          },
          {
            "key": "tags",
            "label": "태그",
            "type": "string_list",
            "default": []
          },
          {
            "key": "note",
            "label": "메모",
            "type": "string",
            "default": ""
          }
        ]
      },
      "storage": {
        "kind": "jsonl",
        "file": "config/local_nodes.jsonl"
      },
