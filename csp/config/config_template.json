          { "key": "target_ref",                "label": "Target 참조", "type": "string", "default": "",
            "help": "route_set: route_sets.name / access_service: access_services.name / reject: 무시" },
          { "key": "transform_rule_set_refs",   "label": "변환 Rule Sets (예약)", "type": "string_list", "default": [],
            "help": "향후 메시지 변환 용. 현재 런타임 미구현 (reserved)" },
          { "key": "fail_action",               "label": "실패 시", "type": "enum",
            "options": ["reject", "next_policy"], "default": "next_policy" },
          { "key": "tags",                      "label": "태그", "type": "string_list", "default": [] },
          { "key": "note",                      "label": "메모", "type": "string", "default": "" }
        ]
      },
      "storage": { "kind": "jsonl", "file": "config/routing_policies.jsonl" }
    },
    {
      "key": "acl_policies",
      "title": "ACL Policy",
      "description": "Rule Set 이 match 하면 allow/deny. scope 단위로 적용.",
      "restart": false,
      "reload_hint": "저장 시 CSP SIGUSR1 reload",
      "schema": {
        "primary_key": ["id"],
        "id_field": "id",
        "id_type": "uuid",
        "unique_keys": [["name"]],
        "fields": [
          { "key": "id",                 "label": "ID", "type": "string", "readonly": true, "auto": "uuid" },
          { "key": "name",               "label": "이름", "type": "string", "required": true },
          { "key": "enabled",            "label": "활성", "type": "bool", "default": true },
          { "key": "priority",           "label": "우선순위", "type": "int", "default": 100, "min": 1 },
          { "key": "match_rule_set_ref", "label": "매치 Rule Set", "type": "ref", "ref_collection": "rule_sets", "required": true },
          { "key": "scope",              "label": "범위", "type": "enum",
